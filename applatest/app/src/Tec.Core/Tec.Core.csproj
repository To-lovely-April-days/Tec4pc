<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Tec.Core</RootNamespace>
    <AssemblyName>Tec.Core</AssemblyName>
  </PropertyGroup>

  <!-- 领域核心：不引用 Avalonia，不引用任何具体驱动。
       这里出现 "Raman" / "RD105" 这样的名字就是架构被破坏了（核心架构 §1）。 -->
  <ItemGroup>
    <ProjectReference Include="..\Tec.Driver.Abi\Tec.Driver.Abi.csproj" />
  </ItemGroup>

  <!-- 全局库（配方 + 化合物）的落盘。Persistence 这一层本来就在读写文件
       （TecFiles 写 .tec / .tecbench / .tecrecipe），多一个数据库文件是同一类事。
       bundle 版自带各平台的原生 sqlite3，装机不必另外装运行时。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <!-- 导出器里有几处只该给自己人用的小工具（列号换算、页名消毒、字体子集），
       它们不是对外接口，但**必须有测试**——一个列号换错整份工作簿就打不开。 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Tec.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
