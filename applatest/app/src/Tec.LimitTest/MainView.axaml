<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tec.LimitTest.MainView"
             Background="White" FontSize="13">

  <!-- 三栏：左 = 设备串口；中 = 矩阵 + 按钮 + 等水提示 + 条件 + 参数；右 = 实时读数 + 日志。界面从简。 -->

  <Grid ColumnDefinitions="360,*,420" RowDefinitions="Auto,*" Margin="12">

    <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
      <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding ConnStatus}" Margin="16,0,0,0" Foreground="#555555" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>

    <!-- 左栏：设备与串口 -->
    <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
      <StackPanel Spacing="6">
        <TextBlock Text="设备与串口" FontWeight="Bold"/>
        <TextBlock Text="{Binding BenchPathText}" TextWrapping="Wrap" Foreground="#777777" FontSize="11"/>
        <TextBlock Text="{Binding PortsHint}" TextWrapping="Wrap" Foreground="#777777" FontSize="11"/>
        <ItemsControl ItemsSource="{Binding Devices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="6" Margin="0,2">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Label}" FontWeight="Bold"/>
                  <TextBlock Text="{Binding Status}" Foreground="#555555" FontSize="11" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="120,*" Margin="0,1">
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"/>
                          <TextBox Grid.Column="1" Text="{Binding Value}" FontSize="12" MinHeight="26" Padding="6,3"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="导入台面…" Click="Import_Click" IsEnabled="{Binding CanConnect}"/>
          <Button Content="保存并连接" Click="Connect_Click" IsEnabled="{Binding CanConnect}"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="#777777" FontSize="11" Margin="0,6,0,0"
                   Text="串口只能一个程序占着：开这个工具前把工作站 / 设备 HMI 关掉。台面文件跟工作站是同一种格式，可以「导入台面…」选工作站另存的 .tecbench。"/>
      </StackPanel>
    </ScrollViewer>

    <!-- 中栏：两页。「极限矩阵」= 矩阵、按钮、条件、参数；「升降温速率」（【本地改动】2026-11-17，用户要的满功率升 / 降温速率测试） -->
    <TabControl Grid.Row="1" Grid.Column="1" Margin="4,0" Padding="0,6,0,0">
    <TabItem>
    <TabItem.Header><TextBlock Text="极限矩阵" FontSize="15" FontWeight="Bold"/></TabItem.Header>
    <ScrollViewer>
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,Auto,16,Auto,*">
          <TextBlock Text="控温对象" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox Grid.Column="1" SelectedIndex="{Binding ObjectIndex}" IsEnabled="{Binding CanEditPlan}" MinWidth="170"
                    ToolTip.Tip="夹套：温控器自带那路 TC，单环。釜内：上位机串级，外环吃宇电探头的 Tr——台面里「控温方式」得是「上位机 PID（串级）」而且两个工位的 Tr 都有读数，否则开始时拒绝。到达、提前结束、稳定度都按被控量判">
            <ComboBoxItem Content="夹套 Tj（单环）"/>
            <ComboBoxItem Content="釜内 Tr（串级）"/>
          </ComboBox>
          <TextBlock Grid.Column="3" Text="冷却水温度 ℃" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox Grid.Column="4" Text="{Binding WatersText}" IsEnabled="{Binding CanEditPlan}"
                   ToolTip.Tip="逗号分开，顺序就是跑的顺序；不低于 7 ℃（冷水机的下限）。推荐 20 / 12 / 7"/>
        </Grid>
        <TextBlock TextWrapping="Wrap" Foreground="#555555"
                   Text="测试矩阵：勾要跑的格。每个水温下按「最低温 → 恒温」串着跑，两项之间先回温；换水温时停下来等你把冷却水调好。最高温不用冷却水、只测一次，放最后跑，跑完不回温（自然冷却）。"/>
        <ItemsControl ItemsSource="{Binding Cells}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="8" Margin="3" Background="{Binding Fill}" MinHeight="78">
                <StackPanel Spacing="2">
                  <CheckBox Content="{Binding Title}" IsChecked="{Binding Selected}" IsEnabled="{Binding CanEdit}"/>
                  <TextBlock Text="{Binding StateText}" FontWeight="Bold"/>
                  <TextBlock Text="{Binding Note}" FontSize="11" Foreground="#666666" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="开始" Click="Start_Click" IsEnabled="{Binding CanStart}" Background="#2E7D32" Foreground="White" Padding="22,8"/>
          <Button Content="跳过当前" Click="Skip_Click" IsEnabled="{Binding CanSkip}" Padding="14,8"/>
          <Button Content="停止" Click="Stop_Click" IsEnabled="{Binding CanStop}" Padding="14,8"/>
          <Button Content="急停" Click="Estop_Click" Background="#C62828" Foreground="White" Padding="22,8"
                  ToolTip.Tip="设备所有输出收安全态（TEC / 加热棒都断），整轮结束。没在跑也能按"/>
        </StackPanel>

        <Border IsVisible="{Binding IsWaitingWater}" Background="#FFF8E1" BorderBrush="#F9A825" BorderThickness="1" Padding="10">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding PromptText}" TextWrapping="Wrap" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="实际水温 ℃（手填）" VerticalAlignment="Center" IsVisible="{Binding PromptNeedsWater}"/>
              <TextBox Text="{Binding WaterText}" Width="90" IsVisible="{Binding PromptNeedsWater}"/>
              <Button Content="继续" Click="Continue_Click" Background="#1565C0" Foreground="White" Padding="18,6"/>
              <TextBlock Text="不做这一组就点「跳过当前」" VerticalAlignment="Center" Foreground="#777777" FontSize="11"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding PhaseText}" Foreground="#555555" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding BookPathText}" FontSize="11" Foreground="#777777" TextWrapping="Wrap"/>

        <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
          <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
            <TextBlock Text="测试条件（手填）" FontWeight="Bold"/>
            <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto">
              <TextBlock Text="操作人" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding OperatorName}" Margin="0,1"/>
              <TextBlock Grid.Row="1" Text="环境温度 ℃" VerticalAlignment="Center"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AmbientText}" Margin="0,1"/>
              <TextBlock Grid.Row="2" Text="补丁版本" VerticalAlignment="Center"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PatchText}" Margin="0,1"/>
              <TextBlock Grid.Row="3" Text="输出目录" VerticalAlignment="Center"/>
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OutDir}" Margin="0,1"/>
            </Grid>
            <Button Content="打开输出目录" Click="OpenOut_Click" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="参数" FontWeight="Bold"/>
            <Grid ColumnDefinitions="110,*,70,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <TextBlock Text="最低温目标 ℃" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding MinTargetText}" Margin="0,1,6,1"/>
              <TextBlock Grid.Column="2" Text="跑 min" VerticalAlignment="Center"/>
              <TextBox Grid.Column="3" Text="{Binding MinMinutesText}" Margin="0,1"/>
              <TextBlock Grid.Row="1" Text="最高温目标 ℃" VerticalAlignment="Center"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxTargetText}" Margin="0,1,6,1"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Text="跑 min" VerticalAlignment="Center"/>
              <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MaxMinutesText}" Margin="0,1"/>
              <TextBlock Grid.Row="2" Text="恒温目标 ℃" VerticalAlignment="Center"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HoldTargetText}" Margin="0,1,6,1"/>
              <TextBlock Grid.Row="2" Grid.Column="2" Text="恒温 min" VerticalAlignment="Center"/>
              <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding HoldMinutesText}" Margin="0,1"/>
              <TextBlock Grid.Row="3" Text="提前结束阈值 ℃" VerticalAlignment="Center" ToolTip.Tip="最低温 / 最高温：最近 10 min 两工位被控量变化都不到这个数就提前结束；0 = 不提前"/>
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SettleText}" Margin="0,1,6,1"/>
              <TextBlock Grid.Row="3" Grid.Column="2" Text="回温 ℃" VerticalAlignment="Center" ToolTip.Tip="两项之间先回到这个温度附近再做下一项（一律控夹套）"/>
              <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding ReturnTempText}" Margin="0,1"/>
              <TextBlock Grid.Row="4" Text="稳定度窗口 min" VerticalAlignment="Center" ToolTip.Tip="恒温：取记录最后这么多分钟的每秒数据算峰峰值 / 标准差 / 与目标差（±0.01 看这几项）"/>
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding StabilityText}" Margin="0,1,6,1"/>
            </Grid>
            <TextBlock TextWrapping="Wrap" Foreground="#777777" FontSize="11"
                       Text="手填的只有操作人、环境温度、冷却水温度；LIMITED、超温上限从温控器读，切换阈值、死区从台面配置读，没读到留空。恒温稳定度用每秒数据算（表里 2 min 一行那份只是抽样）。"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
    </TabItem>

    <TabItem>
    <TabItem.Header><TextBlock Text="升降温速率" FontSize="15" FontWeight="Bold"/></TabItem.Header>
    <ScrollViewer>
      <StackPanel Spacing="8">
        <TextBlock TextWrapping="Wrap" Foreground="#555555"
                   Text="满功率升 / 降温速率：从当前温度直接开始，给夹套一个够不着的目标，让输出顶在温控器的「最大输出占空比」上（= 满功率）。每个工位从接上满功率那一刻起算，满功率到时输出归零，再记一段看停了以后还冲多少。满功率这段夹套升（降）够合格线算合格。「升到目标温度」也是满功率从当前温度升，夹套过每个目标（缺省 80、100 ℃）记用时、算平均升温速度，到最高那个就归零。两个工位一起测，做完出一份 Excel 报告（汇总 + 每秒数据 + 曲线）。"/>
        <Border Background="#FFF3E0" BorderBrush="#FB8C00" BorderThickness="1" Padding="8">
          <TextBlock TextWrapping="Wrap"
                     Text="玻璃釜：满功率一分钟升 20 ℃，釜内外温差很大，有炸裂风险——釜里最好有液体，别从太高的温度开始。「升到目标温度」会满功率一路升到最高目标（缺省 100 ℃）。升温途中夹套到「升温停止线」那一路马上归零；读数几秒不更新、安全层触发都会两路全停。降温要冷却水：开始降温前会停下来让你把水开好、填水温。"/>
        </Border>
        <WrapPanel>
          <CheckBox Content="升温（加热棒满功率）" IsChecked="{Binding RateHeat}" IsEnabled="{Binding CanEditRate}" Margin="0,0,18,4"/>
          <CheckBox Content="降温（TEC 满功率，要冷却水）" IsChecked="{Binding RateCool}" IsEnabled="{Binding CanEditRate}" Margin="0,0,18,4"/>
          <CheckBox Content="升到目标温度（看用时）" IsChecked="{Binding RateReach}" IsEnabled="{Binding CanEditRate}" Margin="0,0,18,4"
                    ToolTip.Tip="加热棒满功率从当前温度一路升，夹套过每个目标温度记用时、算平均升温速度（（目标 − 起点）÷ 用时），到最高那个输出归零。排在降温后面做"/>
          <CheckBox Content="工位 A" IsChecked="{Binding RateWellA}" IsEnabled="{Binding CanEditRate}" Margin="0,0,18,4"/>
          <CheckBox Content="工位 B" IsChecked="{Binding RateWellB}" IsEnabled="{Binding CanEditRate}" Margin="0,0,18,4"/>
        </WrapPanel>
        <Grid ColumnDefinitions="140,*,140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Text="合格线：升 ℃" VerticalAlignment="Center" ToolTip.Tip="满功率这段夹套至少升这么多算合格（缺省 20：一分钟升 20 ℃）"/>
          <TextBox Grid.Column="1" Text="{Binding RateHeatPassText}" IsEnabled="{Binding CanEditRate}" Margin="0,1,10,1"/>
          <TextBlock Grid.Column="2" Text="合格线：降 ℃" VerticalAlignment="Center" ToolTip.Tip="满功率这段夹套至少降这么多算合格（缺省 20）"/>
          <TextBox Grid.Column="3" Text="{Binding RateCoolPassText}" IsEnabled="{Binding CanEditRate}" Margin="0,1"/>
          <TextBlock Grid.Row="1" Text="满功率 s" VerticalAlignment="Center" ToolTip.Tip="从接上满功率起开多久（缺省 60 = 一分钟）"/>
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RateFullText}" IsEnabled="{Binding CanEditRate}" Margin="0,1,10,1"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="归零后再记 s" VerticalAlignment="Center" ToolTip.Tip="输出归零以后再记多久，看夹套还冲多少（缺省 60）"/>
          <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding RateAfterText}" IsEnabled="{Binding CanEditRate}" Margin="0,1"/>
          <TextBlock Grid.Row="2" Text="升温停止线 ℃" VerticalAlignment="Center" ToolTip.Tip="升温途中哪一路夹套到这里就马上归零。导热油夹套上限 200 ℃，缺省 190 留 10 ℃ 给余温上冲"/>
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RateStopLineText}" IsEnabled="{Binding CanEditRate}" Margin="0,1,10,1"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="测几次" VerticalAlignment="Center" ToolTip.Tip="每一次 = 升温、降温、升到目标温度各一次（勾了哪个做哪个），都从当时的温度直接开始"/>
          <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding RateRoundsText}" IsEnabled="{Binding CanEditRate}" Margin="0,1"/>
          <TextBlock Grid.Row="3" Text="目标温度 ℃" VerticalAlignment="Center" ToolTip.Tip="升到目标温度用：逗号隔开，最多 5 个，都得低于升温停止线（缺省 80, 100）。起点已经高于哪个，那个就不测"/>
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RateTargetsText}" IsEnabled="{Binding CanEditRate}" Margin="0,1,10,1"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Text="最长等 min" VerticalAlignment="Center" ToolTip.Tip="升到目标温度满功率最长开多久：到这么久还没到最高那个目标就归零，记「没到」（缺省 20）"/>
          <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding RateReachMaxText}" IsEnabled="{Binding CanEditRate}" Margin="0,1"/>
          <TextBlock Grid.Row="4" Text="釜内物料（手填）" VerticalAlignment="Center" ToolTip.Tip="釜里装的什么、多少（写进报告）：空釜和有料差别很大"/>
          <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding RateMaterial}" IsEnabled="{Binding CanEditRate}" Margin="0,1"/>
        </Grid>
        <Grid ColumnDefinitions="140,*,140,*" RowDefinitions="Auto,Auto">
          <TextBlock Text="操作人" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Text="{Binding OperatorName}" IsEnabled="{Binding CanEditRate}" Margin="0,1,10,1"/>
          <TextBlock Grid.Column="2" Text="环境温度 ℃" VerticalAlignment="Center"/>
          <TextBox Grid.Column="3" Text="{Binding AmbientText}" IsEnabled="{Binding CanEditRate}" Margin="0,1"/>
          <TextBlock Grid.Row="1" Text="补丁版本" VerticalAlignment="Center"/>
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PatchText}" IsEnabled="{Binding CanEditRate}" Margin="0,1,10,1"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="输出目录" VerticalAlignment="Center"/>
          <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding OutDir}" IsEnabled="{Binding CanEditRate}" Margin="0,1"/>
        </Grid>
        <TextBlock TextWrapping="Wrap" Foreground="#777777" FontSize="11"
                   Text="操作人、环境温度、补丁版本、输出目录跟「极限矩阵」那页是同一份。最大输出占空比从温控器读、TEC 接入上限从台面配置读，没读到报告里留空。"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="开始速率测试" Click="RateStart_Click" IsEnabled="{Binding CanStartRate}" Background="#2E7D32" Foreground="White" Padding="22,8"/>
          <Button Content="跳过当前" Click="RateSkip_Click" IsEnabled="{Binding CanSkipRate}" Padding="14,8"
                  ToolTip.Tip="只停当前这一项（两路归零），接着做下一项；等冷却水时点它 = 降温都不做"/>
          <Button Content="停止" Click="RateStop_Click" IsEnabled="{Binding CanStopRate}" Padding="14,8"/>
          <Button Content="急停" Click="Estop_Click" Background="#C62828" Foreground="White" Padding="22,8"
                  ToolTip.Tip="设备所有输出收安全态（TEC / 加热棒都断），整轮结束。没在跑也能按"/>
        </StackPanel>

        <Border IsVisible="{Binding IsRateWaitingWater}" Background="#FFF8E1" BorderBrush="#F9A825" BorderThickness="1" Padding="10">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding RatePromptText}" TextWrapping="Wrap" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="冷却水温度 ℃（手填）" VerticalAlignment="Center"/>
              <TextBox Text="{Binding RateWaterText}" Width="90"/>
              <Button Content="继续" Click="RateContinue_Click" Background="#1565C0" Foreground="White" Padding="18,6"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding RateStatusText}" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding RatePhaseText}" Foreground="#555555" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding RateRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="8" Margin="0,3" Background="{Binding Fill}">
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StateText}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#444444" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding RateReportText}" FontSize="11" Foreground="#777777" TextWrapping="Wrap"/>
        <Button Content="打开输出目录" Click="OpenOut_Click"/>
      </StackPanel>
    </ScrollViewer>
    </TabItem>
    </TabControl>

    <!-- 右栏：实时与日志 -->
    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="8,0,0,0">
      <TextBlock Text="实时读数（每秒）" FontWeight="Bold"/>
      <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1" Padding="8" Margin="0,4">
        <TextBlock Text="{Binding AText}" TextWrapping="Wrap"/>
      </Border>
      <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1" Padding="8" Margin="0,0,0,4">
        <TextBlock Text="{Binding BText}" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Grid.Row="3" Text="日志" FontWeight="Bold" Margin="0,6,0,2"/>
      <ListBox Grid.Row="4" ItemsSource="{Binding LogLines}" FontSize="11" BorderBrush="#DDDDDD" BorderThickness="1">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
