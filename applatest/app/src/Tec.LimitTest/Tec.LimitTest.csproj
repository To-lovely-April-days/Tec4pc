<Project Sdk="Microsoft.NET.Sdk">

  <!-- 控温极限测试工具：给现场做极限测试用的独立小程序（界面从简）。
       托管与设备 HMI 同一套地基（HmiRuntime：真机驱动 / 台面 / 管线 / 安全层），
       按「最低温 / 最高温 / 恒温稳定性 × 冷却水 20 / 15 / 7 ℃」的矩阵自动跑，
       数据直接写进「控温极限测试记录」工作簿。
       串口只能一个程序占着：它替代工作站 / HMI 运行，不同时开。地基在 Tec.LimitTest.Core。 -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Tec.LimitTest</RootNamespace>
    <AssemblyName>Tec.LimitTest</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- 版本 = 打到的补丁号：标题栏显示它，记录表「补丁版本」缺省填它。
         出包脚本（scripts/publish-limit-test.sh / .cmd）用 /p:Version /p:InformationalVersion 覆盖 -->
    <Version>1.0.325</Version>
    <InformationalVersion>0325</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!-- 串口下拉：问系统要这台机器真有的口 -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tec.LimitTest.Core\Tec.LimitTest.Core.csproj" />
  </ItemGroup>

</Project>
