<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             x:Class="Tec.App.Views.CompoundsView">
  <UserControl.Styles>
    <!-- .crow：44 色块 / 名称 / CAS / 分子式 / 分子量 / 熔点 / 类别 / 备注 -->
    <Style Selector="Border.crow">
      <!-- 没有背景的 Border 不参与命中测试，点在列与列之间就没反应 -->
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#ececec" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.crow:pointerover">
      <Setter Property="Background" Value="#f5f5f5" />
    </Style>
    <Style Selector="Border.crow.sel">
      <Setter Property="Background" Value="#e8f2fb" />
      <Setter Property="BorderBrush" Value="#ececec" />
    </Style>
    <Style Selector="Border.crow TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#2b2b2b" />
      <Setter Property="Margin" Value="10,8" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.crow.sel TextBlock">
      <Setter Property="Foreground" Value="#0b3760" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.crow TextBlock.fx">
      <Setter Property="FontFamily" Value="Consolas,monospace" />
      <Setter Property="Foreground" Value="#4a4a4a" />
    </Style>
    <Style Selector="Border.crow TextBlock.note">
      <Setter Property="Foreground" Value="#7a7a7a" />
    </Style>
    <Style Selector="Border.crow.sel TextBlock.fx, Border.crow.sel TextBlock.note">
      <Setter Property="Foreground" Value="#0b3760" />
    </Style>
    <!-- 表头：11px + 字距，粘在顶部 -->
    <Style Selector="TextBlock.chd">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#3a3a3a" />
      <Setter Property="Margin" Value="10,8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.unit">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8d8d8d" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.frowk">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#3d3d3d" />
      <Setter Property="Width" Value="96" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- CARET：圆圈 + 箭头（与台面属性面板同款） -->
    <Style Selector="Border.exp3.up">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="180" />
      </Setter>
    </Style>
    <Style Selector="Button.secbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.secbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.exp3">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#6b6b6b" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,342">

    <!-- ========== .cmain ========== -->
    <DockPanel Grid.Column="0" Background="White">

      <!-- .ctool：58px 高，#ededed -->
      <Border DockPanel.Dock="Top" Height="58" Background="#ededed">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0" VerticalAlignment="Center">
          <TextBlock Text="检索：" FontSize="12" Foreground="#444444" VerticalAlignment="Center" />
          <Panel Width="260">
            <TextBox Classes="srch" Text="{Binding Search, Mode=TwoWay}"
                     Watermark="名称 / CAS / 分子式" />
            <ctl:TecIcon Key="ui-search" Tint="#9a9a9a" Size="13" Margin="8,0,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         IsHitTestVisible="False" />
          </Panel>
          <TextBlock Text="类别：" FontSize="12" Foreground="#444444" VerticalAlignment="Center" />
          <ComboBox Classes="sel" Width="130" ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding Category, Mode=TwoWay}" />
          <Button Classes="tbtn sm" Command="{Binding AddNew}"
                  ToolTip.Tip="新增一条空白化合物（不预填任何物性——预填等于替人编数据）">
            <ctl:TecIcon Key="ui-cmp-cmpnew" />
          </Button>
          <Button Classes="tbtn sm" Command="{Binding Import}"
                  ToolTip.Tip="从 CSV 导入。按 CAS 合并：已有的更新，没有的新增；表里没填的列不会把库里原值清掉。表头认中文也认英文，顺序随便排">
            <ctl:TecIcon Key="ui-cmp-cmpimport" />
          </Button>
          <Button Classes="tbtn sm" Command="{Binding Export}"
                  ToolTip.Tip="把整库导成 CSV（带 BOM，Excel 双击打开不乱码）">
            <ctl:TecIcon Key="ui-snav-export" />
          </Button>
          <Button Classes="tbtn del" Command="{Binding Delete}" ToolTip.Tip="删除选中的这一条">
            <ctl:TecIcon Key="ui-foot-trash" />
          </Button>
          <!-- 清空整库：换体系、换客户的时候一条条删不现实。要先问一遍，
               而且框里得写清楚「先导出一份 CSV 才是后悔药」 -->
          <Button Classes="tbtn del danger" Command="{Binding ClearAll}"
                  ToolTip.Tip="清空整个化合物库（不可撤销；要留底先用「导出」存一份 CSV）">
            <ctl:TecIcon Key="ui-foot-trash" Tint="#c0392b" />
          </Button>

          <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                     Foreground="{Binding StatusColorHex}" FontSize="11.5"
                     VerticalAlignment="Center" Margin="6,0,0,0" MaxWidth="520"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
        </StackPanel>
      </Border>

      <!-- 表头（.crow.head）：常驻顶部 -->
      <Border DockPanel.Dock="Top" Background="#fafafa"
              BorderBrush="#d5d5d5" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="44,1.3*,1*,0.9*,76,86,72,76,92,1*">
          <TextBlock Grid.Column="1" Text="名称" Classes="chd" />
          <TextBlock Grid.Column="2" Text="CAS 号" Classes="chd" />
          <TextBlock Grid.Column="3" Text="分子式" Classes="chd" />
          <TextBlock Grid.Column="4" Text="分子量" Classes="chd" />
          <TextBlock Grid.Column="5" Text="密度 g/mL" Classes="chd" />
          <TextBlock Grid.Column="6" Text="纯度" Classes="chd" />
          <TextBlock Grid.Column="7" Text="熔点 ℃" Classes="chd" />
          <TextBlock Grid.Column="8" Text="类别" Classes="chd" />
          <TextBlock Grid.Column="9" Text="备注" Classes="chd" />
        </Grid>
      </Border>

      <ScrollViewer>
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="crow" PointerPressed="OnRowPressed"
                        Classes.sel="{Binding IsSelected}">
                  <Grid ColumnDefinitions="44,1.3*,1*,0.9*,76,86,72,76,92,1*">
                    <TextBlock Grid.Column="1" Text="{Binding Name}" />
                    <TextBlock Grid.Column="2" Text="{Binding CasText}" />
                    <TextBlock Grid.Column="3" Text="{Binding Formula}" Classes="fx" />
                    <TextBlock Grid.Column="4" Text="{Binding MwText}" />
                    <TextBlock Grid.Column="5" Text="{Binding DensityText}" />
                    <TextBlock Grid.Column="6" Text="{Binding PurityText}" />
                    <TextBlock Grid.Column="7" Text="{Binding MpText}" />
                    <TextBlock Grid.Column="8" Text="{Binding Category}" />
                    <TextBlock Grid.Column="9" Text="{Binding Note}" Classes="note" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="没有匹配的化合物" IsVisible="{Binding NoMatch}"
                     FontSize="12" Foreground="#a2a2a2" Margin="30"
                     HorizontalAlignment="Center" />
          <!-- 空库跟「筛没了」分开说：空库要告诉人去哪儿添，筛没了只要告诉人换个词 -->
          <StackPanel IsVisible="{Binding IsEmpty}" Margin="30" Spacing="7"
                      HorizontalAlignment="Center">
            <TextBlock Text="化合物库是空的" FontSize="13.5" Foreground="#7a7a7a"
                       HorizontalAlignment="Center" />
            <TextBlock FontSize="11.5" Foreground="#a2a2a2" LineHeight="19" MaxWidth="470"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Text="用工具条上的「＋」逐条录入，或者「导入」一份 CSV。这里的数会拿去算加料体积、判析出、卡温度——程序不替你预置任何物性。" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- ========== 右侧物性详情 ========== -->
    <!-- 与台面属性同一套观感：白底面板 + 浅紫内容块。
         从前这一整栏是 #ececec 的灰，跟台面 / 配方 / 配方库那三页对不上 -->
    <Border Grid.Column="1" Background="{StaticResource ThemeGap}"
            BorderBrush="#d2d2d2" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <Border Background="{StaticResource ThemeFill}" Padding="18,16,18,20">
        <Panel>
        <!-- 一条都没选中（库空了 / 筛没了）：整块物性收起来，只留一句话。
             留着那一排空输入框，看着像「有一条化合物，只是什么都没填」 -->
        <StackPanel IsVisible="{Binding !HasSelection}" Spacing="8">
          <TextBlock Text="物性详情" FontSize="24" FontWeight="Light" Foreground="#333333"
                     HorizontalAlignment="Center" Margin="0,0,0,8" />
          <TextBlock Text="在左侧表里选中一条化合物，这里显示它的物性。"
                     FontSize="11.5" Foreground="#8d8d8d" LineHeight="19"
                     TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="库是空的就先用工具条上的「＋」新建一条，或者「导入」一份 CSV。"
                     FontSize="11.5" Foreground="#8d8d8d" LineHeight="19"
                     TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}" />
        </StackPanel>
        <StackPanel DataContext="{Binding Selected}"
                    IsVisible="{Binding $parent[UserControl].DataContext.HasSelection}">
          <TextBlock Text="物性详情" FontSize="24" FontWeight="Light" Foreground="#333333"
                     HorizontalAlignment="Center" Margin="0,0,0,8" />
          <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Light" Foreground="#333333"
                     HorizontalAlignment="Center" Margin="0,0,0,12" />

          <!-- 结构式：骨架式；离子化合物没有骨架，排离子对 -->
          <Border Background="White" BorderBrush="#dcdcdc" BorderThickness="1" CornerRadius="3"
                  Margin="0,0,0,14">
            <ctl:MoleculeView Structure="{Binding Structure}" IonText="{Binding IonText}" />
          </Border>

          <StackPanel Spacing="7">
            <!-- 名称也得能改：新增出来的那一条叫「新化合物」，没有这一格就改不了名 -->
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="名称" Classes="frowk" />
              <TextBox Classes="finput" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="196" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="CAS 号" Classes="frowk" />
              <TextBox Classes="finput" Text="{Binding CasEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="196"
                       Watermark="没有就留空" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="分子式" Classes="frowk" />
              <TextBox Classes="finput" Text="{Binding Formula, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="196" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="分子量" Classes="frowk" />
              <TextBox Classes="finput" Text="{Binding MwEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="152" Watermark="未填" />
              <TextBlock Text="g/mol" Classes="unit" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="密度" Classes="frowk" />
              <TextBox Classes="finput" Text="{Binding DensityEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="152"
                       Watermark="未填"
                       ToolTip.Tip="配料表把质量换成加料体积就靠它——泵下发的是体积。留空 = 没填，不是 0" />
              <TextBlock Text="g/mL" Classes="unit" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="纯度" Classes="frowk" />
              <TextBox Classes="finput" Text="{Binding PurityEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="152"
                       Watermark="未填"
                       ToolTip.Tip="当量计算要用：65 % 的硝酸和 100 % 的硝酸，同样称 10 g 差着三分之一的物质的量" />
              <TextBlock Text="%" Classes="unit" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="熔点" Classes="frowk" />
              <TextBox Classes="finput" Text="{Binding MpEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="152" Watermark="未填"
                       ToolTip.Tip="留空 = 没填，不能拿 0 顶：水的熔点就是 0 ℃" />
              <TextBlock Text="℃" Classes="unit" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="沸点" Classes="frowk" />
              <TextBox Classes="finput" Text="{Binding BpEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="152" Watermark="未填" />
              <TextBlock Text="℃" Classes="unit" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="比热" Classes="frowk" />
              <TextBox Classes="finput" Text="{Binding CpEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="152" Watermark="未填"
                       ToolTip.Tip="量热要用。现在只存着，还没有地方消费它" />
              <TextBlock Text="J/(g·K)" Classes="unit" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="相态" Classes="frowk" />
              <ComboBox Classes="sel" Width="152" FontSize="11.5"
                        ItemsSource="{Binding PhaseOptions}"
                        SelectedItem="{Binding PhaseText, Mode=TwoWay}"
                        ToolTip.Tip="纯品常温常压下的形态，参考数据。配料行连库时把它当默认值带过去；行上可以改——固体配成溶液走泵就把行上的改成「液」" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="常用溶剂" Classes="frowk" />
              <TextBox Classes="finput" Text="{Binding Solvent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="196" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="批号" Classes="frowk" />
              <TextBox Classes="finput" Text="{Binding Batch, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="196"
                       ToolTip.Tip="跟着这一瓶料走。GLP 要求记得出「用的是哪一批」" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="供应商" Classes="frowk" />
              <TextBox Classes="finput" Text="{Binding Supplier, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="196" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="备注" Classes="frowk" />
              <TextBox Classes="finput" Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="196" />
            </StackPanel>
          </StackPanel>

          <Border Height="1" Background="#d5d5d5" Margin="0,12,0,14" />
          <!-- 这一块的 DataContext 是选中的化合物，小节状态在视图模型上，
               所以要顺着 UserControl 往上取 -->
          <Button Classes="secbtn" Margin="0,0,0,8"
                  Command="{Binding $parent[UserControl].DataContext.SolubilitySection.Toggle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="exp3"
                      Classes.up="{Binding $parent[UserControl].DataContext.SolubilitySection.Open}">
                <ctl:TecIcon Key="ui-chev-down" Tint="#555555" />
              </Border>
              <TextBlock Text="溶解度 – 温度（g/100 mL 水）" FontSize="11.5" Foreground="#3d3d3d"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Border Background="White" BorderBrush="#dcdcdc" BorderThickness="1" CornerRadius="3"
                  IsVisible="{Binding $parent[UserControl].DataContext.SolubilitySection.Open}">
            <ctl:SolubilityView Coefficients="{Binding Solubility}" />
          </Border>

          <!-- 从前这里是一颗死按钮（没有 Command），下面还配着一句「可自动引用…」的承诺。
               饱和温度要拿浓度才算得出来，而浓度 = 溶质质量 ÷ 溶剂体积——这两个数只有
               配料表里才有，所以真正的换算在那一页上，这颗按钮把人带过去 -->
          <Button Classes="btn primary" Content="到配料表算饱和温度 →"
                  HorizontalAlignment="Center" Margin="0,14,0,0"
                  Command="{Binding $parent[UserControl].DataContext.GoCharge}" />
          <TextBlock Classes="intro left" Margin="0,10,0,0"
                     Text="饱和温度要按这一炉的浓度算（溶质质量 ÷ 溶剂体积），那两个数在配料表里。算出来可以直接写进控温步骤的目标温度（FR-5.9）。曲线是水中的溶解度，溶剂不是水就不换算。" />
        </StackPanel>
        </Panel>
        </Border>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
