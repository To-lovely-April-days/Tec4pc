<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="urn:tec:ctl"
             x:Class="Tec.App.Views.SchemaFormView">

  <!-- 表单一律由 schema 渲染。尺寸照原型 .frow / .finput：
       标签 76px · 11.5px，输入框 23px 高 · 11.5px，行间距 8px。
       提示是 .pf-tip —— 10.5px 灰字，不是蓝底方块。

       标签列原本 96：那是属性栏还有 342 宽时定的。栏缩到 312（现在 288）、
       再让出 14px 滚动条之后，输入框只剩一百出头，「1 台（2 通道，2 启用）」
       这种整句读数就被切在框里。标签绝大多数是 ≤5 个汉字（「反应釜规格」
       60px），76 减去 10 的右边距还剩 66，够站；省下的 20px 全给输入框。
       个别 7 个字的（「到达后等待稳定」「多久没数算失效」）折成两行——
       所以这一列的 TextWrapping 不能去掉。 -->
  <StackPanel>

    <ItemsControl ItemsSource="{Binding Fields}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <!-- 单位列固定 40px（原型 .pf-u）：写 Auto 的话没有单位的行输入框会多伸出去，
               一列输入框长短不一 -->
          <Grid ColumnDefinitions="76,*,40" Margin="0,0,0,8" IsVisible="{Binding IsVisible}">
            <!-- 字段自带的说明（FieldSpec.Tip）挂在标签上。这些话驱动里一直写着，
                 从前哪儿都不显示——「串口下拉里是当前检测到的口」正是要答的那一句 -->
            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                       FontSize="12" Foreground="#3a3d41" TextWrapping="Wrap" Margin="0,0,10,0"
                       ToolTip.Tip="{Binding Tip}" />

            <TextBox Grid.Column="1" Classes="fin" Text="{Binding NumberText, Mode=TwoWay}"
                     IsVisible="{Binding IsNumber}" />
            <TextBox Grid.Column="1" Classes="fin" Text="{Binding DurationText, Mode=TwoWay}"
                     IsVisible="{Binding IsDuration}" Watermark="时:分:秒" />
            <!-- ToolTip：串口那种「COM16 · USB-Enhanced-SERIAL-A CH344」在这一百多宽的
                 输入列里收起来只看得见前半截。ChoiceTip 只在显示串带了额外信息时才有值 -->
            <ComboBox Grid.Column="1" Classes="fsel" ItemsSource="{Binding Choices}"
                      SelectedItem="{Binding ChoiceValue, Mode=TwoWay}"
                      ToolTip.Tip="{Binding ChoiceTip}"
                      IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch" />
            <CheckBox Grid.Column="1" IsChecked="{Binding ToggleValue, Mode=TwoWay}"
                      IsVisible="{Binding IsToggle}" MinHeight="23" Padding="4,0,0,0" />
            <TextBox Grid.Column="1" Classes="fin" Text="{Binding TextValue, Mode=TwoWay}"
                     IsVisible="{Binding IsText}" />

            <TextBlock Grid.Column="2" Text="{Binding Unit}" FontSize="10.5" Foreground="#888d92"
                       VerticalAlignment="Center" Margin="7,0,0,0" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 多分段表：梯度控温、分段加料 -->
    <StackPanel IsVisible="{Binding HasTable}">
      <Border Height="1" Background="#d3d5d2" Margin="0,10,0,10" />
      <TextBlock Text="{Binding TableLabel}" FontSize="12" Foreground="#3a3d41" Margin="0,0,0,6" />

      <!-- 曲线预览：一张三列的表读不出形状，画出来一眼看见斜多久、平多久。
           与下面的表格是同一份数据，改哪边另一边立刻跟着变 -->
      <Border IsVisible="{Binding HasProfile}" BorderBrush="#e5e8ec" BorderThickness="1"
              CornerRadius="3" Background="White" Margin="0,0,0,8" ClipToBounds="True">
        <ctl:ProfileView Segments="{Binding Profile}" StartTemp="{Binding StartTemp}" />
      </Border>
      <TextBlock IsVisible="{Binding HasProfile}" Text="{Binding ProfileNote}"
                 FontSize="10.5" Foreground="#888d92" Margin="0,-4,0,8" />

      <ItemsControl ItemsSource="{Binding RowForms}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#f8f9fb" BorderBrush="#e5e8ec" BorderThickness="1"
                    CornerRadius="3" Padding="6" Margin="0,0,0,4">
              <!-- 折行而不是横排：起始限值一行有四列（监测量/条件/阈值/动作），
                   横排会把第四列挤出面板可视区，谁都不会发现那儿还有个下拉 -->
              <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Width="90" Margin="0,0,6,4">
                      <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#888d92" Margin="0,0,0,2" />
                      <TextBox Classes="fin" Text="{Binding NumberText, Mode=TwoWay}" IsVisible="{Binding IsNumber}" />
                      <TextBox Classes="fin" Text="{Binding DurationText, Mode=TwoWay}" IsVisible="{Binding IsDuration}" />
                      <ComboBox Classes="fsel" ItemsSource="{Binding Choices}"
                                SelectedItem="{Binding ChoiceValue, Mode=TwoWay}"
                                IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch" />
                      <TextBox Classes="fin" Text="{Binding TextValue, Mode=TwoWay}" IsVisible="{Binding IsText}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Classes="btn" Content="＋ 添加一段" Click="OnAddRow" HorizontalAlignment="Left"
              Height="24" MinWidth="0" Padding="10,0" FontSize="11.5" Margin="0,2,0,0" />
    </StackPanel>

    <!-- .pf-tip：10.5px 灰字。
         下边距不能省：一张表单的 tip 后面往往紧跟着**另一张**表单
         （台面栏里「连接」和「设备参数」是前后两个 SchemaFormView），
         只写上边距的话 tip 末行跟下一张表头一行贴在一起，看着像叠上去了。 -->
    <TextBlock IsVisible="{Binding HasTip}" Text="{Binding Tip}"
               FontSize="10.5" Foreground="#959a9f" LineHeight="16"
               TextWrapping="Wrap" Margin="0,7,0,12" />
  </StackPanel>

  <UserControl.Styles>
    <Style Selector="TextBox.fin">
      <Setter Property="Height" Value="23" />
      <Setter Property="MinHeight" Value="23" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#dddddd" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#202225" />
    </Style>
    <Style Selector="TextBox.fin:focus">
      <Setter Property="BorderBrush" Value="#acc3df" />
    </Style>
    <Style Selector="ComboBox.fsel">
      <Setter Property="Height" Value="23" />
      <Setter Property="MinHeight" Value="23" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#dddddd" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="White" />
    </Style>
  </UserControl.Styles>
</UserControl>
