<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             xmlns:v="clr-namespace:Tec.App.Views"
             x:Class="Tec.App.Views.BenchView">

  <!-- 三栏宽度：设备库 260 · 台面自适应 · 属性面板 312。
       左栏跟配方页、配方库页同宽——三页的左栏都是「库」，宽度不一致的话
       在菜单之间切换整个中列会横跳一下。从前这里是 118（一列一格），
       分类和两列格子都是在这个宽度上摆不下的 -->
  <Grid ColumnDefinitions="260,*,312">

    <!--
      设备库：分类成组——40px 组头（圆圈箭头 + 类名 + 台数）+ 两列设备格，
      组头可点，整类收起展开。

      **底色关系反过来了**：整栏铺面色 #F1F1F1，设备格是白的。
      从前是反的（栏白、格子铺面色），那样格子是「挖在白纸上的浅灰坑」；
      现在栏是一块灰底、一台设备一张白卡片浮在上面，
      「这里有几台机器」这句话是白卡片在说，跟参考图一致。

      分类色条（6px，按模块着色）去掉了：分类名本来就写在组头上，
      色条是同一件事说第二遍；而且它是这一栏唯一的强色，
      六个分类并排就是左缘一条彩虹，比它旁边的设备图还抢眼。
    -->
    <Border Grid.Column="0" Background="{StaticResource ThemeFill}">
      <DockPanel>
        <!-- 不写「设备库」这个抬头（GBG 也没有，配方页的步骤库也已经拆了）：
             一列设备图摆在那儿，本来就没人会认错成别的东西 -->
        <!-- 底部留白同配方页：写内容的 Margin，不写 ScrollViewer 的 Padding -->
        <!--
          滚动条走缺省（Auto + 自动隐藏）。从前写死 Visible + AllowAutoHide=False，
          于是不管内容够不够高，右边永远杵着一条灰带子。

          实测缺省态的两档行为：
          · 内容装得下（设备就这几台、窗口最大化时就是这种情况）——**整条不出现**，
            栏宽 260 全归格子，一格 118。
          · 内容装不下——占 14px 的槽，格子收到 111；滑块指针离开约 3 秒后自己淡掉，
            只剩一条 #EFF0EE 的轨，比栏底 #F1F1F1 亮两级，肉眼看不出来。
          也就是说 AllowAutoHide 淡的是滑块不是槽，槽该占的宽还是要占。
          这一档反复不要紧：设备图已经不写死宽度、跟着格子拉伸（见下面 DeviceArtView），
          槽来了图自己缩一点，不会裁掉半台机器。
        -->
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,40">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="grp" Margin="0,0,0,8">
                    <StackPanel>

                      <!-- 52 → 40：这一行只有一个圈箭头（18）、一个类名和一个台数，
                           52 的时候上下各空 17，比它自己的内容还高 -->
                      <Border Classes="grphd" Height="40" Cursor="Hand"
                              PointerPressed="OnGroupPressed">
                        <!-- 左内边距 10：色条没了以后，组头和下面那排格子
                             左缘要落在同一条线上（格子那排也是 10） -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0,10,0">
                          <Border Grid.Column="0" Classes="exp3m" Classes.up="{Binding Open}">
                            <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" Size="10"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15"
                                     FontWeight="Light" Foreground="#3a3d41"
                                     VerticalAlignment="Center" Margin="11,0,0,0" />
                          <TextBlock Grid.Column="2" Text="{Binding Items.Count}"
                                     FontSize="10.5" Foreground="#9aa0a6"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Border>

                      <!-- 设备格：两列。左右各 10（右边只写 5，格子自己带 5 的右外边距，
                           5+5 才跟左边的 10 对称）。
                           格子宽度不再算死：滚动条出不出来都行，图跟着格子走 -->
                      <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding Open}"
                                    Margin="10,0,5,1">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="cell" PointerPressed="OnLibraryPressed">
                              <StackPanel>
                                <!--
                                  图占满格子的宽、高给到 92。Fit 取宽高两个方向的较小比例，
                                  整幅不裁；宽度不写死是为了让它跟着格子走
                                  （滚动条出不出来、栏宽以后改不改，都不用回来改这里）。

                                  74 → 92 是为了「设备在白卡片上占得更大」：
                                  各设备图约 176×145，格子净宽约 112 时按宽算比例是 0.64，
                                  高 74 时按高算只有 0.51 —— 也就是说高度在卡脖子，
                                  图两边空着一截白。给到 92 之后按高算 0.63，两个方向差不多齐，
                                  图才真的把格子填满。
                                -->
                                <ctl:DeviceArtView ArtKey="{Binding ArtKey}" Fit="True" Height="92" />
                                <TextBlock Text="{Binding Name}" FontSize="11"
                                           Foreground="#3a3d41" LineHeight="14"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="4,3,4,0" />
                                <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}"
                                           FontSize="9.5" Foreground="#a81e15" Margin="4,0"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                    </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 台面：绑定连线 + 设备 + 左下工具条 -->
    <Panel Grid.Column="1" Name="Stage" Background="White" ClipToBounds="True"
           Focusable="True" PointerMoved="OnStageMoved" PointerReleased="OnStageReleased"
           KeyDown="OnKeyDown" SizeChanged="OnStageSize">
      <Panel Name="World">
        <Panel.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
            <TranslateTransform X="{Binding PanX}" Y="{Binding PanY}" />
          </TransformGroup>
        </Panel.RenderTransform>
      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="ItemsControl > ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- 本地值会盖掉样式，所以底色与描边都交给 Style 定 -->
            <Border Classes="dev" Classes.sel="{Binding IsSelected}"
                    PointerPressed="OnDevicePressed">
              <StackPanel>
                <ctl:DeviceArtView ArtKey="{Binding ArtKey}" ArtWidth="{Binding Width}" />
                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="#383b3f"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock Text="{Binding ChannelText}" FontSize="10" Foreground="#959a9f"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 管路画在设备**之上**：接口开在釜盖那三个管口上，位置在图的中段，
           画在设备下面的话最后一截会被机身挡住，管子看着像停在机器边上 -->
      <ctl:BenchLinks Links="{Binding Links}" IsHitTestVisible="False" />

      <!-- 拖拽中：可插的口 + 跟手的幽灵设备 -->
      <ItemsControl ItemsSource="{Binding Ports}" IsHitTestVisible="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="ItemsControl > ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- 能插的亮、占用的暗、当前会插上的最大并显示名字 -->
            <Panel Opacity="{Binding Opacity}">
              <Ellipse Width="{Binding Size}" Height="{Binding Size}"
                       Fill="White" Stroke="{Binding ColorHex}" StrokeThickness="1.8" />
              <Ellipse Width="5" Height="5" Fill="{Binding ColorHex}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Label}" IsVisible="{Binding Hot}" FontSize="10.5"
                         Foreground="{Binding ColorHex}" HorizontalAlignment="Center"
                         VerticalAlignment="Top" Margin="0,-18,0,0" />
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      </Panel>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" Margin="12">
        <Button Classes="tbtn sm" ToolTip.Tip="放大" Command="{Binding ZoomIn}"><ctl:TecIcon Key="ui-tool-zoomin" /></Button>
        <Button Classes="tbtn sm" ToolTip.Tip="缩小" Command="{Binding ZoomOut}"><ctl:TecIcon Key="ui-tool-zoomout" /></Button>
        <Button Classes="tbtn sm" ToolTip.Tip="适应窗口" Command="{Binding FitAll}"><ctl:TecIcon Key="ui-tool-fit" /></Button>
        <TextBlock Text="{Binding ZoomText}" FontSize="11" Foreground="#959a9f"
                   VerticalAlignment="Center" Margin="4,0,0,0" />
      </StackPanel>

      <TextBlock Text="从左侧设备库把设备拖到这里" IsVisible="{Binding IsEmpty}"
                 FontSize="14" Foreground="#c4b0b4" HorizontalAlignment="Center"
                 VerticalAlignment="Center" IsHitTestVisible="False" />

      <TextBlock Text="{Binding BenchSummary}" FontSize="11" Foreground="#959a9f"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" />
    </Panel>

    <!--
      属性栏（学 GBG）：**栏本身不铺底色**，底色在每一「块」上——
      台面块常驻，设备块与动作区只在选中设备时出现。什么都不选的时候，
      台面块下面就是空白，不是一整条从头灰到尾的空面板。
      跟画布之间也不画分界线：块的底色本身就是边界。
    -->
    <Border Grid.Column="2">
      <DockPanel>
        <!-- 底部动作区：左边同样一条 6px 色条，跟设备块一条线上——
             这排按钮（保存 / 连接 / 初始化 / 删除、手动控制面板、测试连接）
             干的都是「对这台设备」的事，所以**没选设备时整块不出现**（GBG 同）。
             另存与保存在标题栏和开始页都有，不会因此够不着 -->
        <Border DockPanel.Dock="Bottom" Padding="18,10,18,14"
                Background="{StaticResource PropsBg}"
                IsVisible="{Binding HasSelection}"
                BorderBrush="{StaticResource PropsBar}" BorderThickness="6,0,0,0">
          <StackPanel>
            <TextBlock Text="{Binding SaveHint}" IsVisible="{Binding HasSaveHint}"
                       FontSize="10.5" Foreground="#55595e" LineHeight="16" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="{Binding ProbeResult}" IsVisible="{Binding HasProbeResult}"
                       FontSize="10.5" Foreground="#55595e" LineHeight="16" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                        Margin="0,0,0,10" IsVisible="{Binding HasSelection}">
              <Button Classes="pill" Content="手动控制面板" IsVisible="{Binding IsReactor}" />
              <Button Classes="pill" Content="测试连接" Command="{Binding Probe}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
              <Button Classes="tbtn foot" ToolTip.Tip="保存实验" Command="{Binding SaveExperiment}">
                <ctl:TecIcon Key="ui-foot-save" />
              </Button>
              <Button Classes="tbtn foot" ToolTip.Tip="连接" Command="{Binding Probe}"><ctl:TecIcon Key="ui-foot-link" /></Button>
              <Button Classes="tbtn del" ToolTip.Tip="删除选中设备" Command="{Binding DeleteSelected}"><ctl:TecIcon Key="ui-foot-trash" /></Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <ScrollViewer>
          <StackPanel>

            <!-- ===== 台面块：**常驻**，选没选设备都在（GBG 的 Welcome 块就是这样）=====
                 台面名称、设备数、通道总表是这张台面自己的属性，跟「当前点中了谁」
                 无关；从前它们跟设备属性二选一地换着显示，点一下设备台面信息就没了，
                 想看通道总表还得先去空白处点一下取消选中 -->
            <Border Padding="18,16,18,20" Background="{StaticResource PropsBg}">
            <StackPanel>

            <!-- 原型 .props h2：24px / 300 / #333，细体。正文加粗、标题细，
                 层次才拉得开；标题跟着一起加粗的话满栏一样重，反而没有重点 -->
            <TextBlock Text="台面属性"
                       FontSize="24" FontWeight="Light" Foreground="#303337"
                       HorizontalAlignment="Center" Margin="0,0,0,8" />

            <StackPanel>
              <TextBlock Classes="intro"
                         Text="从左侧设备库拖入设备组成台面。点选台面上的设备可编辑其连接与通道绑定；下表可独立启停每个通道。" />
              <!-- 列宽 76,*,40 跟 SchemaFormView 的表单行一模一样（标签 76、
                   输入自适应、右边 40 留给单位）。从前这两行写的是 96,*，
                   输入框一直伸到最右，比下面那排设备参数宽出 40px，
                   一列输入框长短不一，看着像没对齐——因为确实没对齐 -->
              <Grid ColumnDefinitions="76,*,40" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Text="台面名称" FontSize="12" Foreground="#3a3d41"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" Classes="finput" Text="{Binding BenchName, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="76,*,40" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" Text="设备数" FontSize="12" Foreground="#3a3d41"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" Classes="finput" Text="{Binding DeviceCountText}" IsEnabled="False" />
              </Grid>
            </StackPanel>

            <Border Height="1" Background="#d3d5d2" Margin="0,10,0,14" />
            <Button Classes="acc" Command="{Binding ToggleChTable}" Margin="0,6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="exp3" Classes.up="{Binding ChTableOpen}">
                  <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" />
                </Border>
                <TextBlock Text="通道总表（勾选 = 启用）" FontSize="12" Foreground="#3a3d41"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- .chtable：色块 + CHn + 来源 + 探头标签 + 启停勾选 -->
            <Border Background="White" BorderBrush="#dadcd9" BorderThickness="1" CornerRadius="3"
                    IsVisible="{Binding ChTableOpen}">
              <ItemsControl ItemsSource="{Binding ChannelRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#edeeeb" BorderThickness="0,0,0,1" Padding="10,0" MinHeight="32">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                        <Border Grid.Column="0" Width="12" Height="12" CornerRadius="3"
                                Background="{Binding ColorHex}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#292b2e" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Host}" FontSize="11" Foreground="#888d92"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <ItemsControl Grid.Column="3" ItemsSource="{Binding Probes}" VerticalAlignment="Center">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="#fafafa" BorderBrush="#c5c8c7" BorderThickness="1"
                                      CornerRadius="8" Padding="6,1">
                                <TextBlock Text="{Binding}" FontSize="9" Foreground="#757a7f" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Grid.Column="4" Classes="mini" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <TextBlock FontSize="11.5" Foreground="#565a5f" LineHeight="18" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       IsVisible="{Binding ChTableOpen}"
                       Text="两台反应器可组成 4 通道高通量系统，也可拆分为两套独立系统分别运行；停用的通道不参与配方与运行。" />
            </StackPanel>
            </Border>

            <!-- 块与块之间的缝。栏本身没有底色，这里空着就是画布的白，
                 不用再刷一层白 -->
            <Border Height="9" IsVisible="{Binding HasSelection}" />

            <!-- ===== 设备块：选中谁显示谁 =====
                 左边一条 4px 粗色条（学 GBG）：这一块讲的是「当前选中的那台设备」，
                 跟上面常驻的台面块不是一回事。色条比分割线说得更清楚——
                 它标的是「这一段属于谁」，而不只是「这里断开」 -->
            <Border Padding="18,16,18,20" IsVisible="{Binding HasSelection}"
                    Background="{StaticResource PropsBg}"
                    BorderBrush="{StaticResource PropsBar}" BorderThickness="6,0,0,0">
            <StackPanel>

            <StackPanel IsVisible="{Binding HasSelection}">

              <!-- prop-head（原型 .prop-head）：**只有设备名 + 圆形改名钮，没有
                   「设备属性」这个抬头**。名字本身就是这一块的标题，上面再压一行
                   「设备属性」是白说一遍。原型 .prop-head .t 是 21px / 300 / #333，
                   细体——正文加粗、标题反而细，两者拉开层次才看得出主次 -->
              <!-- 看的时候：名字居中，旁边一颗改名钮 -->
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                          Margin="0,0,0,12" IsVisible="{Binding !Renaming}">
                <TextBlock Text="{Binding SelectedTitle}"
                           FontSize="21" FontWeight="Light" Foreground="#303337"
                           VerticalAlignment="Center" />
                <Button Classes="hbtn" ToolTip.Tip="重命名" Command="{Binding ToggleRename}">
                  <ctl:TecIcon Key="ui-pencil" Tint="#1d1f22" />
                </Button>
              </StackPanel>

              <!-- 改的时候：输入框落进下面表单的同一列（76,*,40），
                   左右两边都跟串口 / 波特率那排对齐。**输入框就该跟输入框一列**——
                   从前它是居中浮着的固定 180px，跟下面哪一条边都对不上 -->
              <Grid ColumnDefinitions="76,*,40" Margin="0,0,0,12" IsVisible="{Binding Renaming}">
                <TextBox Grid.Column="1" Classes="finput"
                         Text="{Binding DeviceName, Mode=TwoWay}" />
                <Button Grid.Column="2" Classes="hbtn" ToolTip.Tip="改完" Margin="7,0,0,0"
                        Command="{Binding ToggleRename}">
                  <ctl:TecIcon Key="ui-pencil" Tint="#1d1f22" />
                </Button>
              </Grid>

              <!-- 连接与设备参数：由驱动 schema 渲染，平铺成 frow，不再分节 -->
              <v:SchemaFormView DataContext="{Binding ConnectionForm}" />
              <v:SchemaFormView DataContext="{Binding ConfigForm}" />

              <!-- 探头要绑通道；反应器自带通道，没有这一行 -->
              <Grid ColumnDefinitions="76,*,40" Margin="0,0,0,8" IsVisible="{Binding IsProbe}">
                <TextBlock Grid.Column="0" Text="绑定通道" FontSize="12" Foreground="#3a3d41"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Column="1" Classes="sel" Height="23" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding BindTargets}"
                          SelectedItem="{Binding BindTarget, Mode=TwoWay}" />
              </Grid>

              <Border Height="1" Background="#d3d5d2" Margin="0,10,0,14" />

              <!-- 反应器：孔位 → 通道，可独立启停 -->
              <StackPanel IsVisible="{Binding IsReactor}">
                <Button Classes="acc" Command="{Binding ToggleWells}" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="exp3" Classes.up="{Binding WellsOpen}">
                      <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" />
                    </Border>
                    <TextBlock Text="通道启用（独立启停）" FontSize="12" Foreground="#3a3d41"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Wells}" IsVisible="{Binding WellsOpen}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,6">
                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" MinHeight="0"
                                  VerticalAlignment="Center" />
                        <Border Width="12" Height="12" CornerRadius="3" Background="{Binding ColorHex}"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Host}" FontSize="12" Foreground="#3a3d41"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Panel Height="8" />
                <CheckBox Content="LED 背景照明" IsChecked="True" Classes="chk2" />
                <CheckBox Content="pH 反馈控制允许" IsChecked="True" Classes="chk2" />
              </StackPanel>

              <!-- 探头：反馈允许 -->
              <CheckBox Content="自动反馈控制允许" IsChecked="True" Classes="chk2"
                        IsVisible="{Binding IsProbe}" />

              <CheckBox Content="模拟" Classes="chk2" IsChecked="{Binding DeviceSimulated, Mode=TwoWay}" />

              <TextBlock Classes="intro left" IsVisible="{Binding IsProbe}" Margin="0,10,0,0"
                         Text="绑定后，该设备的数据与命令归属所选通道；配方中的加料 / pH / 分析步骤将作用于此设备。" />
            </StackPanel>

            </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <!-- 拖拽中的幽灵：跨三栏画在最上层，从设备库拖出来时压在库面板上方。
         拖台面上已有的设备时不画——那台设备自己跟着手在走。

         画的是一张固定尺寸的小样（Fit 进 88×64），不是落地后的原大，
         也不跟着缩放变。原大那一版拖一台反应器就是一大块半透明的图糊在
         画布上，把底下的接口圆点和管路预览全挡了——而拖动时真正要看的
         正是那两样。小样只回答「手上是哪一台」。 -->
    <Canvas Grid.Column="0" Grid.ColumnSpan="3" IsHitTestVisible="False"
            IsVisible="{Binding ShowGhost}">
      <ctl:DeviceArtView Canvas.Left="{Binding GhostX}" Canvas.Top="{Binding GhostY}"
                         ArtKey="{Binding DragArtKey}" Fit="True"
                         Width="{Binding GhostBoxW}" Height="{Binding GhostBoxH}"
                         Opacity="0.75" />
    </Canvas>
  </Grid>

  <UserControl.Styles>
    <!-- 一类 = 左边一条 6px 分类色条 + 组头 + 设备格，**块本身不铺底色**。
         铺了的话一格一格的设备底就连成一整片，看不出是一台一台的东西了
         （这一栏要说的正是「这里有几台机器」）。分类靠色条和组头站住，
         不靠一块底色圈起来。块与块之间 8px 白缝。 -->
    <!-- 圆角从 0,2,2,0 改回四角都是 2：那个「左边两角不倒」是为了跟色条严丝合缝，
         色条没了就没有理由再缺两个角 -->
    <Style Selector="Border.grp">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.grphd">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 组头悬停压一层黑，跟圆钮、勾选框一套：栏底从白换成面色之后，
         原来那支 #E2E5E9 比新底只深两级，指上去几乎看不出来 -->
    <Style Selector="Border.grphd:pointerover">
      <Setter Property="Background" Value="#14000000" />
    </Style>

    <!-- 组头那个圆圈箭头。18 是配 52px 组头的，同配方页的 exp3m -->
    <Style Selector="Border.exp3m">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderBrush" Value="#9aa0a6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.exp3m.up">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>

    <!-- 设备库的一格：一台设备一张**白卡片**，浮在整栏那块面色底上，
         格与格之间留缝露灰底。
         上下内边距收到 4 / 5（原来 7 / 6）：省下来的都归图，
         图在卡片上占得更满。
         没有悬停态：白卡片没法再往亮里走，往暗里走又会比它坐着的灰底还暗、
         读成「按下去了」，描边又被否掉了——所以这一格只靠手型光标说「能点」。 -->
    <Style Selector="Border.cell">
      <Setter Property="Background" Value="White" />
      <Setter Property="Padding" Value="0,4,0,5" />
      <Setter Property="Margin" Value="0,0,5,5" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.pill">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="#f7f7f6" />
      <Setter Property="BorderBrush" Value="#868b90" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#303337" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- 悬停压一层黑、描边到纯黑，跟圆钮一族同一个做法。
         原来是 #F4E4E6 + #A41626 那套粉红，换配色以前留下的 -->
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#18000000" />
      <Setter Property="BorderBrush" Value="#000000" />
    </Style>
    <Style Selector="Border.dev">
      <Setter Property="Padding" Value="6,6,6,4" />
      <Setter Property="BorderThickness" Value="1.6" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- 台面上选中的设备：**只描一圈框，不填底**，框色走标题栏那支靛（Shell）。
         填底那一版是把设备图整个染上一层色，机器本身什么颜色就看不准了。
         框色试过属性栏底色 #eff1f3——那是「跟右边那块系上」的想法，可它离白
         只差一点点，压在白画布上等于没描 -->
    <Style Selector="Border.dev.sel">
      <Setter Property="BorderBrush" Value="{StaticResource Shell}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 26px 圆钮，规格照 Button.tbtn.del.d26：底透、描边 #1f2124 1.6。
         从前填 #e0c3c6 描边 #373a3e，是换配色以前的品牌红剩下的 -->
    <Style Selector="Button.hbtn">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#1f2124" />
      <Setter Property="BorderThickness" Value="1.6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.hbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#18000000" />
      <Setter Property="BorderBrush" Value="#000000" />
    </Style>
    <!-- 通道总表里的勾选框。Avalonia 的缺省 CheckBox 连边距一共占 32px 高，
         一行就被它撑到 47px；原型那张表一行 32px，四条通道一屏放得下。
         这里把它压到 18px：只是勾选框本身，不带文字 -->
    <!--
      通道总表里的勾选框。Avalonia 缺省 CheckBox 要占 32px 高，一行就被撑到 33px。

      **不能靠给控件写死 Height 来压**：那 32px 是模板*内层*元素的最小高，
      外面把控件限到 24，内层照旧按 32 排版然后被裁掉底下一截——
      勾上时看不出来（勾号在中间），没勾时方框直接少一条底边。
      把内层的最小高一起放开，让它按方框本身（20×20）自然排才对。
    -->
    <Style Selector="CheckBox.mini">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <!-- 上下各 -6 的负边距：只把它在排版里占的位子从 32 收到 20，
           **渲染照旧完整**（方框 20×20 画满，多出来的是透明空隙）。
           写死 Height 是不行的——那 32px 在模板内层，外面限高只会把它裁掉，
           没勾的时候方框直接少一条底边 -->
      <Setter Property="Margin" Value="8,-6,0,-6" />
    </Style>

    <!-- .frow.chk2：14px 方框 + 11.5px 文字 -->
    <Style Selector="CheckBox.chk2">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#3a3d41" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- .acc：整行可点，看起来还是一行字 -->
    <Style Selector="Button.acc">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.acc:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 收起时箭头翻上去 -->
    <Style Selector="Border.exp3.up">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="180" />
      </Setter>
    </Style>
    <Style Selector="Border.exp3">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#676b70" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
</UserControl>
