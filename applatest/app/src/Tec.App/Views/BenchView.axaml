<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             xmlns:v="clr-namespace:Tec.App.Views"
             x:Class="Tec.App.Views.BenchView">

  <!-- 三栏宽度照原型：设备库 118 · 台面自适应 · 属性面板 342 -->
  <Grid ColumnDefinitions="118,*,342">

    <!-- 设备库。原型 .lib：#f4f4f4 的窄栏，每台设备是一张白卡（.thumb），
         卡下面跟一行名字。之前那版把每台设备铺成一块浅紫、块间留白缝，
         整栏看着比台面还抢眼——设备库是取货架，不该压过台面本身 -->
    <Border Grid.Column="0" Background="{StaticResource LibBg}"
            BorderBrush="#dcdcdc" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="0,6,0,8">
          <TextBlock Text="设备库" FontSize="11" Foreground="#6a6a6a"
                     HorizontalAlignment="Center" />
        </Border>
        <ScrollViewer Padding="0,0,0,40">
          <ItemsControl ItemsSource="{Binding Library}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,10" HorizontalAlignment="Center"
                            PointerPressed="OnLibraryPressed">
                  <!-- 统一 108×88 的格子，图等比缩进去。各设备图的高度本来就接近
                       （138~150），按高度缩放出来的比例也就接近，看着是一样大的；
                       宽的那两台（反应器 176、加料泵 172）由宽度兜住，整幅不裁 -->
                  <Border Classes="thumb">
                    <ctl:DeviceArtView ArtKey="{Binding ArtKey}" Fit="True"
                                       Width="108" Height="88" HorizontalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding Name}" FontSize="11"
                             Foreground="#3d3d3d" Width="108"
                             TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Width="108"
                             FontSize="9.5" Foreground="#b3261e" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 台面：绑定连线 + 设备 + 左下工具条 -->
    <Panel Grid.Column="1" Name="Stage" Background="White" ClipToBounds="True"
           Focusable="True" PointerMoved="OnStageMoved" PointerReleased="OnStageReleased"
           KeyDown="OnKeyDown" SizeChanged="OnStageSize">
      <Panel Name="World">
        <Panel.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
            <TranslateTransform X="{Binding PanX}" Y="{Binding PanY}" />
          </TransformGroup>
        </Panel.RenderTransform>
      <ctl:BenchLinks Links="{Binding Links}" />

      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="ItemsControl > ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- 本地值会盖掉样式，所以底色与描边都交给 Style 定 -->
            <Border Classes="dev" Classes.sel="{Binding IsSelected}"
                    PointerPressed="OnDevicePressed">
              <StackPanel>
                <ctl:DeviceArtView ArtKey="{Binding ArtKey}" ArtWidth="{Binding Width}" />
                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="#3b3b3b"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock Text="{Binding ChannelText}" FontSize="10" Foreground="#9a9a9a"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 拖拽中：可插的口 + 跟手的幽灵设备 -->
      <ItemsControl ItemsSource="{Binding Ports}" IsHitTestVisible="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="ItemsControl > ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- 能插的亮、占用的暗、当前会插上的最大并显示名字 -->
            <Panel Opacity="{Binding Opacity}">
              <Ellipse Width="{Binding Size}" Height="{Binding Size}"
                       Fill="White" Stroke="{Binding ColorHex}" StrokeThickness="1.8" />
              <Ellipse Width="5" Height="5" Fill="{Binding ColorHex}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Label}" IsVisible="{Binding Hot}" FontSize="10.5"
                         Foreground="{Binding ColorHex}" HorizontalAlignment="Center"
                         VerticalAlignment="Top" Margin="0,-18,0,0" />
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      </Panel>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" Margin="12">
        <Button Classes="tbtn sm" ToolTip.Tip="放大" Command="{Binding ZoomIn}"><ctl:TecIcon Key="ui-tool-zoomin" /></Button>
        <Button Classes="tbtn sm" ToolTip.Tip="缩小" Command="{Binding ZoomOut}"><ctl:TecIcon Key="ui-tool-zoomout" /></Button>
        <Button Classes="tbtn sm" ToolTip.Tip="适应窗口" Command="{Binding FitAll}"><ctl:TecIcon Key="ui-tool-fit" /></Button>
        <TextBlock Text="{Binding ZoomText}" FontSize="11" Foreground="#9a9a9a"
                   VerticalAlignment="Center" Margin="4,0,0,0" />
      </StackPanel>

      <TextBlock Text="从左侧设备库把设备拖到这里" IsVisible="{Binding IsEmpty}"
                 FontSize="14" Foreground="#b6b0c4" HorizontalAlignment="Center"
                 VerticalAlignment="Center" IsHitTestVisible="False" />

      <TextBlock Text="{Binding BenchSummary}" FontSize="11" Foreground="#9a9a9a"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" />
    </Panel>

    <!-- 属性面板。原型 .props：整栏一块 #ececec，左边一条 #d2d2d2 的分界线，
         里面不再分块、不留白缝——白色留给真正要填东西的地方（输入框、通道总表），
         这样一眼就能看出哪儿能改 -->
    <Border Grid.Column="2" Background="{StaticResource PropsBg}"
            BorderBrush="#d2d2d2" BorderThickness="1,0,0,0">
      <DockPanel>
        <!-- 底部工具条：设备的动作都集中在这里，底色跟面板一致 -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="#d5d5d5" BorderThickness="0,1,0,0" Padding="18,10,18,14">
          <StackPanel>
            <TextBlock Text="{Binding SaveHint}" IsVisible="{Binding HasSaveHint}"
                       FontSize="10.5" Foreground="#7a7580" LineHeight="16" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="{Binding ProbeResult}" IsVisible="{Binding HasProbeResult}"
                       FontSize="10.5" Foreground="#7a7580" LineHeight="16" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                        Margin="0,0,0,10" IsVisible="{Binding HasSelection}">
              <Button Classes="pill" Content="手动控制面板" IsVisible="{Binding IsReactor}" />
              <Button Classes="pill" Content="测试连接" Command="{Binding Probe}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
              <Button Classes="tbtn foot" ToolTip.Tip="保存实验" Command="{Binding SaveExperiment}">
                <ctl:TecIcon Key="ui-foot-save" />
              </Button>
              <Button Classes="tbtn foot" ToolTip.Tip="连接" Command="{Binding Probe}"><ctl:TecIcon Key="ui-foot-link" /></Button>
              <Button Classes="tbtn foot" ToolTip.Tip="初始化" Command="{Binding Rebuild}"><ctl:TecIcon Key="ui-foot-init" /></Button>
              <Button Classes="tbtn foot" ToolTip.Tip="删除选中设备" Command="{Binding DeleteSelected}"><ctl:TecIcon Key="ui-foot-trash" /></Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <ScrollViewer>
          <StackPanel>

            <!-- ===== 台面块：**常驻**，选没选设备都在（GBG 的 Welcome 块就是这样）=====
                 台面名称、设备数、通道总表是这张台面自己的属性，跟「当前点中了谁」
                 无关；从前它们跟设备属性二选一地换着显示，点一下设备台面信息就没了，
                 想看通道总表还得先去空白处点一下取消选中 -->
            <Border Padding="18,16,18,20">
            <StackPanel>

            <!-- 原型 .props h2：24px / 300 / #333，细体。正文加粗、标题细，
                 层次才拉得开；标题跟着一起加粗的话满栏一样重，反而没有重点 -->
            <TextBlock Text="台面属性"
                       FontSize="24" FontWeight="Light" Foreground="#333333"
                       HorizontalAlignment="Center" Margin="0,0,0,8" />

            <StackPanel>
              <TextBlock Classes="intro"
                         Text="从左侧设备库拖入设备组成台面。点选台面上的设备可编辑其连接与通道绑定；下表可独立启停每个通道。" />
              <Grid ColumnDefinitions="96,*" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Text="台面名称" FontSize="12" Foreground="#3d3d3d"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" Classes="finput" Text="{Binding BenchName, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="96,*" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" Text="设备数" FontSize="12" Foreground="#3d3d3d"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" Classes="finput" Text="{Binding DeviceCountText}" IsEnabled="False" />
              </Grid>
            </StackPanel>

            <Border Height="1" Background="#d5d5d5" Margin="0,10,0,14" />
            <Button Classes="acc" Command="{Binding ToggleChTable}" Margin="0,6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="exp3" Classes.up="{Binding ChTableOpen}">
                  <ctl:TecIcon Key="ui-chev-down" Tint="#555555" />
                </Border>
                <TextBlock Text="通道总表（勾选 = 启用）" FontSize="12" Foreground="#3d3d3d"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- .chtable：色块 + CHn + 来源 + 探头标签 + 启停勾选 -->
            <Border Background="White" BorderBrush="#dcdcdc" BorderThickness="1" CornerRadius="3"
                    IsVisible="{Binding ChTableOpen}">
              <ItemsControl ItemsSource="{Binding ChannelRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#eeeeee" BorderThickness="0,0,0,1" Padding="10,7">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                        <Border Grid.Column="0" Width="12" Height="12" CornerRadius="3"
                                Background="{Binding ColorHex}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#2b2b2b" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Host}" FontSize="11" Foreground="#8d8d8d"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <ItemsControl Grid.Column="3" ItemsSource="{Binding Probes}" VerticalAlignment="Center">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="#fafafa" BorderBrush="#c8c8c8" BorderThickness="1"
                                      CornerRadius="8" Padding="6,1">
                                <TextBlock Text="{Binding}" FontSize="9" Foreground="#7a7a7a" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Grid.Column="4" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  Margin="8,0,0,0" VerticalAlignment="Center" MinHeight="0" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <TextBlock FontSize="11.5" Foreground="#5a5a5a" LineHeight="18" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       IsVisible="{Binding ChTableOpen}"
                       Text="两台反应器可组成 4 通道高通量系统，也可拆分为两套独立系统分别运行；停用的通道不参与配方与运行。" />
            </StackPanel>
            </Border>

            <!-- 两块之间留一道白缝（GBG 就是这么分块的）：底色是灰的，
                 缝用白色才切得干净。只有选中设备时才有第二块，缝也跟着出现 -->
            <Border Height="9" Background="White" IsVisible="{Binding HasSelection}" />

            <!-- ===== 设备块：选中谁显示谁 ===== -->
            <Border Padding="18,16,18,20" IsVisible="{Binding HasSelection}">
            <StackPanel>

            <StackPanel IsVisible="{Binding HasSelection}">

              <!-- prop-head（原型 .prop-head）：**只有设备名 + 圆形改名钮，没有
                   「设备属性」这个抬头**。名字本身就是这一块的标题，上面再压一行
                   「设备属性」是白说一遍。原型 .prop-head .t 是 21px / 300 / #333，
                   细体——正文加粗、标题反而细，两者拉开层次才看得出主次 -->
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                          Margin="0,0,0,12">
                <TextBlock Text="{Binding SelectedTitle}" IsVisible="{Binding !Renaming}"
                           FontSize="21" FontWeight="Light" Foreground="#333333"
                           VerticalAlignment="Center" />
                <TextBox Classes="finput" Width="180" IsVisible="{Binding Renaming}"
                         Text="{Binding DeviceName, Mode=TwoWay}" />
                <Button Classes="hbtn" ToolTip.Tip="重命名"
                        Command="{Binding ToggleRename}">
                  <ctl:TecIcon Key="ui-pencil" Tint="#1f1f1f" />
                </Button>
              </StackPanel>

              <!-- 连接与设备参数：由驱动 schema 渲染，平铺成 frow，不再分节 -->
              <v:SchemaFormView DataContext="{Binding ConnectionForm}" />
              <v:SchemaFormView DataContext="{Binding ConfigForm}" />

              <!-- 探头要绑通道；反应器自带通道，没有这一行 -->
              <Grid ColumnDefinitions="96,*,40" Margin="0,0,0,8" IsVisible="{Binding IsProbe}">
                <TextBlock Grid.Column="0" Text="绑定通道" FontSize="12" Foreground="#3d3d3d"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Column="1" Classes="sel" Height="23" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding BindTargets}"
                          SelectedItem="{Binding BindTarget, Mode=TwoWay}" />
              </Grid>

              <Border Height="1" Background="#d5d5d5" Margin="0,10,0,14" />

              <!-- 反应器：孔位 → 通道，可独立启停 -->
              <StackPanel IsVisible="{Binding IsReactor}">
                <Button Classes="acc" Command="{Binding ToggleWells}" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="exp3" Classes.up="{Binding WellsOpen}">
                      <ctl:TecIcon Key="ui-chev-down" Tint="#555555" />
                    </Border>
                    <TextBlock Text="通道启用（独立启停）" FontSize="12" Foreground="#3d3d3d"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Wells}" IsVisible="{Binding WellsOpen}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,6">
                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" MinHeight="0"
                                  VerticalAlignment="Center" />
                        <Border Width="12" Height="12" CornerRadius="3" Background="{Binding ColorHex}"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Host}" FontSize="12" Foreground="#3d3d3d"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Panel Height="8" />
                <CheckBox Content="LED 背景照明" IsChecked="True" Classes="chk2" />
                <CheckBox Content="pH 反馈控制允许" IsChecked="True" Classes="chk2" />
              </StackPanel>

              <!-- 探头：反馈允许 -->
              <CheckBox Content="自动反馈控制允许" IsChecked="True" Classes="chk2"
                        IsVisible="{Binding IsProbe}" />

              <CheckBox Content="模拟" Classes="chk2" IsChecked="{Binding DeviceSimulated, Mode=TwoWay}" />

              <TextBlock Classes="intro left" IsVisible="{Binding IsProbe}" Margin="0,10,0,0"
                         Text="绑定后，该设备的数据与命令归属所选通道；配方中的加料 / pH / 分析步骤将作用于此设备。" />
            </StackPanel>

            </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <!-- 拖拽中的幽灵：跨三栏画在最上层，从设备库拖出来时压在库面板上方。
         拖台面上已有的设备时不画——那台设备自己跟着手在走 -->
    <Canvas Grid.Column="0" Grid.ColumnSpan="3" IsHitTestVisible="False"
            IsVisible="{Binding ShowGhost}">
      <Border Canvas.Left="{Binding GhostX}" Canvas.Top="{Binding GhostY}" Opacity="0.7"
              Padding="6,6,6,4" RenderTransformOrigin="0%,0%">
        <Border.RenderTransform>
          <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
        </Border.RenderTransform>
        <ctl:DeviceArtView ArtKey="{Binding DragArtKey}" ArtWidth="{Binding DragWidth}" />
      </Border>
    </Canvas>
  </Grid>

  <UserControl.Styles>
    <!-- 设备库的白卡（原型 .lib-item .thumb）。悬停描蓝框加柔环，
         跟台面上选中设备是同一套提示语言 -->
    <Style Selector="Border.thumb">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#cfcfcf" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.thumb:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource SelBd}" />
      <Setter Property="BoxShadow" Value="0 0 0 2 #381a7fc4" />
    </Style>

    <Style Selector="Button.pill">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="#f7f7f7" />
      <Setter Property="BorderBrush" Value="#8b8b8b" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#333333" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e3f0f9" />
      <Setter Property="BorderBrush" Value="#1a91d6" />
    </Style>
    <Style Selector="Border.dev">
      <Setter Property="Padding" Value="6,6,6,4" />
      <Setter Property="BorderThickness" Value="1.6" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- 台面上选中的设备描一圈蓝框 -->
    <Style Selector="Border.dev.sel">
      <Setter Property="BorderBrush" Value="#1a7fc4" />
      <Setter Property="Background" Value="#0d1a7fc4" />
    </Style>

    <!-- GBG 的 hbtn：26px 圆钮，浅蓝底深描边 -->
    <Style Selector="Button.hbtn">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="#c5d2df" />
      <Setter Property="BorderBrush" Value="#3a3a3a" />
      <Setter Property="BorderThickness" Value="1.6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.hbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#d9e4ef" />
    </Style>
    <!-- .frow.chk2：14px 方框 + 11.5px 文字 -->
    <Style Selector="CheckBox.chk2">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#3d3d3d" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- .acc：整行可点，看起来还是一行字 -->
    <Style Selector="Button.acc">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.acc:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 收起时箭头翻上去 -->
    <Style Selector="Border.exp3.up">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="180" />
      </Setter>
    </Style>
    <Style Selector="Border.exp3">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#6b6b6b" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
</UserControl>
