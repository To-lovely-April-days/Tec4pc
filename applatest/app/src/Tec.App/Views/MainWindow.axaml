<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Tec.App.Views"
        xmlns:ctl="clr-namespace:Tec.App.Controls"
        x:Class="Tec.App.Views.MainWindow"
        Title="TecStudio 平行合成工作站 - PSW-4"
        Width="1500" Height="940" MinWidth="1280" MinHeight="720"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        Foreground="#303337" Background="Transparent"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <!--
    窗口圆角自绘：Windows 11 的 DWM 只给还原态窗口加圆角，最大化一律方角，
    应用改不了它的行为——所以圆角由这里裁。代价是最大化时屏幕四角透出桌面。
    OffScreenMargin 是最大化时窗口超出工作区的那一圈（自绘标题栏必须自己补），
    不补的话四边各有几像素内容跑到屏幕外面。
  -->
  <Border Name="Shell" Background="White" CornerRadius="8" ClipToBounds="True"
          Margin="{Binding $parent[Window].OffScreenMargin}">
  <DockPanel>

    <!-- 窗口标题栏：30px，纯色 Shell（#352d6a），自绘（原型 .titlebar）。
         三色里的黑。标题栏面积大，是外壳不是信号，所以不占品牌红。
         右下那颗运行药丸走的是同一支笔——全程序只有一个黑 -->
    <Border DockPanel.Dock="Top" Height="30" Background="{StaticResource Shell}"
            PointerPressed="OnTitlebarPressed">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="8,0,0,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="tbico" Command="{Binding SimRun}" ToolTip.Tip="运行">
            <ctl:TecIcon Key="ui-tb-run" />
          </Button>
          <Button Classes="tbico" Command="{Binding Start.SaveExperiment}" ToolTip.Tip="保存实验">
            <ctl:TecIcon Key="ui-tb-save" />
          </Button>
        </StackPanel>
        <Border Grid.Column="1" Margin="10,0,0,0" Padding="8,2" CornerRadius="3"
                Background="#24ffffff" VerticalAlignment="Center">
          <TextBlock Text="基础" Foreground="White" FontSize="12" />
        </Border>
        <!-- 实验名跟着当前打开的文件走，改过没存的加个星号 -->
        <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                   Foreground="White" FontSize="12">
          <Run Text="TecStudio 平行合成工作站 - PSW-4 · " />
          <Run Text="{Binding DocTitle}" />
        </TextBlock>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0">
            <ctl:TecIcon Key="ui-tb-about" Tint="#c8ccd1" VerticalAlignment="Center" />
            <TextBlock Text="关于" Foreground="#c8ccd1" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0">
            <ctl:TecIcon Key="ui-tb-settings" Tint="#c8ccd1" VerticalAlignment="Center" />
            <TextBlock Text="设置" Foreground="#c8ccd1" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0">
            <ctl:TecIcon Key="ui-tb-help" Tint="#c8ccd1" VerticalAlignment="Center" />
            <TextBlock Text="帮助" Foreground="#c8ccd1" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0">
          <!-- 同登录窗：窗钮画成线条，不用 — ▢ ✕ 这类字符 -->
          <Button Classes="win" Click="OnMinimize" ToolTip.Tip="最小化">
            <Path Data="M 0,0 H 11" Stroke="White" StrokeThickness="1.2" />
          </Button>
          <Button Classes="win" Click="OnMaximize" ToolTip.Tip="最大化 / 还原">
            <Path Data="M 0,0 H 9 V 9 H 0 Z" Stroke="White" StrokeThickness="1.2"
                  Fill="Transparent" />
          </Button>
          <Button Classes="win close" Click="OnClose" ToolTip.Tip="关闭">
            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="White" StrokeThickness="1.2" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 标题栏以下整块（菜单栏 + 视图区）外面再包一层：
         登录层盖在这一块之上——没登录时只有窗口标题栏还露着
         （拖动 / 最小化 / 关闭得始终可用），别的全在登录页后面 -->
    <Panel>
    <DockPanel>

    <!--
      底部状态条：22px，通用深色底 #333333 白字。

      只写「已打开 + 当前实验名」这一件事。GBG 那条底栏写的也正是这个
      （Opened Documentation）。别往里塞它拿不到的东西：这一层能实时跟得住的
      只有 Store.Changed 这一路信号，凑数写上去的字要么是死的、要么是编的。
      要加运行状态 / 通道数得先把那几路的变更通知接到这一层来，是另一件事。
    -->
    <Border DockPanel.Dock="Bottom" Height="22" Background="{StaticResource Chrome}">
      <TextBlock VerticalAlignment="Center" Margin="12,0" FontSize="11" Foreground="White"
                 TextTrimming="CharacterEllipsis">
        <Run Text="已打开 " /><Run Text="{Binding DocTitle}" />
      </TextBlock>
    </Border>

    <!-- 主菜单栏：44px，底色 #bfc9d7；右侧运行控制与用户区叠在同一行。
         底边那条分界线去掉了：从前是白底才需要一条线跟下面的白画布断开，
         现在底色自己就是边界，再压一条比它浅的线反而像描歪了。
         52 → 44：菜单字 22px、实高 21，52 是照原型 25px 拉丁定的高度，
         中文压到 22 之后上下就空出来了 -->
    <Panel DockPanel.Dock="Top" Height="44" Background="{StaticResource MenuBar}">
      <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
        <Button Classes="menu" Content="开始"        Command="{Binding Go}" CommandParameter="0" Classes.on="{Binding IsStart}" />
        <Button Classes="menu" Content="台面"        Command="{Binding Go}" CommandParameter="1" Classes.on="{Binding IsBench}" />
        <Button Classes="menu" Content="配方"        Command="{Binding Go}" CommandParameter="2" Classes.on="{Binding IsRecipe}" />
        <Button Classes="menu" Content="配方库"      Command="{Binding Go}" CommandParameter="3" Classes.on="{Binding IsLib}" />
        <Button Classes="menu" Content="化合物数据库" Command="{Binding Go}" CommandParameter="4" Classes.on="{Binding IsCompounds}" />
        <Button Classes="menu" Content="配料表"      Command="{Binding Go}" CommandParameter="5" Classes.on="{Binding IsCharge}" />
        <Button Classes="menu" Content="运行"        Command="{Binding Go}" CommandParameter="6" Classes.on="{Binding IsRun}" />
        <Button Classes="menu" Content="数据导出"    Command="{Binding Go}" CommandParameter="7" Classes.on="{Binding IsExport}" />
      </StackPanel>

      <!-- 运行控制：黑药丸 + 三颗圆钮（运行 / 停止 / 暂停）。
           原型那句「模拟模式」去掉了——接上真机之后它就不对了，
           而这三个钮不论仿真真机都是同一件事，图标自己说得清 -->
      <Border Background="{StaticResource Chrome}" CornerRadius="8" Height="38" Margin="0,3,150,0"
              HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- 三颗都是「对全部已启用通道」。单路的启停在运行页的通道磁贴上。
               原型那颗「单步」去掉了：跳步是看着这一路当前那一步临时决定的，
               四路情况各不相同，一次全跳掉几乎不可能是人想要的，
               而且跳掉的每一步都写进记录撤不回来 -->
          <Button Classes="rbtn play" Command="{Binding SimRun}" IsEnabled="{Binding CanSimRun}"
                  ToolTip.Tip="{Binding SimRunTip}"><ctl:TecIcon Key="ui-sim-play" /></Button>
          <!-- 停止是急停，长得跟别的不一样：慌起来按错的代价太大 -->
          <Button Classes="rbtn stop" Command="{Binding SimStop}" IsEnabled="{Binding CanSimStop}"
                  ToolTip.Tip="停止全部通道"><ctl:TecIcon Key="ui-sim-stop" /></Button>
          <Button Classes="rbtn" Command="{Binding SimPause}" IsEnabled="{Binding CanSimPause}"
                  ToolTip.Tip="暂停全部正在跑的通道"><ctl:TecIcon Key="ui-sim-pause" /></Button>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Margin="0,0,12,0">
        <!-- 这台机器本身。直接用设备库那份双通道反应器的图，不再另存一份图标：
             同一台机器在顶栏、设备库、画布上就永远是同一张脸。
             套一个圆圈，尺寸与描边照 Button.tbtn（34 / #474a4e 2px 描边）——
             顶栏右边这一排本来就全是圆的（三颗运行钮、用户头像），
             只有它是一张裸图浮在那儿，看着像没做完 -->
        <!-- 圈里是透的，露菜单栏的底色，不刷白：写 Transparent 而不是写死
             #bfc9d7，菜单栏底色哪天再动，这个圈自己就跟上了 -->
        <Border Width="34" Height="34" CornerRadius="17" Background="Transparent"
                BorderBrush="#474a4e" BorderThickness="2" ClipToBounds="True"
                VerticalAlignment="Center" ToolTip.Tip="双通道反应器 RD-105">
          <ctl:DeviceArtView ArtKey="reactor2" Fit="True" Width="24" Height="22"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <!-- 用户区（照 gbg-account 原型 .um-anchor / .um-menu 重做）：
             头像 + 署名，点开 252 宽的账户菜单——头部是「谁在用这台机器」，
             下面四条带图标的菜单项 -->
        <Button Name="UserZone" Classes="userzone" VerticalAlignment="Center" Cursor="Hand">
          <StackPanel>
            <ctl:TecIcon Key="ui-user" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding UserName}" FontSize="10" Foreground="#51555a"
                       HorizontalAlignment="Center" Margin="0,-2,0,0" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" HorizontalOffset="4"
                    FlyoutPresenterClasses="umenupop">
              <StackPanel Width="252">
                <!-- 菜单头：登录名 + 角色标签 / 署名 / 本次会话起于何时、哪台机器 -->
                <Border Background="#fafafa" BorderBrush="#ebece9" BorderThickness="0,0,0,1"
                        Padding="14,13,14,12">
                  <StackPanel Orientation="Horizontal" Spacing="11">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#474a4e"
                            VerticalAlignment="Top">
                      <Viewbox Width="18" Height="18" HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <Canvas Width="26" Height="26">
                          <Ellipse Canvas.Left="8" Canvas.Top="3" Width="10" Height="10" Fill="White" />
                          <Path Data="M 3,25 C 3,19 7.5,16 13,16 C 18.5,16 23,19 23,25 Z" Fill="White" />
                        </Canvas>
                      </Viewbox>
                    </Border>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding UserLogin}" FontSize="14" FontWeight="Light"
                                   Foreground="#292b2e" VerticalAlignment="Center" />
                        <Border Background="#f0f8f3" BorderBrush="#a6cdb4" BorderThickness="1"
                                CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding UserRoleName}" FontSize="10" Foreground="#0e7a3e" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding UserSignLine}" FontSize="11" Foreground="#6b6f74"
                                 Margin="0,3,0,0" />
                      <TextBlock Text="{Binding SessionLine}" FontSize="10.5" Foreground="#9ea2a6"
                                 Margin="0,4,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- 图标都装在 Viewbox+Canvas 里：Path 自己量出来的大小是
                     「原点到几何右下角」，左上那块空白也算进去，直接 Center
                     会连空白一起居中（登录页那两个圆圈踩过） -->
                <Button Classes="umenu" Click="OnChangePassword">
                  <Grid ColumnDefinitions="15,9,*,Auto">
                    <Viewbox Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                      <Canvas Width="16" Height="16">
                        <Path Data="M 5.6,5.2 A 2.8,2.8 0 1 0 5.6,10.8 A 2.8,2.8 0 1 0 5.6,5.2 M 8.4,8 H 14 M 12,8 V 10.6 M 10.2,8 V 10"
                              Stroke="#565a5f" StrokeThickness="1.4" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Column="2" Text="修改密码" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="umenu" Click="OnManageUsers" IsVisible="{Binding IsAdmin}">
                  <Grid ColumnDefinitions="15,9,*,Auto">
                    <Viewbox Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                      <Canvas Width="16" Height="16">
                        <Path Data="M 6,3 A 2.6,2.6 0 1 0 6,8.2 A 2.6,2.6 0 1 0 6,3 M 1.6,13.4 C 1.6,10.8 3.6,9.4 6,9.4 C 8.4,9.4 10.4,10.8 10.4,13.4 M 11,4.2 A 2.4,2.4 0 0 1 11,8.6 M 12.4,13.4 C 12.4,11.6 11.9,10.5 11,9.8"
                              Stroke="#565a5f" StrokeThickness="1.4" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Column="2" Text="用户管理" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="仅管理员" FontSize="10" Foreground="#9ea2a6"
                               VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <Border Height="1" Background="#ebece9" Margin="0,4" />

                <Button Classes="umenu" Click="OnLockScreen">
                  <Grid ColumnDefinitions="15,9,*,Auto">
                    <Viewbox Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                      <Canvas Width="16" Height="16">
                        <Path Data="M 3.4,7 H 12.6 V 14 H 3.4 Z M 5.6,7 V 5.2 A 2.4,2.4 0 0 1 10.4,5.2 V 7"
                              Stroke="#565a5f" StrokeThickness="1.4" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Column="2" Text="锁定屏幕" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="运行不中断" FontSize="10" Foreground="#9ea2a6"
                               VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="umenu" Click="OnLogout">
                  <Grid ColumnDefinitions="15,9,*,Auto">
                    <Viewbox Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                      <Canvas Width="16" Height="16">
                        <Path Data="M 6.4,2.6 H 3 V 13.4 H 6.4 M 9,5.4 L 11.6,8 L 9,10.6 M 11.6,8 H 6"
                              Stroke="#565a5f" StrokeThickness="1.4" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Column="2" Text="注销" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Panel>

    <!-- 菜单栏与下面内容之间的白缝。6px —— 跟属性栏左边那条色条一个厚度：
         全程序「这里断开」这件事只用一个尺寸说，缝多宽、条多粗是同一个数 -->
    <Border DockPanel.Dock="Top" Height="6" Background="White" />

    <!-- 视图区 -->
    <Panel>
      <ContentControl IsVisible="{Binding IsStart}" Content="{Binding Start}">
        <ContentControl.ContentTemplate><DataTemplate><v:StartView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsBench}" Content="{Binding Bench}">
        <ContentControl.ContentTemplate><DataTemplate><v:BenchView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsRecipe}" Content="{Binding Recipe}">
        <ContentControl.ContentTemplate><DataTemplate><v:RecipeView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsLib}" Content="{Binding Library}">
        <ContentControl.ContentTemplate><DataTemplate><v:RecipeLibView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsCompounds}" Content="{Binding Compounds}">
        <ContentControl.ContentTemplate><DataTemplate><v:CompoundsView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsCharge}" Content="{Binding Charge}">
        <ContentControl.ContentTemplate><DataTemplate><v:ChargeView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsRun}" Content="{Binding Run}">
        <ContentControl.ContentTemplate><DataTemplate><v:RunView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsExport}" Content="{Binding Export}">
        <ContentControl.ContentTemplate><DataTemplate><v:ExportView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
    </Panel>
    </DockPanel>
    </Panel>
  </DockPanel>
  </Border>

  <Window.Styles>
    <!-- 标题栏左上那两个图标按钮：只有指针悬停时才显出底色，平时和标题栏一体 -->
    <Style Selector="Button.tbico">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tbico:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#33ffffff" />
    </Style>

    <!--
      账户菜单的**外壳**。Flyout 弹出来的不是我们给的那块内容，外面还套着一层
      FlyoutPresenter，它自带 8px 内边距、圆角和一圈浅描边——结果就是菜单里的
      东西离外框有一圈白，头部那块灰底和悬停的浅蓝都够不到边（用户看出来的
      「元素和外边的框有距离感」）。把这层压平：内边距归零、方角、
      1px #868b90 描边（原型 .um-menu 就是这一道），内容自己贴住框。
    -->
    <Style Selector="FlyoutPresenter.umenupop">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#868b90" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- 用户区那颗按钮本身 -->
    <Style Selector="Button.userzone">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.userzone:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#eff0ee" />
    </Style>

    <!-- 账户菜单里的行（原型 .um-mi：31 高、左右 14、悬停浅蓝） -->
    <Style Selector="Button.umenu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Height" Value="31" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#292b2e" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.umenu:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#f0f0ee" />
    </Style>

    <Style Selector="Button.win">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.win:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2effffff" />
    </Style>
    <Style Selector="Button.win.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e81123" />
    </Style>

  </Window.Styles>
</Window>
