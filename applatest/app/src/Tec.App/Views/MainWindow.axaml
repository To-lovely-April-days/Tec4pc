<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Tec.App.Views"
        xmlns:ctl="clr-namespace:Tec.App.Controls"
        x:Class="Tec.App.Views.MainWindow"
        Title="TecStudio 平行合成工作站 - PSW-4"
        Width="1500" Height="940" MinWidth="1280" MinHeight="720"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        Foreground="#333333" Background="Transparent"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <!--
    窗口圆角自绘：Windows 11 的 DWM 只给还原态窗口加圆角，最大化一律方角，
    应用改不了它的行为——所以圆角由这里裁。代价是最大化时屏幕四角透出桌面。
    OffScreenMargin 是最大化时窗口超出工作区的那一圈（自绘标题栏必须自己补），
    不补的话四边各有几像素内容跑到屏幕外面。
  -->
  <Border Name="Shell" Background="White" CornerRadius="8" ClipToBounds="True"
          Margin="{Binding $parent[Window].OffScreenMargin}">
  <DockPanel>

    <!-- 窗口标题栏：30px 深紫渐变，自绘（原型 .titlebar） -->
    <Border DockPanel.Dock="Top" Height="30" PointerPressed="OnTitlebarPressed">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#3c2d63" Offset="0" />
          <GradientStop Color="#2f2350" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="8,0,0,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="tbico" Command="{Binding SimRun}" ToolTip.Tip="运行">
            <ctl:TecIcon Key="ui-tb-run" />
          </Button>
          <Button Classes="tbico" Command="{Binding Start.SaveExperiment}" ToolTip.Tip="保存实验">
            <ctl:TecIcon Key="ui-tb-save" />
          </Button>
        </StackPanel>
        <Border Grid.Column="1" Margin="10,0,0,0" Padding="8,2" CornerRadius="3"
                Background="#24ffffff" VerticalAlignment="Center">
          <TextBlock Text="基础" Foreground="White" FontSize="12" />
        </Border>
        <!-- 实验名跟着当前打开的文件走，改过没存的加个星号 -->
        <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                   Foreground="White" FontSize="12">
          <Run Text="TecStudio 平行合成工作站 - PSW-4 · " />
          <Run Text="{Binding DocTitle}" />
        </TextBlock>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0">
            <ctl:TecIcon Key="ui-tb-about" Tint="#e6e0f5" VerticalAlignment="Center" />
            <TextBlock Text="关于" Foreground="#e6e0f5" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0">
            <ctl:TecIcon Key="ui-tb-settings" Tint="#e6e0f5" VerticalAlignment="Center" />
            <TextBlock Text="设置" Foreground="#e6e0f5" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0">
            <ctl:TecIcon Key="ui-tb-help" Tint="#e6e0f5" VerticalAlignment="Center" />
            <TextBlock Text="帮助" Foreground="#e6e0f5" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0">
          <Button Classes="win" Content="—" Click="OnMinimize" />
          <Button Classes="win" Content="▢" Click="OnMaximize" />
          <Button Classes="win close" Content="✕" Click="OnClose" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主菜单栏：52px 白底，25px 细体菜单项；右侧模拟模式与用户区叠在同一行 -->
    <Panel DockPanel.Dock="Top" Height="52" Background="White">
      <Border BorderBrush="#e3e3e3" BorderThickness="0,0,0,1" />
      <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
        <Button Classes="menu" Content="开始"        Command="{Binding Go}" CommandParameter="0" Classes.on="{Binding IsStart}" />
        <Button Classes="menu" Content="台面"        Command="{Binding Go}" CommandParameter="1" Classes.on="{Binding IsBench}" />
        <Button Classes="menu" Content="配方"        Command="{Binding Go}" CommandParameter="2" Classes.on="{Binding IsRecipe}" />
        <Button Classes="menu" Content="配方库"      Command="{Binding Go}" CommandParameter="3" Classes.on="{Binding IsLib}" />
        <Button Classes="menu" Content="化合物数据库" Command="{Binding Go}" CommandParameter="4" Classes.on="{Binding IsCompounds}" />
        <Button Classes="menu" Content="配料表"      Command="{Binding Go}" CommandParameter="5" Classes.on="{Binding IsCharge}" />
        <Button Classes="menu" Content="运行"        Command="{Binding Go}" CommandParameter="6" Classes.on="{Binding IsRun}" />
        <Button Classes="menu" Content="数据导出"    Command="{Binding Go}" CommandParameter="7" Classes.on="{Binding IsExport}" />
      </StackPanel>

      <!-- 运行控制：黑色药丸 + 4 个圆钮（运行 / 停止 / 暂停 / 单步）。
           原型那句「模拟模式」去掉了——接上真机之后它就不对了，
           而这四个钮不论仿真真机都是同一件事，图标自己说得清 -->
      <Border Background="#151515" CornerRadius="8" Height="48" Margin="0,2,150,0"
              HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,0">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <!-- 三颗都是「对全部已启用通道」。单路的启停在运行页的通道磁贴上。
               原型那颗「单步」去掉了：跳步是看着这一路当前那一步临时决定的，
               四路情况各不相同，一次全跳掉几乎不可能是人想要的，
               而且跳掉的每一步都写进记录撤不回来 -->
          <Button Classes="rbtn play" Command="{Binding SimRun}" IsEnabled="{Binding CanSimRun}"
                  ToolTip.Tip="{Binding SimRunTip}"><ctl:TecIcon Key="ui-sim-play" /></Button>
          <!-- 停止是急停，长得跟别的不一样：慌起来按错的代价太大 -->
          <Button Classes="rbtn stop" Command="{Binding SimStop}" IsEnabled="{Binding CanSimStop}"
                  ToolTip.Tip="停止全部通道"><ctl:TecIcon Key="ui-sim-stop" /></Button>
          <Button Classes="rbtn" Command="{Binding SimPause}" IsEnabled="{Binding CanSimPause}"
                  ToolTip.Tip="暂停全部正在跑的通道"><ctl:TecIcon Key="ui-sim-pause" /></Button>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Margin="0,0,12,0">
        <ctl:TecIcon Key="ui-robot" VerticalAlignment="Center" />
        <StackPanel>
          <ctl:TecIcon Key="ui-user" HorizontalAlignment="Center" />
          <TextBlock Text="管理员" FontSize="10" Foreground="#555555" HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Panel>

    <!-- 视图区 -->
    <Panel>
      <ContentControl IsVisible="{Binding IsStart}" Content="{Binding Start}">
        <ContentControl.ContentTemplate><DataTemplate><v:StartView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsBench}" Content="{Binding Bench}">
        <ContentControl.ContentTemplate><DataTemplate><v:BenchView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsRecipe}" Content="{Binding Recipe}">
        <ContentControl.ContentTemplate><DataTemplate><v:RecipeView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsLib}" Content="{Binding Library}">
        <ContentControl.ContentTemplate><DataTemplate><v:RecipeLibView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsCompounds}" Content="{Binding Compounds}">
        <ContentControl.ContentTemplate><DataTemplate><v:CompoundsView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsCharge}" Content="{Binding Charge}">
        <ContentControl.ContentTemplate><DataTemplate><v:ChargeView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsRun}" Content="{Binding Run}">
        <ContentControl.ContentTemplate><DataTemplate><v:RunView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
      <ContentControl IsVisible="{Binding IsExport}" Content="{Binding Export}">
        <ContentControl.ContentTemplate><DataTemplate><v:ExportView /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
    </Panel>
  </DockPanel>
  </Border>

  <Window.Styles>
    <!-- 标题栏左上那两个图标按钮：只有指针悬停时才显出底色，平时和标题栏一体 -->
    <Style Selector="Button.tbico">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tbico:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#33ffffff" />
    </Style>

    <Style Selector="Button.win">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.win:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2effffff" />
    </Style>
    <Style Selector="Button.win.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e81123" />
    </Style>

    <Style Selector="Button.rbtn">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="#4d4d4d" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.rbtn.play">
      <Setter Property="Background" Value="#28b44a" />
    </Style>
    <!-- 急停：红底。四颗一个样的话，慌起来很容易把停止按成暂停 -->
    <Style Selector="Button.rbtn.stop">
      <Setter Property="Background" Value="#c8352b" />
    </Style>
    <!-- 按不了的时候暗下去。缺省禁用样式会把底色整个刷成一片灰，
         三颗糊在一起分不出哪颗是哪颗——这里各自保住自己的颜色，只是整体压暗 -->
    <Style Selector="Button.rbtn:disabled">
      <Setter Property="Opacity" Value="0.32" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!-- 三颗的底色钉死：Fluent 的缺省 :pointerover / :pressed / :disabled 都会去改
         ContentPresenter 的 Background，鼠标一压上去急停就从红变灰，
         看着像它自己失效了。原型这三颗本来就没有悬停效果 -->
    <Style Selector="Button.rbtn:pointerover /template/ ContentPresenter,
                     Button.rbtn:pressed /template/ ContentPresenter,
                     Button.rbtn:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#4d4d4d" />
    </Style>
    <Style Selector="Button.rbtn.play:pointerover /template/ ContentPresenter,
                     Button.rbtn.play:pressed /template/ ContentPresenter,
                     Button.rbtn.play:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#28b44a" />
    </Style>
    <Style Selector="Button.rbtn.stop:pointerover /template/ ContentPresenter,
                     Button.rbtn.stop:pressed /template/ ContentPresenter,
                     Button.rbtn.stop:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#c8352b" />
    </Style>
  </Window.Styles>
</Window>
