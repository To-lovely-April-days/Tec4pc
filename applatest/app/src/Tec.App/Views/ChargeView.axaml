<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             x:Class="Tec.App.Views.ChargeView">
  <UserControl.Styles>
    <!-- 表格行：与化合物库同一套（白底 + 悬停浅灰 + 选中淡蓝） -->
    <Style Selector="Border.grow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#ececec" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.grow:pointerover">
      <Setter Property="Background" Value="#f5f5f5" />
    </Style>
    <Style Selector="Border.grow.sel">
      <Setter Property="Background" Value="#e8f2fb" />
      <Setter Property="BorderBrush" Value="#ececec" />
    </Style>
    <Style Selector="Border.grow TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#2b2b2b" />
      <Setter Property="Margin" Value="10,8" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.grow.sel TextBlock">
      <Setter Property="Foreground" Value="#0b3760" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 算出来的那几列排等宽数字，扫一眼对得齐 -->
    <Style Selector="Border.grow TextBlock.calc">
      <Setter Property="FontFamily" Value="Consolas,monospace" />
      <Setter Property="Foreground" Value="#3d3d3d" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.grow.sel TextBlock.calc">
      <Setter Property="Foreground" Value="#0b3760" />
    </Style>
    <Style Selector="TextBlock.chd">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#3a3a3a" />
      <Setter Property="Margin" Value="10,8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.chd.r">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.frowk">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#3d3d3d" />
      <Setter Property="Width" Value="80" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.unit">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8d8d8d" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 小节标题 -->
    <Style Selector="TextBlock.sect">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#6b6b6b" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,342">

    <DockPanel Grid.Column="0" Background="White">

      <!-- 工具条：通道 + 四个动作 + 釜容 + 状态 -->
      <Border DockPanel.Dock="Top" Height="58" Background="#ededed">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0" VerticalAlignment="Center">
          <TextBlock Text="通道：" FontSize="12" Foreground="#444444" VerticalAlignment="Center" />
          <ComboBox Classes="sel" Width="92" ItemsSource="{Binding Channels}"
                    SelectedItem="{Binding ChannelText, Mode=TwoWay}"
                    IsEnabled="{Binding HasChannels}" />

          <Button Classes="tbtn sm" Command="{Binding AddRow}" IsEnabled="{Binding HasChannels}"
                  ToolTip.Tip="加一行空白组分（不预填任何物性——预填等于替人编数据）">
            <ctl:TecIcon Key="ui-cmp-cmpnew" />
          </Button>
          <Button Classes="tbtn sm" Command="{Binding DeleteRow}" IsEnabled="{Binding HasChannels}" ToolTip.Tip="删除选中的这一行">
            <ctl:TecIcon Key="ui-foot-trash2" />
          </Button>
          <Button Classes="tbtn sm" Command="{Binding ApplyToRecipe}" IsEnabled="{Binding HasChannels}"
                  ToolTip.Tip="把算出来的体积填进这一路配方里同名的加料步骤。按料液名对应；改了哪几步会逐条说出来，配方页可以撤销">
            <ctl:TecIcon Key="ui-snav-export" />
          </Button>
          <Button Classes="tbtn sm" Command="{Binding ReadBack}" IsEnabled="{Binding HasChannels}"
                  ToolTip.Tip="从这一炉的运行记录把「实取」填回来——泵的累计加料量一直在采，不必手抄。读不出来的那几步会照实说，不拿计划量顶">
            <ctl:TecIcon Key="ui-snav-import" />
          </Button>
          <Button Classes="tbtn sm" Command="{Binding RefreshLibrary}" IsEnabled="{Binding HasChannels}"
                  ToolTip.Tip="把连库行的物性改回化合物库的当前值并重新盖快照章。会覆盖行上手改的物性——改了什么逐条列出。平时不用按：连库行的物性是快照，不跟着库变，这正是历史记录不被追溯改动的保证">
            <ctl:TecIcon Key="ui-ex-refresh" />
          </Button>

          <TextBlock Text="釜容：" FontSize="12" Foreground="#444444" VerticalAlignment="Center"
                     Margin="8,0,0,0" />
          <TextBox Classes="finput" Width="72" Text="{Binding VesselEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                   Watermark="不检查"
                   ToolTip.Tip="填了就拿各组分体积之和跟它对一下。留空 = 不检查" />
          <TextBlock Text="mL" Classes="unit" />

          <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                     Foreground="{Binding StatusColorHex}" FontSize="11.5"
                     VerticalAlignment="Center" Margin="6,0,0,0" MaxWidth="470"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
        </StackPanel>
      </Border>

      <!-- 问题条：有一条说一条，不汇总成「有问题」 -->
      <Border DockPanel.Dock="Top" Background="#fdf6e3" BorderBrush="#e8d9a8"
              BorderThickness="0,0,0,1" IsVisible="{Binding HasProblems}" Padding="14,8">
        <ItemsControl ItemsSource="{Binding Problems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontSize="11.5" Foreground="#8a6d1f"
                         TextWrapping="Wrap" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- 表头 -->
      <Border DockPanel.Dock="Top" Background="#fafafa"
              BorderBrush="#d5d5d5" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="1.5*,80,84,92,72,84,88,84,84,1.2*">
          <TextBlock Grid.Column="0" Text="组分" Classes="chd" />
          <TextBlock Grid.Column="1" Text="角色" Classes="chd" />
          <TextBlock Grid.Column="2" Text="基准" Classes="chd" />
          <TextBlock Grid.Column="3" Text="给定量" Classes="chd r" />
          <TextBlock Grid.Column="4" Text="当量" Classes="chd r" />
          <TextBlock Grid.Column="5" Text="mmol" Classes="chd r" />
          <TextBlock Grid.Column="6" Text="应称量 g" Classes="chd r" />
          <TextBlock Grid.Column="7" Text="体积 mL" Classes="chd r" />
          <TextBlock Grid.Column="8" Text="实投 g" Classes="chd r" />
          <TextBlock Grid.Column="9" Text="提示" Classes="chd" />
        </Grid>
      </Border>

      <ScrollViewer>
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="grow" PointerPressed="OnRowPressed" Classes.sel="{Binding IsSelected}">
                  <Grid ColumnDefinitions="1.5*,80,84,92,72,84,88,84,84,1.2*">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding RoleText}" />
                    <TextBlock Grid.Column="2" Text="{Binding BasisText}" />
                    <TextBlock Grid.Column="3" Text="{Binding AmountText}" Classes="calc" />
                    <TextBlock Grid.Column="4" Text="{Binding EqText}" Classes="calc" />
                    <TextBlock Grid.Column="5" Text="{Binding MolesText}" Classes="calc" />
                    <TextBlock Grid.Column="6" Text="{Binding MassText}" Classes="calc" />
                    <TextBlock Grid.Column="7" Text="{Binding VolumeText}" Classes="calc" />
                    <StackPanel Grid.Column="8" Orientation="Vertical" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ActualMassText}" Classes="calc" Margin="10,0" />
                      <TextBlock Text="{Binding DeviationText}" IsVisible="{Binding HasDeviation}"
                                 Foreground="{Binding DeviationColorHex}" FontSize="10"
                                 HorizontalAlignment="Right" Margin="10,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="9" Text="{Binding Hint}" IsVisible="{Binding HasHint}"
                               Foreground="{Binding HintColorHex}" FontSize="11"
                               ToolTip.Tip="{Binding Hint}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 空态：说清这一页要干什么，而不是摆一张空表 -->
          <StackPanel IsVisible="{Binding IsEmpty}" Margin="24,40" Spacing="8"
                      HorizontalAlignment="Center">
            <TextBlock Text="这一路还没有配料表" FontSize="15" Foreground="#6b6b6b"
                       HorizontalAlignment="Center" />
            <TextBlock MaxWidth="520" TextWrapping="Wrap" FontSize="12" Foreground="#8d8d8d"
                       TextAlignment="Center"
                       Text="按左上角的加号加一行。第一行默认是「限制试剂」——整张表的当量都相对它算：它定量（称多少克 / 量多少毫升 / 要多少毫摩尔），其余组分按当量或倍量跟着走。物性从化合物数据库取，缺什么就说缺什么，不替它填。" />
          </StackPanel>

          <StackPanel IsVisible="{Binding NoChannels}" Margin="24,40" Spacing="8"
                      HorizontalAlignment="Center">
            <TextBlock Text="台面上还没有通道" FontSize="15" Foreground="#6b6b6b"
                       HorizontalAlignment="Center" />
            <TextBlock Text="去「台面」把反应器拖进来，这一页才有得配。" FontSize="12"
                       Foreground="#8d8d8d" HorizontalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- ========== 右栏：这一行的详情 + 合计 ========== -->
    <Border Grid.Column="1" Background="{StaticResource ThemeGap}"
            BorderBrush="#d2d2d2" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel>

          <!-- 合计块 -->
          <Border Background="{StaticResource ThemeFill}" Padding="18,14" Margin="0,0,0,3">
            <StackPanel Spacing="6">
              <TextBlock Text="这一炉合计" FontSize="15" FontWeight="Light" Foreground="#333333"
                         HorizontalAlignment="Center" Margin="0,0,0,6" />
              <Grid ColumnDefinitions="72,*">
                <TextBlock Grid.Column="0" Text="限制试剂" Classes="frowk" />
                <TextBlock Grid.Column="1" Text="{Binding LimitingText}" FontSize="12"
                           Foreground="#2b2b2b" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="72,*">
                <TextBlock Grid.Column="0" Text="投料合计" Classes="frowk" />
                <TextBlock Grid.Column="1" Text="{Binding TotalMassText}" FontSize="12" Foreground="#2b2b2b" />
              </Grid>
              <Grid ColumnDefinitions="72,*">
                <TextBlock Grid.Column="0" Text="合计体积" Classes="frowk" />
                <TextBlock Grid.Column="1" Text="{Binding TotalVolumeText}" FontSize="12"
                           Foreground="{Binding VesselColorHex}"
                           ToolTip.Tip="各组分体积相加的估计值。混合后的实际体积会有出入——拿它跟釜容对一下够用，别当实测值" />
              </Grid>
              <Grid ColumnDefinitions="72,*" IsVisible="{Binding HasConcentration}">
                <TextBlock Grid.Column="0" Text="摩尔浓度" Classes="frowk" />
                <TextBlock Grid.Column="1" Text="{Binding ConcentrationText}" FontSize="12" Foreground="#2b2b2b"
                           ToolTip.Tip="限制试剂的物质的量 ÷ 溶剂总体积。有溶剂行算不出体积（缺密度）就不给这个数——按打了折的体积算浓度，得出的数偏高还看着可信" />
              </Grid>
              <TextBlock Text="{Binding YieldText}" IsVisible="{Binding HasYield}" FontSize="11.5"
                         Foreground="#2f8f49" TextWrapping="Wrap" Margin="0,4,0,0" />
              <TextBlock Text="{Binding ScaleHint}" IsVisible="{Binding HasScaleHint}" FontSize="11"
                         Foreground="#8d8d8d" TextWrapping="Wrap" Margin="0,2,0,0"
                         ToolTip.Tip="放大批量本来就只是改限制试剂那一格的数——整张表都是相对它算的。这个数只是省一次除法，不是「放大设计」：传热面积与体积之比、搅拌、加料时长、放热速率都不随批量线性缩放" />
            </StackPanel>
          </Border>

          <!-- 饱和温度：算得出来才出现，算不出来把原因摆出来 -->
          <Border Background="{StaticResource ThemeFill}" Padding="18,14" Margin="0,0,0,3"
                  IsVisible="{Binding HasSaturation}">
            <StackPanel Spacing="6">
              <TextBlock Text="溶解度与饱和温度" FontSize="15" FontWeight="Light" Foreground="#333333"
                         HorizontalAlignment="Center" Margin="0,0,0,4" />
              <TextBlock FontSize="11" Foreground="#8d8d8d" TextWrapping="Wrap" TextAlignment="Center"
                         Margin="0,0,0,6"
                         Text="库里那条曲线是水里的溶解度（g/100 mL 水）。溶剂不是水就不换算——拿水的曲线去算别的溶剂，会得到一个看着很合理的错温度。" />

              <ItemsControl ItemsSource="{Binding SaturationLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="11.5" Foreground="#2b2b2b"
                               TextWrapping="Wrap" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="#d5d5d5" Margin="0,8" />

              <!-- 这一路没有控温步骤时说一句，不摆一个空下拉在那儿让人点 -->
              <TextBlock Text="这一路的配方里还没有「控温」步骤，加一条才写得进去。"
                         IsVisible="{Binding NoTempSteps}" FontSize="11.5" Foreground="#8a6d1f"
                         TextWrapping="Wrap" Margin="0,2" />
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasTempSteps}">
                <TextBlock Text="写入" Classes="frowk" Width="40" />
                <ComboBox Classes="sel" Width="236" ItemsSource="{Binding TempSteps}"
                          SelectedItem="{Binding TempStepPick, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasTempSteps}">
                <TextBlock Text="余量" Classes="frowk" Width="40" />
                <TextBox Classes="finput" Width="84"
                         Text="{Binding MarginEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip.Tip="写进去的是饱和温度加这个余量。溶清通常 +5 ~ +10 ℃，结晶终点是负的" />
                <TextBlock Text="℃　→" Classes="unit" />
                <TextBlock Text="{Binding TargetText}" FontSize="12" FontWeight="SemiBold"
                           Foreground="#2b2b2b" VerticalAlignment="Center" />
              </StackPanel>
              <Button Classes="btn primary" Content="写入这条控温步骤"
                      HorizontalAlignment="Center" Margin="0,8,0,0"
                      IsVisible="{Binding HasTempSteps}"
                      Command="{Binding WriteSaturation}"
                      IsEnabled="{Binding CanWriteSaturation}" />
            </StackPanel>
          </Border>

          <!-- 组分详情 -->
          <Border Background="{StaticResource ThemeFill}" Padding="18,16,18,20"
                  IsVisible="{Binding HasSelection}">
            <StackPanel DataContext="{Binding Selected}">
              <TextBlock Text="组分详情" FontSize="18" FontWeight="Light" Foreground="#333333"
                         HorizontalAlignment="Center" Margin="0,0,0,4" />
              <TextBlock Text="{Binding RowNote}" FontSize="11" Foreground="#8d8d8d"
                         TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12" />

              <StackPanel Spacing="7">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="名称" Classes="frowk" />
                  <TextBox Classes="finput" Width="196"
                           Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           ToolTip.Tip="加料步骤里那个「料液」填的就是它——两边叫同一个名字才对得上" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="角色" Classes="frowk" />
                  <ComboBox Classes="sel" Width="196"
                            ItemsSource="{Binding $parent[UserControl].DataContext.Roles}"
                            SelectedItem="{Binding RoleText, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="基准" Classes="frowk" />
                  <ComboBox Classes="sel" Width="196"
                            ItemsSource="{Binding $parent[UserControl].DataContext.Bases}"
                            SelectedItem="{Binding BasisText, Mode=TwoWay}"
                            ToolTip.Tip="限制试剂必须「直接给量」——它是基准，不能拿自己当参照。溶剂常用「按倍量」：每 1 g 限制试剂用几 mL" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding AmountLabel}" Classes="frowk" />
                  <TextBox Classes="finput" Width="118"
                           Text="{Binding AmountEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           Watermark="未填" />
                  <ComboBox Classes="sel" Width="72" Margin="6,0,0,0"
                            IsVisible="{Binding ShowUnit}"
                            ItemsSource="{Binding $parent[UserControl].DataContext.Units}"
                            SelectedItem="{Binding UnitText, Mode=TwoWay}" />
                  <TextBlock Text="{Binding AmountUnitText}" Classes="unit"
                             IsVisible="{Binding !ShowUnit}" />
                </StackPanel>
              </StackPanel>

              <TextBlock Text="连到化合物库" Classes="sect" />
              <ComboBox Classes="sel" Width="276" HorizontalAlignment="Left"
                        ItemsSource="{Binding $parent[UserControl].DataContext.LibraryNames}"
                        SelectedItem="{Binding $parent[UserControl].DataContext.LibraryPick, Mode=TwoWay}"
                        ToolTip.Tip="连上之后摩尔质量 / 密度 / 纯度就跟着库走，库里改了这里也跟着变" />

              <TextBlock Text="这一瓶的物性（连库时从库里拷来，改动只落在本行）" Classes="sect" />
              <StackPanel Spacing="7">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="摩尔质量" Classes="frowk" />
                  <TextBox Classes="finput" Width="118"
                           Text="{Binding MwText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           Watermark="没有就空着" />
                  <TextBlock Text="g/mol" Classes="unit" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="密度" Classes="frowk" />
                  <TextBox Classes="finput" Width="118"
                           Text="{Binding DensityText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           Watermark="没有就空着"
                           ToolTip.Tip="把质量换成加料体积就靠它。没有它就算不出体积——那时表里是空的，不会拿 1 g/mL 顶" />
                  <TextBlock Text="g/mL" Classes="unit" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="纯度" Classes="frowk" />
                  <TextBox Classes="finput" Width="118"
                           Text="{Binding PurityText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           Watermark="没有就空着"
                           ToolTip.Tip="应称量按它折算：料只有 65 %，要拿到那么多物质的量就得多称。手里这瓶实测多少就填多少，库里那个是通用参考值" />
                  <TextBlock Text="%" Classes="unit" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="相态" Classes="frowk" />
                  <ComboBox Classes="sel" Width="118" FontSize="11.5"
                            ItemsSource="{Binding PhaseOptions}"
                            SelectedItem="{Binding PhaseText, Mode=TwoWay}"
                            ToolTip.Tip="这一炉以什么形态投料——不是纯品常态：苯甲酸是固体，配成乙醇溶液泵进去就选「液」。标「固」的行接到泵加料步骤会被拦（泵打不了固体）；没填就不拦也不猜" />
                </StackPanel>
              </StackPanel>

              <TextBlock Text="这一瓶与实际投料" Classes="sect" />
              <StackPanel Spacing="7">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="批号" Classes="frowk" />
                  <TextBox Classes="finput" Width="196"
                           Text="{Binding Batch, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           ToolTip.Tip="跟着这一瓶料走。GLP 要求记得出「用的是哪一批」" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="供应商" Classes="frowk" />
                  <TextBox Classes="finput" Width="196"
                           Text="{Binding Supplier, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="实投" Classes="frowk" />
                  <TextBox Classes="finput" Width="118"
                           Text="{Binding ActualMassEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           Watermark="称完回填"
                           ToolTip.Tip="算出来的是应称量，这一格是真投进去的。产物那一行填的是实际产量，用来算收率" />
                  <TextBlock Text="g" Classes="unit" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="实取" Classes="frowk" />
                  <TextBox Classes="finput" Width="118"
                           Text="{Binding ActualVolumeEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           Watermark="按体积量的填这个" />
                  <TextBlock Text="mL" Classes="unit" />
                </StackPanel>
                <!-- 实投折算（CH-3.5）：回填之后反算回摩尔，跟计划一比就是过量/欠量 -->
                <TextBlock Text="{Binding ActualCalcText}" IsVisible="{Binding HasActualCalc}"
                           FontSize="11" Foreground="#5a6b5e" TextWrapping="Wrap"
                           ToolTip.Tip="实投按本行纯度折算成物质的量；实际当量以限制试剂实投为基准（没回填则按计划）；过量/欠量是相对计划当量而言" />
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="备注" Classes="frowk" />
                  <TextBox Classes="finput" Width="196"
                           Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
