<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             xmlns:v="clr-namespace:Tec.App.Views"
             x:Class="Tec.App.Views.StartView">

  <!--
    版式照 GBG 的 Start 标签页：左缘一列圆钮（图标在圈里、名字在圈下），
    右边并排两栏磁贴——左「最近」、右「实验目录」，抬头直接写目录路径。
    颜色不跟它：GBG 那一片是品牌绿，我们走自己那支卡片色 #bfc9d7。

    左缘只有「新建 / 打开」两颗常驻，「保存 / 另存为」等打开或新建过一份实验
    之后才出现——GBG 的做法（Once a program is loaded, Save and Save As will be
    visible）。一份都没开的时候，那两颗按下去无非是存一份空的，摆着只让人猜。

    ⚠ 导入台面 / 导出台面按这一版从这里撤掉了，而它们**在别处没有入口**。
    数据导出还有主菜单那一栏，退出还有标题栏的 ✕，这两个没有。
  -->
  <Grid ColumnDefinitions="Auto,*">

    <Border Grid.Column="0" Background="White">
      <ScrollViewer Width="96" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,16,0,20" Spacing="14">

          <!-- 一颗 = 圆钮 + 圈下的名字。整块可点，不是只有圆圈能点 -->
          <Button Classes="srail" Command="{Binding NewExperiment}" ToolTip.Tip="新建实验">
            <StackPanel Spacing="5">
              <Border Classes="srailo"><ctl:TecIcon Key="ui-snav-new" Tint="#1f2124" /></Border>
              <TextBlock Text="新建" Classes="sraill" />
            </StackPanel>
          </Button>
          <Button Classes="srail" Command="{Binding OpenExperiment}" ToolTip.Tip="打开实验">
            <StackPanel Spacing="5">
              <Border Classes="srailo"><ctl:TecIcon Key="ui-snav-open" Tint="#1f2124" /></Border>
              <TextBlock Text="打开" Classes="sraill" />
            </StackPanel>
          </Button>
          <Button Classes="srail" Command="{Binding SaveExperiment}" ToolTip.Tip="保存实验"
                  IsVisible="{Binding HasDoc}">
            <StackPanel Spacing="5">
              <Border Classes="srailo"><ctl:TecIcon Key="ui-snav-save" Tint="#1f2124" /></Border>
              <TextBlock Text="保存" Classes="sraill" />
            </StackPanel>
          </Button>
          <Button Classes="srail" Command="{Binding SaveAsExperiment}" ToolTip.Tip="另存为"
                  IsVisible="{Binding HasDoc}">
            <StackPanel Spacing="5">
              <Border Classes="srailo"><ctl:TecIcon Key="ui-snav-saveas" Tint="#1f2124" /></Border>
              <TextBlock Text="另存为" Classes="sraill" />
            </StackPanel>
          </Button>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- 右边整块：一条状态行（文件操作的结果）+ 两栏磁贴 -->
    <DockPanel Grid.Column="1" Margin="4,16,20,0">

      <!-- 文件操作的结果写在这儿，成了失败了都看得见。不弹框——操作人手上可能正跑着实验 -->
      <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" FontSize="12" Foreground="#0e7a3e"
                 TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,0,12"
                 IsVisible="{Binding Status, Converter={x:Static v:Converters.NotBlank}}" />

      <!-- 两栏等宽，中间 20 的沟。GBG 是左窄右宽（左边固定六格），
           我们两边条数都不定，等分不会有一边空着 -->
      <Grid ColumnDefinitions="*,20,*">

        <!-- ══ 左：最近 ══ -->
        <DockPanel Grid.Column="0">
          <TextBlock DockPanel.Dock="Top" Text="最近" FontSize="19" FontWeight="Light"
                     Foreground="#55595e" Margin="2,0,0,12" />

          <Border DockPanel.Dock="Top" IsVisible="{Binding IsEmpty}"
                  Background="{StaticResource ThemeFill}" CornerRadius="3" Padding="22,26">
            <StackPanel Spacing="7">
              <TextBlock Text="还没有实验" FontSize="15" Foreground="#6b6f74" />
              <TextBlock FontSize="12" Foreground="#959a9f" LineHeight="19" TextWrapping="Wrap"
                         Text="新建实验、在台面上摆好设备、配好配方，保存之后就会出现在这里。" />
            </StackPanel>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Recent}" Margin="0,0,0,24">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="tile" Classes.on="{Binding On}"
                          PointerPressed="OnCardPressed" ToolTip.Tip="{Binding Path}">
                    <Panel>
                      <StackPanel Margin="10,22,10,8">
                        <!-- 白底预览框：台面按真实坐标缩放画出来，管路一并画上。
                             从没打开过的那些没有缩略图，框就是空的——不编一个台面出来 -->
                        <Border Classes="tileth"><ctl:BenchThumb Parts="{Binding Parts}" Margin="5" /></Border>
                        <TextBlock Text="{Binding Name}" Classes="tilen" />
                      </StackPanel>

                      <!-- ✕：把这一条从「最近」里划掉。**不删文件**——
                           它还在实验目录里，右边那一栏照样看得见 -->
                      <Button Classes="tilex" ToolTip.Tip="从最近列表里移除（不删文件）"
                              Command="{Binding $parent[UserControl].DataContext.Forget}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="✕" FontSize="11" Foreground="#4a4f55"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Button>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- ══ 右：实验目录 ══ -->
        <DockPanel Grid.Column="2">
          <!-- 抬头就是目录路径本身（GBG 也是这么写的）：这一栏读的是哪儿，
               不用另找地方说 -->
          <TextBlock DockPanel.Dock="Top" Text="{Binding FolderPath}" FontSize="19"
                     FontWeight="Light" Foreground="#55595e" Margin="2,0,0,12"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FolderPath}" />

          <Border DockPanel.Dock="Top" IsVisible="{Binding FolderEmpty}"
                  Background="{StaticResource ThemeFill}" CornerRadius="3" Padding="22,26">
            <StackPanel Spacing="7">
              <TextBlock Text="这个目录里还没有实验文件" FontSize="15" Foreground="#6b6f74" />
              <TextBlock FontSize="12" Foreground="#959a9f" LineHeight="19" TextWrapping="Wrap"
                         Text="用「另存为」把实验存进这个目录，它就会出现在这一栏。" />
            </StackPanel>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Folder}" Margin="0,0,0,24">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="tile dir" Classes.on="{Binding On}"
                          PointerPressed="OnCardPressed" ToolTip.Tip="{Binding Path}">
                    <Panel>
                      <StackPanel Margin="10,22,10,8">
                        <Border Classes="tileth"><ctl:BenchThumb Parts="{Binding Parts}" Margin="5" /></Border>
                        <TextBlock Text="{Binding Name}" Classes="tilen" />
                      </StackPanel>

                      <!-- 这一栏的 ✕ 是**真删文件**，跟左边那栏的「划掉一条记录」
                           不是一回事。所以命令里一定先弹一句确认——
                           删的是操作人存下来的整份实验，没有回收站可退 -->
                      <Button Classes="tilex" ToolTip.Tip="删除这个实验文件"
                              Command="{Binding $parent[UserControl].DataContext.DeleteFile}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="✕" FontSize="11" Foreground="#4a4f55"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Button>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

      </Grid>
    </DockPanel>
  </Grid>

  <UserControl.Styles>

    <!-- ══ 左缘那一列圆钮 ══ -->
    <Style Selector="Button.srail">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.srail:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 圈本身：尺寸与描边照 Button.tbtn（34 / #474a4e 2px），全程序圆钮一副样子 -->
    <Style Selector="Border.srailo">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#474a4e" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- 悬停：只有圈变，字不动 -->
    <Style Selector="Button.srail:pointerover Border.srailo">
      <Setter Property="Background" Value="{StaticResource ThemeFill}" />
    </Style>
    <Style Selector="TextBlock.sraill">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#3a3d41" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ══ 磁贴 ══
         GBG 两栏是同一支绿的深浅两档：左「Recent」重、右「目录」淡。
         我们照这个关系摆，色值走自己这条线上的两档——
         · 左「最近」 #d7dde5：卡片色 #bfc9d7 与面色 #eff1f3 的正中间。
           比原来的卡片色亮一档（原来压在白页上偏重），又明显比右栏实。
           没有引进新的色相，只是同一条线上多站了一格。
         · 右「实验目录」 #eff1f3：面色本身，最淡的一档，往后退。
         168 宽：预览框 148×86 + 名字一行，一栏 ~470 宽能并排两个 -->
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="168" />
      <Setter Property="Background" Value="#d7dde5" />
      <Setter Property="CornerRadius" Value="2" />
      <!-- 内边距写在内容的 Margin 上、不写这儿：Padding 会把里面所有东西
           一起框进去，右上角那个 ✕ 就只能贴到预览框的角，贴不到磁贴的角。
           上边留 22 而不是 10：18px 的 ✕ 加上下各 3 的余量正好 24，
           留 10 的话它有一半压在白预览框上，看着像预览图自己带了个叉 -->
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="Background" Value="#c6cfda" />
    </Style>
    <!-- 右栏：面色那一档，连悬停也跟着淡一格 -->
    <Style Selector="Border.tile.dir">
      <Setter Property="Background" Value="{StaticResource ThemeFill}" />
    </Style>
    <Style Selector="Border.tile.dir:pointerover">
      <Setter Property="Background" Value="#dee3e8" />
    </Style>
    <!-- 当前打开的那一份：描一圈菜单选中蓝。这是全页唯一要一眼找到的东西 -->
    <Style Selector="Border.tile.on">
      <Setter Property="BorderBrush" Value="{StaticResource MenuBlue}" />
    </Style>

    <!-- 预览框：白底，磁贴上唯一的白 -->
    <Style Selector="Border.tileth">
      <Setter Property="Height" Value="86" />
      <Setter Property="Background" Value="White" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="TextBlock.tilen">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#22262b" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,7,0,0" />
    </Style>

    <!-- 右上角那个 ✕：平时压到很淡，指针进了磁贴才浮出来 -->
    <Style Selector="Button.tilex">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,3,3,0" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.tile:pointerover Button.tilex">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.tilex:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#66ffffff" />
    </Style>

  </UserControl.Styles>
</UserControl>
