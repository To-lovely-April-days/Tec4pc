<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tec.App.Views.LoginView"
             Focusable="True">

  <!--
    登录页，照 gbglogin 设计稿的登录窗本体：顶上 30px 深紫条（含语言切换），
    下面 300px 品牌区 + 表单区。品牌区是绿圆播放标 + TecStudio 字标 +
    一张位图（Resources\login-visual.png，不是 SVG；没提供时画虚线占位）。

    所有文字走 T.XXX（LoginText）——换语言只换那张表，版面不动。
  -->

  <UserControl.Styles>
    <Style Selector="TextBox.lgin">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#a8a8a8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="TextBox.lgin:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#1a91d6" />
    </Style>

    <!-- 按钮文字水平垂直都居中：默认模板的内容是靠上的，32 高的钮里字会偏下沿 -->
    <Style Selector="Button.lgbtn">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Background" Value="#f2f2f2" />
      <Setter Property="Foreground" Value="#333333" />
      <Setter Property="BorderBrush" Value="#8b8b8b" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.lgbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e3f0f9" />
      <Setter Property="BorderBrush" Value="#1a91d6" />
    </Style>
    <Style Selector="Button.lgbtn.primary">
      <Setter Property="Background" Value="#2f8f49" />
      <Setter Property="BorderBrush" Value="#28803f" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.lgbtn.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#28803f" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="ToggleButton.lgeye">
      <Setter Property="Width" Value="32" />
      <Setter Property="Background" Value="#fafafa" />
      <Setter Property="BorderBrush" Value="#e2e2e2" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="CornerRadius" Value="0,2,2,0" />
      <Setter Property="Foreground" Value="#7a7a7a" />
    </Style>
    <Style Selector="ToggleButton.lgeye:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#eaf6fd" />
    </Style>

    <!-- 标题条里的语言按钮（原型 .tb-link） -->
    <Style Selector="Button.langbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Foreground" Value="#e6e0f5" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.langbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#24ffffff" />
    </Style>
    <Style Selector="Button.langitem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.langitem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#eaf6fd" />
    </Style>
  </UserControl.Styles>

  <Panel Background="White">
    <DockPanel>

      <!-- 顶条：跟主程序同一条深紫渐变。右侧是语言切换（原型标题栏里那颗） -->
      <Border DockPanel.Dock="Top" Height="30">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#3c2d63" Offset="0" />
            <GradientStop Color="#2f2350" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="8,0"
                      VerticalAlignment="Center">
            <!-- 小播放标（原型 titlebar 那枚 16×16 的 svg）。整幅画进 Viewbox：
                 圆和三角在同一个坐标系里，三角的位置由图自己定，不靠对齐去凑 -->
            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
              <Canvas Width="16" Height="16">
                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="14" Height="14" Fill="#8ec63f" />
                <Path Data="M 6,4.5 L 11,8 L 6,11.5 Z" Fill="White" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="{Binding T.WindowTitle}" Foreground="White" FontSize="12"
                       VerticalAlignment="Center" />
          </StackPanel>

          <!-- 语言：地球 + 当前语言名 + 下拉。菜单里每项带一行小字说明
               这套文案管到哪（目前只管登录页），不让人以为整机都能切 -->
          <Button Grid.Column="2" Classes="langbtn" VerticalAlignment="Center"
                  Margin="0,0,66,0" ToolTip.Tip="{Binding T.LangMenu}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                <Canvas Width="16" Height="16">
                  <Ellipse Canvas.Left="1.6" Canvas.Top="1.6" Width="12.8" Height="12.8"
                           Stroke="#e6e0f5" StrokeThickness="1.3" />
                  <Ellipse Canvas.Left="5.1" Canvas.Top="1.6" Width="5.8" Height="12.8"
                           Stroke="#e6e0f5" StrokeThickness="1.1" />
                  <Path Data="M 1.9,5.8 H 14.1 M 1.9,10.2 H 14.1"
                        Stroke="#e6e0f5" StrokeThickness="1.1" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="{Binding LangName}" VerticalAlignment="Center" />
              <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#e6e0f5" StrokeThickness="1.3"
                    VerticalAlignment="Center" Margin="1,2,0,0" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ItemsControl ItemsSource="{Binding Languages}" Width="190">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="langitem"
                              Command="{Binding $parent[UserControl].DataContext.PickLang}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="14,*,Auto">
                          <!-- 当前那一项打勾 -->
                          <Path Grid.Column="0" Data="M 0,3.4 L 2.6,6 L 7.4,0.6"
                                Stroke="#2f8f49" StrokeThickness="1.8" Fill="Transparent"
                                VerticalAlignment="Center" IsVisible="{Binding IsCurrent}" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                     Foreground="#2b2b2b" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding Sub}" FontSize="10.5"
                                     Foreground="#a2a2a2" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="300,*">

        <!-- ═ 左：品牌（原型 .lg-brand，整列铺满高度） ═ -->
        <Border Grid.Column="0" Background="#ececec"
                BorderBrush="#d2d2d2" BorderThickness="0,0,1,0"
                Padding="24,26,24,20">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <!-- 品牌标：绿圆 + 白三角。三角画在原型那个 26×26 的画布里
                   （Viewbox 缩到 24 居中）——直接把 Path 丢进圆里对齐是不行的：
                   Path 量到的是「原点到几何右下角」那个盒子，把这个盒子居中，
                   等于把三角连同它左上那片空白一起居中，看着就偏右下了 -->
              <Border Width="52" Height="52" CornerRadius="26" Background="#2f8f49"
                      HorizontalAlignment="Left" Margin="0,0,0,14">
                <Viewbox Width="24" Height="24"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Canvas Width="26" Height="26">
                    <Path Data="M 8,5 L 21,13 L 8,21 Z" Fill="White" />
                  </Canvas>
                </Viewbox>
              </Border>
              <TextBlock Text="TecStudio" FontSize="28" FontWeight="Light" Foreground="#2b2b2b" />
              <TextBlock Text="{Binding T.BrandSub}" FontSize="12" Foreground="#7a7a7a"
                         Margin="0,6,0,0" />
              <Border Height="1" Background="#d5d5d5" Margin="0,18,0,16" />

              <!-- 图位（原型 .lg-art 252×176）：一张位图。没提供就按原型给虚线占位 -->
              <Panel Width="252" Height="176" HorizontalAlignment="Left">
                <Image Source="{Binding ArtImage}" IsVisible="{Binding HasArt}"
                       Stretch="Uniform" />
                <Panel IsVisible="{Binding !HasArt}">
                  <Border Background="#f4f4f4" CornerRadius="2" />
                  <Rectangle Stroke="#c2c2c2" StrokeThickness="1" StrokeDashArray="4,3"
                             RadiusX="2" RadiusY="2" />
                  <!-- 路径可能很长，得能折行：不折的话尾巴会被占位框裁掉，
                       而被裁掉的恰好是「放在哪」那一段 -->
                  <TextBlock Text="{Binding ArtHint}" FontSize="10" Foreground="#a2a2a2"
                             TextAlignment="Center" LineHeight="16" TextWrapping="Wrap"
                             Margin="10,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
              </Panel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionLine}" FontSize="10.5"
                       Foreground="#9a9a9a" VerticalAlignment="Bottom" LineHeight="17" />
            <Panel />
          </DockPanel>
        </Border>

        <!-- ═ 右：表单台面。块竖直居中，宽度封顶——窗口再宽字段也不失比例 ═ -->
        <StackPanel Grid.Column="1" IsVisible="{Binding IsForm}" VerticalAlignment="Center"
                    HorizontalAlignment="Left" MaxWidth="620" MinWidth="480" Margin="40,26">
          <TextBlock Text="{Binding T.H1}" FontSize="26" FontWeight="Light" Foreground="#3b3b3b" />
          <TextBlock Text="{Binding T.Lead}" FontSize="11.5"
                     Foreground="#7a7a7a" Margin="0,6,0,0" />

          <!-- 首次启动的提示（黄条）：初始密码是公开值，明说 -->
          <Border Margin="0,16,0,0" Background="#fdf8ec" BorderBrush="#e8d6a8"
                  BorderThickness="1" CornerRadius="2" IsVisible="{Binding ShowSeedNote}">
            <Grid ColumnDefinitions="3,*">
              <Border Grid.Column="0" Background="#dba32c" />
              <TextBlock Grid.Column="1" Text="{Binding SeedNote}" FontSize="11.5"
                         Foreground="#8a6a1f" LineHeight="17" TextWrapping="Wrap"
                         Margin="9,8" />
            </Grid>
          </Border>

          <!-- 错误条（红条） -->
          <Border Margin="0,14,0,0" Background="#fdf2f2" BorderBrush="#f0c9c9"
                  BorderThickness="1" CornerRadius="2" IsVisible="{Binding HasError}">
            <Grid ColumnDefinitions="3,*">
              <Border Grid.Column="0" Background="#e02020" />
              <TextBlock Grid.Column="1" Text="{Binding Error}" FontSize="11.5"
                         Foreground="#8d2b2b" LineHeight="17" TextWrapping="Wrap"
                         Margin="9,8" />
            </Grid>
          </Border>

          <!-- 用户名 / 密码 -->
          <Grid ColumnDefinitions="Auto,*" Margin="0,20,0,11">
            <TextBlock Grid.Column="0" Text="{Binding T.User}" FontSize="12" Foreground="#3d3d3d"
                       MinWidth="68" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Name="UserBox" Classes="lgin" Watermark="{Binding T.UserPh}"
                     Text="{Binding User, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Text="{Binding T.Pass}" FontSize="12" Foreground="#3d3d3d"
                       MinWidth="68" Margin="0,0,12,0" VerticalAlignment="Center" />
            <Panel Grid.Column="1">
              <TextBox Classes="lgin" Name="PassBox" PasswordChar="●" Padding="9,0,38,0"
                       RevealPassword="{Binding Reveal}"
                       Text="{Binding Pass, Mode=TwoWay}" />
              <ToggleButton Classes="lgeye" IsChecked="{Binding Reveal, Mode=TwoWay}"
                            HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            Margin="0,1,1,1" ToolTip.Tip="{Binding T.ShowPass}">
                <Path Data="M 1,8 C 1,8 3.6,3.8 8,3.8 C 12.4,3.8 15,8 15,8 C 15,8 12.4,12.2 8,12.2 C 3.6,12.2 1,8 1,8 Z M 8,10.1 A 2.1,2.1 0 1 0 8,5.9 A 2.1,2.1 0 0 0 8,10.1 Z"
                      Stroke="#7a7a7a" StrokeThickness="1.3" Fill="Transparent"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </ToggleButton>
            </Panel>
          </Grid>

          <!-- 记住密码 + 忘记密码。勾选项带提示：这层保护有多厚，说在明处 -->
          <StackPanel Orientation="Horizontal" Spacing="18" Margin="80,0,0,0">
            <CheckBox FontSize="11.5" Foreground="#333333" Content="{Binding T.Remember}"
                      ToolTip.Tip="{Binding T.RememberTip}"
                      IsChecked="{Binding Remember, Mode=TwoWay}" />
            <Button Background="Transparent" BorderThickness="0" Padding="0"
                    VerticalAlignment="Center" Cursor="Hand"
                    Command="{Binding ToggleReset}">
              <TextBlock Text="{Binding T.Forgot}" FontSize="11" Foreground="#1a91d6" />
            </Button>
          </StackPanel>

          <!-- 忘记密码的说明（黄条，点上面那个链接开关） -->
          <Border Margin="0,12,0,0" Background="#fdf8ec" BorderBrush="#e8d6a8"
                  BorderThickness="1" CornerRadius="2" IsVisible="{Binding ShowReset}">
            <Grid ColumnDefinitions="3,*">
              <Border Grid.Column="0" Background="#dba32c" />
              <TextBlock Grid.Column="1" Text="{Binding T.ResetNote}" FontSize="11.5"
                         Foreground="#8a6a1f" LineHeight="17" TextWrapping="Wrap"
                         Margin="9,8" />
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                      Margin="0,18,0,0">
            <Button Classes="lgbtn" Content="{Binding T.Cancel}" Command="{Binding Cancel}" />
            <Button Classes="lgbtn primary" Content="{Binding T.SignIn}" Command="{Binding Submit}" />
          </StackPanel>
          <Border Height="1" Background="#e3e3e3" Margin="0,16,0,0" />
          <TextBlock Text="{Binding T.Foot}" FontSize="10.5" Foreground="#9a9a9a"
                     LineHeight="17" TextWrapping="Wrap" Margin="0,11,0,0" />
        </StackPanel>

        <!-- ═ 右：登录成功台面（数据都是真的） ═ -->
        <StackPanel Grid.Column="1" IsVisible="{Binding IsDone}" VerticalAlignment="Center"
                    HorizontalAlignment="Left" MaxWidth="620" MinWidth="480" Margin="40,26">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <!-- 对勾同理：画在原型那个 24×24 的画布里，Viewbox 缩到 22 居中 -->
            <Border Width="46" Height="46" CornerRadius="23" Background="#2f8f49">
              <Viewbox Width="22" Height="22"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Data="M 4.5,12.5 L 9.5,17.5 L 19.5,6.5" Stroke="White"
                        StrokeThickness="2.6" StrokeLineCap="Round" StrokeJoin="Round"
                        Fill="Transparent" />
                </Canvas>
              </Viewbox>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding DoneTitle}" FontSize="20" FontWeight="Light"
                         Foreground="#3b3b3b" />
              <TextBlock Text="{Binding DoneSub}" FontSize="11.5" Foreground="#7a7a7a"
                         Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>
          <Border Height="1" Background="#d5d5d5" Margin="0,22,0,16" />
          <Grid ColumnDefinitions="*,Auto" Margin="0,4">
            <TextBlock Text="{Binding T.KSession}" FontSize="12" Foreground="#333333" />
            <TextBlock Grid.Column="1" Text="{Binding DoneSession}" FontSize="12" Foreground="#5a5a5a" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" Margin="0,4">
            <TextBlock Text="{Binding T.KStation}" FontSize="12" Foreground="#333333" />
            <TextBlock Grid.Column="1" Text="{Binding DoneStation}" FontSize="12" Foreground="#5a5a5a" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" Margin="0,4">
            <TextBlock Text="{Binding T.KPrev}" FontSize="12" Foreground="#333333" />
            <TextBlock Grid.Column="1" Text="{Binding DonePrev}" FontSize="12" Foreground="#5a5a5a" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                      Margin="0,22,0,0">
            <Button Classes="lgbtn" Content="{Binding T.SignOut}" Command="{Binding BackToForm}" />
            <Button Classes="lgbtn primary" Content="{Binding T.OpenApp}" Command="{Binding Enter}" />
          </StackPanel>
        </StackPanel>

      </Grid>
    </DockPanel>
  </Panel>
</UserControl>
