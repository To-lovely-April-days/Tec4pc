<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             xmlns:local="clr-namespace:Tec.App.Views"
             x:Class="Tec.App.Views.RunView">

  <!-- 原型 view-run：runtop 44px → runbody 三块 pane → 底部执行记录抽屉 -->
  <DockPanel Background="White">

    <!-- runtop。启动 / 停止 / 暂停 / 单步在菜单栏右边那排圆钮上，这里不再摆一份 -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Height="44" Margin="14,0"
          VerticalAlignment="Top">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="实验：" FontSize="12" Foreground="#444444" VerticalAlignment="Center" />
        <!-- 同时只打开一个实验；能切换要等「打开实验」做出来 -->
        <TextBlock Text="{Binding ExperimentName}" FontSize="12" FontWeight="SemiBold"
                   Foreground="#2b2b2b" VerticalAlignment="Center" />
        <TextBlock Text="{Binding RunTop}" FontSize="12" Foreground="#444444"
                   VerticalAlignment="Center" Margin="14,0,0,0" />
      </StackPanel>

      <TextBlock Grid.Column="1" Text="{Binding Say}" IsVisible="{Binding HasSay}"
                 FontSize="11.5" Foreground="#2f8f49" VerticalAlignment="Center"
                 TextAlignment="Right" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
    </Grid>

    <!-- 报警带。一条都没有就整条不画——平时不占地方，有事才出现。
         **刻意不做成弹框**：模态窗会把急停那颗钮挡在后面，
         而报警恰恰是最需要人能马上按停的时候 -->
    <StackPanel DockPanel.Dock="Top" IsVisible="{Binding Alarms.Any}" Margin="8,0,8,6">
      <Border Background="{Binding Alarms.BarFillHex}" BorderBrush="{Binding Alarms.BarLineHex}"
              BorderThickness="1" CornerRadius="3" Height="32" Padding="10,0">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" Margin="0,0,8,0"
                  Background="{Binding Alarms.BarInkHex}" VerticalAlignment="Center">
            <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding Alarms.Text}" FontSize="12"
                     Foreground="{Binding Alarms.BarInkHex}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Classes="pill" Content="全部确认" Margin="8,0,6,0"
                  Command="{Binding Alarms.AckAll}" IsEnabled="{Binding Alarms.CanAckAll}"
                  ToolTip.Tip="确认不等于解除：条件还成立的仍然留在清单上" />
          <Button Grid.Column="3" Classes="pill" Content="{Binding Alarms.ToggleText}"
                  Command="{Binding Alarms.Toggle}" />
        </Grid>
      </Border>

      <!-- 展开的清单。每一条都要答四件事：出了什么、机器做了什么、多久了、有没有人管 -->
      <Border IsVisible="{Binding Alarms.Open}" Background="White" BorderBrush="#dcdcdc"
              BorderThickness="1,0,1,1" CornerRadius="0,0,3,3" MaxHeight="182">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Alarms.Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#f0f0f0" BorderThickness="0,0,0,1" Padding="10,7">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="2" Margin="0,4,8,0"
                            Background="{Binding ChColorHex}" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="{Binding ChLabel}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#3d3d3d" VerticalAlignment="Center" />
                        <Border CornerRadius="8" Height="16" Padding="7,0"
                                Background="{Binding StateFillHex}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                     Foreground="{Binding StateColorHex}" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="#8d8d8d"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding Message}" FontSize="12" Foreground="#2b2b2b"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding DidText}" FontSize="10.5" Foreground="#7a7a7a"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding AckText}" IsVisible="{Binding Acknowledged}"
                                 FontSize="10.5" Foreground="#2f8f49" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding CanAck}" VerticalAlignment="Top">
                      <TextBox Classes="finput" Width="188" Height="24"
                               Text="{Binding Note, Mode=TwoWay}"
                               Watermark="处理说明（选填，进记录）" />
                      <Button Classes="pill" Content="确认" Command="{Binding Ack}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </StackPanel>

    <!-- 执行记录抽屉（原型 .rundraw，贴在底部） -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#b9b9b9" BorderThickness="0,1,0,0" Background="White">
      <DockPanel>
        <!-- rdhead 32px -->
        <Border DockPanel.Dock="Top" Height="32" Background="Transparent" Cursor="Hand"
                PointerPressed="OnDrawHeadPressed">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,0" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="9" BorderBrush="#6b6b6b" BorderThickness="1.5">
              <ctl:TecIcon Key="ui-chev-up" Tint="#555555" Size="9"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="执行记录" FontSize="12" FontWeight="SemiBold" Foreground="#3d3d3d"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding DrawLast}" FontSize="12" Foreground="#8d8d8d"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding DrawCnt}" FontSize="11" Foreground="#8d8d8d"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding DrawOpen}" Height="268">
          <!-- rdtool -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,12,6">
            <TextBlock Text="通道" FontSize="11.5" Foreground="#444444" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Chips}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="chchip" Classes.on="{Binding On}"
                          PointerPressed="OnChipPressed" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="10" Height="10" Fill="{Binding ColorHex}" />
                      <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Width="1" />
            <TextBlock Text="排列" FontSize="11.5" Foreground="#444444" VerticalAlignment="Center"
                       Margin="12,0,0,0" />
            <ComboBox Classes="sel" Width="128" ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SortLabel, Mode=TwoWay}" />
            <CheckBox Content="含事件行" FontSize="12" IsChecked="{Binding WithEvents, Mode=TwoWay}"
                      MinHeight="0" VerticalAlignment="Center" />

            <!-- 手动标记：操作人在跑的途中记一笔（取样、投料、看到析晶）。
                 记录只追加不修改，所以标记就是这条通道记录链上的一条事件，
                 导出时跟步骤行一起走 -->
            <Border Width="1" Background="#e3e3e3" Margin="8,2" />
            <TextBlock Text="{Binding SelectedLabel}" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="#3d3d3d" VerticalAlignment="Center" />
            <TextBox Classes="finput" Width="240" Height="24" VerticalAlignment="Center"
                     Text="{Binding MarkText, Mode=TwoWay}"
                     Watermark="记一笔（取样 / 投料 / 观察到的现象）" />
            <Button Classes="pill" Content="记一笔" Command="{Binding Mark}"
                    IsEnabled="{Binding CanMark}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- rdtbl：11 列 -->
          <ScrollViewer Height="220">
            <StackPanel>
              <Grid Classes="rdhdr" ColumnDefinitions="64,30,*,72,72,72,72,72,72,84,64" Background="#f5f5f5">
                <TextBlock Grid.Column="0" Text="通道" />
                <TextBlock Grid.Column="1" Text="#" />
                <TextBlock Grid.Column="2" Text="步骤 / 事件" />
                <TextBlock Grid.Column="3" Text="计划开始" />
                <TextBlock Grid.Column="4" Text="实际开始" />
                <TextBlock Grid.Column="5" Text="开始偏差" />
                <TextBlock Grid.Column="6" Text="计划时长" />
                <TextBlock Grid.Column="7" Text="实际时长" />
                <TextBlock Grid.Column="8" Text="时长偏差" />
                <TextBlock Grid.Column="9" Text="结束原因" />
                <TextBlock Grid.Column="10" Text="操作人" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="rdrow" Classes.ev="{Binding IsEvent}" Classes.alarm="{Binding IsAlarm}"
                            Classes.sep="{Binding GroupSep}">
                      <Grid ColumnDefinitions="64,30,*,72,72,72,72,72,72,84,64">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                          <Border Width="8" Height="8" CornerRadius="2" Background="{Binding ChColorHex}"
                                  VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Ch, StringFormat='CH{0}'}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Seq}" Classes="num" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                          <Border Classes="rdbadge" Classes.al="{Binding IsAlarm}"
                                  Classes.evb="{Binding IsEvent}" IsVisible="{Binding HasBadge}">
                            <TextBlock Text="{Binding Badge}" FontSize="10" />
                          </Border>
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding PlanStart}" Classes="num" />
                        <TextBlock Grid.Column="4" Text="{Binding RealStart}" Classes="num" />
                        <TextBlock Grid.Column="5" Text="{Binding StartDev}" Classes="num"
                                   Classes.warn="{Binding StartDevClass, Converter={x:Static ctl:Is.Warn}}"
                                   Classes.bad="{Binding StartDevClass, Converter={x:Static ctl:Is.Bad}}" />
                        <TextBlock Grid.Column="6" Text="{Binding PlanDur}" Classes="num" />
                        <TextBlock Grid.Column="7" Text="{Binding RealDur}" Classes="num"
                                   Classes.run="{Binding Running}" />
                        <TextBlock Grid.Column="8" Text="{Binding DurDev}" Classes="num"
                                   Classes.warn="{Binding DurDevClass, Converter={x:Static ctl:Is.Warn}}"
                                   Classes.bad="{Binding DurDevClass, Converter={x:Static ctl:Is.Bad}}" />
                        <TextBlock Grid.Column="9" Text="{Binding EndBy}" />
                        <TextBlock Grid.Column="10" Text="{Binding User}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock IsVisible="{Binding NoRows}" Margin="0,22" TextAlignment="Center"
                         FontSize="12" Foreground="#9a9a9a"
                         Text="尚无执行记录。通道启动后，每一步与每一次操作都会实时记入此表。" />
            </StackPanel>
          </ScrollViewer>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- runbody。列宽随折叠状态在 RunView.axaml.cs 里算——
         ColumnDefinition 不在可视树上，绑不了 DataContext -->
    <Grid x:Name="Body" ColumnDefinitions="600,6,*,6,430,Auto" Margin="8,0,8,8">

      <!-- pane 台面总览 -->
      <Border Grid.Column="0" Classes="pane">
        <DockPanel>
          <Border DockPanel.Dock="Left" Classes="panetab">
            <StackPanel Spacing="10" Margin="0,8,0,0" HorizontalAlignment="Center">
              <Button Classes="collapse" Command="{Binding BenchPane.Toggle}" ToolTip.Tip="收起 / 展开">
                <ctl:TecIcon Key="ui-collapse" Tint="#555555" />
              </Button>
              <TextBlock Classes="vtxt" Text="台&#10;面&#10;总&#10;览" />
            </StackPanel>
          </Border>
          <DockPanel IsVisible="{Binding BenchPane.Open}">
            <!-- statusrow：按宿主设备分组。一台 RD-105 = 两路，摆一个框里，
                 「这两路共用一台机器」一眼看得见；但每一路自己启停 -->
            <Border DockPanel.Dock="Bottom" Height="178" BorderBrush="#dcdcdc" BorderThickness="0,1,0,0">
              <Panel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#dcdcdc" BorderThickness="0,0,1,0">
                          <DockPanel>
                            <!-- 设备头：这一框里的两路属于哪台机器 -->
                            <Border DockPanel.Dock="Top" Height="24" Background="#f4f4f4"
                                    BorderBrush="#e3e3e3" BorderThickness="0,0,0,1" Padding="9,0">
                              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="#3d3d3d" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Sub}" FontSize="10.5" Foreground="#9a9a9a"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Tiles}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Classes="stat" Classes.off="{Binding Off}"
                                          Classes.sel="{Binding IsSelected}" Width="140"
                                          Cursor="Hand" PointerPressed="OnTilePressed">
                                    <Grid ColumnDefinitions="12,Auto,*">
                                      <Border Grid.Column="0" Background="{Binding ColorHex}" />
                                      <TextBlock Grid.Column="1" Text="{Binding NameVertical}" FontSize="13"
                                                 FontWeight="Light" Foreground="#333333" Margin="2,8"
                                                 LineHeight="14" TextAlignment="Center" />

                                      <DockPanel Grid.Column="2" Margin="6,6,6,4">
                                        <!-- 这一路自己的四个操作。整机启停在菜单栏那排圆钮上 -->
                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                    Spacing="5" HorizontalAlignment="Center" Margin="0,4,0,0">
                                          <Button Classes="chbtn" Command="{Binding Start}"
                                                  IsEnabled="{Binding CanStart}" ToolTip.Tip="{Binding StartTip}">
                                            <ctl:TecIcon Key="ui-sim-play" Tint="#1f1f1f" Recolor="True" Size="10" />
                                          </Button>
                                          <Button Classes="chbtn" Command="{Binding PauseResume}"
                                                  IsEnabled="{Binding CanPause}" ToolTip.Tip="{Binding PauseTip}">
                                            <ctl:TecIcon Key="ui-sim-pause" Tint="#1f1f1f" Recolor="True" Size="10" />
                                          </Button>
                                          <Button Classes="chbtn" Command="{Binding Stop}"
                                                  IsEnabled="{Binding CanStop}" ToolTip.Tip="停止这一路">
                                            <ctl:TecIcon Key="ui-sim-stop" Tint="#1f1f1f" Recolor="True" Size="10" />
                                          </Button>
                                          <Button Classes="chbtn" Command="{Binding Skip}"
                                                  IsEnabled="{Binding CanSkip}" ToolTip.Tip="跳过当前步">
                                            <ctl:TecIcon Key="ui-sim-step" Tint="#1f1f1f" Recolor="True" Size="10" />
                                          </Button>
                                        </StackPanel>

                                        <!-- 状态一个词说清：待机 / 运行中 / 已暂停 / 已完成 / 故障 -->
                                        <Border DockPanel.Dock="Top" CornerRadius="9" Height="17" Padding="7,0"
                                                HorizontalAlignment="Left" Margin="0,0,0,4"
                                                Background="{Binding StateFillHex}">
                                          <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                                     Foreground="{Binding StateColorHex}"
                                                     VerticalAlignment="Center" />
                                        </Border>

                                        <!-- 停用：只写它是哪个孔（数据行留着全是「—」，看着像坏了） -->
                                        <TextBlock IsVisible="{Binding Off}" Text="{Binding HostLabel}"
                                                   FontSize="11" Foreground="#b0b0b0"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />

                                        <StackPanel IsVisible="{Binding On}" Spacing="2" VerticalAlignment="Top">
                                          <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="Tr" Classes="statk" /><TextBlock Text="{Binding TrText}" Classes="statv" />
                                          </StackPanel>
                                          <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="Tj" Classes="statk" /><TextBlock Text="{Binding TjText}" Classes="statv" />
                                          </StackPanel>
                                          <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="pH" Classes="statk" /><TextBlock Text="{Binding PhText}" Classes="statv" />
                                          </StackPanel>
                                          <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="搅拌" Classes="statk" /><TextBlock Text="{Binding RpmText}" Classes="statv" />
                                          </StackPanel>
                                          <TextBlock Text="{Binding StartLine}" FontSize="10.5" Foreground="#8d8d8d" />
                                          <TextBlock Text="{Binding StepNow}" FontSize="10" Foreground="#2f8f49"
                                                     TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                      </DockPanel>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock IsVisible="{Binding NoChannels}" FontSize="12" Foreground="#9a9a9a"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="台面上还没有通道。拖一台反应器进台面，这里就会出现它的通道。" />
              </Panel>
            </Border>
            <!-- deck -->
            <Border Background="#f7f7f7" ClipToBounds="True">
              <ctl:DeckView x:Name="Deck" Workspace="{Binding Workspace}" />
            </Border>
          </DockPanel>
        </DockPanel>
      </Border>

      <!-- pane 趋势曲线 -->
      <Border Grid.Column="2" Classes="pane">
        <DockPanel>
          <Border DockPanel.Dock="Left" Classes="panetab">
            <StackPanel Spacing="10" Margin="0,8,0,0" HorizontalAlignment="Center">
              <Button Classes="collapse" Command="{Binding TrendPane.Toggle}" ToolTip.Tip="收起 / 展开">
                <ctl:TecIcon Key="ui-collapse" Tint="#555555" />
              </Button>
              <TextBlock Classes="vtxt" Text="趋&#10;势&#10;曲&#10;线" />
            </StackPanel>
          </Border>
          <DockPanel IsVisible="{Binding TrendPane.Open}">
            <!-- 原型 .trend-tool 是 flex-wrap:wrap：窗口一窄图例换行，不是被切掉 -->
            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,4">
              <TextBlock Text="通道" FontSize="12" Foreground="#444444" VerticalAlignment="Center"
                         Margin="0,0,10,0" />
              <ComboBox Classes="sel" Width="104" Margin="0,0,10,0" ItemsSource="{Binding TrendChannels}"
                        SelectedItem="{Binding TrendChLabel, Mode=TwoWay}" />
              <TextBlock Text="窗口" FontSize="12" Foreground="#444444" VerticalAlignment="Center"
                         Margin="4,0,10,0" />
              <ComboBox Classes="sel" Width="118" Margin="0,0,10,0" ItemsSource="{Binding TrendWins}"
                        SelectedItem="{Binding TrendWinLabel, Mode=TwoWay}" />
              <!-- 存 PNG。不是截屏：另排一份带实验名 / 通道 / 时间范围的图，
                   图离开程序之后就只剩那几行字能解释它 -->
              <Button Classes="pill" Content="导出图片" Margin="0,0,14,0" Command="{Binding ExportTrend}"
                      IsEnabled="{Binding CanExportTrend}" ToolTip.Tip="{Binding ExportTrendTip}"
                      VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                <Border Width="14" Height="3" CornerRadius="2" Background="#e02020" VerticalAlignment="Center" />
                <TextBlock Text="Tr 釜内" FontSize="11" Foreground="#444444" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                <Border Width="14" Height="3" CornerRadius="2" Background="#3f6fd8" VerticalAlignment="Center" />
                <TextBlock Text="Tj 夹套" FontSize="11" Foreground="#444444" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
                <Border Width="14" Height="3" CornerRadius="2" Background="#b56cc9" VerticalAlignment="Center" />
                <TextBlock Text="Tr−Tj" FontSize="11" Foreground="#444444" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                          IsVisible="{Binding TrendHasPh}">
                <Border Width="14" Height="3" CornerRadius="2" Background="#2f8f49" VerticalAlignment="Center" />
                <TextBlock Text="pH" FontSize="11" Foreground="#444444" />
              </StackPanel>
            </WrapPanel>
            <Panel>
              <ctl:TrendView Model="{Binding Trend}" IsVisible="{Binding !TrendEmpty}" />
              <TextBlock IsVisible="{Binding TrendEmpty}" Text="{Binding TrendEmptyText}"
                         FontSize="12" Foreground="#9a9a9a" TextAlignment="Center"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </DockPanel>
        </DockPanel>
      </Border>

      <!-- pane 步骤甘特 -->
      <Border Grid.Column="4" Classes="pane">
        <DockPanel>
          <Border DockPanel.Dock="Left" Classes="panetab">
            <StackPanel Spacing="10" Margin="0,8,0,0" HorizontalAlignment="Center">
              <Button Classes="collapse" Command="{Binding GanttPane.Toggle}" ToolTip.Tip="收起 / 展开">
                <ctl:TecIcon Key="ui-collapse" Tint="#555555" />
              </Button>
              <TextBlock Classes="vtxt" Text="步&#10;骤&#10;进&#10;度" />
            </StackPanel>
          </Border>
          <DockPanel IsVisible="{Binding GanttPane.Open}">
            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,4">
              <ComboBox Classes="sel" Width="104" FontSize="11" Margin="0,0,10,0"
                        ItemsSource="{Binding AlignOptions}" SelectedItem="{Binding AlignLabel, Mode=TwoWay}" />
              <CheckBox Content="显示时间" FontSize="12" Margin="0,0,10,0"
                        IsChecked="{Binding ShowTime, Mode=TwoWay}"
                        MinHeight="0" VerticalAlignment="Center" />
              <!-- 运行中改参数：改的是选中那一路的**这一趟**，基线不动 -->
              <Button Classes="pill" Content="改参数" Margin="0,0,10,0" Command="{Binding OpenEdit}"
                      IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Binding EditTip}"
                      VerticalAlignment="Center" />
              <TextBlock Text="{Binding GTotal}" FontSize="11" Foreground="#5a5a5a"
                         Margin="0,0,10,0" VerticalAlignment="Center" />
              <TextBlock Text="淡 = 计划，实 = 实际" FontSize="11" Foreground="#9a9a9a"
                         VerticalAlignment="Center" />
            </WrapPanel>
            <Panel>
              <ScrollViewer IsVisible="{Binding !NoChannels}">
                <ctl:GanttView Model="{Binding Gantt}" />
              </ScrollViewer>
              <TextBlock IsVisible="{Binding NoChannels}" FontSize="12" Foreground="#9a9a9a"
                         TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="没有通道，也就没有进度可排。" />
            </Panel>
          </DockPanel>
        </DockPanel>
      </Border>

      <!-- 运行中改参数（FR-5.5 / §7.6）。开着才占位置，关了整列收成 0。
           改的是这一趟：基线不动、偏差照常按基线算，改动逐条进执行记录 -->
      <Border Grid.Column="5" Classes="pane" Width="326" Margin="6,0,0,0"
              IsVisible="{Binding Edit.Open}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource ThemeFill}"
                  BorderBrush="{StaticResource ThemeLine}" BorderThickness="0,0,0,1" Padding="12,9">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{Binding Edit.Title}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="#3d3d3d" />
                <TextBlock Text="基线不动，偏差照常按基线算；改动进执行记录"
                           FontSize="10.5" Foreground="#7a7a7a" />
              </StackPanel>
              <Button Grid.Column="1" Classes="collapse" Command="{Binding Edit.Close}"
                      VerticalAlignment="Top" ToolTip.Tip="收起">
                <ctl:TecIcon Key="ui-collapse" Tint="#555555" />
              </Button>
            </Grid>
          </Border>

          <!-- 底部：修改原因 + 应用。原因必填——一条没有理由的运行中改参数，
               事后没有任何人能解释它，而审计要的正是那句话 -->
          <Border DockPanel.Dock="Bottom" Background="{StaticResource ThemeFill}"
                  BorderBrush="{StaticResource ThemeLine}" BorderThickness="0,1,0,0" Padding="12,9">
            <StackPanel Spacing="7">
              <TextBlock Text="修改原因（必填）" FontSize="11.5" Foreground="#3d3d3d" />
              <TextBox Classes="finput" Height="24" Text="{Binding Edit.Reason, Mode=TwoWay}"
                       Watermark="例如：实测放热偏大，降 5 ℃" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button Classes="btn primary" Content="应用" Height="26" MinWidth="0" Padding="18,0"
                        Command="{Binding Edit.Apply}" IsEnabled="{Binding Edit.CanApply}"
                        ToolTip.Tip="{Binding Edit.ApplyTip}" />
                <Button Classes="btn" Content="还原" Height="26" MinWidth="0" Padding="14,0"
                        Command="{Binding Edit.Revert}" ToolTip.Tip="把编辑框拨回现在实际在跑的那一份" />
              </StackPanel>
            </StackPanel>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10">

              <!-- 挑一步。每一行都写清「改了什么时候生效」——同一个改动落在
                   当前步、后面某一步、已经跑过的一步上，结果完全不同 -->
              <TextBlock Text="本趟的步骤" FontSize="11.5" Foreground="#3d3d3d" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding Edit.Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="hstep" Classes.sel="{Binding IsSelected}"
                            Classes.no="{Binding !CanEdit}" Cursor="Hand"
                            PointerPressed="OnHotStepPressed">
                      <Grid ColumnDefinitions="4,22,*,Auto">
                        <Border Grid.Column="0" Background="{Binding ColorHex}" CornerRadius="2"
                                Margin="0,1,7,1" />
                        <TextBlock Grid.Column="1" Text="{Binding Seq}" FontSize="11"
                                   Foreground="#8d8d8d" VerticalAlignment="Center"
                                   TextAlignment="Right" Margin="0,0,7,0" />
                        <StackPanel Grid.Column="2" Spacing="1">
                          <TextBlock Text="{Binding Title}" FontSize="11.5" Foreground="#2b2b2b"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Effect}" FontSize="10" Foreground="#8d8d8d"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="3" CornerRadius="7" Height="15" Padding="6,0"
                                Margin="6,0,0,0" IsVisible="{Binding HasBadge}"
                                Background="{Binding BadgeFillHex}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Badge}" FontSize="10"
                                     Foreground="{Binding BadgeInkHex}" VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock IsVisible="{Binding Edit.NoSteps}" FontSize="11.5" Foreground="#9a9a9a"
                         TextWrapping="Wrap" Margin="0,6"
                         Text="这一趟没有可改的步骤。" />

              <!-- 选中那一步的参数表。表单由 schema 渲染，与配方页同一套 -->
              <StackPanel IsVisible="{Binding Edit.HasSelection}" Margin="0,12,0,0">
                <Border Height="1" Background="{StaticResource ThemeLine}" Margin="0,0,0,10" />

                <Border Background="#fdf4f3" BorderBrush="#e0b4ad" BorderThickness="1" CornerRadius="3"
                        Padding="9,7" Margin="0,0,0,9" IsVisible="{Binding Edit.IsBlocked}">
                  <TextBlock Text="{Binding Edit.BlockedText}" FontSize="11" Foreground="#c0392b"
                             TextWrapping="Wrap" LineHeight="17" />
                </Border>

                <Border Background="{StaticResource ThemeFill}" CornerRadius="3" Padding="9,7"
                        Margin="0,0,0,10">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="基线" Classes="hk" />
                      <TextBlock Text="{Binding Edit.BaselineText}" Classes="hv" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Edit.Amended}">
                      <TextBlock Text="现行" Classes="hk" />
                      <TextBlock Text="{Binding Edit.CurrentText}" Classes="hv" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="改为" Classes="hk" />
                      <TextBlock Text="{Binding Edit.NextText}" Classes="hv" Foreground="#1f4e79" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <ContentControl Content="{Binding Edit.Form}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate><local:SchemaFormView /></DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <TextBlock IsVisible="{Binding Edit.HasTableNote}" Text="{Binding Edit.TableNote}"
                           FontSize="10.5" Foreground="#8d8d8d" LineHeight="16"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>

  <UserControl.Styles>
    <Style Selector="Border.pane">
      <Setter Property="BorderBrush" Value="#b9b9b9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="Border.panetab">
      <Setter Property="Width" Value="28" />
      <Setter Property="Background" Value="#f4f4f4" />
      <Setter Property="BorderBrush" Value="#dcdcdc" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="TextBlock.vtxt">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Light" />
      <Setter Property="Foreground" Value="#3d3d3d" />
      <Setter Property="LineHeight" Value="17" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- 收起 / 展开：20px 圆圈 + 箭头，与属性面板那些折叠头同款 -->
    <Style Selector="Button.collapse">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#6b6b6b" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.collapse:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e8f2fb" />
      <Setter Property="BorderBrush" Value="#1a7fc4" />
    </Style>

    <Style Selector="Border.stat">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#dcdcdc" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.stat.off">
      <Setter Property="Background" Value="#f4f4f4" />
    </Style>
    <Style Selector="Border.stat:pointerover">
      <Setter Property="Background" Value="#f2f8fd" />
    </Style>
    <!-- 选中态：与全程一套（实线边 + 底色）。这条要排在 :pointerover 后面——
         同权重后写的赢，写在前面的话鼠标一悬停选中态就被盖掉，看着像选丢了 -->
    <Style Selector="Border.stat.sel, Border.stat.sel:pointerover">
      <Setter Property="Background" Value="#e8f2fb" />
      <Setter Property="BorderBrush" Value="#1a7fc4" />
      <Setter Property="BorderThickness" Value="0,2,1,0" />
    </Style>
    <!-- 磁贴上那一路自己的操作钮：20px 圆圈，比底部工具条那排小一号 -->
    <Style Selector="Button.chbtn">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#6b6b6b" />
      <Setter Property="BorderThickness" Value="1.4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e8f2fb" />
      <Setter Property="BorderBrush" Value="#1a7fc4" />
    </Style>
    <!-- 按不了的时候还是一个圈，只是淡下去；缺省禁用样式会把描边抹掉，剩一块灰饼 -->
    <Style Selector="Button.chbtn:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#fafafa" />
      <Setter Property="BorderBrush" Value="#d2d2d2" />
    </Style>
    <Style Selector="Button.chbtn:disabled">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- 改参数面板：步骤行 + 基线/现行/改为三行 -->
    <Style Selector="Border.hstep">
      <Setter Property="Padding" Value="5,5" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#ececec" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.hstep:pointerover">
      <Setter Property="Background" Value="#f2f8fd" />
    </Style>
    <!-- 选中态排在 :pointerover 后面：同权重后写的赢，写前面一悬停就被盖掉 -->
    <Style Selector="Border.hstep.sel, Border.hstep.sel:pointerover">
      <Setter Property="Background" Value="#e8f2fb" />
      <Setter Property="BorderBrush" Value="#1a7fc4" />
    </Style>
    <!-- 改不了的那几步淡下去，但仍然摆在表上：知道它在、知道为什么改不了，
         比让它凭空消失强 -->
    <Style Selector="Border.hstep.no">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TextBlock.hk">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="#8d8d8d" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBlock.hv">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="#3d3d3d" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="15" />
    </Style>

    <Style Selector="TextBlock.statk">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#666666" />
      <Setter Property="MinWidth" Value="24" />
    </Style>
    <Style Selector="TextBlock.statv">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#333333" />
    </Style>

    <Style Selector="Border.chchip">
      <Setter Property="BorderBrush" Value="#d5d5d5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="8,5,12,5" />
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="Border.chchip.on">
      <Setter Property="BorderBrush" Value="#1a7fc4" />
      <Setter Property="Background" Value="#e8f2fb" />
    </Style>

    <Style Selector="Grid.rdhdr > TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#5a5a5a" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Border.rdrow">
      <Setter Property="BorderBrush" Value="#f0f0f0" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.rdrow.ev">
      <Setter Property="Background" Value="#fafafa" />
    </Style>
    <Style Selector="Border.rdrow.alarm">
      <Setter Property="Background" Value="#fdf4f3" />
    </Style>
    <Style Selector="Border.rdrow.sep">
      <Setter Property="BorderBrush" Value="#d5d5d5" />
      <Setter Property="BorderThickness" Value="0,1,0,1" />
    </Style>
    <Style Selector="Border.rdrow TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#2b2b2b" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.rdrow.ev TextBlock">
      <Setter Property="Foreground" Value="#7a7a7a" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="Border.rdrow.alarm TextBlock">
      <Setter Property="Foreground" Value="#c0392b" />
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="#a8710a" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="#c0392b" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.run">
      <Setter Property="Foreground" Value="#2f8f49" />
    </Style>

    <Style Selector="Border.rdbadge">
      <Setter Property="Height" Value="15" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Background" Value="#eef4e9" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.rdbadge > TextBlock">
      <Setter Property="Foreground" Value="#2f8f49" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.rdbadge.evb">
      <Setter Property="Background" Value="#eeeeee" />
    </Style>
    <Style Selector="Border.rdbadge.evb > TextBlock">
      <Setter Property="Foreground" Value="#6b6b6b" />
    </Style>
    <Style Selector="Border.rdbadge.al">
      <Setter Property="Background" Value="#fbe6e3" />
    </Style>
    <Style Selector="Border.rdbadge.al > TextBlock">
      <Setter Property="Foreground" Value="#c0392b" />
    </Style>
  </UserControl.Styles>
</UserControl>
