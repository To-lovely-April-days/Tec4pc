<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             xmlns:v="clr-namespace:Tec.App.Views"
             x:Class="Tec.App.Views.RecipeView"
             Focusable="True" KeyDown="OnKeyDown">

  <!--
    左侧步骤库和中间的编辑区照 iControl 6.2 那份原型改：
    步骤库 259 + 1px 分界 ｜ 流程区 ｜ 属性 342（属性栏不动，仍是台面页那一套）。

    左侧色条一律 6px。全程序用到这条「左边一道色条 = 这一块属于谁」的地方
    一共四处，从前各写各的（12 / 11 / 6 / 4），同一个说法四个粗细：
      · 配方页 步骤卡（原型 .step .sbar 11）
      · 配方页 / 台面页 属性块          ← 6，基准就是它
      · 运行页 通道磁贴（12）
      · 运行页 热编辑步骤行（4）
    旁边那些 12×12 的小色块是另一回事（色卡，不是色条），不在此列。
    步骤库的分组从整块色底改成了「3×11 的一小截色记号」，也不在此列。
  -->
  <Grid ColumnDefinitions="240,*,288">

    <!-- ══ 左：步骤库 ══
         原型是一栏 259 宽的白列：24px 深色标题条 + 35px 搜索行 + 一条条 23px 的
         指令行（15px 红方块图标 + 13px 指令名），组与组之间一条 1px 分隔线。

         从「6 个 96px 的分组块 + 3 列 48px 图标格」换成平铺细行，是因为
         21 条指令铺成细行一屏就放得下（原来六组展开要滚三屏）。代价是
         48px 的彩色插画退到了步骤卡和属性栏，库里改用红底白线的小方块——
         48 缩到 15 那种多色带阴影的图会糊成一团，两处本来就不该是同一张图。 -->
    <!-- 栏底纯白、不画右分界线：中列左边留的那 6px 白缝就是分界。
         从前是 #fdfdfd 加一条 #c9c9c9 —— 白缝旁边摆一条比它暗一丝的近白色，
         那一丝差别正好落在「看得出不一样又说不出为什么」那个区间 -->
    <Border Grid.Column="0" Background="White">
      <DockPanel>
        <!-- 搜索行：平时不占位，点分组头右端那枚放大镜才展开（SearchOpen）。
             21 条指令分在 6 个模块里，多数时候用不着搜；记不住「梯度控温」
             在哪一组的时候，打两个字比挨组翻快。指令名和模块名两处都匹配：
             打「温度」也该把那一组捞出来。
             Dock 在上而不是塞进 ScrollViewer：搜着搜着往下滚，框还在眼前 -->
        <Border DockPanel.Dock="Top" Height="35" Background="#f1f1f1"
                BorderBrush="#cfcfcf" BorderThickness="0,0,0,1" Padding="9,0"
                IsVisible="{Binding SearchOpen}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Name="LibFind" Classes="lfind" Watermark="搜索指令 / 模块"
                     Text="{Binding LibFilter, Mode=TwoWay}" />
            <Button Grid.Column="1" Classes="lfindx" Margin="6,0,0,0"
                    Command="{Binding ToggleSearch}" ToolTip.Tip="收起搜索">
              <TextBlock Text="✕" FontSize="10" Foreground="#6b6f74"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>
        </Border>

        <!-- 底部那截留白写在内容的 Margin 上，不写 ScrollViewer 的 Padding：
             Padding 是从可视区里扣的，不进滚动范围——最后一行会卡在下边缘，
             滚到底也露不出来 -->
        <ScrollViewer>
          <!-- 上边距必须是 0：中列的工具条是从栏顶第 0 行开始画的，
               这里留 6 的话第一个分组块比工具条低一截，两栏顶不在一条线上 -->
          <StackPanel Margin="0,0,0,18">
            <TextBlock Text="没有匹配的指令" FontSize="12" Foreground="#959a9f"
                       Margin="12,8,0,0" IsVisible="{Binding LibEmpty}" />
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- 一个模块 = 一块 #eeefec，左边一条 6px 模块色条贯通整块
                       （收起时就是那 52px，展开了连指令格一起包），块与块之间 2px 白缝 -->
                  <Border Classes="dev" Margin="0,0,0,8" IsVisible="{Binding Visible}">
                    <Grid ColumnDefinitions="6,*">
                      <Border Grid.Column="0" Background="{Binding Color}" />
                      <StackPanel Grid.Column="1">
                        <!-- 组头 52 高。原型那条是 96——那是给 23px 拉丁字留的，
                             中文组名到 15px 就够，96 高只剩空白，六组一收起
                             就吃掉 588px。52 之后六组全收起只占 354 -->
                        <Border Classes="devhd" Height="52" Cursor="Hand"
                                PointerPressed="OnGroupBarPressed">
                          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="12,0,6,0">
                            <Border Grid.Column="0" Classes="exp3m" Classes.up="{Binding Open}">
                              <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" Size="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15"
                                       FontWeight="Light" Foreground="#3a3d41"
                                       VerticalAlignment="Center" Margin="11,0,0,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Commands.Count}"
                                       FontSize="10.5" Foreground="#9aa0a6"
                                       VerticalAlignment="Center" />
                            <!-- 放大镜。库的抬头拆掉之后，搜索没有别的地方落脚了，
                                 就落在组头这一行的右端——每组都有一枚，点哪一枚
                                 都是开同一个搜索框（搜的是整个库，不是这一组） -->
                            <Button Grid.Column="3" Classes="gfind" ToolTip.Tip="搜索指令 / 模块"
                                    Click="OnFindToggle">
                              <ctl:TecIcon Key="ui-search" Tint="#9aa0a6" Size="13" />
                            </Button>
                          </Grid>
                        </Border>

                        <!-- 指令格：2 列 × 46 高，27px 红方块 + 指令名。
                             栏宽 259 减去色条和左右各 6，指令区净 241，两列每格 120——
                             名字那半格净 76，最长的「溶解度点测定」6 个字 69px 排得下 -->
                        <ItemsControl ItemsSource="{Binding Commands}" IsVisible="{Binding Open}"
                                      Margin="6,0,6,8">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Classes="cmd2"
                                      ToolTip.Tip="点一下加到当前通道，按住拖到画布里指定位置"
                                      Command="{Binding $parent[UserControl].DataContext.AddStep}"
                                      CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="7"
                                            VerticalAlignment="Center">
                                  <!-- 方块底是 Border、图标铺在上面，不是给 TecIcon 加描边：
                                       原型那张图的白线本来就画到方块边上，
                                       用 BorderThickness 装它会把线切掉一圈 -->
                                  <Panel Classes="tile27" VerticalAlignment="Center">
                                    <Border Classes="tilebg27" Background="{Binding TileBrush}" />
                                    <ctl:TecIcon Key="{Binding TileIcon}" Size="27"
                                                 Tint="{Binding TileTint}" />
                                  </Panel>
                                  <TextBlock Text="{Binding Name}" FontSize="11.5"
                                             Foreground="#373a3e" LineHeight="15"
                                             TextWrapping="Wrap" MaxLines="2"
                                             TextTrimming="CharacterEllipsis"
                                             VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ══ 中：工具条 + 一键复制 + 校验 + 泳道（原型 .procwrap）══
         左右各留 6px 白缝。6 跟属性栏左边那条色条一个厚度，也跟菜单栏
         底下那条白缝一个厚度——全程序「这里断开」只用一个尺寸说。
         右边：工具条那条面色一直铺到属性栏跟前，而属性栏用的是同一支面色，
         不留缝两块就连成一片。左边：步骤库的分组块也是这支面色，同理。 -->
    <Border Grid.Column="1" Background="White" Padding="6,0,6,0">
    <DockPanel>

      <!-- 原型 .proctool：面色一条整的、34px 圆钮。
           58 → 48：里面最高的是 34 的圆钮，58 上下各空 12，白留得太多 -->
      <Border DockPanel.Dock="Top" Height="48" Background="{StaticResource ThemeFill}">
        <!-- 圆钮之间 4（不是 8）：GBG 那排工具钮几乎是挨着的，一排读成一组；
             8 的时候每颗都像独立的一件东西 -->
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="14,0" VerticalAlignment="Center">
          <TextBlock Text="配方：" Classes="lbl" Margin="0,0,4,0" />
          <ComboBox Classes="sel" Width="246" ItemsSource="{Binding Lanes}"
                    SelectedItem="{Binding CurLane, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding LaneName}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="tbtn" ToolTip.Tip="新建：把当前通道清成空配方"
                  Command="{Binding NewRecipe}" IsEnabled="{Binding HasLanes}">
            <ctl:TecIcon Key="ui-bar-plus" />
          </Button>
          <Button Classes="tbtn" ToolTip.Tip="撤销（当前通道）"
                  Command="{Binding Undo}" IsEnabled="{Binding CanUndo}">
            <ctl:TecIcon Key="ui-bar-undo" />
          </Button>
          <Button Classes="tbtn" ToolTip.Tip="重做（当前通道）"
                  Command="{Binding Redo}" IsEnabled="{Binding CanRedo}">
            <ctl:TecIcon Key="ui-bar-redo" />
          </Button>
          <Border Width="1" Height="22" Background="#cdcfcd" Margin="4,0" />
          <Button Classes="tbtn" ToolTip.Tip="导入配方文件到当前通道（.tecrecipe）"
                  Command="{Binding ImportRecipe}" IsEnabled="{Binding HasLanes}">
            <ctl:TecIcon Key="ui-snav-import" />
          </Button>
          <Button Classes="tbtn" ToolTip.Tip="把当前通道的配方导出成文件（.tecrecipe）"
                  Command="{Binding ExportRecipe}" IsEnabled="{Binding HasLanes}">
            <ctl:TecIcon Key="ui-snav-export" />
          </Button>
          <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="11"
                     Foreground="#666a6f" VerticalAlignment="Center" Margin="6,0,0,0"
                     TextTrimming="CharacterEllipsis" MaxWidth="330" />
        </StackPanel>
      </Border>

      <!-- 工具条与 copybar 之间的白缝，6px，同全程序那一个尺寸。
           跟 copybar 一起显隐：没有通道时 copybar 不在，这条缝也不该单独留着 -->
      <Border DockPanel.Dock="Top" Height="6" Background="White"
              IsVisible="{Binding HasLanes}" />

      <!-- copybar（原型 .bar2）：左边一键复制，右端一枚校验 chip。
           #f6f7f9 比工具条那条面色浅一档（跟着面色一起转的冷调，
           别留回原来那支暖灰 #f5f5f4，两条带子会一暖一冷）——分得出层次，
           chip 的 hover / 展开态才有白底可反白（白条上反白等于没反应）。

           校验并进这一行、不另立一条：它不是一块常驻内容，是一枚状态灯。
           从前那条校验条摊在画布上头，问题一多就把泳道往下顶，
           越是有问题越看不见配方——正好跟它的目的相反 -->
      <!-- 底下那条 1px 分隔线去掉：copybar 自己就是一条跟白画布不同色的带子，
           边界已经由色差交代清楚了，再描一条线是同一件事说两遍 -->
      <Border DockPanel.Dock="Top" Background="#f6f7f9"
              IsVisible="{Binding HasLanes}" Padding="14,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ctl:TecIcon Key="ui-copybar" />
            <TextBlock Classes="lbl">
              <Run Text="把 " /><Run Text="{Binding CurName}" FontWeight="SemiBold" /><Run Text=" 的配方复制到" />
            </TextBlock>
            <ComboBox Classes="sel" Width="130" ItemsSource="{Binding CopyTargets}"
                      SelectedItem="{Binding CopyTarget, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- 从「一键复制」那颗品牌红方钮换成圆钮一族的 26 号：这一句话本身
                 （把 X 的配方复制到 [通道]）已经把动作说完了，钮只是那个动词；
                 一块红方块杵在冷灰带子上，比它旁边真正要读的那句话还抢眼。
                 字挪进 ToolTip，图标用复制记号 ui-foot-dup —— 跟属性栏那颗
                 「复制设备」同一个记号，同一件事 -->
            <Button Classes="tbtn d26" Command="{Binding CopyRecipe}"
                    ToolTip.Tip="一键复制：把当前通道的配方复制到所选通道">
              <ctl:TecIcon Key="ui-foot-dup" Size="12" />
            </Button>
            <TextBlock Text="各通道配方可独立编辑，互不影响" FontSize="12" Foreground="#888d92"
                       VerticalAlignment="Center" />
          </StackPanel>

          <!-- 校验 chip（原型 .vchip）：没问题时是一枚绿灯，也照常摆着——
               「没报错」和「没校验」不是一回事，空着说不清是哪种 -->
          <Button Grid.Column="2" Classes="vchip" Classes.open="{Binding PanelOpen}"
                  Command="{Binding TogglePanel}" IsEnabled="{Binding HasProblems}">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <!-- 三盏灯回到 7px 实心小点（照参考稿）。这里跟步骤卡上的徽记不一样：
                   卡片上那枚圆「!」是钉在某一步上的，得说清严重度；
                   chip 是一行汇总，点后面紧跟着「2 错误」四个字，
                   严重度由字说了，点只管配色——摆一排圆圈反而比字还抢眼 -->
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                          IsVisible="{Binding PanelEmptyAll}">
                <Border Classes="cdot" Background="#0E7A3E" />
                <TextBlock Classes="ctxt" Text="校验通过" Foreground="#0E7A3E" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                          IsVisible="{Binding HasErrors}">
                <Border Classes="cdot" Background="#C42B1C" />
                <TextBlock Classes="ctxt" Text="{Binding ErrorText}" Foreground="#C42B1C" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                          IsVisible="{Binding HasWarns}">
                <!-- 琥珀点配深棕字：#DA9E00 当字色在白底上读不动，
                     所以点用琥珀、字用它压到 #4A3200 的那一档 -->
                <Border Classes="cdot" Background="#DA9E00" />
                <TextBlock Classes="ctxt" Text="{Binding WarnText}" Foreground="#4A3200" />
              </StackPanel>
              <!-- 「多久 · 几步」跟问题无关，隔一条竖线自己占一段 -->
              <Border Width="1" Height="15" Background="#E5E5E5" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ScaleText}" FontSize="12.5" Foreground="#8A8A8A"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding PanelArrow}" FontSize="10" Foreground="#8A8A8A"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- 画布 + 浮在画布上的校验面板。面板浮着不占位：它一展开就把泳道挤扁的话，
           人一边看清单一边找那一步，找的过程里版面又变一次 -->
      <Panel>
      <!-- 画布行（原型 .canvasrow）：左缘一条「变量」竖栏 + 6px 白缝 + 泳道区。
           原型 Process 视图左缘是三条竖栏（Variables / Startup / Shutdown），
           我们要的只有变量这一件事，就一条。

           收起态的尺寸照**运行页那三条收起来的竖栏**（Border.panetab）走：
           28 宽、15px 竖排字。同一个部件在两页不该是两个宽度。
           从前这里是 64 / 17px——那是照原型 .vcol 定的，可原型那三条并排
           才有 64 的道理，我们只有一条。

           白缝 8 → 6：跟属性栏那条色条、菜单栏底下那条缝一个厚度。
           右侧那条 1px 分界线去掉——白缝就是分界，不用再画一条。 -->
      <Grid ColumnDefinitions="Auto,6,*">

        <!-- 收起态：点整条都能展开。
             上边距 14 跟泳道那一摞对齐（ItemsControl Margin 的第二个数），
             两边的块顶在同一条水平线上起 -->
        <Border Grid.Column="0" Width="28" Background="{StaticResource PropsBg}"
                Margin="0,14,0,0" VerticalAlignment="Stretch"
                IsVisible="{Binding VarsClosed}" Cursor="Hand"
                PointerPressed="OnVarsBarPressed">
          <StackPanel Margin="0,8,0,0" Spacing="10" HorizontalAlignment="Center">
            <Border Classes="exp3" Width="20" Height="20" CornerRadius="10">
              <!-- 收起时箭头指右（原型 .vcol 的朝向）：down 逆时针转 90° -->
              <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                <LayoutTransformControl.LayoutTransform>
                  <RotateTransform Angle="-90" />
                </LayoutTransformControl.LayoutTransform>
                <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" />
              </LayoutTransformControl>
            </Border>
            <!-- 竖排组名：汉字一个个正着摞下来，不是把整行转 90°。
                 原型那条竖栏写的是 Variables，拉丁字母转着读没问题；
                 汉字转 90° 就是躺倒的字，读起来像坏了（原来就是转的） -->
            <TextBlock Text="变&#x0a;量" FontSize="15" FontWeight="Light"
                       Foreground="#3a3d41" LineHeight="17" TextAlignment="Center"
                       HorizontalAlignment="Center" />
            <!-- 角标在 28 宽的栏里只剩 26 净宽，左右内边距收到 4 才装得下两位数 -->
            <Border Background="#d7d9d6" CornerRadius="8" Padding="4,2"
                    HorizontalAlignment="Center" IsVisible="{Binding HasVarsBadge}">
              <TextBlock Text="{Binding VarsBadge}" FontSize="10.5" Foreground="#3a3d41" />
            </Border>
          </StackPanel>
        </Border>

        <!-- 展开态：变量表。行编辑直接写回配方，撤销 / 校验与步骤参数同一套。
             上边距与收起态、与泳道那一摞同为 14：开合之间块顶不该跳一下 -->
        <Border Grid.Column="0" Width="332" Background="{StaticResource PropsBg}"
                Margin="0,14,0,0" VerticalAlignment="Stretch"
                IsVisible="{Binding VarsOpen}">
          <DockPanel Margin="12,10,12,10">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12">
              <Border Classes="exp3" Cursor="Hand" PointerPressed="OnVarsBarPressed"
                      Background="Transparent">
                <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                  <LayoutTransformControl.LayoutTransform>
                    <RotateTransform Angle="90" />
                  </LayoutTransformControl.LayoutTransform>
                  <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" />
                </LayoutTransformControl>
              </Border>
              <TextBlock Text="变量" FontSize="17" FontWeight="Light" Foreground="#3a3d41"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding CurName}" FontSize="11" Foreground="#959a9f"
                         VerticalAlignment="Center" />
            </StackPanel>

            <!-- 底部：添加 + 用法说明 -->
            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
              <Button Classes="btn" Content="＋ 添加变量" Command="{Binding AddVar}"
                      IsEnabled="{Binding HasLanes}" HorizontalAlignment="Left" />
              <TextBlock FontSize="11" Foreground="#959a9f" LineHeight="16" TextWrapping="Wrap"
                         Text="变量用在：循环开始与等待的「按条件」、设定变量。条件里还能读实时量 Tr / Tj / pH / 浊度 / rpm。" />
            </StackPanel>

            <ScrollViewer>
              <StackPanel Margin="0,10,0,0" Spacing="4">
                <TextBlock Text="这条配方还没有变量" FontSize="12" Foreground="#959a9f"
                           IsVisible="{Binding NoVars}" Margin="2,4,0,0" />
                <!-- 表头 -->
                <Grid ColumnDefinitions="82,58,46,*,26" Margin="2,0,0,2"
                      IsVisible="{Binding !NoVars}">
                  <TextBlock Grid.Column="0" Text="名称" FontSize="10.5" Foreground="#858a8f" />
                  <TextBlock Grid.Column="1" Text="初值" FontSize="10.5" Foreground="#858a8f" />
                  <TextBlock Grid.Column="2" Text="单位" FontSize="10.5" Foreground="#858a8f" />
                  <TextBlock Grid.Column="3" Text="说明" FontSize="10.5" Foreground="#858a8f" />
                </Grid>
                <ItemsControl ItemsSource="{Binding VarRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="82,58,46,*,26" Margin="0,0,0,4">
                        <TextBox Grid.Column="0" Classes="vcell" Text="{Binding Name, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Classes="vcell" Text="{Binding InitText, Mode=TwoWay}"
                                 Margin="4,0,0,0" />
                        <TextBox Grid.Column="2" Classes="vcell" Text="{Binding Unit, Mode=TwoWay}"
                                 Margin="4,0,0,0" />
                        <TextBox Grid.Column="3" Classes="vcell" Text="{Binding NoteText, Mode=TwoWay}"
                                 Margin="4,0,0,0" />
                        <!-- 24 是这一格的硬上限：第 5 列写死 26，再让出按钮自己的 2px 左边距。
                             要放 32 得把表头（上面那个 Grid）和行模板两处列宽一起改，
                             「说明」列会从 81 掉到 73，行高还会被顶高 6px -->
                        <Button Grid.Column="4" Classes="tbtn del d24" Margin="2,0,0,0"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                ToolTip.Tip="删除该变量"
                                Command="{Binding $parent[UserControl].DataContext.RemoveVar}"
                                CommandParameter="{Binding}">
                          <ctl:TecIcon Key="ui-foot-trash" Size="11" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

      <!-- 白缝。纯白、8 宽，从上通到底（原型那三条竖栏之间就是这么隔的） -->
      <Border Grid.Column="1" Background="White" />

      <!-- 画布：纯白。
           卡片本身也是白的（白→#f6f6f6），只靠那圈 1px #cccccc 立在白底上，
           不再有一块灰底托着——这是白底的代价，换来的是整片区域干净。
           左边那条竖栏仍是 #f1f2f0 的灰块，靠 1px 竖线 + 8px 白缝跟画布分开，
           所以竖栏该是一块、画布该是另一块这件事没丢。 -->
      <Panel Grid.Column="2" Background="White">
        <StackPanel IsVisible="{Binding NoLanes}" Margin="30,26" Spacing="7"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
          <TextBlock Text="还没有通道" FontSize="15" Foreground="#6b6f74" />
          <TextBlock FontSize="12" Foreground="#959a9f" LineHeight="19" MaxWidth="480"
                     TextWrapping="Wrap"
                     Text="每台双通道反应器带来两条泳道。先去「台面」把反应器拖进来，这里就会出现对应的泳道。" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <!-- 左边不再另留：缝由那一列 6px 独占，这里再加就成了 6+n，
               跟别处的缝对不上。上边距 14 是竖栏跟着对齐的那条线 -->
          <ItemsControl ItemsSource="{Binding Lanes}" Margin="0,14,0,40">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- 一条泳道 = 一块自己的底色（原型每一列都坐在一块灰上），
                     展开 232 宽、收起 52。竖着拉满：底色那一块要从上通到底，
                     几条并排才像几根柱子；收起的那条也就跟着一样高。
                     内容 222 宽，Padding 3（从 5 收的，算式见 SlabWidth 的注释）。

                     BorderBrush 不写在这儿、走 laneBox 那条样式：内联值压得过样式，
                     写死成 Transparent 之后 laneSel 和 laneDrop 的描边永远上不了色。 -->
                <Border Width="{Binding SlabWidth}" Padding="3" CornerRadius="4"
                        BorderThickness="1.6" Tag="lane" Classes="laneBox"
                        VerticalAlignment="Stretch"
                        Classes.laneSel="{Binding IsCurrent}"
                        Classes.laneDrop="{Binding IsDropLane}"
                        PointerPressed="OnLanePressed" Cursor="Hand">
                  <Panel>
                  <!-- ── 收起态：一条窄竖栏，跟左缘那条「变量」同一个说法 ── -->
                  <StackPanel IsVisible="{Binding Closed}" Margin="0,8,0,0" Spacing="10"
                              HorizontalAlignment="Center">
                    <Border Classes="exp3m" Cursor="Hand" Background="Transparent"
                            PointerPressed="OnLaneToggle">
                      <LayoutTransformControl HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                        <LayoutTransformControl.LayoutTransform>
                          <RotateTransform Angle="-90" />
                        </LayoutTransformControl.LayoutTransform>
                        <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" Size="10" />
                      </LayoutTransformControl>
                    </Border>
                    <TextBlock Text="{Binding NameStacked}" FontSize="13" FontWeight="Light"
                               Foreground="#3a3d41" LineHeight="16" TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <Border Background="#d7d9d6" CornerRadius="8" Padding="5,2"
                            HorizontalAlignment="Center">
                      <TextBlock Text="{Binding Channel, StringFormat='CH{0}'}" FontSize="10.5"
                                 Foreground="#3a3d41" />
                    </Border>
                  </StackPanel>

                  <!-- ── 展开态 ── -->
                  <StackPanel IsVisible="{Binding Open}">
                    <!-- 原型 .lane-head：#bfc9d7 一块，两行「标签 + 输入 + 圆钮」。
                         有错的时候描一圈红（原型是把整块染成 #fdf2f2，我们这块是
                         蓝灰的实心底，染红只会脏，而且要跟蓝色选中环抢眼睛） -->
                    <!-- 描边常在、平时不着色（BorderBrush 不写死成 Transparent：
                         内联值压得过样式，那样 laneHeadErr 永远上不了色，实测踩到）。
                         粗细恒为 1.4，出不出错都不改版 -->
                    <Border Background="#bfc9d7" CornerRadius="2" Padding="8,8,8,10"
                            BorderThickness="1.4"
                            Classes.laneHeadErr="{Binding HasErrors}">
                      <StackPanel Spacing="8">
                        <!-- 名称行：平时一行字，按铅笔才变成输入框。
                             行高写死 26（= 圆钮直径）：字比输入框矮，
                             不定高的话一按铅笔整块头就往下长一截 -->
                        <Grid ColumnDefinitions="38,*,26" Height="26">
                          <TextBlock Grid.Column="0" Text="名称" FontSize="12.5"
                                     Foreground="#292b2e" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Margin="6,0" Text="{Binding LaneName}"
                                     FontSize="12.5" Foreground="#1b1d20"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding NotRenaming}" />
                          <TextBox Grid.Column="1" Classes="hin" Margin="6,0"
                                   Text="{Binding LaneName, Mode=TwoWay}"
                                   IsVisible="{Binding Renaming}" />
                          <!-- 铅笔：改名开关。原来这个位置是垃圾桶，跟「名称」这一格
                               没关系；现在铅笔跟着它改的那一行走，垃圾桶挪到下一行 -->
                          <Button Grid.Column="2" Classes="tbtn d26" ToolTip.Tip="改这条通道的配方名"
                                  Command="{Binding ToggleRename}">
                            <ctl:TecIcon Key="ui-lane-pencil" Size="12" />
                          </Button>
                        </Grid>
                        <Grid ColumnDefinitions="38,*,26" Height="26">
                          <TextBlock Grid.Column="0" Text="通道" FontSize="12.5"
                                     Foreground="#292b2e" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="1" Classes="hsel" Margin="6,0"
                                    ItemsSource="{Binding ChannelOptions}"
                                    SelectedItem="{Binding ChannelPick, Mode=TwoWay}" />
                          <!-- 这一格从前是一颗「通道属性」铅笔钮，可它压根没挂命令，
                               点下去什么都不会发生，只有一句「在台面中设置」的悬停字——
                               删了它，位置让给垃圾桶。
                               垃圾桶清的是这条通道的**步骤**，通道绑定不动，悬停里说清 -->
                          <Button Grid.Column="2" Classes="tbtn del d26"
                                  ToolTip.Tip="清空该通道的配方（步骤全删，通道绑定不动）"
                                  Click="OnLaneRemove">
                            <ctl:TecIcon Key="ui-foot-trash" Size="12" />
                          </Button>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!--
                      泳道体，外面套一层 Panel 只为了把折叠钮浮在它左上角。

                      折叠钮从前自己占一行（18 高 + 5 间距，摆在头卡上方），
                      那一行整条只有左端一枚圈，右边全空——四条泳道就是四条空行。
                      现在它落进头卡和第一张步骤卡之间那截缝里：
                      缝 ＝ 体的上边距 10 + 连接线那一截 14 ＝ 24，
                      钮 18 居中 ⇒ 上边距 3。缝本来就是空的（只有正中一条 1px 竖线），
                      钮贴在左端跟谁都不打架，泳道整条省下 23px。

                      钮写在体后面 ⇒ 画在上层，点得着；体那几层 Panel / StackPanel
                      都没有背景，命中测试会穿过去，不会把点击吃掉。
                    -->
                    <Panel>
                    <!-- 原型 .lane-body：步骤卡竖着排，卡之间一截 14px 的细线 -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                      <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel HorizontalAlignment="Center">
                              <!-- 连接线那一截同时当落点指示用：**这一格高度恒为 14**，
                                   拖动时版面不跳。箭头比 14 高，靠 ZIndex 压在上下两张卡之上
                                   露出来，不占布局，见 Path.droparrow 那条样式 -->
                              <Panel Height="14" ZIndex="5">
                                <Border Width="1" Height="14" Background="#757a7f"
                                        HorizontalAlignment="Center" />
                                <Path Classes="droparrow" IsVisible="{Binding DropBefore}" />
                              </Panel>
                              <!-- 循环体缩进：每套一层让出 14px，并在让出的位置画一条竖线。
                                   泳道整体仍是 222 宽，各条泳道对得齐 -->
                              <StackPanel Orientation="Horizontal" Width="222">
                              <ItemsControl ItemsSource="{Binding Spines}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Panel Width="14">
                                      <Border Width="2" Background="#c9ced3" HorizontalAlignment="Center" />
                                    </Panel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>

                              <!-- 原型 .step：白卡（白→#f6f6f6 竖向渐变 + 1px #cccccc），
                                   左上一枚 27px 红方块图标，右边整句描述；底下一条
                                   1px #dedede 把「这一步做什么」和「什么时候做」分开。

                                   里面那层 stepwrap 是原型那个 3px padding 的壳，
                                   卡片四周那 5px 的空当就是它撑的（padding 3 + 描边 2，
                                   描边不着色）。选中环从前画在这层壳的外沿，
                                   现在选中改成卡片自己那圈描边了，壳只剩下留白这一个作用——
                                   留着是因为卡片的宽高、卡与卡之间的疏密全靠它，去掉版面就变了。

                                   竖排模块名去掉了：描述本来就是一整句工艺语句，
                                   模块名在里头基本重复。模块身份留在左边那条 6px 色条上。 -->
                              <Panel Width="{Binding CardWidth}" Tag="stepcard" Cursor="Hand"
                                     Classes.stepGhost="{Binding Ghosted}"
                                     PointerPressed="OnStepPressed">
                              <Border Classes="stepwrap">
                                <Border Classes="step"
                                        Classes.stepSel="{Binding IsSelected}">
                                <Grid ColumnDefinitions="6,*">
                                  <Border Grid.Column="0" Background="{Binding ModuleColor}" />
                                  <!-- 第一行留星号：卡片有最小高度，多出来的空当落在这一行，
                                       那条分隔线才一直贴着底（原型 margin-top:auto） -->
                                  <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto"
                                        Margin="7,6,7,5">
                                    <Grid Grid.Row="0" ColumnDefinitions="27,7,*,Auto">
                                      <Panel Classes="tile27" VerticalAlignment="Top">
                                        <Border Classes="tilebg27" Background="{Binding TileBrush}" />
                                        <ctl:TecIcon Key="{Binding TileIcon}" Size="27"
                                                     Tint="{Binding TileTint}" />
                                      </Panel>
                                      <TextBlock Grid.Column="2" Text="{Binding Desc}"
                                                 FontSize="12" Foreground="#1b1b1b"
                                                 LineHeight="15" TextWrapping="Wrap"
                                                 MaxLines="4" TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Top" />

                                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                  VerticalAlignment="Top" Margin="6,0,0,0">
                                        <!-- 并行标记：这一步与上一步同一时刻开跑（组内全结束才走下一组） -->
                                        <Border IsVisible="{Binding IsParallel}" Background="#10868f"
                                                CornerRadius="2" Padding="4,0" Height="14"
                                                ToolTip.Tip="与上一步并行启动：同一时刻开跑，整组都结束才进下一步">
                                          <TextBlock Text="∥" FontSize="10" FontWeight="Bold"
                                                     Foreground="White" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- 徽记（原型 .sbadge）。悬停能读到具体哪儿不对——
                                             红框只说「这一步有事」，是什么事得说得出来，
                                             不然人还得回面板里对 -->
                                        <Border Classes="sev"
                                                Classes.warn="{Binding IssueWarn}"
                                                VerticalAlignment="Top"
                                                IsVisible="{Binding HasIssue}"
                                                ToolTip.Tip="{Binding IssueTip}">
                                          <ctl:TecIcon Key="ui-alert" />
                                        </Border>
                                      </StackPanel>
                                    </Grid>

                                    <!-- 分隔线用半透明黑，不写死浅灰：卡底从白换成
                                         #82dcfe 之后，#dedede 跟它明度几乎一样，
                                         这条线等于没画。压一层黑在什么底上都看得见 -->
                                    <Border Grid.Row="1" Height="1" Background="#22000000"
                                            Margin="0,6,0,0" />

                                    <!-- 排期这一行：左边预计开始，中间耗时，垃圾桶收在最右。
                                         这一行就是泳道宽度的下限——实测「预计开始 00:00:00」
                                         占 ≈100、「耗时 0:20:00」≈76，加上列间距 10、桶 20、
                                         卡内边距 14、色条 6，一共 ≈226 —— 这是估上限，
                                         实际卡片画出来 222 就排得下（一行不断），
                                         「耗时」是 Auto 列，真到摆不下的时候先截「预计开始」，
                                         不会把行挤散。

                                         桶不套圈（见 App.axaml 里 Button.tbtn.bare 那段） -->
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto"
                                          Margin="0,3,0,0">
                                      <TextBlock Grid.Column="0" FontSize="11.5"
                                                 Foreground="#2b2b2b" VerticalAlignment="Center"
                                                 TextTrimming="CharacterEllipsis">
                                        <Run Text="预计开始 " /><Run Text="{Binding PlanStart}" />
                                      </TextBlock>
                                      <TextBlock Grid.Column="1" FontSize="11.5"
                                                 Foreground="#6b6f74" VerticalAlignment="Center"
                                                 Margin="6,0,4,0"
                                                 IsVisible="{Binding HasDuration}">
                                        <Run Text="耗时 " /><Run Text="{Binding PlanDuration}" />
                                      </TextBlock>
                                      <Button Grid.Column="2" Classes="tbtn del bare"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="删除该步骤"
                                              Command="{Binding $parent[UserControl].DataContext.RemoveStep}"
                                              CommandParameter="{Binding}">
                                        <ctl:TecIcon Key="ui-foot-trash" Size="13" />
                                      </Button>
                                    </Grid>
                                  </Grid>
                                </Grid>
                                </Border>
                              </Border>
                              </Panel>
                              </StackPanel>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- 泳道末尾的落点。**那张虚线卡片整个没了**：
                           它从前一直杵在每条泳道底下（不拖也在），一条泳道等于永远挂着
                           一个空盒子，四条泳道就是四个。落点该在拖的时候才出现。
                           线也只在这时候画——链子到最后一张卡就断了，不再往下拖一截空的。 -->
                      <Panel Height="14" ZIndex="5">
                        <Border Width="1" Height="14" Background="#757a7f"
                                HorizontalAlignment="Center" IsVisible="{Binding DropAtEnd}" />
                        <Path Classes="droparrow" IsVisible="{Binding DropAtEnd}" />
                      </Panel>
                      <!-- 空泳道还是得有句话告诉人往哪儿放，但只留字、不再是一张卡 -->
                      <TextBlock Text="{Binding DropHint}" IsVisible="{Binding ShowHint}"
                                 FontSize="11" Foreground="#888d92" Width="222"
                                 TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,4" />
                    </StackPanel>

                    <!-- 收起这条泳道。落在头卡底下那截缝的左端。
                         跟收起态顶上那枚在同一条竖线上（都贴左），只是高度不同——
                         收起来之后没有头卡了，那枚自然回到列顶 -->
                    <Border Classes="exp3m up" Cursor="Hand" Background="Transparent"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="1,3,0,0"
                            ToolTip.Tip="收起该通道" PointerPressed="OnLaneToggle">
                      <LayoutTransformControl HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                        <LayoutTransformControl.LayoutTransform>
                          <RotateTransform Angle="-90" />
                        </LayoutTransformControl.LayoutTransform>
                        <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" Size="10" />
                      </LayoutTransformControl>
                    </Border>
                    </Panel>
                  </StackPanel>
                  </Panel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
      </Grid>

      <!-- ══ 校验面板 ══ 从 chip 底下垂下来，浮在画布上不撑开布局
           （它一展开就把泳道挤扁的话，人一边看清单一边找那一步，找的过程里版面又变一次）。

           这一版按参考稿重排：
           · 通道名从每行右边那枚小牌子，提到**组头**上——同一条通道连着几行时，
             那块牌子从前要重复几遍，还跟「定位」挤在同一侧，右半边很闹。
             组头顺带报这条通道各有几错几提醒，不用挨行数。
           · 行首从 8px 实心小点换成 15px 的圆「!」：点只说得出「这里有一条」，
             说不出多严重；圆圈里那个「!」跟步骤卡徽记、chip 上的记号是同一个形。
           · 那句「去哪儿改」压成一行，多出来的用省略号收，全文进 ToolTip。
             一条问题占的高度从此固定，扫清单快；真要动手的人停一下就能读全。
           · 「全部 / 仅错误」两格各带一个数，不点开也知道各有多少条。 -->
      <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Width="452"
                  Margin="0,0,16,0" IsVisible="{Binding PanelOpen}">
        <!-- 指着 chip 的那个小尖角。离右缘 34 正好落在 chip 的箭头底下。
             **两条斜边得描出来**：参考稿里页面底色是灰的，一枚白三角自己就看得见；
             我们这儿它坐在白画布上，纯白三角等于没画（实测那 7 行整条是白的）。
             描边只画两条斜边、不画底边——底边跟面板顶上那道描边重着，
             画了就是两条线叠一块儿。 -->
        <Panel Width="14" Height="7" HorizontalAlignment="Right" Margin="0,0,34,0">
          <Path Data="M 0,7 L 7,0 L 14,7 Z" Fill="White" Stretch="None" />
          <Path Data="M 0,7 L 7,0 L 14,7" Stroke="#1A000000" StrokeThickness="1"
                StrokeJoin="Round" Stretch="None" />
        </Panel>
        <Border Background="White" BorderBrush="#12000000" BorderThickness="1"
                CornerRadius="7" BoxShadow="0 8 16 0 #24000000" ClipToBounds="True">
        <DockPanel>
          <!-- 头：标题 + 分段 + 关。42 高，跟 chip 一族的字号拉开半档（13.5 对 12.5） -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Height="42">
            <TextBlock Grid.Column="0" Text="配方校验" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="#1B1B1B" VerticalAlignment="Center" Margin="13,0,0,0" />
            <!-- 全部 / 仅错误：提醒多起来的时候，先把真挡启动的那几条挑出来。
                 连体两格坐在一块 #F0F0F0 的槽里，选中那格浮成白的 -->
            <Border Grid.Column="2" Background="#F0F0F0" CornerRadius="5" Padding="2"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Button Classes="segb" Classes.on="{Binding AllTab}" Command="{Binding ShowAll}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="全部" VerticalAlignment="Center" />
                    <TextBlock Classes="segn" Text="{Binding AllCountText}" />
                  </StackPanel>
                </Button>
                <Button Classes="segb" Classes.on="{Binding OnlyErrors}" Command="{Binding ShowOnlyErrors}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="仅错误" VerticalAlignment="Center" />
                    <TextBlock Classes="segn" Text="{Binding ErrCountText}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <Button Grid.Column="3" Classes="xbtn" Margin="4,0,7,0"
                    Command="{Binding ClosePanel}" ToolTip.Tip="收起">
              <TextBlock Text="✕" FontSize="12" Foreground="#5C5C5C"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>

          <!-- 脚注常在：不是提示，是这个面板的读法说明——两种记号后果不一样。
               压成两枚图例，一枚一句，比原来那整段话扫得快 -->
          <Border DockPanel.Dock="Bottom" Background="#F9F9F9" Height="32"
                  BorderBrush="#EDEDED" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"
                        Margin="13,0">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Border Classes="legd" Background="#C42B1C" />
                <TextBlock Classes="legt" Text="有错误时无法运行" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Border Classes="legd" Background="#DA9E00" />
                <TextBlock Classes="legt" Text="提醒不阻断运行" />
              </StackPanel>
            </StackPanel>
          </Border>

          <ScrollViewer MaxHeight="288" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <StackPanel IsVisible="{Binding PanelEmpty}" Spacing="6" Margin="0,26">
                <TextBlock Text="{Binding PanelEmptyText}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="#1B1B1B" HorizontalAlignment="Center" />
                <TextBlock Text="配方可以运行" FontSize="11.5" Foreground="#8A8A8A"
                           HorizontalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding PanelGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <!-- 组头：通道色块 + 通道名 + 右端「n 错误 · m 提醒」 -->
                      <Border Background="#F9F9F9" Height="26"
                              BorderBrush="#EDEDED" BorderThickness="0,1">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="13,0">
                          <Border Grid.Column="0" Width="8" Height="8" CornerRadius="2"
                                  VerticalAlignment="Center" Background="{Binding ColorHex}" />
                          <TextBlock Grid.Column="1" Text="{Binding ChannelLabel}" FontSize="11"
                                     Foreground="#8A8A8A" VerticalAlignment="Center"
                                     Margin="7,0,0,0" />
                          <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="11"
                                     Foreground="#8A8A8A" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Classes="issue" IsEnabled="{Binding CanGo}"
                                    Command="{Binding $parent[UserControl].DataContext.PickIssue}"
                                    CommandParameter="{Binding}">
                              <Border BorderBrush="#F2F2F2" BorderThickness="0,0,0,1">
                                <!-- 记号顶对齐第一行，不是整块居中：标题折成两行的时候，
                                     居中的记号会掉到两行中间，看着不像在标那一条 -->
                                <Grid ColumnDefinitions="15,9,*,Auto,Auto" Margin="13,9,11,9">
                                  <Border Grid.Column="0" Width="15" Height="15" CornerRadius="8"
                                          VerticalAlignment="Top" Margin="0,1,0,0"
                                          Background="{Binding BadgeBg}">
                                    <TextBlock Text="!" FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding BadgeInk}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Border>
                                  <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Text}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#1B1B1B" LineHeight="18" TextWrapping="Wrap" />
                                    <!-- 一行封顶 + 省略号，全文进 ToolTip：一条问题占的高度固定，
                                         清单扫得快；真要动手的人停一下就读得全 -->
                                    <TextBlock Text="{Binding Hint}" FontSize="11.5" Foreground="#5C5C5C"
                                               LineHeight="17" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                               IsVisible="{Binding HasHint}"
                                               ToolTip.Tip="{Binding Hint}" />
                                  </StackPanel>
                                  <!-- 「定位」平时不占眼睛，指到这一行才显出来；
                                       指不到具体某一步的那几条（整条通道缺能力）连位置都不留 -->
                                  <TextBlock Grid.Column="3" Classes="goto" Text="定位" FontSize="11.5"
                                             FontWeight="SemiBold" Foreground="#1668C7"
                                             VerticalAlignment="Center" Margin="0,0,6,0"
                                             IsVisible="{Binding CanGo}" />
                                  <TextBlock Grid.Column="4" Classes="chev" Text="›" FontSize="13"
                                             VerticalAlignment="Center" />
                                </Grid>
                              </Border>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        </Border>
      </StackPanel>
      </Panel>
    </DockPanel>
    </Border>

    <!-- ══ 右：属性栏 ══
         不照原型那块 #ebece9 通栏，按台面页那一套：栏本身不铺底色、跟画布之间
         不画分界线，底色下沉到块上；「当前选中的那一步」左边一条 6px 粗色条 -->
    <Border Grid.Column="2">
      <!-- 视口上沿那道 14px 渐隐：往下滚的时候卷上去的那一行不再被齐刷刷切一刀，
           而是化开。跟台面页属性栏同一处理，那边的注释写得全，改这儿也去看那一段
           （BenchView.axaml，属性栏那个 ScrollViewer）。两页的属性栏是同一块东西，
           一处化开一处齐口的话，来回切菜单会看出差别 -->
      <ScrollViewer>
        <ScrollViewer.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,14" SpreadMethod="Pad">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#FF000000" Offset="1" />
          </LinearGradientBrush>
        </ScrollViewer.OpacityMask>
        <StackPanel>

          <!-- ═ 配方块：常驻。应用配方库、通道状态讲的是这条泳道自己的事，
               跟「当前点中了哪一步」无关（台面页的台面块就是这么摆的）═ -->
          <Border Padding="18,16,18,20" Background="{StaticResource PropsBg}">
            <StackPanel>
              <TextBlock Text="配方属性" FontSize="24" FontWeight="Light" Foreground="#303337"
                         HorizontalAlignment="Center" Margin="0,0,0,8" />
              <TextBlock Classes="intro"
                         Text="从左侧步骤库拖进画布组成配方。点选画布中的步骤，在此查看与编辑其参数。" />

              <Border Height="1" Background="#d3d5d2" Margin="0,10,0,4" />
              <Button Classes="secbtn" Command="{Binding LibSection.Toggle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="exp3s" Classes.up="{Binding LibSection.Open}">
                    <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" Size="10" />
                  </Border>
                  <TextBlock Text="应用配方库" Classes="acc" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <StackPanel IsVisible="{Binding LibSection.Open}">
                <Grid ColumnDefinitions="76,*,40" Margin="0,6,0,0">
                  <TextBlock Grid.Column="0" Text="配方" FontSize="12" Foreground="#3a3d41"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                  <ComboBox Grid.Column="1" Classes="sel" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Library}"
                            SelectedItem="{Binding LibPick, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <!-- 圆圈图标 + 居中，与台面属性底部那排动作按钮同款 -->
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,12,0,8"
                            HorizontalAlignment="Center">
                  <Button Classes="tbtn foot" ToolTip.Tip="应用到当前通道（替换全部步骤）"
                          Command="{Binding ApplyLib}">
                    <ctl:TecIcon Key="ui-snav-import" />
                  </Button>
                  <Button Classes="tbtn foot" ToolTip.Tip="把当前通道的配方存入配方库"
                          Command="{Binding SaveToLib}">
                    <ctl:TecIcon Key="ui-foot-save" />
                  </Button>
                </StackPanel>
                <TextBlock FontSize="11.5" Foreground="#565a5f" LineHeight="18"
                           TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="应用会替换当前通道的全部步骤；库里那条捎着配料表的，配料表也一起替换（引用才不断）。存入时配料表随配方入库，实投与批号不带——那是跟某一炉走的。" />
                <Button Classes="linkbtn" Content="管理配方库 →" Command="{Binding ManageLibrary}"
                        HorizontalAlignment="Right" Margin="0,4,0,0" />
              </StackPanel>

              <Border Height="1" Background="#d3d5d2" Margin="0,10,0,4" />
              <Button Classes="secbtn" Command="{Binding StatesSection.Toggle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="exp3s" Classes.up="{Binding StatesSection.Open}">
                    <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" Size="10" />
                  </Border>
                  <TextBlock Text="通道状态" Classes="acc" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Background="White" BorderBrush="#dadcd9" BorderThickness="1" CornerRadius="3"
                      IsVisible="{Binding StatesSection.Open}">
                <ItemsControl ItemsSource="{Binding ChannelStates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#edeeeb" BorderThickness="0,0,0,1" Padding="10,0" MinHeight="32">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                          <Border Grid.Column="0" Width="9" Height="9" CornerRadius="5" Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Background="{Binding Lit, Converter={x:Static v:Converters.LedBrush}}"
                                  BorderBrush="#a1a5a9" BorderThickness="1" />
                          <Border Grid.Column="1" Width="11" Height="11" CornerRadius="3" Margin="0,0,8,0"
                                  VerticalAlignment="Center" Background="{Binding ColorHex}" />
                          <!-- 两个 TextBlock 而不是一个带 Run 的：Run 上挂 StringFormat 会和
                               TextBlock 的 inlines 变更互相触发，转起来收不住（栈溢出） -->
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#292b2e"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ChannelSuffix}" FontSize="12" Foreground="#959a9f" />
                          </StackPanel>
                          <TextBlock Grid.Column="3" Text="{Binding State}" FontSize="11"
                                     Foreground="#888d92" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </Border>

          <!-- 块与块之间的缝：栏本身没底色，这里空着就是画布的白 -->
          <Border Height="9" IsVisible="{Binding HasSelection}" />

          <!-- ═ 步骤块：选中哪一步显示哪一步，左边一条 6px 粗色条 ═ -->
          <Border Padding="18,16,18,20" IsVisible="{Binding HasSelection}"
                  Background="{StaticResource PropsBg}"
                  BorderBrush="{StaticResource PropsBar}" BorderThickness="6,0,0,0">
            <StackPanel>
              <!-- 指令名本身就是这一块的标题，上面不再压一行「步骤属性」 -->
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12"
                          HorizontalAlignment="Center">
                <!-- 跟画布上那张卡同一枚红方块：从卡片点进属性栏，认的是同一个记号 -->
                <Panel Classes="tile27" VerticalAlignment="Center">
                  <Border Classes="tilebg27" Background="{Binding StepTileBrush}" />
                  <ctl:TecIcon Key="{Binding StepTile}" Size="27"
                               Tint="{Binding StepTileTint}" />
                </Panel>
                <TextBlock Text="{Binding StepName}" FontSize="21" FontWeight="Light"
                           Foreground="#303337" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StepChannel}" FontSize="12" Foreground="#888d92"
                           VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock IsVisible="{Binding NoParams}" Text="该指令无需设置参数。"
                         FontSize="11.5" Foreground="#888d92" Margin="0,2,0,8" />

              <v:SchemaFormView DataContext="{Binding Form}" />

              <!-- 加料步骤连配料表（CH-4.1）：选一行建立引用，体积从此跟随计算 -->
              <StackPanel IsVisible="{Binding IsDoseStep}" Margin="0,10,0,0" Spacing="5">
                <Grid ColumnDefinitions="76,*,40">
                  <TextBlock Grid.Column="0" Text="连配料表" FontSize="12" Foreground="#3a3d41"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                  <ComboBox Grid.Column="1" Classes="sel" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ChargeRowNames}"
                            SelectedItem="{Binding ChargeRowPick, Mode=TwoWay}"
                            PlaceholderText="选一行建立引用"
                            ToolTip.Tip="选中配料表里的一行就建立引用：加料体积改为跟随配料表的计算（改组分名也不断）。手改体积即脱离跟随，校验面板会提示差多少" />
                </Grid>
                <TextBlock Text="{Binding ChargeLinkNote}" Foreground="{Binding ChargeLinkColorHex}"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>

              <!-- 执行选项：两个真会影响运行的开关 -->
              <StackPanel Margin="0,14,0,0" Spacing="6">
                <Button Classes="secbtn" Command="{Binding ExecSection.Toggle}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="exp3s" Classes.up="{Binding ExecSection.Open}">
                      <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" Size="10" />
                    </Border>
                    <TextBlock Text="执行选项" Classes="acc" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <StackPanel IsVisible="{Binding ExecSection.Open}" Spacing="6">
                  <CheckBox Classes="chk2" Content="失败时暂停并报警"
                            IsChecked="{Binding PauseOnFault, Mode=TwoWay}" />
                  <CheckBox Classes="chk2" Content="跳过该步骤（不执行、不计入排期）"
                            IsChecked="{Binding StepSkipped, Mode=TwoWay}" />
                  <CheckBox Classes="chk2" Content="与上一步并行启动"
                            IsChecked="{Binding StepParallel, Mode=TwoWay}"
                            IsVisible="{Binding CanParallel}"
                            ToolTip.Tip="iControl 的 Series/Parallel：勾上后这一步与上一步同一时刻开跑；一组并行步全部结束，下一步才开始。第一步、循环标记、起始步骤不能并行" />
                  <!-- 工艺阶段：设备不知道这一段在结晶还是在蒸馏，只有人知道。
                       标了就进记录、进报告，报告里注明是操作人标的 -->
                  <Grid ColumnDefinitions="76,*,40" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Text="工艺阶段" FontSize="12" Foreground="#3a3d41"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Grid.Column="1" Classes="sel" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding PhaseOptions}"
                              SelectedItem="{Binding StepPhase, Mode=TwoWay}"
                              ToolTip.Tip="事后看 Tr−Tj 曲线时，靠它才知道某一段在做什么。由操作人标注，不是设备回报" />
                  </Grid>
                </StackPanel>
              </StackPanel>

              <!-- 本步安全覆盖（iControl 每步的 Advanced 层）：执行期间临时收紧的限值，
                   开始挂进安全层、结束自动撤下还原。三层限值同时求值，只能收紧 -->
              <StackPanel Margin="0,10,0,0" Spacing="6">
                <Button Classes="secbtn" Command="{Binding GuardSection.Toggle}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="exp3s" Classes.up="{Binding GuardSection.Open}">
                      <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" Size="10" />
                    </Border>
                    <TextBlock Text="本步安全覆盖" Classes="acc" VerticalAlignment="Center" />
                    <!-- 折叠着也要看得出有覆盖在生效，颜色用安全组那支蓝 -->
                    <Border IsVisible="{Binding GuardActive}" Background="#3465c0" CornerRadius="2"
                            Padding="5,1" VerticalAlignment="Center">
                      <TextBlock Text="已设" FontSize="10" Foreground="White" />
                    </Border>
                  </StackPanel>
                </Button>
                <StackPanel IsVisible="{Binding GuardSection.Open}" Spacing="6">
                  <TextBlock Text="这一步执行期间临时加的限值，结束自动撤下还原。留空 = 不设那一条；与底线、配方限值同时求值，只能收紧不能放宽。"
                             FontSize="10.5" Foreground="#888d92" LineHeight="15" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="76,*,14,*,40" RowDefinitions="18,Auto,6,Auto,6,Auto"
                        Margin="0,2,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="下限" FontSize="10" Foreground="#959a9f" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="上限" FontSize="10" Foreground="#959a9f" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="釜内 Tr" FontSize="12" Foreground="#3a3d41"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Classes="gin"
                             Text="{Binding GuardTrMin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBox Grid.Row="1" Grid.Column="3" Classes="gin"
                             Text="{Binding GuardTrMax, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="℃" FontSize="11" Foreground="#888d92"
                               VerticalAlignment="Center" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="夹套 Tj" FontSize="12" Foreground="#3a3d41"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Classes="gin"
                             Text="{Binding GuardTjMin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBox Grid.Row="3" Grid.Column="3" Classes="gin"
                             Text="{Binding GuardTjMax, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Row="3" Grid.Column="4" Text="℃" FontSize="11" Foreground="#888d92"
                               VerticalAlignment="Center" Margin="6,0,0,0" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="pH" FontSize="12" Foreground="#3a3d41"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Row="5" Grid.Column="1" Classes="gin"
                             Text="{Binding GuardPhMin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBox Grid.Row="5" Grid.Column="3" Classes="gin"
                             Text="{Binding GuardPhMax, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                  </Grid>
                  <Grid ColumnDefinitions="76,*,40" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Text="触发动作" FontSize="12" Foreground="#3a3d41"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Classes="sel" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding GuardActions}"
                              SelectedItem="{Binding GuardAction, Mode=TwoWay}"
                              ToolTip.Tip="越限（或读不到值）时安全层执行的动作，与「改限值」的五档一致" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- 跟手的幽灵卡。盖在三列之上、不吃事件，所以底下照样能命中泳道 -->
    <Canvas Grid.Column="0" Grid.ColumnSpan="3" IsHitTestVisible="False">
      <Border IsVisible="{Binding Dragging}"
              Canvas.Left="{Binding DragX}" Canvas.Top="{Binding DragY}"
              Width="222" Background="White" BorderBrush="{StaticResource MenuBlue}" BorderThickness="1.5"
              Padding="7,6" Opacity="0.96"
              BoxShadow="0 5 16 0 #33000000">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Panel Classes="tile27" VerticalAlignment="Center">
            <Border Classes="tilebg27" Background="{Binding DragTileBrush}" />
            <ctl:TecIcon Key="{Binding DragTile}" Size="27"
                         Tint="{Binding DragTileTint}" />
          </Panel>
          <TextBlock Text="{Binding DragTitle}" FontSize="12" Foreground="#1b1b1b"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </Canvas>
  </Grid>

  <UserControl.Styles>
    <!-- ══ 步骤库（原型 iControl 6.2 的 Recipe Library）══ -->

    <!-- 本步安全覆盖的小数字框，样式与 SchemaForm 的 fin 一族同一张脸 -->
    <Style Selector="TextBox.gin">
      <Setter Property="Height" Value="23" />
      <Setter Property="MinHeight" Value="23" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#dddddd" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#202225" />
    </Style>
    <Style Selector="TextBox.gin:focus">
      <Setter Property="BorderBrush" Value="#acc3df" />
    </Style>

    <!-- 搜索框：原型是 29×21 的白底细框 -->
    <Style Selector="TextBox.lfind">
      <Setter Property="Height" Value="21" />
      <Setter Property="MinHeight" Value="21" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#8d9196" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.lfindx">
      <Setter Property="Width" Value="19" />
      <Setter Property="Height" Value="19" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.lfindx:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e2e2e2" />
    </Style>

    <!-- 组头右端那枚放大镜 -->
    <Style Selector="Button.gfind">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.gfind:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#dcdedb" />
    </Style>

    <!-- 分组块：一块 #eeefec，左边不倒角——色条是方的，块跟着方，色条才贴得平。
         悬停只亮组头那一条，不亮整块：块里装着指令格，指着某一格时
         整块跟着变色，看着像是整组被选中了 -->
    <Style Selector="Border.dev">
      <Setter Property="Background" Value="{StaticResource ThemeFill}" />
      <Setter Property="CornerRadius" Value="0,2,2,0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.devhd">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.devhd:pointerover">
      <Setter Property="Background" Value="#e2e5e9" />
    </Style>

    <!-- 组头那个圆圈箭头。18 是配 52px 组头的：exp3 那 22 是给 96px 组头留的 -->
    <Style Selector="Border.exp3m">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderBrush" Value="#676b70" />
      <Setter Property="BorderThickness" Value="1.4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.exp3m.up">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="180" />
      </Setter>
    </Style>

    <!-- 指令格：2 列 × 46 高，横排「方块 + 名字」。
         **悬停不变色**：这一列格子本来就是一格一个彩方块，鼠标扫过去再浮一层白，
         整列跟着一格一格地闪。要点哪个由方块和名字自己说，不靠底色喊。
         （从前浮白，更早是浅红 #FAF2F3） -->
    <Style Selector="Button.cmd2">
      <Setter Property="Height" Value="46" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,0,4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!--
      「不变色」得**写出来**，不能只是把自己那条悬停样式删掉。
      Fluent 的按钮主题自己有 :pointerover / :pressed 两条，直接往模板里那块
      ContentPresenter 上刷底色；上面 Button.cmd2 的 Background=Transparent 设在
      控件上，压不住它。删掉我们自己那条之后露出来的是 Fluent 的默认灰
      （实测悬停格子 #D9D9D9，旁边没悬停的是面色 #F1F1F1）。
      所以这两条得留着，把底色按回透明。
    -->
    <Style Selector="Button.cmd2:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.cmd2:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!--
      落点箭头。松手会插在哪儿，就在哪儿画这么一支宽头朝下的箭。

      尺寸：箭头本身 56 宽 × 72 长，其中杆 24 宽 44 长、三角 56 宽 28 长。
      一路收窄拉长过来的：172×20 → 108×32 → 68×44 → 56×72。
      最后这一档是「三角再窄一点、杆加长」：三角 68 → 56，杆 16 → 44。
      外框跟卡片同宽（现在 222），图形画在框中间，见下面「画法」那段。
      可它待的那一格只有 14 高——那 14 是两张卡之间的连接线，
      **不能为了放箭头就把它撑开**，一撑开，鼠标在两个落点之间来回移，
      底下整列跟着上下弹。所以箭头不占布局，多出来的 58 靠负外边距**只往上溢**：
        VerticalAlignment=Top + Margin 0,-58 ⇒ 占 y −58..14，尖正好落在这一格的底边，
        也就是新卡片将要插进去的那条缝上。
      箭越长，压在上面那张卡上的就越多——现在 58，而卡片高才 64，几乎整张盖住。
      这是有意的：箭只在拖动中出现，压着谁都不碍事，
      而「尖对准哪条缝」比「不遮挡」重要。**但这条路到头了**：
      再加长就会盖到上上张卡去。真要更长，得换个法子——
      要么把箭改成半透明，要么让那条 14 的缝在拖动时自己撑开
      （撑开就得接受版面跳，那正是当初把箭做成不占布局的原因）。

      **只往上溢，不往下溢**，是因为压不住下面那张卡：往下溢的那截会被它盖掉。
      同一个 item 里，这一格排在卡片前面，画得也早；给父 Panel 加 ZIndex 不管用
      （试过 ZIndex=5，箭头尖照样被卡片吃掉）。往上溢就没这问题——
      上面那张卡是**更早**的一个 item（或者泳道头），我们画得比它晚，压得住。

      画法：Stretch=None，外框写死 222×72，图形按自己的坐标画，
      横向中点 111 就是 222 的一半——Path 的 HorizontalAlignment 是不管用的
      （Shape 在 Stretch=None 下按 geometry.Bounds.Right 量宽），只能拿坐标对齐。

      渐变：左 #42A0D3 → 中 #50BBEB → 右 #319FD8，横向。
      三个色里 #50BBEB 明显最亮，另外两个亮度几乎一样（160/211 对 159/216），
      这正是「中间一道高光、两边各一道暗边」的样子——要是上下明到暗的直渐变，
      用不着两支这么接近的深色。所以按横向三段铺，箭头看着像根圆棍。

      端点就是 0% 和 100%。这里有个容易想岔的地方：**渐变量的是图形自己的包围盒
      （箭头那 56 宽），不是控件框那 222**。所以不用为了「让三个色都露出来」
      去按 (111±28)/222 折算端点——试过折算（那会儿箭头 108 宽，写 26.7%/73.3%），
      结果渐变缩到中间一半：两头各平铺一块死色，只有当中 56px 在过渡。
      写 0/100% 反而正好铺满箭身。
    -->
    <Style Selector="Path.droparrow">
      <Setter Property="Width" Value="222" />
      <Setter Property="Height" Value="72" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,-58,0,0" />
      <!-- 杆 24 宽 44 长（x 99..123，y 0..44），三角 56 宽 28 长（x 83..139，尖在 111,72）。
           三角只比杆宽出两侧各 16——再窄下去就不像箭头、像根钉子了。
           111 是 222 的一半，靠这个居中——Path 的 HorizontalAlignment 不管用 -->
      <Setter Property="Data" Value="M 99,0 L 123,0 L 123,44 L 139,44 L 111,72 L 83,44 L 99,44 Z" />
      <Setter Property="Fill">
        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
          <GradientStop Color="#42A0D3" Offset="0" />
          <GradientStop Color="#50BBEB" Offset="0.5" />
          <GradientStop Color="#319FD8" Offset="1" />
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- 指令图标那枚方块：库里和步骤卡上同一个尺寸 27，
         从库里点进泳道不会「变小一号」 -->
    <Style Selector="Panel.tile27">
      <Setter Property="Width" Value="27" />
      <Setter Property="Height" Value="27" />
    </Style>
    <!--
      方块的底不再写死在样式里，改成每处各自 Background="{Binding …TileBrush}"：
      从前是一支品牌红渐变 #C8404F → #A41626，全程序所有指令共用；
      现在方块＝该指令所属模块的色（见 ModuleInfo 那段说明），
      跟卡片左边那条 6px 色条、库里的分类色条、甘特图上的色块说的是同一件事。

      渐变的做法没变（顶上提亮 20%），只是底色换成了模块色，在 ModuleInfo.BrushOf 里建。
      方块里那两支配角色（淡色画液面、深色画描边）由 SvgArt 从 TecIcon.Tint 推出来，
      所以四处都要连 Tint 一起绑——只绑底不绑 Tint，线条会留在原来那套红上。
    -->
    <Style Selector="Border.tilebg27">
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!-- ══ 步骤卡 ══
         原型 .step：白→#f6f6f6 竖向渐变 + 1px #cccccc，不倒角。
         最小高度 75 = 上下 1px 描边 + 6 + 图标 27 + 6 + 分隔线 1 + 3 + 删除钮 24 + 5 -->
    <Style Selector="Border.step">
      <Setter Property="MinHeight" Value="75" />
      <!-- 粗细恒为 1、平时不着色。**不能改成 0**：粗细一变，卡片的内容盒跟着变，
           选中那一刻描述会重新折行、卡片抖一下。所以「没有边框」是画一圈透明的 -->
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <!-- 实底 #82dcfe（甲方给的），不是从前那道白→灰的渐变：
           渐变是拿来在白画布上「浮」一张白卡的，卡本身有颜色之后，
           上下两端各调一档只会看着脏 -->
      <Setter Property="Background" Value="#82dcfe" />
    </Style>
    <Style Selector="Border.step:pointerover">
      <Setter Property="Background" Value="#6ad2f8" />
    </Style>
    <!-- 选中：卡片自己那圈描边染黑。**必须排在 Border.step 后面**——
         Avalonia 的样式按源码顺序决胜，不看选择器谁更具体 -->
    <Style Selector="Border.step.stepSel">
      <Setter Property="BorderBrush" Value="#000000" />
    </Style>

    <!-- 泳道头里的输入：原型 .hsel，22 高、白底、#a9adb1 描边 -->
    <Style Selector="TextBox.hin">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="BorderBrush" Value="#a9adb1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="White" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 通道那个下拉：白框常在。跟上面那行名称不一样——名称是一句已经填好的字，
         平时没人碰；这一格是要人从几个通道里挑一个的，框在那儿才看得出「这儿能选」 -->
    <Style Selector="ComboBox.hsel">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="BorderBrush" Value="#a9adb1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="White" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Button.lhbtn（泳道头那颗 26px 方角圆钮）整族删了：它唯一的用处是
         「通道属性」那颗按钮，而那颗按钮压根没挂命令，点下去什么都不会发生。
         现在名称行用铅笔（tbtn d26）、通道行用垃圾桶（tbtn del d26），
         泳道头上的钮跟全程序同一族 -->

    <!-- 泳道的底：一条泳道坐在一块自己的浅灰上（原型每一列都有），
         画布是白的，几块灰并排才看得出这是几根柱子、缝在哪儿。
         描边常在、平时不着色，必须排在 laneSel / laneDrop 前面——
         Avalonia 比的是写的先后，不是选择器谁更具体 -->
    <!-- 泳道底跟工具条、步骤库分类块是同一层「不是画布的面」，走同一支面色。
         从前它是中性 #efefef，跟 #eff1f3 只差一丝冷暖：两块紧挨着（泳道顶到
         工具条底下），差这么一点点反而比差一大截更难看 -->
    <Style Selector="Border.laneBox">
      <Setter Property="Background" Value="{StaticResource ThemeFill}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- 当前通道：不画描边，只在外面浮一层很浅的黑影。
         从头到尾框一圈实线（不管红的黑的）都太重——那是全页最大的一个框，
         而它说的只是「参数栏现在编的是这一路」这么一件小事。
         描边那一格仍然留着（laneBox 的 Transparent + 1.6 厚度）：
         宽度恒定，laneDrop 要染红时有地方染，版面也不会横跳 -->
    <Style Selector="Border.laneBox.laneSel">
      <Setter Property="BoxShadow" Value="0 0 0 3 #2617191c" />
    </Style>
    <!-- 校验面板里的一条：整行可点，跳到出问题的那一步 -->
    <Style Selector="Button.issue">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- 悬停铺一层极淡的蓝（参考稿里的 acc-bg）：这一行是可点的、点了会跳走，
         用「当前 / 生效中」那支蓝的浅底说，比一层灰更像「按了会有事发生」 -->
    <Style Selector="Button.issue:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EFF6FC" />
    </Style>
    <!-- 不可点的那些行照常是白的：默认主题给 disabled 按钮铺一块灰底，
         摆在这儿会变成「一条灰杠」，看着像被禁用的整块面板 -->
    <Style Selector="Button.issue:disabled">
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.issue:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 「定位」平时不占眼睛，指到这一行才显出来。位置照常留着，显不显都不挪版 -->
    <Style Selector="Button.issue TextBlock.goto">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.issue:pointerover TextBlock.goto">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- 行尾那枚 ›：平时是一枚淡灰的箭头（告诉人这一行能点），指上去转成蓝的 -->
    <Style Selector="Button.issue TextBlock.chev">
      <Setter Property="Foreground" Value="#B8BEC4" />
    </Style>
    <Style Selector="Button.issue:pointerover TextBlock.chev">
      <Setter Property="Foreground" Value="#1668C7" />
    </Style>
    <Style Selector="Button.issue:disabled TextBlock.chev">
      <Setter Property="Foreground" Value="#DCDFE2" />
    </Style>

    <!-- 脚注那两枚图例点 -->
    <Style Selector="Border.legd">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.legt">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8A8A8A" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- chip 上那三颗 7px 小点 -->
    <Style Selector="Border.cdot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.ctxt">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 校验 chip：**常驻一枚白底细框的按钮**（照参考稿），不再是「平时无框、
         指上去才浮出来」。它是这一行里唯一能点开东西的地方，一直看得见边界，
         人才知道它可点；从前无框的时候要靠鼠标扫过去才发现。
         34 高 / 圆角 7 / 一道很浅的投影，跟下面那块面板是同一套壳 -->
    <Style Selector="Button.vchip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- 投影写在模板里那块 ContentPresenter 上，不写在 Button 上：
         Button 自己没有 BoxShadow 这个属性（实测编译期 AVLN2000），
         画底色描边圆角的本来也就是这一块 -->
    <Style Selector="Button.vchip /template/ ContentPresenter">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#E5E5E5" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #0A000000" />
    </Style>
    <Style Selector="Button.vchip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F5F5F5" />
      <Setter Property="BorderBrush" Value="#E5E5E5" />
    </Style>
    <Style Selector="Button.vchip.open /template/ ContentPresenter">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D0D0D0" />
    </Style>
    <!-- 校验通过时不可点（没什么可展开的），但那枚绿灯和「多久 · 几步」照读，
         所以不许它按 disabled 的老规矩把自己整枚变淡；框也照旧留着 -->
    <Style Selector="Button.vchip:disabled">
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.vchip:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E5E5E5" />
    </Style>

    <!--
      ══ 严重度记号 Border.sev ══
      「这里有事」这个意思，页面上原本有三种长相：泳道角标是实心胶囊 + 软阴影，
      步骤卡徽记是实心圆 + 白「!」，copybar 状态灯是一颗 8px 实心小点。
      同一件事三种拼法，而且三处都是实心色块——跟刚刚定下的圆钮一族
      （底透 / 1.6 描边 / 里面一个记号）正好相反。

      现在统一成一副样子：**18 的透明圆 + 1.6 描边 + 里面一个记号**，
      尺寸和描边跟 Border.exp3m（泳道那枚折叠圆）、Button.tbtn 一族对齐，
      只有颜色按严重度分。颜色直接借 copybar 上早就在用的那三支文字色，
      于是「圈的颜色 = 记号的颜色 = 后面那行字的颜色」，一档严重度一支色。

      代价说在前面：实心琥珀胶囊 + 阴影本来是能一眼扫到的，换成描边之后
      「远看一眼就知道哪条泳道不能跑」这件事弱了一档。要是嫌淡，
      单给 err 那一档留回实心是最小的回退，说一声就改。
    -->
    <Style Selector="Border.sev">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1.6" />
      <Setter Property="BorderBrush" Value="#d93025" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.sev.warn">
      <Setter Property="BorderBrush" Value="#8a6100" />
    </Style>
    <!-- Border.sev.ok（绿圈 + 对号）撤了：只有 chip 上那句「校验通过」用过它，
         而 chip 上的三盏灯已经换成 7px 实心小点。Assets/icons/ui-ok.svg 也就
         没人引了——先留着，哪天再要一枚绿灯还是它 -->
    <!--
      圈里那个记号：跟着圈一个色。

      **「!」不用字符、改画成图标**：字符在圈里居不了中。字的盒子是
      「上沿 = 字体 ascent、下沿 = descent」，跟这个字实际的墨迹对不上——
      「!」的墨迹只占盒子上半截偏下，descent 那一块是空的，
      于是盒子居中 = 墨迹偏上。实测上留 2px 下留 3px。
      画成 svg 就是墨迹自己对着 viewBox 居中，跟字体无关：
      竖杠 3.8..8.4（圆头，实际墨迹 2.6..9.6）+ 圆点 12.05 半径 1.35
      （墨迹 10.7..13.4），整体 2.6..13.4，正中 8.0。
    -->
    <Style Selector="Border.sev ctl|TecIcon">
      <Setter Property="Size" Value="11" />
      <Setter Property="Tint" Value="#d93025" />
    </Style>
    <Style Selector="Border.sev.warn ctl|TecIcon">
      <Setter Property="Tint" Value="#8a6100" />
    </Style>

    <!-- 泳道级的角标（原型 .cbadge，「n 错误 / n 提醒」）整个去掉。
         同一条消息在这一页上本来就说了三遍：copybar 右端那枚 vchip 报总数、
         泳道头出错时描一圈红、出问题的那张步骤卡右上角有一枚记号——
         哪一路不能跑、坏在哪一步，后两样已经指到位了，中间这一层是重复。
         校验面板照旧从 copybar 那枚 vchip 点开。 -->

    <!-- 有错的那条泳道，头上描一圈红。原型是把整块染成 #fdf2f2——
         我们这块是 #d6b8bb 的实心底，染红只会脏，而且要跟蓝色选中环抢眼睛 -->
    <Style Selector="Border.laneHeadErr">
      <Setter Property="BorderBrush" Value="#d93025" />
    </Style>

    <!-- 面板头上那对「全部 / 仅错误」：两格坐在一块 #F0F0F0 的槽里（外面那层 Border），
         自己是透明的；选中那格浮成白的 + 一道浅影，像被抬起来一档 -->
    <Style Selector="Button.segb">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#5C5C5C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.segb:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0A000000" />
    </Style>
    <!-- 格子里那个数：常态灰，选中时染成强调蓝 -->
    <Style Selector="Button.segb TextBlock.segn">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="#8A8A8A" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.segb.on TextBlock.segn">
      <Setter Property="Foreground" Value="#1668C7" />
    </Style>
    <!-- 选中那格：字色写在 Button 自己身上，不写在 /template/ 的
         ContentPresenter 上——那条路只改得动背景，字色传不下去，
         结果两格长得一模一样，看不出选的是哪个（实测踩到） -->
    <!-- 选中那格：字色写在 Button 自己身上，不写在 /template/ 的 ContentPresenter 上——
         那条路只改得动背景，字色传不下去，结果两格长得一模一样，
         看不出选的是哪个（实测踩到）。从前选中是品牌红字 + 浅红底，
         那是「这一格被选中」而不是「这里有错」，跟旁边真正的红撞意思了 -->
    <Style Selector="Button.segb.on">
      <Setter Property="Foreground" Value="#1B1B1B" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.segb.on /template/ ContentPresenter">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#0D000000" />
    </Style>

    <!-- 面板右上那个收起叉：中性灰底，别蹭步骤卡那套青色 -->
    <Style Selector="Button.xbtn">
      <!-- 28 见方（参考稿）：42 高的面板头里，20 的钮显得点不着 -->
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.xbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F5F5F5" />
    </Style>
    <Style Selector="Button.xbtn:pointerover">
      <Setter Property="Foreground" Value="#1B1B1B" />
    </Style>

    <!-- 圆圈箭头：展开朝上、收起朝下。22px 是原型 .dev .exp 的尺寸 -->
    <Style Selector="Border.exp3">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="BorderBrush" Value="#676b70" />
      <Setter Property="BorderThickness" Value="1.6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 变量表的小输入格 -->
    <Style Selector="TextBox.vcell">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#d4d6d3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="Border.exp3s">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="#676b70" />
      <Setter Property="BorderThickness" Value="1.3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.exp3 > :is(Control), Border.exp3s > :is(Control)">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.exp3.up, Border.exp3s.up">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="180" />
      </Setter>
    </Style>
    <!-- 小节头：整行可点，看起来还是一行字 -->
    <Style Selector="Button.secbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.secbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- .pf-row.bool：14px 方框 + 11.5px 文字，与台面属性同款 -->
    <Style Selector="CheckBox.chk2">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#3a3d41" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- 正文里的链接：看着是一句话的一部分，不是一个按钮 -->
    <Style Selector="Button.linkbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#a41626" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.linkbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#7e0f1c" />
    </Style>
    <Style Selector="Border.stepGhost">
      <Setter Property="Opacity" Value="0.42" />
    </Style>
    <!--
      拖拽落点这一整套从品牌红换成菜单蓝 #2A6FE5（浅底 #E8F0FD）：
      泳道描边、步骤之间那根落点条、末尾那个虚线框、跟手的幽灵卡描边，
      四样一起换——它们说的是同一件事「松手就放这儿」，不该一半红一半别的。

      为什么不留红：红在这一页已经有主了——校验里的「错误」是红的。
      拖一个步骤的时候整条泳道镶一圈红边，跟「这条通道有错」长得一模一样，
      而这两件事的意思正好相反（一个是「可以放」，一个是「这儿不对」）。
      蓝在这套配色里的意思是「当前 / 生效中」（菜单选中就是它），
      落点是个转瞬即逝的「现在指着这儿」，正好同一支。
    -->
    <Style Selector="Border.laneDrop">
      <Setter Property="BorderBrush" Value="{StaticResource MenuBlue}" />
      <Setter Property="Background" Value="#f5f9ff" />
    </Style>

    <!--
      步骤卡外面那层壳。**横向那 10 撤了，只留竖向的 5。**

      它当初是给选中环占位的（环画在壳的外沿，2 的描边 + 3 的内边距，每边 5），
      这样选不选中卡片的宽高都不变、描述不会重新折行。选中改到卡片自己那圈描边
      之后（见 Border.step.stepSel），横向这 10 就纯粹是白让的了——
      卡片 222，泳道内容却得留 232，头卡还比步骤卡宽出 10。

      竖向那 5 留着：卡与卡之间的疏密全靠它（14 的连接线 + 上下各 5 = 24），
      撤了整列会紧一档，那不是这次要动的东西。 -->
    <Style Selector="Border.stepwrap">
      <Setter Property="Padding" Value="0,5" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
      步骤卡的描边只说一件事：**这一张是不是当前选中的**。见上面 Border.step.stepSel。

      去掉的两条，记在这儿免得又加回来：
      · 选中环（Rectangle.selring）——黑虚线 2px + 5% 黑铺底，盖在卡片之上。
        现在选中改成卡片自己那圈描边染黑，一条实线，不再另铺一层。
      · 出错红框（Border.step.stepErr）——描边染 #d93025。
        「这一步有事」改由卡片右上那枚红色感叹号徽记单说（它本来就在，
        还带 ToolTip 说得出是什么事）；描边腾出来专给选中用，
        一张卡上不会再同时挂两种意思的框。
    -->
  </UserControl.Styles>
</UserControl>
