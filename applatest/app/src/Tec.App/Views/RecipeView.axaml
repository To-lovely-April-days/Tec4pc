<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             xmlns:v="clr-namespace:Tec.App.Views"
             x:Class="Tec.App.Views.RecipeView"
             Focusable="True" KeyDown="OnKeyDown">

  <!-- 原型 view-recipe：工具箱 308 ｜ 中列 ｜ 属性 342 -->
  <Grid ColumnDefinitions="308,*,342">

    <!-- ══ 左：步骤工具箱 ══
         与台面设备库同一套：一个模块 = 一块主题色，块之间留 3px 白缝 -->
    <Border Grid.Column="0" Background="{StaticResource ThemeGap}"
            BorderBrush="#dcdcdc" BorderThickness="0,0,1,0">
      <ScrollViewer Padding="0,0,0,40">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource ThemeFill}" Margin="0,0,0,7">
                <StackPanel>
                  <!-- grpbar：圆形箭头 + 模块色块 + 组名（通用组没有条，直接平铺） -->
                  <Border IsVisible="{Binding HasBar}" Background="Transparent"
                          Padding="10,8" PointerPressed="OnGroupBarPressed" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                      <!-- 展开时箭头朝上，收起朝下。原来钉死成 ui-chev-up，
                           点了内容收了、箭头没动，看着像没生效 -->
                      <Border Classes="exp3" Classes.up="{Binding Open}">
                        <ctl:TecIcon Key="ui-chev-down" Tint="#555555"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Border Width="12" Height="12" CornerRadius="3"
                              Background="{Binding Color}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Light"
                                 Foreground="#3d3d3d" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>

                  <!-- cmdgrid：4 列 × 84 高，图标 + 指令名 -->
                  <ItemsControl ItemsSource="{Binding Commands}" IsVisible="{Binding Open}"
                                Margin="6,6,6,10">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="cmd" Command="{Binding $parent[UserControl].DataContext.AddStep}"
                                CommandParameter="{Binding}">
                          <StackPanel>
                            <Panel Height="34">
                              <ctl:TecIcon Key="{Binding IconKey}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#3a3a3a"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- ══ 中：配方工具条 + 一键复制 + 泳道 ══ -->
    <DockPanel Grid.Column="1" Background="White">

      <!-- advbar -->
      <Border DockPanel.Dock="Top" Height="44" BorderBrush="#e3e3e3" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
          <TextBlock Text="配方：" Classes="lbl" />
          <ComboBox Classes="sel" Width="220" ItemsSource="{Binding Lanes}"
                    SelectedItem="{Binding CurLane, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding LaneName}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="tbtn sm" ToolTip.Tip="新建：把当前通道清成空配方"
                  Command="{Binding NewRecipe}" IsEnabled="{Binding HasLanes}">
            <ctl:TecIcon Key="ui-bar-plus" />
          </Button>
          <Button Classes="tbtn sm" ToolTip.Tip="撤销（当前通道）"
                  Command="{Binding Undo}" IsEnabled="{Binding CanUndo}">
            <ctl:TecIcon Key="ui-bar-undo" />
          </Button>
          <Button Classes="tbtn sm" ToolTip.Tip="重做（当前通道）"
                  Command="{Binding Redo}" IsEnabled="{Binding CanRedo}">
            <ctl:TecIcon Key="ui-bar-redo" />
          </Button>
          <Border Width="1" Height="20" Background="#dcdcdc" Margin="4,0" />
          <Button Classes="tbtn sm" ToolTip.Tip="导入配方文件到当前通道（.tecrecipe）"
                  Command="{Binding ImportRecipe}" IsEnabled="{Binding HasLanes}">
            <ctl:TecIcon Key="ui-snav-import" />
          </Button>
          <Button Classes="tbtn sm" ToolTip.Tip="把当前通道的配方导出成文件（.tecrecipe）"
                  Command="{Binding ExportRecipe}" IsEnabled="{Binding HasLanes}">
            <ctl:TecIcon Key="ui-snav-export" />
          </Button>
          <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="11"
                     Foreground="#7a7a7a" VerticalAlignment="Center" Margin="6,0,0,0"
                     TextTrimming="CharacterEllipsis" MaxWidth="360" />
        </StackPanel>
      </Border>

      <!-- copybar：没有通道就没得复制，整条收起来 -->
      <Border DockPanel.Dock="Top" Background="#fafafa" BorderBrush="#e3e3e3"
              IsVisible="{Binding HasLanes}"
              BorderThickness="0,0,0,1" Padding="14,8">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ctl:TecIcon Key="ui-copybar" />
          <TextBlock Classes="lbl">
            <Run Text="把 " /><Run Text="{Binding CurName}" FontWeight="SemiBold" /><Run Text=" 的配方复制到" />
          </TextBlock>
          <ComboBox Classes="sel" Width="130" ItemsSource="{Binding CopyTargets}"
                    SelectedItem="{Binding CopyTarget, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="btn primary" Content="一键复制" Command="{Binding CopyRecipe}" />
          <TextBlock Text="各通道配方可独立编辑，互不影响" FontSize="12" Foreground="#9a9a9a"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- 校验条：有问题才出现。校验器一直在跑，以前结果直接扔了 -->
      <Border DockPanel.Dock="Top" Background="#fdf6f5" BorderBrush="#f0d8d4"
              BorderThickness="0,0,0,1" Padding="14,7" IsVisible="{Binding HasProblems}">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="配方校验" FontSize="11.5" Foreground="#3d3d3d" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ProblemSummary}" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="#c62828" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalNote}" FontSize="11" Foreground="#9a9a9a"
                       VerticalAlignment="Center" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Problems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="issue" Command="{Binding $parent[UserControl].DataContext.PickIssue}"
                        CommandParameter="{Binding}" IsEnabled="{Binding CanGo}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                            Background="{Binding Dot}" />
                    <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="#3d3d3d"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- lanes：网格底纹 + 泳道横排 -->
      <Panel>
        <ctl:GridBackdrop LineBrush="#fbfbfb" />
        <StackPanel IsVisible="{Binding NoLanes}" Margin="30,26" Spacing="7"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
          <TextBlock Text="还没有通道" FontSize="15" Foreground="#6f6f6f" />
          <TextBlock FontSize="12" Foreground="#9a9a9a" LineHeight="19" MaxWidth="480"
                     TextWrapping="Wrap"
                     Text="每台双通道反应器带来两条泳道。先去「台面」把反应器拖进来，这里就会出现对应的泳道。" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Lanes}" Margin="14,12,14,40">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- .lane：选中 = 蓝实线边 + 柔环 -->
                <Border Width="300" Padding="4" CornerRadius="5" BorderThickness="1.6"
                        Tag="lane"
                        BorderBrush="Transparent" Background="Transparent"
                        Classes.laneSel="{Binding IsCurrent}"
                        Classes.laneDrop="{Binding IsDropLane}"
                        PointerPressed="OnLanePressed" Cursor="Hand">
                  <StackPanel>
                    <!-- lane-head：淡紫粉底 #efd9ec -->
                    <Border Background="#efd9ec" CornerRadius="3" Padding="10,9">
                      <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="名称：" FontSize="12" Width="42" VerticalAlignment="Center" />
                          <TextBox Classes="finput" Width="150"
                                   Text="{Binding LaneName, Mode=TwoWay}" />
                          <Button Classes="lhbtn" ToolTip.Tip="删除该通道标签"
                                  Click="OnLaneRemove">
                            <ctl:TecIcon Key="ui-lane-trash" Tint="#3a3a3a" />
                          </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="通道：" FontSize="12" Width="42" VerticalAlignment="Center" />
                          <ComboBox Classes="sel" Width="150" Height="26"
                                    ItemsSource="{Binding ChannelOptions}"
                                    SelectedItem="{Binding ChannelPick, Mode=TwoWay}" />
                          <Button Classes="lhbtn" ToolTip.Tip="通道属性（在台面中设置）">
                            <ctl:TecIcon Key="ui-lane-pencil" Tint="#3a3a3a" />
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- lane-body：开始帽 → 步骤卡 → 落点 → 结束帽 -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                      <Border Width="270" Height="30" Background="#2eaa4e" CornerRadius="2" Padding="11,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <ctl:TecIcon Key="ui-cap-begin" />
                          <TextBlock Text="开始" Foreground="White" FontSize="12.5" />
                        </StackPanel>
                      </Border>

                      <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel HorizontalAlignment="Center">
                              <!-- 连接线那一截同时当落点指示条用：高度不变，拖动时版面不跳 -->
                              <Panel Height="14">
                                <Border Width="1" Height="14" Background="#7a7a7a"
                                        HorizontalAlignment="Center" />
                                <Border Width="270" Height="4" CornerRadius="2" Background="#1a7fc4"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding DropBefore}" />
                              </Panel>
                              <!-- 循环体缩进：每套一层让出 14px，并在让出的位置画一条竖线。
                                   泳道整体仍是 270 宽，四条泳道对得齐 -->
                              <StackPanel Orientation="Horizontal" Width="270">
                              <ItemsControl ItemsSource="{Binding Spines}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Panel Width="14">
                                      <Border Width="2" Background="#c9ced3" HorizontalAlignment="Center" />
                                    </Panel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <!-- .step 卡片 -->
                              <Border Width="{Binding CardWidth}" Background="White" BorderBrush="#d3dae0"
                                      BorderThickness="1" CornerRadius="4" Cursor="Hand"
                                      Tag="stepcard"
                                      Classes.stepSel="{Binding IsSelected}"
                                      Classes.stepGhost="{Binding Ghosted}"
                                      PointerPressed="OnStepPressed">
                                <StackPanel>
                                  <Grid ColumnDefinitions="Auto,*" Margin="9,8">
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="5"
                                            Background="{Binding ModuleColor}">
                                      <ctl:TecIcon Key="{Binding IconKey}" White="True" Size="26"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,1,0,0">
                                      <TextBlock Text="{Binding Desc}" FontSize="11.5" Foreground="#22303a"
                                                 TextWrapping="Wrap" MaxLines="3" LineHeight="16" />
                                      <TextBlock Text="{Binding ModLine}" FontSize="9.5" Foreground="#93a3ae"
                                                 Margin="0,3,0,0" />
                                    </StackPanel>
                                  </Grid>
                                  <!-- sfoot -->
                                  <Border Background="#fafbfc" BorderBrush="#eef1f3" BorderThickness="0,1,0,0"
                                          CornerRadius="0,0,4,4" Padding="9,4,9,5">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                      <TextBlock Grid.Column="0" FontSize="10" Foreground="#8b98a2">
                                        <Run Text="预计开始 " /><Run Text="{Binding PlanStart}"
                                            FontWeight="SemiBold" Foreground="#4a5560" />
                                      </TextBlock>
                                      <TextBlock Grid.Column="2" FontSize="10" Foreground="#a8b3bb"
                                                 IsVisible="{Binding HasDuration}" Margin="0,0,8,0">
                                        <Run Text="耗时 " /><Run Text="{Binding PlanDuration}" />
                                      </TextBlock>
                                      <Button Grid.Column="3" Classes="trash" ToolTip.Tip="删除该步骤"
                                              Command="{Binding $parent[UserControl].DataContext.RemoveStep}"
                                              CommandParameter="{Binding}">
                                        <ctl:TecIcon Key="ui-trash-step" />
                                      </Button>
                                    </Grid>
                                  </Border>
                                </StackPanel>
                              </Border>
                              </StackPanel>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Panel Height="14">
                        <Border Width="1" Height="14" Background="#7a7a7a" HorizontalAlignment="Center" />
                        <Border Width="270" Height="4" CornerRadius="2" Background="#1a7fc4"
                                VerticalAlignment="Center" IsVisible="{Binding DropAtEnd}" />
                      </Panel>
                      <Panel Width="270" Height="64">
                        <Rectangle Fill="White" Stroke="#9a9a9a" StrokeThickness="1.5"
                                   StrokeDashArray="4,3" IsVisible="{Binding !DropAtEnd}" />
                        <Rectangle Fill="#eef7fd" Stroke="#1a7fc4" StrokeThickness="1.8"
                                   StrokeDashArray="4,3" IsVisible="{Binding DropAtEnd}" />
                        <TextBlock Text="{Binding DropHint}" FontSize="11" Foreground="#8d8d8d"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="4" />
                      </Panel>
                      <Border Width="1" Height="14" Background="#7a7a7a" HorizontalAlignment="Center" />
                      <Border Width="270" Height="30" Background="#b8483c" CornerRadius="2" Padding="11,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <ctl:TecIcon Key="ui-cap-end" />
                          <TextBlock Text="结束" Foreground="White" FontSize="12.5" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </DockPanel>

    <!-- ══ 右：步骤属性 + 应用配方库 + 通道状态 ══ -->
    <!-- 与台面属性同一套观感：白底面板 + 浅紫内容块 -->
    <Border Grid.Column="2" Background="{StaticResource ThemeGap}"
            BorderBrush="#d2d2d2" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <Border Background="{StaticResource ThemeFill}" Padding="18,16,18,20">
        <StackPanel Spacing="0">
          <!-- 标题恒为「步骤属性」；选没选中步骤只改下面的内容 -->
          <TextBlock Text="步骤属性" Classes="h2big" />
          <TextBlock Classes="intro" IsVisible="{Binding NoSelection}"
                     Text="点选画布中的步骤，在此查看与编辑其参数。" />

          <!-- prop-head：模块色块 + 指令名 + 它属于哪个通道 -->
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,12"
                      HorizontalAlignment="Center" IsVisible="{Binding HasSelection}">
            <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                    Background="{Binding StepColor}" />
            <TextBlock Text="{Binding StepName}" FontSize="21" FontWeight="Light"
                       Foreground="#333333" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StepChannel}" FontSize="12" Foreground="#8d8d8d"
                       VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock IsVisible="{Binding NoParams}" Text="该指令无需设置参数。"
                     FontSize="11.5" Foreground="#8d8d8d" Margin="0,2,0,8" />

          <StackPanel IsVisible="{Binding HasSelection}">
            <v:SchemaFormView DataContext="{Binding Form}" />
          </StackPanel>

          <!-- 执行选项：两个真会影响运行的开关 -->
          <StackPanel IsVisible="{Binding HasSelection}" Margin="0,14,0,0" Spacing="6">
            <Button Classes="secbtn" Command="{Binding ExecSection.Toggle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="exp3s" Classes.up="{Binding ExecSection.Open}">
                  <ctl:TecIcon Key="ui-chev-down" Tint="#555555" Size="10" />
                </Border>
                <TextBlock Text="执行选项" Classes="acc" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel IsVisible="{Binding ExecSection.Open}" Spacing="6">
              <CheckBox Classes="chk2" Content="失败时暂停并报警"
                        IsChecked="{Binding PauseOnFault, Mode=TwoWay}" />
              <CheckBox Classes="chk2" Content="跳过该步骤（不执行、不计入排期）"
                        IsChecked="{Binding StepSkipped, Mode=TwoWay}" />
            </StackPanel>
          </StackPanel>

          <Border Height="1" Background="#d5d5d5" Margin="0,14" />
          <Button Classes="secbtn" Command="{Binding LibSection.Toggle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="exp3s" Classes.up="{Binding LibSection.Open}">
                <ctl:TecIcon Key="ui-chev-down" Tint="#555555" Size="10" />
              </Border>
              <TextBlock Text="应用配方库" Classes="acc" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel IsVisible="{Binding LibSection.Open}">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
            <TextBlock Text="配方" Classes="lbl" Width="40" />
            <ComboBox Classes="sel" Width="220" ItemsSource="{Binding Library}"
                      SelectedItem="{Binding LibPick, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <!-- 圆圈图标 + 居中，与台面属性底部那排动作按钮同款 -->
          <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,12,0,8"
                      HorizontalAlignment="Center">
            <Button Classes="tbtn foot" ToolTip.Tip="应用到当前通道（替换全部步骤）"
                    Command="{Binding ApplyLib}">
              <ctl:TecIcon Key="ui-snav-import" />
            </Button>
            <Button Classes="tbtn foot" ToolTip.Tip="把当前通道的配方存入配方库"
                    Command="{Binding SaveToLib}">
              <ctl:TecIcon Key="ui-foot-save" />
            </Button>
          </StackPanel>
          <TextBlock FontSize="11.5" Foreground="#5a5a5a" LineHeight="18"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0">
            <Run Text="应用会替换当前通道的全部步骤。" />
            <InlineUIContainer>
              <Button Classes="linkbtn" Content="管理配方库 →" Command="{Binding ManageLibrary}" />
            </InlineUIContainer>
          </TextBlock>
          </StackPanel>

          <Border Height="1" Background="#d5d5d5" Margin="0,10" />
          <Button Classes="secbtn" Command="{Binding StatesSection.Toggle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="exp3s" Classes.up="{Binding StatesSection.Open}">
                <ctl:TecIcon Key="ui-chev-down" Tint="#555555" Size="10" />
              </Border>
              <TextBlock Text="通道状态" Classes="acc" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Background="White" BorderBrush="#dcdcdc" BorderThickness="1" CornerRadius="3"
                  IsVisible="{Binding StatesSection.Open}">
            <ItemsControl ItemsSource="{Binding ChannelStates}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#eeeeee" BorderThickness="0,0,0,1" Padding="10,7">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <Border Grid.Column="0" Width="9" Height="9" CornerRadius="5" Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Background="{Binding Lit, Converter={x:Static v:Converters.LedBrush}}"
                              BorderBrush="#a5a5a5" BorderThickness="1" />
                      <Border Grid.Column="1" Width="11" Height="11" CornerRadius="3" Margin="0,0,8,0"
                              VerticalAlignment="Center" Background="{Binding ColorHex}" />
                      <!-- 两个 TextBlock 而不是一个带 Run 的：Run 上挂 StringFormat 会和
                           TextBlock 的 inlines 变更互相触发，转起来收不住（栈溢出） -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#2b2b2b"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ChannelSuffix}" FontSize="12" Foreground="#9a9a9a" />
                      </StackPanel>
                      <TextBlock Grid.Column="3" Text="{Binding State}" FontSize="11"
                                 Foreground="#8d8d8d" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
        </Border>
      </ScrollViewer>
    </Border>
    <!-- 跟手的幽灵卡。盖在三列之上、不吃事件，所以底下照样能命中泳道 -->
    <Canvas Grid.Column="0" Grid.ColumnSpan="3" IsHitTestVisible="False">
      <Border IsVisible="{Binding Dragging}"
              Canvas.Left="{Binding DragX}" Canvas.Top="{Binding DragY}"
              Width="216" Background="White" BorderBrush="#1a7fc4" BorderThickness="1.5"
              CornerRadius="4" Padding="8,6" Opacity="0.94"
              BoxShadow="0 5 16 0 #33000000">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Border Width="30" Height="30" CornerRadius="4" Background="{Binding DragColor}">
            <ctl:TecIcon Key="{Binding DragIcon}" White="True" Size="19"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding DragTitle}" FontSize="12" Foreground="#22303a"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </Canvas>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.cmd">
      <Setter Property="Height" Value="84" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="3,8,3,4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cmd:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e8f4fb" />
    </Style>

    <Style Selector="Button.lhbtn">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#8a6a86" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.lhbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e8f2fb" />
      <Setter Property="BorderBrush" Value="#1a7fc4" />
    </Style>

    <Style Selector="Button.trash">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.trash:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#fdecea" />
    </Style>

    <Style Selector="Border.laneSel">
      <Setter Property="BorderBrush" Value="#1a7fc4" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BoxShadow" Value="0 0 0 3 #381a7fc4, 0 2 10 0 #12000000" />
    </Style>
    <!-- 校验条里的一条：整行可点，跳到出问题的那一步 -->
    <Style Selector="Button.issue">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.issue:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#f7e7e4" />
    </Style>
    <Style Selector="Button.issue:disabled">
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- 圆圈箭头：展开朝上、收起朝下 -->
    <Style Selector="Border.exp3">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#6b6b6b" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.exp3s">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="#6b6b6b" />
      <Setter Property="BorderThickness" Value="1.3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.exp3 > :is(Control), Border.exp3s > :is(Control)">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.exp3.up, Border.exp3s.up">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="180" />
      </Setter>
    </Style>
    <!-- 小节头：整行可点，看起来还是一行字 -->
    <Style Selector="Button.secbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.secbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- .pf-row.bool：14px 方框 + 11.5px 文字，与台面属性同款 -->
    <Style Selector="CheckBox.chk2">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#3d3d3d" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- 正文里的链接：看着是一句话的一部分，不是一个按钮 -->
    <Style Selector="Button.linkbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#1a7fc4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.linkbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#12628f" />
    </Style>
    <Style Selector="Border.stepGhost">
      <Setter Property="Opacity" Value="0.42" />
    </Style>
    <Style Selector="Border.laneDrop">
      <Setter Property="BorderBrush" Value="#1a7fc4" />
      <Setter Property="Background" Value="#f7fbfe" />
    </Style>
    <Style Selector="Border.stepSel">
      <Setter Property="BorderBrush" Value="#1a7fc4" />
      <Setter Property="BoxShadow" Value="0 0 0 2 #1a7fc4, 0 0 0 5 #381a7fc4" />
    </Style>
  </UserControl.Styles>
</UserControl>
