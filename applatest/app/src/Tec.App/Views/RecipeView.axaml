<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             xmlns:v="clr-namespace:Tec.App.Views"
             x:Class="Tec.App.Views.RecipeView"
             Focusable="True" KeyDown="OnKeyDown">

  <!--
    左侧步骤库和中间的编辑区照 iControl 6.2 那份原型改：
    步骤库 259 + 1px 分界 ｜ 流程区 ｜ 属性 342（属性栏不动，仍是台面页那一套）。

    左侧色条一律 6px。全程序用到这条「左边一道色条 = 这一块属于谁」的地方
    一共四处，从前各写各的（12 / 11 / 6 / 4），同一个说法四个粗细：
      · 配方页 步骤卡（原型 .step .sbar 11）
      · 配方页 / 台面页 属性块          ← 6，基准就是它
      · 运行页 通道磁贴（12）
      · 运行页 热编辑步骤行（4）
    旁边那些 12×12 的小色块是另一回事（色卡，不是色条），不在此列。
    步骤库的分组从整块色底改成了「3×11 的一小截色记号」，也不在此列。
  -->
  <Grid ColumnDefinitions="260,*,342">

    <!-- ══ 左：步骤库 ══
         原型是一栏 259 宽的白列：24px 深色标题条 + 35px 搜索行 + 一条条 23px 的
         指令行（15px 红方块图标 + 13px 指令名），组与组之间一条 1px 分隔线。

         从「6 个 96px 的分组块 + 3 列 48px 图标格」换成平铺细行，是因为
         21 条指令铺成细行一屏就放得下（原来六组展开要滚三屏）。代价是
         48px 的彩色插画退到了步骤卡和属性栏，库里改用红底白线的小方块——
         48 缩到 15 那种多色带阴影的图会糊成一团，两处本来就不该是同一张图。 -->
    <Border Grid.Column="0" Background="#fdfdfd"
            BorderBrush="#c9c9c9" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- 标题条：原型是 #3d3d3d→#151515 的竖向渐变，这里压平成外壳黑，
             跟标题栏、属性栏那条色条同一个黑（用色纪律：大面积深色只有一种黑） -->
        <Border DockPanel.Dock="Top" Height="24" Background="{StaticResource Shell}"
                Padding="10,0">
          <TextBlock Text="步骤库" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                     VerticalAlignment="Center" />
        </Border>

        <!-- 搜索行：21 条指令分在 6 个模块里，平铺一屏放得下，但记不住
             「梯度控温」在哪一组的时候，打两个字比挨组翻快。
             指令名和模块名两处都匹配：打「温度」也该把那一组捞出来 -->
        <Border DockPanel.Dock="Top" Height="35" Background="#f1f1f1"
                BorderBrush="#cfcfcf" BorderThickness="0,0,0,1" Padding="9,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Classes="lfind" Watermark="搜索指令 / 模块"
                     Text="{Binding LibFilter, Mode=TwoWay}" />
            <Button Grid.Column="1" Classes="lfindx" Margin="6,0,0,0"
                    IsVisible="{Binding HasLibFilter}" Command="{Binding ClearLibFilter}"
                    ToolTip.Tip="清除搜索">
              <TextBlock Text="✕" FontSize="10" Foreground="#6b6f74"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>
        </Border>

        <!-- 底部那截留白写在内容的 Margin 上，不写 ScrollViewer 的 Padding：
             Padding 是从可视区里扣的，不进滚动范围——最后一行会卡在下边缘，
             滚到底也露不出来 -->
        <ScrollViewer>
          <StackPanel Margin="0,7,0,18">
            <TextBlock Text="没有匹配的指令" FontSize="12" Foreground="#959a9f"
                       Margin="12,8,0,0" IsVisible="{Binding LibEmpty}" />
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel IsVisible="{Binding Visible}">
                    <!-- 组与组之间才有一条线，第一组上面没有。搜索把前几组滤没了
                         之后这条线得跟着挪，所以由 Rule 决定，不按建库次序写死 -->
                    <Border Height="1" Background="#dcdcdc" Margin="8,10"
                            IsVisible="{Binding Rule}" />
                    <!-- 组名一行：小箭头 + 一小截模块色 + 组名。
                         原型的分组只有分隔线、没有组名——留着是因为
                         「控温」这四个字在哪一组，中文名不像英文那样自解释 -->
                    <Border Height="21" Background="Transparent" Cursor="Hand"
                            PointerPressed="OnGroupBarPressed">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Classes="chevm" Classes.up="{Binding Open}" Margin="10,0,6,0">
                          <ctl:TecIcon Key="ui-chev-down" Tint="#9aa0a6" Size="9" />
                        </Border>
                        <Border Width="3" Height="11" Background="{Binding Color}"
                                VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="#6b6f74"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Commands}" IsVisible="{Binding Open}"
                                  Margin="0,2,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Classes="lrow" ToolTip.Tip="点一下加到当前通道，按住拖到画布里指定位置"
                                  Command="{Binding $parent[UserControl].DataContext.AddStep}"
                                  CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                              <!-- 方块底是 Border、图标铺在上面，不是给 TecIcon 加描边：
                                   原型那张图的白线本来就画到方块边上，
                                   用 BorderThickness 装它会把线切掉一圈 -->
                              <Panel Classes="tile15">
                                <Border Classes="tilebg15" />
                                <ctl:TecIcon Key="{Binding TileIcon}" Size="15" />
                              </Panel>
                              <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#1b1b1b"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ══ 中：工具条 + 一键复制 + 校验 + 泳道（原型 .procwrap）══
         右边留 6px 白：工具条那条 #ecedea 的灰带一直铺到属性栏跟前，
         而属性栏那块是 #ebece9——差一级，眼睛看不出是两块，整条通到底。
         左边靠步骤库那 4px 白缝分开，右边照样得有一条 -->
    <Border Grid.Column="1" Background="White" Padding="0,0,6,0">
    <DockPanel>

      <!-- 原型 .proctool：58 高、#ecedea 一条整的、34px 圆钮 -->
      <Border DockPanel.Dock="Top" Height="58" Background="#ecedea">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0" VerticalAlignment="Center">
          <TextBlock Text="配方：" Classes="lbl" />
          <ComboBox Classes="sel" Width="246" ItemsSource="{Binding Lanes}"
                    SelectedItem="{Binding CurLane, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding LaneName}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="tbtn" ToolTip.Tip="新建：把当前通道清成空配方"
                  Command="{Binding NewRecipe}" IsEnabled="{Binding HasLanes}">
            <ctl:TecIcon Key="ui-bar-plus" />
          </Button>
          <Button Classes="tbtn" ToolTip.Tip="撤销（当前通道）"
                  Command="{Binding Undo}" IsEnabled="{Binding CanUndo}">
            <ctl:TecIcon Key="ui-bar-undo" />
          </Button>
          <Button Classes="tbtn" ToolTip.Tip="重做（当前通道）"
                  Command="{Binding Redo}" IsEnabled="{Binding CanRedo}">
            <ctl:TecIcon Key="ui-bar-redo" />
          </Button>
          <Border Width="1" Height="22" Background="#cdcfcd" Margin="4,0" />
          <Button Classes="tbtn" ToolTip.Tip="导入配方文件到当前通道（.tecrecipe）"
                  Command="{Binding ImportRecipe}" IsEnabled="{Binding HasLanes}">
            <ctl:TecIcon Key="ui-snav-import" />
          </Button>
          <Button Classes="tbtn" ToolTip.Tip="把当前通道的配方导出成文件（.tecrecipe）"
                  Command="{Binding ExportRecipe}" IsEnabled="{Binding HasLanes}">
            <ctl:TecIcon Key="ui-snav-export" />
          </Button>
          <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="11"
                     Foreground="#666a6f" VerticalAlignment="Center" Margin="6,0,0,0"
                     TextTrimming="CharacterEllipsis" MaxWidth="330" />
        </StackPanel>
      </Border>

      <!-- copybar（原型 .bar2）：左边一键复制，右端一枚校验 chip。
           #f5f5f4 比工具条那条 #ecedea 浅一档——两条灰带分得出层次，
           chip 的 hover / 展开态才有白底可反白（白条上反白等于没反应）。

           校验并进这一行、不另立一条：它不是一块常驻内容，是一枚状态灯。
           从前那条校验条摊在画布上头，问题一多就把泳道往下顶，
           越是有问题越看不见配方——正好跟它的目的相反 -->
      <Border DockPanel.Dock="Top" Background="#f5f5f4" BorderBrush="#e1e3e0"
              IsVisible="{Binding HasLanes}"
              BorderThickness="0,0,0,1" Padding="14,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ctl:TecIcon Key="ui-copybar" />
            <TextBlock Classes="lbl">
              <Run Text="把 " /><Run Text="{Binding CurName}" FontWeight="SemiBold" /><Run Text=" 的配方复制到" />
            </TextBlock>
            <ComboBox Classes="sel" Width="130" ItemsSource="{Binding CopyTargets}"
                      SelectedItem="{Binding CopyTarget, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="btn primary" Content="一键复制" Command="{Binding CopyRecipe}" />
            <TextBlock Text="各通道配方可独立编辑，互不影响" FontSize="12" Foreground="#888d92"
                       VerticalAlignment="Center" />
          </StackPanel>

          <!-- 校验 chip（原型 .vchip）：没问题时是一枚绿灯，也照常摆着——
               「没报错」和「没校验」不是一回事，空着说不清是哪种 -->
          <Button Grid.Column="2" Classes="vchip" Classes.open="{Binding PanelOpen}"
                  Command="{Binding TogglePanel}" IsEnabled="{Binding HasProblems}">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                          IsVisible="{Binding PanelEmptyAll}">
                <Border Width="8" Height="8" CornerRadius="4" Background="#2fa35f"
                        VerticalAlignment="Center" />
                <TextBlock Text="校验通过" FontSize="12.5" Foreground="#0e7a3e"
                           VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                          IsVisible="{Binding HasErrors}">
                <Border Width="8" Height="8" CornerRadius="4" Background="#d93025"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorText}" FontSize="12.5" Foreground="#d93025"
                           VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                          IsVisible="{Binding HasWarns}">
                <Border Width="8" Height="8" CornerRadius="4" Background="#e8a33d"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding WarnText}" FontSize="12.5" Foreground="#8a6100"
                           VerticalAlignment="Center" />
              </StackPanel>
              <!-- 「多久 · 几步」跟问题无关，隔一条竖线自己占一段 -->
              <Border Width="1" Height="14" Background="#dadcd9" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ScaleText}" FontSize="12" Foreground="#888d92"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding PanelArrow}" FontSize="9" Foreground="#888d92"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- 画布 + 浮在画布上的校验面板。面板浮着不占位：它一展开就把泳道挤扁的话，
           人一边看清单一边找那一步，找的过程里版面又变一次 -->
      <Panel>
      <!-- 画布行（原型 .canvasrow）：左缘一条「变量」竖栏 + 8px 白缝 + 泳道区。
           原型 Process 视图左缘是三条竖栏（Variables / Startup / Shutdown），
           我们要的只有变量这一件事，就一条。样式照 .vcol：64 宽、#f1f2f0、
           右侧 1px #d7d9d6 分界、22px 圆圈箭头（exp3 与它同规格）+ 竖排名。
           原型竖排字 20px Latin，按惯用换算中文取 17。

           中间那道白缝是原型的做法：竖栏之间、竖栏与泳道之间都空一条纯白，
           两块灰各自成块，不连成一片。它只有在**两边都是灰**的时候才看得见——
           从前画布铺的是径向渐变，最亮的一头正好落在左缘（实测 249,249,249），
           白缝糊在那片近白里等于没有。所以画布底色压平成 #f0f0f0：
           跟竖栏那 #f1f2f0 同一档，白缝夹在中间才立得住。 -->
      <Grid ColumnDefinitions="Auto,8,*">

        <!-- 收起态：点整条都能展开 -->
        <Border Grid.Column="0" Width="64" Background="#f1f2f0"
                BorderBrush="#d7d9d6" BorderThickness="0,0,1,0"
                IsVisible="{Binding VarsClosed}" Cursor="Hand"
                PointerPressed="OnVarsBarPressed">
          <StackPanel Margin="0,12,0,0" Spacing="12" HorizontalAlignment="Center">
            <Border Classes="exp3">
              <!-- 收起时箭头指右（原型 .vcol 的朝向）：down 逆时针转 90° -->
              <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                <LayoutTransformControl.LayoutTransform>
                  <RotateTransform Angle="-90" />
                </LayoutTransformControl.LayoutTransform>
                <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" />
              </LayoutTransformControl>
            </Border>
            <!-- 竖排组名：汉字一个个正着摞下来，不是把整行转 90°。
                 原型那条竖栏写的是 Variables，拉丁字母转着读没问题；
                 汉字转 90° 就是躺倒的字，读起来像坏了（原来就是转的） -->
            <TextBlock Text="变&#x0a;量" FontSize="17" FontWeight="Light"
                       Foreground="#3a3d41" LineHeight="21" TextAlignment="Center"
                       HorizontalAlignment="Center" />
            <Border Background="#d7d9d6" CornerRadius="9" Padding="6,2"
                    HorizontalAlignment="Center" IsVisible="{Binding HasVarsBadge}">
              <TextBlock Text="{Binding VarsBadge}" FontSize="11" Foreground="#3a3d41" />
            </Border>
          </StackPanel>
        </Border>

        <!-- 展开态：变量表。行编辑直接写回配方，撤销 / 校验与步骤参数同一套 -->
        <Border Grid.Column="0" Width="332" Background="#fafafa"
                BorderBrush="#d7d9d6" BorderThickness="0,0,1,0"
                IsVisible="{Binding VarsOpen}">
          <DockPanel Margin="12,12,12,10">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12">
              <Border Classes="exp3" Cursor="Hand" PointerPressed="OnVarsBarPressed"
                      Background="Transparent">
                <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                  <LayoutTransformControl.LayoutTransform>
                    <RotateTransform Angle="90" />
                  </LayoutTransformControl.LayoutTransform>
                  <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" />
                </LayoutTransformControl>
              </Border>
              <TextBlock Text="变量" FontSize="17" FontWeight="Light" Foreground="#3a3d41"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding CurName}" FontSize="11" Foreground="#959a9f"
                         VerticalAlignment="Center" />
            </StackPanel>

            <!-- 底部：添加 + 用法说明 -->
            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
              <Button Classes="btn" Content="＋ 添加变量" Command="{Binding AddVar}"
                      IsEnabled="{Binding HasLanes}" HorizontalAlignment="Left" />
              <TextBlock FontSize="11" Foreground="#959a9f" LineHeight="16" TextWrapping="Wrap"
                         Text="变量用在：循环开始与等待的「按条件」、设定变量。条件里还能读实时量 Tr / Tj / pH / 浊度 / rpm。" />
            </StackPanel>

            <ScrollViewer>
              <StackPanel Margin="0,10,0,0" Spacing="4">
                <TextBlock Text="这条配方还没有变量" FontSize="12" Foreground="#959a9f"
                           IsVisible="{Binding NoVars}" Margin="2,4,0,0" />
                <!-- 表头 -->
                <Grid ColumnDefinitions="82,58,46,*,26" Margin="2,0,0,2"
                      IsVisible="{Binding !NoVars}">
                  <TextBlock Grid.Column="0" Text="名称" FontSize="10.5" Foreground="#858a8f" />
                  <TextBlock Grid.Column="1" Text="初值" FontSize="10.5" Foreground="#858a8f" />
                  <TextBlock Grid.Column="2" Text="单位" FontSize="10.5" Foreground="#858a8f" />
                  <TextBlock Grid.Column="3" Text="说明" FontSize="10.5" Foreground="#858a8f" />
                </Grid>
                <ItemsControl ItemsSource="{Binding VarRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="82,58,46,*,26" Margin="0,0,0,4">
                        <TextBox Grid.Column="0" Classes="vcell" Text="{Binding Name, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Classes="vcell" Text="{Binding InitText, Mode=TwoWay}"
                                 Margin="4,0,0,0" />
                        <TextBox Grid.Column="2" Classes="vcell" Text="{Binding Unit, Mode=TwoWay}"
                                 Margin="4,0,0,0" />
                        <TextBox Grid.Column="3" Classes="vcell" Text="{Binding NoteText, Mode=TwoWay}"
                                 Margin="4,0,0,0" />
                        <!-- 24 是这一格的硬上限：第 5 列写死 26，再让出按钮自己的 2px 左边距。
                             要放 32 得把表头（上面那个 Grid）和行模板两处列宽一起改，
                             「说明」列会从 81 掉到 73，行高还会被顶高 6px -->
                        <Button Grid.Column="4" Classes="tbtn del d24" Margin="2,0,0,0"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                ToolTip.Tip="删除该变量"
                                Command="{Binding $parent[UserControl].DataContext.RemoveVar}"
                                CommandParameter="{Binding}">
                          <ctl:TecIcon Key="ui-foot-trash" Size="11" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

      <!-- 白缝。纯白、8 宽，从上通到底（原型那三条竖栏之间就是这么隔的） -->
      <Border Grid.Column="1" Background="White" />

      <!-- 画布：一块平的 #f0f0f0。从前是纯白，配从前那种青色实心卡够用；
           现在卡片本身是白的（白→#f6f6f6 + 1px #cccccc），得有块底托着。
           不用原型那层径向渐变：原型的内容压在画布中段，我们的泳道一律贴左，
           而渐变最亮的一头正好在左缘，白缝会糊在里面（见上一段） -->
      <Panel Grid.Column="2" Background="#f0f0f0">
        <StackPanel IsVisible="{Binding NoLanes}" Margin="30,26" Spacing="7"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
          <TextBlock Text="还没有通道" FontSize="15" Foreground="#6b6f74" />
          <TextBlock FontSize="12" Foreground="#959a9f" LineHeight="19" MaxWidth="480"
                     TextWrapping="Wrap"
                     Text="每台双通道反应器带来两条泳道。先去「台面」把反应器拖进来，这里就会出现对应的泳道。" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <!-- 左边只留 4：白缝已经占了 8，两处加起来就把泳道推离竖栏太远了 -->
          <ItemsControl ItemsSource="{Binding Lanes}" Margin="4,14,0,40">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- 原型 .col 是 246 宽（卡片里的字放大到 12.5 之后，200 装不下排期那一行）。
                     外面这圈 padding 留给「当前通道」的选中环 -->
                <!-- 顶对齐（原型 .lanes{align-items:flex-start}）：不这么写的话
                     泳道会被拉到画布满高，选中环就变成一个从头拖到底的长框 -->
                <Border Width="258" Padding="5" CornerRadius="4" BorderThickness="1.6"
                        Tag="lane" VerticalAlignment="Top"
                        BorderBrush="Transparent" Background="Transparent"
                        Classes.laneSel="{Binding IsCurrent}"
                        Classes.laneDrop="{Binding IsDropLane}"
                        PointerPressed="OnLanePressed" Cursor="Hand">
                  <StackPanel>
                    <!-- 原型 .lane-head：#d6b8bb 一块，两行「标签 + 输入 + 圆钮」。
                         有错的时候描一圈红（原型是把整块染成 #fdf2f2，我们这块是
                         蓝灰的实心底，染红只会脏，而且要跟蓝色选中环抢眼睛）。
                         角标钉在这块的右上角、探出去一半（原型 .cbadge top/right -8） -->
                    <Panel>
                    <!-- 描边常在、平时不着色（BorderBrush 不写死成 Transparent：
                         内联值压得过样式，那样 laneHeadErr 永远上不了色，实测踩到）。
                         粗细恒为 1.4，出不出错都不改版 -->
                    <Border Background="#d6b8bb" CornerRadius="2" Padding="8,8,8,10"
                            BorderThickness="1.4"
                            Classes.laneHeadErr="{Binding HasErrors}">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="38,*,26">
                          <TextBlock Grid.Column="0" Text="名称" FontSize="12.5"
                                     Foreground="#292b2e" VerticalAlignment="Center" />
                          <TextBox Grid.Column="1" Classes="hin" Margin="6,0"
                                   Text="{Binding LaneName, Mode=TwoWay}" />
                          <!-- 从 lhbtn 家族里摘出来挂到 del 上，而不是去改 lhbtn 的样式：
                               正下方那颗「通道属性」铅笔钮（lhbtn sq）跟删除毫无关系，
                               它只覆写了圆角，其余全靠 lhbtn 基类——动基类等于连它一起改。
                               直径仍是 26（列宽写死 26），跟铅笔钮对得齐，只是底色和图标换了 -->
                          <Button Grid.Column="2" Classes="tbtn del d26" ToolTip.Tip="清空该通道的配方"
                                  Click="OnLaneRemove">
                            <ctl:TecIcon Key="ui-foot-trash" Size="12" />
                          </Button>
                        </Grid>
                        <Grid ColumnDefinitions="38,*,26">
                          <TextBlock Grid.Column="0" Text="通道" FontSize="12.5"
                                     Foreground="#292b2e" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="1" Classes="hsel" Margin="6,0"
                                    ItemsSource="{Binding ChannelOptions}"
                                    SelectedItem="{Binding ChannelPick, Mode=TwoWay}" />
                          <Button Grid.Column="2" Classes="lhbtn sq" ToolTip.Tip="通道属性（在台面中设置）">
                            <ctl:TecIcon Key="ui-lane-pencil" Tint="#1d1f22" />
                          </Button>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- 角标（原型 .cbadge）：实心胶囊，探出泳道头右上角。
                         四条泳道并排的时候，「哪一路不能跑」要在扫一眼的距离上
                         就分得出来，不该等人挨条点开看。点它展开校验面板。
                         只有提醒没有错误时转琥珀——两种后果不一样，颜色得跟着分 -->
                    <Button Classes="cbadge" Classes.warn="{Binding BadgeWarn}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-8,-8,0" IsVisible="{Binding HasBadge}"
                            ToolTip.Tip="{Binding BadgeTip}"
                            Command="{Binding $parent[UserControl].DataContext.OpenPanel}">
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="⚠" FontSize="10.5" Foreground="White"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BadgeText}" FontSize="11" Foreground="White"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    </Panel>

                    <!-- 原型 .lane-body：步骤卡竖着排，卡之间一截 14px 的细线 -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                      <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel HorizontalAlignment="Center">
                              <!-- 连接线那一截同时当落点指示条用：高度不变，拖动时版面不跳 -->
                              <Panel Height="14">
                                <Border Width="1" Height="14" Background="#757a7f"
                                        HorizontalAlignment="Center" />
                                <Border Width="246" Height="4" CornerRadius="2" Background="#a41626"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding DropBefore}" />
                              </Panel>
                              <!-- 循环体缩进：每套一层让出 14px，并在让出的位置画一条竖线。
                                   泳道整体仍是 246 宽，各条泳道对得齐 -->
                              <StackPanel Orientation="Horizontal" Width="246">
                              <ItemsControl ItemsSource="{Binding Spines}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Panel Width="14">
                                      <Border Width="2" Background="#c9ced3" HorizontalAlignment="Center" />
                                    </Panel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>

                              <!-- 原型 .step：白卡（白→#f6f6f6 竖向渐变 + 1px #cccccc），
                                   左上一枚 27px 红方块图标，右边整句描述；底下一条
                                   1px #dedede 把「这一步做什么」和「什么时候做」分开。

                                   外面这层 stepwrap 是原型那个 3px padding 的壳：
                                   选中环画在壳上（2px 主题红 + 一层 7% 的红），
                                   卡片自己的宽度不变，描述不会因为选中而重新折行。

                                   竖排模块名去掉了：描述本来就是一整句工艺语句，
                                   模块名在里头基本重复。模块身份留在左边那条 6px 色条上。 -->
                              <Border Classes="stepwrap" Width="{Binding CardWidth}"
                                      Tag="stepcard"
                                      Classes.stepSel="{Binding IsSelected}"
                                      Classes.stepGhost="{Binding Ghosted}"
                                      PointerPressed="OnStepPressed">
                                <Border Classes="step"
                                        Classes.stepSel="{Binding IsSelected}"
                                        Classes.stepErr="{Binding HasStepError}">
                                <Grid ColumnDefinitions="6,*">
                                  <Border Grid.Column="0" Background="{Binding ModuleColor}" />
                                  <!-- 第一行留星号：卡片有最小高度，多出来的空当落在这一行，
                                       那条分隔线才一直贴着底（原型 margin-top:auto） -->
                                  <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto"
                                        Margin="7,6,7,5">
                                    <Grid Grid.Row="0" ColumnDefinitions="27,7,*,Auto">
                                      <Panel Classes="tile27" VerticalAlignment="Top">
                                        <Border Classes="tilebg27" />
                                        <ctl:TecIcon Key="{Binding TileIcon}" Size="27" />
                                      </Panel>
                                      <TextBlock Grid.Column="2" Text="{Binding Desc}"
                                                 FontSize="12" Foreground="#1b1b1b"
                                                 LineHeight="15" TextWrapping="Wrap"
                                                 MaxLines="4" TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Top" />

                                      <!-- 徽记（原型 .sbadge）。悬停能读到具体哪儿不对——
                                           红框只说「这一步有事」，是什么事得说得出来，
                                           不然人还得回面板里对 -->
                                      <Border Grid.Column="3" Width="17" Height="17"
                                              CornerRadius="9" Classes="sbadge"
                                              Classes.warn="{Binding IssueWarn}"
                                              VerticalAlignment="Top" Margin="6,0,0,0"
                                              IsVisible="{Binding HasIssue}"
                                              ToolTip.Tip="{Binding IssueTip}">
                                        <TextBlock Text="!" FontSize="11" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                      </Border>
                                    </Grid>

                                    <Border Grid.Row="1" Height="1" Background="#dedede"
                                            Margin="0,6,0,0" />

                                    <!-- 排期这一行：左边预计开始，右边耗时，垃圾桶收在最右。
                                         d24 是删除钮一族里最小的一号（见 App.axaml 那段说明），
                                         这一行的高度就是它撑出来的 -->
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto"
                                          Margin="0,3,0,0">
                                      <TextBlock Grid.Column="0" FontSize="11.5"
                                                 Foreground="#2b2b2b" VerticalAlignment="Center"
                                                 TextTrimming="CharacterEllipsis">
                                        <Run Text="预计开始 " /><Run Text="{Binding PlanStart}" />
                                      </TextBlock>
                                      <TextBlock Grid.Column="1" FontSize="11.5"
                                                 Foreground="#6b6f74" VerticalAlignment="Center"
                                                 Margin="6,0,4,0"
                                                 IsVisible="{Binding HasDuration}">
                                        <Run Text="耗时 " /><Run Text="{Binding PlanDuration}" />
                                      </TextBlock>
                                      <Button Grid.Column="2" Classes="tbtn del d24"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="删除该步骤"
                                              Command="{Binding $parent[UserControl].DataContext.RemoveStep}"
                                              CommandParameter="{Binding}">
                                        <ctl:TecIcon Key="ui-foot-trash" Size="11" />
                                      </Button>
                                    </Grid>
                                  </Grid>
                                </Grid>
                                </Border>
                              </Border>
                              </StackPanel>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Panel Height="14">
                        <Border Width="1" Height="14" Background="#757a7f" HorizontalAlignment="Center" />
                        <Border Width="246" Height="4" CornerRadius="2" Background="#a41626"
                                VerticalAlignment="Center" IsVisible="{Binding DropAtEnd}" />
                      </Panel>
                      <Panel Width="246" Height="64">
                        <Rectangle Fill="White" Stroke="#959a9f" StrokeThickness="1.5"
                                   StrokeDashArray="4,3" IsVisible="{Binding !DropAtEnd}" />
                        <Rectangle Fill="#faf2f3" Stroke="#a41626" StrokeThickness="1.8"
                                   StrokeDashArray="4,3" IsVisible="{Binding DropAtEnd}" />
                        <TextBlock Text="{Binding DropHint}" FontSize="11" Foreground="#888d92"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="4" />
                      </Panel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
      </Grid>

      <!-- ══ 校验面板（原型 .vpop）：从 chip 底下垂下来，浮在画布上不撑开布局 ══
           它一展开就把泳道挤扁的话，人一边看清单一边找那一步，
           找的过程里版面又变一次。

           一条问题两句话：上面说哪儿不对，下面灰的那句说去哪儿改。分成两行是因为
           读的时机不同——扫一眼的人只读上面那句，真要动手的才读下面那句；
           摞成一段长文案，两件事都读不快。
           右边那枚「机A · CH1」标出是哪条通道：面板列的是四条泳道的事，
           不写清楚就得挨条点进去认。 -->
      <Border VerticalAlignment="Top" HorizontalAlignment="Right" Width="472"
              Margin="0,0,16,0" IsVisible="{Binding PanelOpen}"
              Background="White" BorderBrush="#b1b5b7" BorderThickness="1"
              CornerRadius="5" BoxShadow="0 10 30 0 #33000000">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto"
                Background="#fafafa" Margin="0" >
            <Border Grid.ColumnSpan="4" BorderBrush="#ebece9" BorderThickness="0,0,0,1" />
            <TextBlock Grid.Column="0" Text="配方校验" FontSize="12.5"
                       Foreground="#303337" VerticalAlignment="Center" Margin="12,10,10,10" />
            <!-- 全部 / 仅错误：提醒多起来的时候，先把真挡启动的那几条挑出来 -->
            <Border Grid.Column="1" CornerRadius="4" BorderBrush="#c5c8c7" BorderThickness="1"
                    VerticalAlignment="Center" ClipToBounds="True">
              <StackPanel Orientation="Horizontal">
                <Button Classes="segb" Classes.on="{Binding AllTab}" Content="全部"
                        Command="{Binding ShowAll}" />
                <Border Width="1" Background="#dadcd9" />
                <Button Classes="segb" Classes.on="{Binding OnlyErrors}" Content="仅错误"
                        Command="{Binding ShowOnlyErrors}" />
              </StackPanel>
            </Border>
            <Button Grid.Column="3" Classes="xbtn" Margin="0,0,10,0"
                    Command="{Binding ClosePanel}" ToolTip.Tip="收起">
              <TextBlock Text="✕" FontSize="11" Foreground="#888d92"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>

          <!-- 脚注常在：不是提示，是这个面板的读法说明——两种圆点后果不一样。
               「错误」「提醒」加粗，是因为这句话的全部意思就在这两个词的分别上 -->
          <Border DockPanel.Dock="Bottom" Background="#fafafa"
                  BorderBrush="#ebece9" BorderThickness="0,1,0,0" Padding="12,9">
            <TextBlock FontSize="11.5" Foreground="#888d92" LineHeight="18" TextWrapping="Wrap">
              <Run Text="存在" /><Run Text="错误" FontWeight="SemiBold" /><Run
                Text="时「运行」不可用；" /><Run Text="提醒" FontWeight="SemiBold" /><Run
                Text="不阻止运行，但结果可能不是你预期的。" />
            </TextBlock>
          </Border>

          <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="{Binding PanelEmptyText}" FontSize="12.5" Foreground="#959a9f"
                         TextAlignment="Center" Margin="12,26" IsVisible="{Binding PanelEmpty}" />
              <ItemsControl ItemsSource="{Binding PanelRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="issue" IsEnabled="{Binding CanGo}"
                            Command="{Binding $parent[UserControl].DataContext.PickIssue}"
                            CommandParameter="{Binding}">
                      <Border BorderBrush="#f1f2f0" BorderThickness="0,0,0,1">
                        <!-- 圆点顶对齐第一行，不是整块居中：标题折成两行的时候，
                             居中的圆点会掉到两行中间，看着不像在标那一条 -->
                        <Grid ColumnDefinitions="18,*,10,Auto" Margin="12,9">
                          <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="0,5,0,0" Background="{Binding Dot}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Text}" FontSize="12.5" Foreground="#292b2e"
                                       LineHeight="19" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Hint}" FontSize="11.5" Foreground="#888d92"
                                       LineHeight="17" TextWrapping="Wrap" Margin="0,3,0,0"
                                       IsVisible="{Binding HasHint}" />
                          </StackPanel>
                          <!-- 通道牌 + 「定位 →」。后者只在指得到具体某一步时才留位置：
                               指不到的那几条（整条通道缺能力）点了也没地方去 -->
                          <StackPanel Grid.Column="3" Spacing="4" HorizontalAlignment="Right">
                            <Border CornerRadius="3" Background="#f1f2f0" Padding="7,2"
                                    HorizontalAlignment="Right">
                              <TextBlock Text="{Binding ChannelLabel}" FontSize="11"
                                         Foreground="#6b6f74" />
                            </Border>
                            <TextBlock Classes="goto" Text="定位 →" FontSize="11"
                                       Foreground="#a41626" HorizontalAlignment="Right"
                                       IsVisible="{Binding CanGo}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      </Panel>
    </DockPanel>
    </Border>

    <!-- ══ 右：属性栏 ══
         不照原型那块 #ebece9 通栏，按台面页那一套：栏本身不铺底色、跟画布之间
         不画分界线，底色下沉到块上；「当前选中的那一步」左边一条 6px 粗色条 -->
    <Border Grid.Column="2">
      <ScrollViewer>
        <StackPanel>

          <!-- ═ 配方块：常驻。应用配方库、通道状态讲的是这条泳道自己的事，
               跟「当前点中了哪一步」无关（台面页的台面块就是这么摆的）═ -->
          <Border Padding="18,16,18,20" Background="{StaticResource PropsBg}">
            <StackPanel>
              <TextBlock Text="配方属性" FontSize="24" FontWeight="Light" Foreground="#303337"
                         HorizontalAlignment="Center" Margin="0,0,0,8" />
              <TextBlock Classes="intro"
                         Text="从左侧步骤库拖进画布组成配方。点选画布中的步骤，在此查看与编辑其参数。" />

              <Border Height="1" Background="#d3d5d2" Margin="0,10,0,4" />
              <Button Classes="secbtn" Command="{Binding LibSection.Toggle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="exp3s" Classes.up="{Binding LibSection.Open}">
                    <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" Size="10" />
                  </Border>
                  <TextBlock Text="应用配方库" Classes="acc" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <StackPanel IsVisible="{Binding LibSection.Open}">
                <Grid ColumnDefinitions="96,*,40" Margin="0,6,0,0">
                  <TextBlock Grid.Column="0" Text="配方" FontSize="12" Foreground="#3a3d41"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                  <ComboBox Grid.Column="1" Classes="sel" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Library}"
                            SelectedItem="{Binding LibPick, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <!-- 圆圈图标 + 居中，与台面属性底部那排动作按钮同款 -->
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,12,0,8"
                            HorizontalAlignment="Center">
                  <Button Classes="tbtn foot" ToolTip.Tip="应用到当前通道（替换全部步骤）"
                          Command="{Binding ApplyLib}">
                    <ctl:TecIcon Key="ui-snav-import" />
                  </Button>
                  <Button Classes="tbtn foot" ToolTip.Tip="把当前通道的配方存入配方库"
                          Command="{Binding SaveToLib}">
                    <ctl:TecIcon Key="ui-foot-save" />
                  </Button>
                </StackPanel>
                <TextBlock FontSize="11.5" Foreground="#565a5f" LineHeight="18"
                           TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="应用会替换当前通道的全部步骤；库里那条捎着配料表的，配料表也一起替换（引用才不断）。存入时配料表随配方入库，实投与批号不带——那是跟某一炉走的。" />
                <Button Classes="linkbtn" Content="管理配方库 →" Command="{Binding ManageLibrary}"
                        HorizontalAlignment="Right" Margin="0,4,0,0" />
              </StackPanel>

              <Border Height="1" Background="#d3d5d2" Margin="0,10,0,4" />
              <Button Classes="secbtn" Command="{Binding StatesSection.Toggle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="exp3s" Classes.up="{Binding StatesSection.Open}">
                    <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" Size="10" />
                  </Border>
                  <TextBlock Text="通道状态" Classes="acc" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Background="White" BorderBrush="#dadcd9" BorderThickness="1" CornerRadius="3"
                      IsVisible="{Binding StatesSection.Open}">
                <ItemsControl ItemsSource="{Binding ChannelStates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#edeeeb" BorderThickness="0,0,0,1" Padding="10,0" MinHeight="32">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                          <Border Grid.Column="0" Width="9" Height="9" CornerRadius="5" Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Background="{Binding Lit, Converter={x:Static v:Converters.LedBrush}}"
                                  BorderBrush="#a1a5a9" BorderThickness="1" />
                          <Border Grid.Column="1" Width="11" Height="11" CornerRadius="3" Margin="0,0,8,0"
                                  VerticalAlignment="Center" Background="{Binding ColorHex}" />
                          <!-- 两个 TextBlock 而不是一个带 Run 的：Run 上挂 StringFormat 会和
                               TextBlock 的 inlines 变更互相触发，转起来收不住（栈溢出） -->
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#292b2e"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ChannelSuffix}" FontSize="12" Foreground="#959a9f" />
                          </StackPanel>
                          <TextBlock Grid.Column="3" Text="{Binding State}" FontSize="11"
                                     Foreground="#888d92" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </Border>

          <!-- 块与块之间的缝：栏本身没底色，这里空着就是画布的白 -->
          <Border Height="9" IsVisible="{Binding HasSelection}" />

          <!-- ═ 步骤块：选中哪一步显示哪一步，左边一条 6px 粗色条 ═ -->
          <Border Padding="18,16,18,20" IsVisible="{Binding HasSelection}"
                  Background="{StaticResource PropsBg}"
                  BorderBrush="{StaticResource PropsBar}" BorderThickness="6,0,0,0">
            <StackPanel>
              <!-- 指令名本身就是这一块的标题，上面不再压一行「步骤属性」 -->
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12"
                          HorizontalAlignment="Center">
                <!-- 跟画布上那张卡同一枚红方块：从卡片点进属性栏，认的是同一个记号 -->
                <Panel Classes="tile27" VerticalAlignment="Center">
                  <Border Classes="tilebg27" />
                  <ctl:TecIcon Key="{Binding StepTile}" Size="27" />
                </Panel>
                <TextBlock Text="{Binding StepName}" FontSize="21" FontWeight="Light"
                           Foreground="#303337" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StepChannel}" FontSize="12" Foreground="#888d92"
                           VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock IsVisible="{Binding NoParams}" Text="该指令无需设置参数。"
                         FontSize="11.5" Foreground="#888d92" Margin="0,2,0,8" />

              <v:SchemaFormView DataContext="{Binding Form}" />

              <!-- 加料步骤连配料表（CH-4.1）：选一行建立引用，体积从此跟随计算 -->
              <StackPanel IsVisible="{Binding IsDoseStep}" Margin="0,10,0,0" Spacing="5">
                <Grid ColumnDefinitions="96,*,40">
                  <TextBlock Grid.Column="0" Text="连配料表" FontSize="12" Foreground="#3a3d41"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                  <ComboBox Grid.Column="1" Classes="sel" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ChargeRowNames}"
                            SelectedItem="{Binding ChargeRowPick, Mode=TwoWay}"
                            PlaceholderText="选一行建立引用"
                            ToolTip.Tip="选中配料表里的一行就建立引用：加料体积改为跟随配料表的计算（改组分名也不断）。手改体积即脱离跟随，校验面板会提示差多少" />
                </Grid>
                <TextBlock Text="{Binding ChargeLinkNote}" Foreground="{Binding ChargeLinkColorHex}"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>

              <!-- 执行选项：两个真会影响运行的开关 -->
              <StackPanel Margin="0,14,0,0" Spacing="6">
                <Button Classes="secbtn" Command="{Binding ExecSection.Toggle}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="exp3s" Classes.up="{Binding ExecSection.Open}">
                      <ctl:TecIcon Key="ui-chev-down" Tint="#51555a" Size="10" />
                    </Border>
                    <TextBlock Text="执行选项" Classes="acc" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <StackPanel IsVisible="{Binding ExecSection.Open}" Spacing="6">
                  <CheckBox Classes="chk2" Content="失败时暂停并报警"
                            IsChecked="{Binding PauseOnFault, Mode=TwoWay}" />
                  <CheckBox Classes="chk2" Content="跳过该步骤（不执行、不计入排期）"
                            IsChecked="{Binding StepSkipped, Mode=TwoWay}" />
                  <!-- 工艺阶段：设备不知道这一段在结晶还是在蒸馏，只有人知道。
                       标了就进记录、进报告，报告里注明是操作人标的 -->
                  <Grid ColumnDefinitions="96,*,40" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Text="工艺阶段" FontSize="12" Foreground="#3a3d41"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Grid.Column="1" Classes="sel" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding PhaseOptions}"
                              SelectedItem="{Binding StepPhase, Mode=TwoWay}"
                              ToolTip.Tip="事后看 Tr−Tj 曲线时，靠它才知道某一段在做什么。由操作人标注，不是设备回报" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- 跟手的幽灵卡。盖在三列之上、不吃事件，所以底下照样能命中泳道 -->
    <Canvas Grid.Column="0" Grid.ColumnSpan="3" IsHitTestVisible="False">
      <Border IsVisible="{Binding Dragging}"
              Canvas.Left="{Binding DragX}" Canvas.Top="{Binding DragY}"
              Width="246" Background="White" BorderBrush="#a41626" BorderThickness="1.5"
              Padding="7,6" Opacity="0.96"
              BoxShadow="0 5 16 0 #33000000">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Panel Classes="tile27" VerticalAlignment="Center">
            <Border Classes="tilebg27" />
            <ctl:TecIcon Key="{Binding DragTile}" Size="27" />
          </Panel>
          <TextBlock Text="{Binding DragTitle}" FontSize="12" Foreground="#1b1b1b"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </Canvas>
  </Grid>

  <UserControl.Styles>
    <!-- ══ 步骤库（原型 iControl 6.2 的 Recipe Library）══ -->

    <!-- 搜索框：原型是 29×21 的白底细框 -->
    <Style Selector="TextBox.lfind">
      <Setter Property="Height" Value="21" />
      <Setter Property="MinHeight" Value="21" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#8d9196" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.lfindx">
      <Setter Property="Width" Value="19" />
      <Setter Property="Height" Value="19" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.lfindx:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e2e2e2" />
    </Style>

    <!-- 组名那行的小箭头：库里的行只有 21/23 高，圆圈箭头（exp3 22px）塞不下 -->
    <Style Selector="Border.chevm">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chevm.up">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="180" />
      </Setter>
    </Style>

    <!-- 指令行：原型 23 高、左内边距 12、图标与名字之间 8、悬停 #f4e0e2 -->
    <Style Selector="Button.lrow">
      <Setter Property="Height" Value="23" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="12,0,8,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.lrow:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#f4e0e2" />
    </Style>

    <!-- 指令图标那枚方块。原型库里 15px 平涂，卡片上 27px 带一层竖向渐变 -->
    <Style Selector="Panel.tile15">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tilebg15">
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="#a41626" />
      <Setter Property="BorderBrush" Value="#7e0f1c" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Panel.tile27">
      <Setter Property="Width" Value="27" />
      <Setter Property="Height" Value="27" />
    </Style>
    <Style Selector="Border.tilebg27">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#c8404f" Offset="0" />
          <GradientStop Color="#a41626" Offset="1" />
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- ══ 步骤卡 ══
         原型 .step：白→#f6f6f6 竖向渐变 + 1px #cccccc，不倒角。
         最小高度 75 = 上下 1px 描边 + 6 + 图标 27 + 6 + 分隔线 1 + 3 + 删除钮 24 + 5 -->
    <Style Selector="Border.step">
      <Setter Property="MinHeight" Value="75" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#cccccc" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#ffffff" Offset="0" />
          <GradientStop Color="#f6f6f6" Offset="1" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Border.step:pointerover">
      <Setter Property="Background" Value="#f2f2f2" />
    </Style>

    <!-- 泳道头里的输入：原型 .hsel，22 高、白底、#a9adb1 描边 -->
    <Style Selector="TextBox.hin">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="BorderBrush" Value="#a9adb1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="White" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.hsel">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="BorderBrush" Value="#a9adb1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="White" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 原型 .hbtn：26px 圆钮，底色比泳道头深一档 -->
    <Style Selector="Button.lhbtn">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="#e0c3c6" />
      <Setter Property="BorderBrush" Value="#373a3e" />
      <Setter Property="BorderThickness" Value="1.6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.lhbtn.sq">
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Button.lhbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#f0dfe1" />
      <Setter Property="BorderBrush" Value="#a41626" />
    </Style>

    <Style Selector="Border.laneSel">
      <Setter Property="BorderBrush" Value="#a41626" />
      <Setter Property="BoxShadow" Value="0 0 0 3 #38a41626" />
    </Style>
    <!-- 校验面板里的一条：整行可点，跳到出问题的那一步 -->
    <Style Selector="Button.issue">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.issue:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#f0f0ee" />
    </Style>
    <!-- 不可点的那些行照常是白的：默认主题给 disabled 按钮铺一块灰底，
         摆在这儿会变成「一条灰杠」，看着像被禁用的整块面板 -->
    <Style Selector="Button.issue:disabled">
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.issue:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 「定位 →」平时不占眼睛，指到这一行才显出来（原型 .go visibility）。
         位置照常留着，显不显都不挪版 -->
    <Style Selector="Button.issue TextBlock.goto">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.issue:pointerover TextBlock.goto">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- 校验 chip（原型 .vchip）：并进工具行的一枚状态灯，平时无框，
         指上去 / 展开时才浮出一块白底 -->
    <Style Selector="Button.vchip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,0,9,0" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.vchip /template/ ContentPresenter">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.vchip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#d3d5d2" />
    </Style>
    <Style Selector="Button.vchip.open /template/ ContentPresenter">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#bfc2c2" />
    </Style>
    <!-- 校验通过时不可点（没什么可展开的），但那枚绿灯和「多久 · 几步」照读，
         所以不许它按 disabled 的老规矩把自己整枚变淡 -->
    <Style Selector="Button.vchip:disabled">
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.vchip:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- 泳道角标（原型 .cbadge）：实心胶囊 + 一圈同色的软阴影，
         探出泳道头右上角。默认红，只有提醒时琥珀 -->
    <!-- 底色 / 圆角 / 投影都写在 /template/ ContentPresenter 上：
         Button 自己没有 BoxShadow 这个属性（只有 Border 和 ContentPresenter 有） -->
    <Style Selector="Button.cbadge">
      <Setter Property="Height" Value="20" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.cbadge /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="#d93025" />
      <Setter Property="BoxShadow" Value="0 2 6 0 #59d93025" />
    </Style>
    <Style Selector="Button.cbadge:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#d93025" />
    </Style>
    <Style Selector="Button.cbadge.warn /template/ ContentPresenter">
      <Setter Property="Background" Value="#e8a33d" />
      <Setter Property="BoxShadow" Value="0 2 6 0 #59e8a33d" />
    </Style>
    <Style Selector="Button.cbadge.warn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#cf8f2c" />
    </Style>

    <!-- 步骤卡上那枚「!」（原型 .sbadge） -->
    <Style Selector="Border.sbadge">
      <Setter Property="Background" Value="#d93025" />
    </Style>
    <Style Selector="Border.sbadge.warn">
      <Setter Property="Background" Value="#e8a33d" />
    </Style>

    <!-- 有错的那条泳道，头上描一圈红。原型是把整块染成 #fdf2f2——
         我们这块是 #d6b8bb 的实心底，染红只会脏，而且要跟蓝色选中环抢眼睛 -->
    <Style Selector="Border.laneHeadErr">
      <Setter Property="BorderBrush" Value="#d93025" />
    </Style>

    <!-- 面板头上那对「全部 / 仅错误」：连体两格，选中的那格淡蓝 -->
    <Style Selector="Button.segb">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#51555a" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Height" Value="23" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.segb:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#eff0ee" />
    </Style>
    <!-- 选中那格：字色写在 Button 自己身上，不写在 /template/ 的
         ContentPresenter 上——那条路只改得动背景，字色传不下去，
         结果两格长得一模一样，看不出选的是哪个（实测踩到） -->
    <Style Selector="Button.segb.on">
      <Setter Property="Foreground" Value="#a41626" />
    </Style>
    <Style Selector="Button.segb.on /template/ ContentPresenter">
      <Setter Property="Background" Value="#f4e4e6" />
    </Style>

    <!-- 面板右上那个收起叉：中性灰底，别蹭步骤卡那套青色 -->
    <Style Selector="Button.xbtn">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.xbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#ebece9" />
    </Style>
    <Style Selector="Button.xbtn:pointerover">
      <Setter Property="Foreground" Value="#303337" />
    </Style>

    <!-- 圆圈箭头：展开朝上、收起朝下。22px 是原型 .dev .exp 的尺寸 -->
    <Style Selector="Border.exp3">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="BorderBrush" Value="#676b70" />
      <Setter Property="BorderThickness" Value="1.6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 变量表的小输入格 -->
    <Style Selector="TextBox.vcell">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#d4d6d3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="Border.exp3s">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="#676b70" />
      <Setter Property="BorderThickness" Value="1.3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.exp3 > :is(Control), Border.exp3s > :is(Control)">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.exp3.up, Border.exp3s.up">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="180" />
      </Setter>
    </Style>
    <!-- 小节头：整行可点，看起来还是一行字 -->
    <Style Selector="Button.secbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.secbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- .pf-row.bool：14px 方框 + 11.5px 文字，与台面属性同款 -->
    <Style Selector="CheckBox.chk2">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#3a3d41" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- 正文里的链接：看着是一句话的一部分，不是一个按钮 -->
    <Style Selector="Button.linkbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#a41626" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.linkbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#7e0f1c" />
    </Style>
    <Style Selector="Border.stepGhost">
      <Setter Property="Opacity" Value="0.42" />
    </Style>
    <Style Selector="Border.laneDrop">
      <Setter Property="BorderBrush" Value="#a41626" />
      <Setter Property="Background" Value="#fdfafa" />
    </Style>

    <!-- 步骤卡外面那层壳（原型给卡片留的 3px padding）：选中环画在这儿，
         卡片自己的宽高一点不动，选中不会让描述重新折行 -->
    <Style Selector="Border.stepwrap">
      <Setter Property="Padding" Value="3" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.stepwrap.stepSel">
      <Setter Property="BorderBrush" Value="#a41626" />
      <!-- 原型 rgba(164,22,38,0.07)：0.07×255 ≈ 0x12 -->
      <Setter Property="Background" Value="#12a41626" />
    </Style>
    <!-- 卡片本身跟着淡红一层。只描外环不染底的话，四条泳道并排时
         那圈 2px 红线太细，扫一眼分不出选中的是哪张 -->
    <Style Selector="Border.step.stepSel">
      <Setter Property="Background" Value="#fbf3f4" />
    </Style>
    <!-- 排在 stepSel 后面是有意的：点了面板里那一条会选中这一步，
         描边要是跟着变回灰的，人刚找到的那张红框卡就在点中它的一瞬间不红了。
         描边归错误，选中归外面那圈环，两件事各占一个记号。
         只换描边、不染底：一条配方里出错的常常是好几步，每张都染一层粉，
         整条泳道会糊成一片红，反倒看不出哪张是当前选中的那一张 -->
    <Style Selector="Border.step.stepErr">
      <Setter Property="BorderBrush" Value="#d93025" />
    </Style>
  </UserControl.Styles>
</UserControl>
