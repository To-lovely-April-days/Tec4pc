<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             x:Class="Tec.App.Views.RecipeLibView">
  <UserControl.Styles>
    <!-- .rrow：34px 圆图标 + 名称 + 元信息 + 模块色带；选中只加深加粗 -->
    <Style Selector="Border.rrow">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#f0f0f0" />
      <Setter Property="BorderThickness" Value="4,0,0,1" />
      <Setter Property="Padding" Value="8,12,14,12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.rrow:pointerover">
      <Setter Property="Background" Value="#f5f5f5" />
    </Style>
    <Style Selector="Border.rrow.sel">
      <Setter Property="Background" Value="#e8f2fb" />
      <Setter Property="BorderBrush" Value="#1a7fc4" />
      <Setter Property="BorderThickness" Value="4,0,0,1" />
    </Style>
    <Style Selector="Border.rrow Border.ri">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="#f2f2f2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.rrow.sel Border.ri">
      <Setter Property="Background" Value="#d4e7f7" />
    </Style>
    <Style Selector="Border.rrow TextBlock.rn2">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="#2b2b2b" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.rrow.sel TextBlock.rn2">
      <Setter Property="Foreground" Value="#0b3760" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.rrow TextBlock.rm2">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="#9a9a9a" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="Border.rrow.sel TextBlock.rm2">
      <Setter Property="Foreground" Value="#6b8ba8" />
    </Style>
    <Style Selector="TextBlock.frowk">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#3d3d3d" />
      <Setter Property="Width" Value="96" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.exp3.up">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="180" />
      </Setter>
    </Style>
    <Style Selector="Button.secbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.secbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.exp3">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#6b6b6b" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="312,*,342">

    <!-- ========== 左：配方列表 ========== -->
    <Border Grid.Column="0" Background="White" BorderBrush="#dcdcdc" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="14,12,14,8">
          <TextBlock Text="配方库" FontSize="20" FontWeight="Light" Foreground="#3b3b3b"
                     VerticalAlignment="Center" Width="200" />
          <Button Classes="tbtn sm" ToolTip.Tip="把配方页当前通道的配方收进库"
                  Command="{Binding NewFromChannel}">
            <ctl:TecIcon Key="ui-lh-libnew" />
          </Button>
          <Button Classes="tbtn sm" ToolTip.Tip="从文件导入（.tecrecipe）"
                  Command="{Binding ImportToLib}">
            <ctl:TecIcon Key="ui-lh-libimport" />
          </Button>
        </StackPanel>
        <ScrollViewer>
          <StackPanel>
          <StackPanel IsVisible="{Binding IsEmpty}" Margin="16,10" Spacing="7">
            <TextBlock Text="配方库还是空的" FontSize="14" Foreground="#6f6f6f" />
            <TextBlock FontSize="11.5" Foreground="#9a9a9a" LineHeight="19" TextWrapping="Wrap"
                       Text="在配方页把一条配方调好，用上面的 ＋ 收进来；或者点旁边那个按钮从 .tecrecipe 文件导入。" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="rrow" Classes.sel="{Binding IsSelected}" PointerPressed="OnRowPressed">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Classes="ri">
                      <!-- Tint 是 Color，不是字符串：直接绑一个 "#0b3760" 绑不上，
                                 运行时只在输出窗口留一行 BindingError，图标默认灰，
                                 界面上看不出来。走转换器 -->
                            <ctl:TecIcon Key="ui-lib-doc" Size="17"
                                         Tint="{Binding IsSelected, Converter={x:Static ctl:Is.SelInk}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Classes="rn2" />
                      <TextBlock Text="{Binding Meta}" Classes="rm2" />
                      <!-- .rmix：一步一段，按模块着色 -->
                      <Border Height="4" CornerRadius="2" Background="#f0f0f0"
                              Margin="0,7,0,0" ClipToBounds="True">
                        <ItemsControl ItemsSource="{Binding Mix}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate><Border Background="{Binding}" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ========== 中：只读流程预览 ========== -->
    <DockPanel Grid.Column="1" Background="White">
      <Border DockPanel.Dock="Top" BorderBrush="#e3e3e3" BorderThickness="0,0,0,1" Padding="24,14,24,10">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Light" Foreground="#2b2b2b" />
          <TextBlock Text="{Binding Desc}" FontSize="12" Foreground="#7a7a7a"
                     VerticalAlignment="Bottom" Margin="0,0,0,3" />
        </StackPanel>
      </Border>

      <Panel>
        <ctl:GridBackdrop LineBrush="#fbfbfb" />
        <StackPanel IsVisible="{Binding IsEmpty}" Margin="30,26" Spacing="7"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
          <TextBlock Text="还没有配方可看" FontSize="15" Foreground="#6f6f6f" />
          <TextBlock FontSize="12" Foreground="#9a9a9a" LineHeight="19" MaxWidth="480"
                     TextWrapping="Wrap"
                     Text="库里存进第一条配方之后，这里会把它的步骤按顺序摊开，方便应用前先看一眼。" />
        </StackPanel>
        <ScrollViewer IsVisible="{Binding HasSelection}">
          <StackPanel HorizontalAlignment="Center" Margin="0,18,0,40">
            <Border Width="270" Height="30" Background="#2eaa4e" CornerRadius="2" Padding="11,0">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ctl:TecIcon Key="ui-cap-begin" />
                <TextBlock Text="开始" Foreground="White" FontSize="12.5" />
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Flow}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel HorizontalAlignment="Center">
                    <Border Width="1" Height="14" Background="#7a7a7a" HorizontalAlignment="Center" />
                    <!-- .step.ro：只读，没有删除按钮，不跟随选中 -->
                    <Border Width="270" Background="White" BorderBrush="#d3dae0"
                            BorderThickness="1" CornerRadius="4">
                      <StackPanel>
                        <Grid ColumnDefinitions="Auto,*" Margin="9,8">
                          <Border Grid.Column="0" Width="44" Height="44" CornerRadius="5"
                                  Background="{Binding ModuleColor}">
                            <ctl:TecIcon Key="{Binding IconKey}" White="True" Size="26"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="9,1,0,0">
                            <TextBlock Text="{Binding Desc}" FontSize="11.5" Foreground="#22303a"
                                       TextWrapping="Wrap" MaxLines="3" LineHeight="16" />
                            <TextBlock Text="{Binding ModLine}" FontSize="9.5" Foreground="#93a3ae"
                                       Margin="0,3,0,0" />
                          </StackPanel>
                        </Grid>
                        <Border Background="#fafbfc" BorderBrush="#eef1f3" BorderThickness="0,1,0,0"
                                CornerRadius="0,0,4,4" Padding="9,4,9,5">
                          <TextBlock FontSize="10" Foreground="#8b98a2">
                            <Run Text="预计开始 " /><Run Text="{Binding PlanStart}"
                                FontWeight="SemiBold" Foreground="#4a5560" />
                          </TextBlock>
                        </Border>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Width="1" Height="14" Background="#7a7a7a" HorizontalAlignment="Center" />
            <Border Width="270" Height="30" Background="#b8483c" CornerRadius="2" Padding="11,0">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ctl:TecIcon Key="ui-cap-end" />
                <TextBlock Text="结束" Foreground="White" FontSize="12.5" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </DockPanel>

    <!-- ========== 右：配方属性 / 应用 ========== -->
    <!-- 与台面属性同一套观感：白底面板 + 浅紫内容块 -->
    <Border Grid.Column="2" Background="{StaticResource ThemeGap}"
            BorderBrush="#d2d2d2" BorderThickness="1,0,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ThemeFill}"
                BorderBrush="#d5d5d5" BorderThickness="0,1,0,0" Padding="18,12,18,14">
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button Classes="tbtn foot" Command="{Binding SaveLib}" ToolTip.Tip="保存配方库">
              <ctl:TecIcon Key="ui-foot-save" />
            </Button>
            <Button Classes="tbtn foot" Command="{Binding Duplicate}" ToolTip.Tip="另存副本"
                    IsEnabled="{Binding HasSelection}">
              <ctl:TecIcon Key="ui-foot-dup" />
            </Button>
            <Button Classes="tbtn foot" Command="{Binding Delete}" ToolTip.Tip="删除"
                    IsEnabled="{Binding HasSelection}">
              <ctl:TecIcon Key="ui-foot-trash2" />
            </Button>
          </StackPanel>
        </Border>

        <ScrollViewer>
          <Border Background="{StaticResource ThemeFill}" Padding="18,16,18,20">
          <StackPanel>
            <TextBlock Text="配方属性" FontSize="24" FontWeight="Light" Foreground="#333333"
                       HorizontalAlignment="Center" Margin="0,0,0,12" />

            <TextBlock Classes="intro" IsVisible="{Binding IsEmpty}"
                       Text="左边库里还没有配方。存进第一条之后，这里可以改名、写描述、应用到通道。" />

            <StackPanel Spacing="7" IsVisible="{Binding HasSelection}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="名称" Classes="frowk" />
                <TextBox Classes="finput" Width="196" Text="{Binding Name, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="描述" Classes="frowk" />
                <TextBox Classes="finput" Width="196" Text="{Binding Desc, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="步骤数" Classes="frowk" />
                <TextBox Classes="finput" Width="196" Text="{Binding StepCountText}" IsEnabled="False" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="最近更新" Classes="frowk" />
                <TextBox Classes="finput" Width="196" Text="{Binding UpdatedText}" IsEnabled="False" />
              </StackPanel>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasSelection}">
            <Border Height="1" Background="#d5d5d5" Margin="0,12,0,14" />
            <Button Classes="secbtn" Command="{Binding ApplySection.Toggle}" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="exp3" Classes.up="{Binding ApplySection.Open}">
                  <ctl:TecIcon Key="ui-chev-down" Tint="#555555" />
                </Border>
                <TextBlock Text="应用到通道" FontSize="11.5" Foreground="#3d3d3d" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <StackPanel IsVisible="{Binding ApplySection.Open}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="目标通道" Classes="frowk" />
                <ComboBox Classes="sel" Width="196" Height="23" ItemsSource="{Binding ApplyTargets}"
                          SelectedItem="{Binding ApplyTarget, Mode=TwoWay}" />
              </StackPanel>

              <!-- 圆圈图标 + 居中，与台面属性底部那排、配方页那两个同款 -->
              <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,12,0,8"
                          HorizontalAlignment="Center">
                <Button Classes="tbtn foot" ToolTip.Tip="应用到该通道（替换全部步骤）"
                        Command="{Binding ApplyToChannel}">
                  <ctl:TecIcon Key="ui-snav-import" />
                </Button>
                <Button Classes="tbtn foot" ToolTip.Tip="应用到全部启用的通道"
                        Command="{Binding ApplyToAll}">
                  <ctl:TecIcon Key="ui-foot-dup" />
                </Button>
              </StackPanel>

              <TextBlock Classes="intro left" Margin="0,2,0,0"
                         Text="应用会替换目标通道当前的全部步骤，并跳转到配方编辑界面。" />
            </StackPanel>
            </StackPanel>
          </StackPanel>
          </Border>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
