<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             x:Class="Tec.App.Views.RecipeLibView">

  <!--
    版式：库列表 240（跟配方页的步骤库同宽）｜ 主区（标题 + 标签页 + 工具条 +
    温度剖面 + 步骤卡）｜ 属性 288。属性栏不照原型那块通栏灰，按你定的那一套走：栏本身不铺底色、
    块用 PropsBg、块之间露白缝、「当前选中的那一个」左边一条粗色条。

    **选中色跟全局一套走（蓝）**：列表、标签页、步骤卡、温度剖面上的色带四处同一个蓝。
    原型这一页是绿调的，但一个程序里「选中」只该有一个颜色——这一页绿、别的页蓝，
    换页时眼睛要重新认一次。四处必须彼此一致这条不变，只是那个颜色取全局的 SelBd。

    原型里有而我们没有的东西，一律不画：版本号（v3.2）、发布状态（PUBLISHED /
    Draft / Archived）、文件路径、置顶、文件夹分组、版本历史——这些字段库里根本不记，
    画出来就是假的。剖面和甘特条画得出来，是因为它们**能从排期推出来**（见 TempProfile）。
  -->
  <UserControl.Styles>
    <!-- 库里的一条。跟配方页的步骤库同一套说法：平铺细行 + 1px 分隔线，
         不是一摞带圆角带边框的小卡片。左边那 6px 是选中条的位置，
         平时透明——写成边框的话选中时内容会横跳 6px -->
    <Style Selector="Border.rxitem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#ececec" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.rxitem:pointerover">
      <Setter Property="Background" Value="#f4e0e2" />
    </Style>
    <Style Selector="Border.rxitem.sel">
      <Setter Property="Background" Value="{StaticResource SelBg}" />
    </Style>
    <Style Selector="Border.rxitem TextBlock.rn">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#1b1b1b" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.rxitem.sel TextBlock.rn">
      <Setter Property="Foreground" Value="{StaticResource SelTx}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 搜索框与它右边那个清除叉：与步骤库那一行同规格（21 高、白底细框） -->
    <Style Selector="TextBox.lfind">
      <Setter Property="Height" Value="21" />
      <Setter Property="MinHeight" Value="21" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="24,1,6,1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#8d9196" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.lfindx">
      <Setter Property="Width" Value="19" />
      <Setter Property="Height" Value="19" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.lfindx:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e2e2e2" />
    </Style>


    <!-- 标签页（原型 .rx-tabs）：20px 细体，当前那个用主色 -->
    <Style Selector="Button.rxtab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Light" />
      <Setter Property="Foreground" Value="#888d92" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.rxtab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#1f2124" />
    </Style>
    <Style Selector="Button.rxtab.on">
      <Setter Property="Foreground" Value="{StaticResource SelBd}" />
    </Style>

    <!-- 表头一格 / 表身一行（原型 .rx-th / .rx-tr） -->
    <Style Selector="TextBlock.th">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#373a3e" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.trow">
      <!-- 透明也能收指针，写白只是省一层：表本来就铺在白上 -->
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#ebece9" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.trow:pointerover">
      <Setter Property="Background" Value="{StaticResource HovBg}" />
    </Style>
    <Style Selector="Border.trow.sel">
      <Setter Property="Background" Value="{StaticResource SelBg}" />
    </Style>
    <Style Selector="Border.trow TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#292b2e" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 步骤卡（原型 .rx-card）：一行分隔线、悬停浅蓝、选中蓝底 + 左边一条蓝。
         选中色跟温度剖面上那条色带同一个蓝：点了色带哪一张卡亮起来，一眼对得上 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#ebece9" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.card:pointerover">
      <Setter Property="Background" Value="#f0f0ee" />
    </Style>
    <Style Selector="Border.card.sel">
      <Setter Property="Background" Value="{StaticResource SelBg}" />
    </Style>

    <!-- 参数小标签（原型 .rx-chip） -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="#f4f4f3" />
      <Setter Property="BorderBrush" Value="#e4e6e3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.exp3">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#676b70" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.exp3.up">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="180" />
      </Setter>
    </Style>
  </UserControl.Styles>

  <!-- 左栏 240 跟配方页的步骤库同宽（239 + 1px 分界）。两页的左栏都是
       「库」，菜单在这两页之间切的时候宽度一变，整个中列跟着横跳一下 -->
  <Grid ColumnDefinitions="240,*,288">

    <!-- ══ 左：配方库（原型 .rx-lib）══ -->
    <!-- ClipToBounds：这一栏宽度写死 240，Grid 不裁，里面的东西真比它宽的话
         会溢到中列上去 -->
    <!-- 抬头照配方页的步骤库那一套：24px 深色标题条 + 35px 搜索行，
         下面是平铺细行。原来是「19px 细体标题 + 白底搜索 + 一条动作行 +
         一摞带圆角带边框的小卡片」，四层白底叠在一起分不出层次，
         八条配方看着像八个散落的盒子 -->
    <!-- 栏底纯白、不画右分界线：中列左边留的那 6px 白缝就是分界（同配方页） -->
    <Border Grid.Column="0" ClipToBounds="True" Background="White">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="24" Background="{StaticResource Shell}"
                Padding="10,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="配方库" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
            <!-- 条数跟标题同一行：它说的就是这个库有多大，不该单占一行 -->
            <TextBlock Grid.Column="1" Text="{Binding LibCountText}" FontSize="10.5"
                       Foreground="#9aa0a6" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- 搜索行：搜索框 + 清除叉，右边隔一条竖线摆库级动作（新增与导入）。
             这两件事跟「库」有关、跟当前打开的是哪条无关，所以仍在库这一栏，
             只是并进这一行、不再单占一条。

             行高 40 而不是步骤库那一行的 35：这两颗钮走全程序统一的圆钮一族
             （tbtn sm，30px），35 高的话圆顶着上下边缘。步骤库那一行没有钮，
             所以还是 35——两页不会并排看，差这 5px 看不出来 -->
        <Border DockPanel.Dock="Top" Height="40" Background="#f1f1f1"
                BorderBrush="#cfcfcf" BorderThickness="0,0,0,1" Padding="9,0">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <Panel Grid.Column="0">
              <TextBox Classes="lfind" Watermark="搜配方名" Text="{Binding Query, Mode=TwoWay}" />
              <ctl:TecIcon Key="ui-search" Tint="#959a9f" Size="13" Margin="6,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Panel>
            <Button Grid.Column="1" Classes="lfindx" Margin="4,0,0,0"
                    IsVisible="{Binding HasQuery}" Command="{Binding ClearQuery}"
                    ToolTip.Tip="清除搜索">
              <TextBlock Text="✕" FontSize="10" Foreground="#6b6f74"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Border Grid.Column="2" Width="1" Height="22" Background="#d4d4d4" Margin="7,0" />
            <Button Grid.Column="3" Classes="tbtn sm" ToolTip.Tip="把配方页当前通道的配方收进库"
                    Command="{Binding NewFromChannel}">
              <ctl:TecIcon Key="ui-lh-libnew" />
            </Button>
            <Button Grid.Column="4" Classes="tbtn sm" Margin="6,0,0,0"
                    ToolTip.Tip="从文件导入（.tecrecipe）" Command="{Binding ImportToLib}">
              <ctl:TecIcon Key="ui-lh-libimport" />
            </Button>
          </Grid>
        </Border>

        <!-- 底部留白写在内容的 Margin 上，不写 ScrollViewer 的 Padding：
             Padding 是从可视区里扣的，不进滚动范围 -->
        <ScrollViewer>
          <StackPanel Margin="0,0,0,40">
            <StackPanel IsVisible="{Binding IsEmpty}" Margin="12,12,12,8" Spacing="7">
              <TextBlock Text="没有配方" FontSize="13" Foreground="#6b6f74" />
              <TextBlock FontSize="11.5" Foreground="#959a9f" LineHeight="19" TextWrapping="Wrap"
                         Text="在配方页把一条配方调好，用上面那颗「收进库」按钮收进来；或者从 .tecrecipe 文件导入。搜索没结果时清空搜索框即可。" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="rxitem" Classes.sel="{Binding IsSelected}">
                    <!-- 6px 那一列常在，选中才上色：内容不会因为选中横跳 -->
                    <Grid ColumnDefinitions="6,*">
                      <Border Grid.Column="0"
                              Background="{Binding IsSelected, Converter={x:Static ctl:Is.SelBar}}" />
                      <StackPanel Grid.Column="1" Margin="8,6,10,7">
                        <TextBlock Text="{Binding Name}" Classes="rn" />
                        <TextBlock Text="{Binding Meta}" FontSize="10.5" Foreground="#959a9f"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ══ 中：标题 + 标签页 + 工具条 + 表（原型 .rx-main）══ -->
    <!-- 左右各 6px 白缝，同配方页。两页的左栏都是「库」，
         切过去缝的宽窄一变就看得出来 -->
    <Border Grid.Column="1" Background="White" Padding="6,0,6,0">
    <DockPanel>

      <!-- 抬头（原型 .rx-head）：名字 26px 细体，下面一行元信息 -->
      <StackPanel DockPanel.Dock="Top" Margin="20,12,20,0" IsVisible="{Binding HasSelection}">
        <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Light" Foreground="#383b3f" />
        <!-- 描述：库里真有这一项，以前只能在右栏编、页面上从不显示。写了就露出来，
             没写就不占位置（原型这一行是文件路径，我们的配方不是文件） -->
        <TextBlock Text="{Binding Desc}" FontSize="11" Foreground="#9ea2a6"
                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding HasDesc}" />
        <TextBlock Text="{Binding HeaderMeta}" FontSize="11" Foreground="#757a7f"
                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <!-- 标签页（原型 .rx-tabs）。原型第三个是「版本历史」，我们不记版本，只有两个 -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="20"
                  Margin="20,10,20,9" IsVisible="{Binding HasSelection}">
        <Button Classes="rxtab" Classes.on="{Binding IsStepsTab}" Content="步骤"
                Command="{Binding ShowSteps}" />
        <Button Classes="rxtab" Classes.on="{Binding IsMatTab}" Content="物料"
                Command="{Binding ShowMaterials}" />
      </StackPanel>

      <!-- 工具条（原型 .rx-tool）：这一条上的动作都是对「当前打开的这条配方」的。
           原型那排是解锁改步骤，我们这一页不改步骤（改在配方页），
           所以放的是这一页真正的主动作——应用到通道 -->
      <Border DockPanel.Dock="Top" Height="42" Background="#f4f4f3"
              BorderBrush="#e1e3e0" BorderThickness="0,1,0,1" IsVisible="{Binding HasSelection}">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,0,16,0"
                    VerticalAlignment="Center">
          <TextBlock Text="应用到" FontSize="12" Foreground="#414448" VerticalAlignment="Center" />
          <ComboBox Classes="sel" Width="180" ItemsSource="{Binding ApplyTargets}"
                    SelectedItem="{Binding ApplyTarget, Mode=TwoWay}" />
          <Button Classes="btn" Content="应用" Command="{Binding ApplyToChannel}"
                  IsEnabled="{Binding HasTargets}"
                  ToolTip.Tip="替换该通道当前的全部步骤，并跳到配方页" />
          <Button Classes="btn" Content="应用到全部通道" Command="{Binding ApplyToAll}"
                  IsEnabled="{Binding HasTargets}"
                  ToolTip.Tip="替换全部启用通道的步骤。每个通道各落一份独立副本" />
          <TextBlock Text="应用会替换目标通道当前的全部步骤" FontSize="11" Foreground="#959a9f"
                     VerticalAlignment="Center" Margin="4,0,0,0" />
        </StackPanel>
      </Border>

      <!-- ── 温度剖面（原型 .rx-prof）：按时长比例的一条带子，点色带选中步骤。
           画的是**计划**——每段的起止来自排期，两端温度来自估算器一路推进的釜温。
           全程没有一步动过温度就整条不出现（一条笔直的水平线什么也没说） ── -->
      <Border DockPanel.Dock="Top" Background="#fafafa" BorderBrush="#dadcd9"
              BorderThickness="0,0,0,1" Padding="20,10,20,11"
              IsVisible="{Binding HasProfile}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,0,8">
            <Path Data="M 1.5,12.5 L 5,8 L 8,10.4 L 14.5,3" Stroke="#f7941e" StrokeThickness="1.6"
                  VerticalAlignment="Center" />
            <TextBlock Text="温度剖面" FontSize="11" Foreground="#3a3d41"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding ProfileNote}" FontSize="10.5" Foreground="#959a9f"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <ctl:RecipeProfileView Name="Profile" Profile="{Binding Profile}"
                                 SelectedIndex="{Binding SelStepIndex}" />
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Top" Background="#fafafa" BorderBrush="#d3d5d2"
              BorderThickness="0,0,0,1" Height="28"
              IsVisible="{Binding IsMatTab}">
        <Grid ColumnDefinitions="6,1.4*,110,80,120,90">
          <TextBlock Grid.Column="1" Text="组分" Classes="th" />
          <TextBlock Grid.Column="2" Text="CAS" Classes="th" />
          <TextBlock Grid.Column="3" Text="角色" Classes="th" />
          <TextBlock Grid.Column="4" Text="用量" Classes="th" />
          <TextBlock Grid.Column="5" Text="相态" Classes="th" />
        </Grid>
      </Border>

      <Panel>
        <!-- 空库 -->
        <StackPanel IsVisible="{Binding IsEmpty}" Margin="30,26" Spacing="7"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
          <TextBlock Text="还没有配方可看" FontSize="15" Foreground="#6b6f74" />
          <TextBlock FontSize="12" Foreground="#959a9f" LineHeight="19" MaxWidth="480"
                     TextWrapping="Wrap"
                     Text="库里存进第一条配方之后，这里会把它的步骤按工艺阶段摊开，方便应用前先看一眼。" />
        </StackPanel>

        <!-- ── 步骤（原型 .rx-phgrp）：左边一条阶段槽，右边一列两行式的卡片。
             从前这里是一张七列的表，参数挤成一串小方块，长一点的就被裁掉；
             卡片两行给了参数一整行的宽度，读起来才是一句话 ── -->
        <ScrollViewer IsVisible="{Binding IsStepsTab}">
          <ItemsControl ItemsSource="{Binding Phases}" Margin="0,0,0,16">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="106,*">
                  <!-- 阶段槽：阶段号 / 阶段名 / 这一段的合计时长（贴底） -->
                  <Border Grid.Column="0" Background="#fafafa" BorderBrush="#e4e6e3"
                          BorderThickness="0,0,1,0" Padding="20,11,12,10">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Bottom" Text="{Binding DurationText}"
                                 FontSize="10" Foreground="#9ea2a6" Margin="0,8,0,0" />
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding OrdinalText}" FontSize="10"
                                   Foreground="{StaticResource SelBd}"
                                   IsVisible="{Binding HasName}" />
                        <TextBlock Text="{Binding NameText}" FontSize="10.5" Foreground="#6b6f74"
                                   LineHeight="14" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="card" Classes.sel="{Binding IsSelected}">
                          <Grid ColumnDefinitions="3,*">
                            <!-- 选中那条 3px 蓝边（原型 inset box-shadow）。常在，只换色 -->
                            <Border Grid.Column="0"
                                    Background="{Binding IsSelected, Converter={x:Static ctl:Is.SelBar}}" />
                            <StackPanel Grid.Column="1" Margin="11,9,16,10">
                              <!-- 第一行：序号 · 模块色条 · 类型 · 整句描述 · 耗时 -->
                              <Grid ColumnDefinitions="15,9,4,9,60,9,*,10,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Seq}" FontSize="10.5"
                                           Foreground="#959a9f" TextAlignment="Right"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2" Height="16" CornerRadius="1"
                                        Background="{Binding ModuleColor}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Name}" FontSize="11"
                                           Foreground="#565a5f" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="6" Text="{Binding Desc}" FontSize="12.5"
                                           Foreground="#292b2e" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="8" Text="{Binding PlanDuration}" FontSize="11.5"
                                           Foreground="#3a3d41" VerticalAlignment="Center" />
                              </Grid>
                              <!-- 第二行：参数一串 + 右端结束条件。缩进到跟描述对齐 -->
                              <Grid ColumnDefinitions="*,12,Auto" Margin="28,6,0,0">
                                <ItemsControl Grid.Column="0" ItemsSource="{Binding Chips}"
                                              ClipToBounds="True">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <StackPanel Orientation="Horizontal" Spacing="5" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding Lead}" FontSize="11"
                                                   Foreground="#d3d5d2" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                   Foreground="#959a9f" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Value}" FontSize="11"
                                                   Foreground="#3a3d41" VerticalAlignment="Center" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="0" Text="无参数" FontSize="11"
                                           Foreground="#bfc2c2" IsVisible="{Binding !HasChips}" />
                                <TextBlock Grid.Column="2" FontSize="11" Foreground="#565a5f"
                                           VerticalAlignment="Center">
                                  <Run Text="→ " /><Run Text="{Binding EndText}" />
                                </TextBlock>
                              </Grid>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- 物料表：配方捎着的配料表。没捎就空着说一句，不编一张假表 -->
        <ScrollViewer IsVisible="{Binding IsMatTab}">
          <StackPanel>
            <TextBlock IsVisible="{Binding NoMaterials}" Margin="20,18" FontSize="11.5"
                       Foreground="#959a9f" TextWrapping="Wrap" MaxWidth="520"
                       HorizontalAlignment="Left"
                       Text="这条配方没有捎配料表。配方页存进库时，通道上那张配料表会一起入库（实投与批号不带——那是跟某一炉走的）。" />
            <ItemsControl ItemsSource="{Binding Materials}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="trow" MinHeight="32" Cursor="Arrow">
                    <Grid ColumnDefinitions="6,1.4*,110,80,120,90">
                      <TextBlock Grid.Column="1" Text="{Binding Name}" />
                      <TextBlock Grid.Column="2" Text="{Binding Cas}" Foreground="#565a5f" />
                      <TextBlock Grid.Column="3" Text="{Binding Role}" Foreground="#565a5f" />
                      <TextBlock Grid.Column="4" Text="{Binding Amount}" Foreground="#474a4e" />
                      <TextBlock Grid.Column="5" Text="{Binding Phase}" Foreground="#565a5f" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </DockPanel>
    </Border>

    <!-- ══ 右：属性栏 ══ 走台面页那一套，不照原型 -->
    <Border Grid.Column="2">
      <ScrollViewer>
          <StackPanel>
            <!-- ═ 配方块：常驻 ═ -->
            <Border Padding="18,16,18,20" Background="{StaticResource PropsBg}">
              <StackPanel>
                <TextBlock Text="配方属性" FontSize="24" FontWeight="Light" Foreground="#303337"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Classes="intro" IsVisible="{Binding IsEmpty}"
                           Text="左边库里还没有配方。存进第一条之后，这里可以改名、写描述，并把它应用到通道。" />
                <TextBlock Classes="intro" IsVisible="{Binding HasSelection}"
                           Text="点中间表里的一行，可在下面查看那一步的参数。" />

                <StackPanel IsVisible="{Binding HasSelection}">
                  <Grid ColumnDefinitions="76,*,40" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="名称" FontSize="12" Foreground="#3a3d41"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Classes="finput" Text="{Binding Name, Mode=TwoWay}" />
                  </Grid>
                  <Grid ColumnDefinitions="76,*,40" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="描述" FontSize="12" Foreground="#3a3d41"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Classes="finput" Text="{Binding Desc, Mode=TwoWay}" />
                  </Grid>
                  <Grid ColumnDefinitions="76,*,40" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="步骤数" FontSize="12" Foreground="#3a3d41"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Classes="finput" Text="{Binding StepCountText}"
                             IsEnabled="False" />
                  </Grid>
                  <Grid ColumnDefinitions="76,*,40" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="作者" FontSize="12" Foreground="#3a3d41"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Classes="finput" Text="{Binding AuthorText}"
                             IsEnabled="False" />
                  </Grid>
                  <Grid ColumnDefinitions="76,*,40">
                    <TextBlock Grid.Column="0" Text="最近更新" FontSize="12" Foreground="#3a3d41"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Classes="finput" Text="{Binding UpdatedText}"
                             IsEnabled="False" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 块与块之间的缝 -->
            <Border Height="9" IsVisible="{Binding HasStepSel}" />

            <!-- ═ 步骤块：表上点中哪一步显示哪一步，左边一条 6px 色条 ═ -->
            <Border Padding="18,16,18,20" IsVisible="{Binding HasStepSel}"
                    Background="{StaticResource PropsBg}"
                    BorderBrush="{StaticResource PropsBar}" BorderThickness="6,0,0,0">
              <StackPanel DataContext="{Binding SelStep}">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                  <!-- 配方页属性栏同款：色块换成这一步自己的指令图标 -->
                  <ctl:TecIcon Key="{Binding IconKey}" Size="24" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Light"
                             Foreground="#303337" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Module}" FontSize="12" Foreground="#888d92"
                             VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding Desc}" FontSize="11.5" Foreground="#3a3d41"
                           LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,10" />

                <Grid ColumnDefinitions="76,*,40" Margin="0,0,0,8">
                  <TextBlock Grid.Column="0" Text="耗时" FontSize="12" Foreground="#3a3d41"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                  <TextBox Grid.Column="1" Classes="finput" Text="{Binding PlanDuration}"
                           IsEnabled="False" />
                </Grid>
                <Grid ColumnDefinitions="76,*,40" Margin="0,0,0,8">
                  <TextBlock Grid.Column="0" Text="结束条件" FontSize="12" Foreground="#3a3d41"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                  <TextBox Grid.Column="1" Classes="finput" Text="{Binding EndText}"
                           IsEnabled="False" />
                </Grid>
                <Grid ColumnDefinitions="76,*,40">
                  <TextBlock Grid.Column="0" Text="工艺阶段" FontSize="12" Foreground="#3a3d41"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                  <TextBox Grid.Column="1" Classes="finput" Text="{Binding PhaseText}"
                           IsEnabled="False" />
                </Grid>

                <Border Height="1" Background="#d3d5d2" Margin="0,12,0,10" />
                <TextBlock Text="参数" FontSize="11.5" Foreground="#565a5f" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Chips}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="76,*" Margin="0,0,0,5">
                        <!-- 标签得能折行：参数名是驱动 schema 给的，长短不由这里说了算
                             （「到达后等待稳定」就有 7 个字）。不折行的话 Grid 不裁剪，
                             标签会直接压到右边那一列的值上 -->
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11.5"
                                   Foreground="#565a5f" Margin="0,0,10,0" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5"
                                   Foreground="#292b2e" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock IsVisible="{Binding !Chips.Count}" Text="该指令无需设置参数。"
                           FontSize="11.5" Foreground="#888d92" />

                <!-- 库里的配方是只读的：要改就应用到某个通道，在配方页改 -->
                <TextBlock FontSize="11" Foreground="#888d92" LineHeight="17" TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Text="库里的配方只看不改。要改先用上面的「应用」把它放到一个通道上，在配方页改完再存回库。" />
              </StackPanel>
            </Border>
            <!-- 动作区：对这条配方本身的三件事。跟在块后面，不钉在栏底——
                 钉底的话面板一高，这三颗就孤零零飘在下边，跟上面的块脱开了 -->
            <Border Height="9" IsVisible="{Binding HasSelection}" />
            <Border Padding="18,12,18,14" Background="{StaticResource PropsBg}"
                    IsVisible="{Binding HasSelection}">
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button Classes="tbtn foot" Command="{Binding SaveLib}" ToolTip.Tip="保存配方库">
                  <ctl:TecIcon Key="ui-foot-save" />
                </Button>
                <Button Classes="tbtn foot" Command="{Binding Duplicate}" ToolTip.Tip="另存副本">
                  <ctl:TecIcon Key="ui-foot-dup" />
                </Button>
                <Button Classes="tbtn del" Command="{Binding Delete}" ToolTip.Tip="从库中删除">
                  <ctl:TecIcon Key="ui-foot-trash" />
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
