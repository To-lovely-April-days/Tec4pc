<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             x:Class="Tec.App.Views.RecipeLibView">

  <!--
    版式照 gbg-recipes.html：库列表 280 ｜ 主区（标题 + 标签页 + 工具条 + 表）｜ 属性 342。
    属性栏不照原型那块通栏灰，按你定的那一套走：栏本身不铺底色、块用 PropsBg、
    块之间露白缝、「当前选中的那一个」左边一条 6px 色条。

    原型里有而我们没有的东西，一律不画：版本号（v3.2）、发布状态（PUBLISHED /
    Draft / Archived）、文件路径、置顶、文件夹分组、版本历史、持续状态甘特条——
    这些字段库里根本不记，画出来就是假的。表上每一格都是真读出来的。
  -->
  <UserControl.Styles>
    <!-- 库里的一条（原型 .rx-item）。左边那 6px 是选中条的位置，
         平时透明——写成边框的话选中时内容会横跳 6px -->
    <Style Selector="Border.rxitem">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#e6e6e6" />
      <Setter Property="BorderThickness" Value="1" />
      <!-- 左边不倒角：那 6px 色条是方的，卡片跟着方，色条才贴得平 -->
      <Setter Property="CornerRadius" Value="0,3,3,0" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.rxitem:pointerover">
      <Setter Property="Background" Value="{StaticResource HovBg}" />
      <Setter Property="BorderBrush" Value="#bfe0f4" />
    </Style>
    <Style Selector="Border.rxitem.sel">
      <Setter Property="Background" Value="{StaticResource SelBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource SelBd}" />
    </Style>
    <Style Selector="Border.rxitem TextBlock.rn">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="#2b2b2b" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.rxitem.sel TextBlock.rn">
      <Setter Property="Foreground" Value="{StaticResource SelTx}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 标签页（原型 .rx-tabs）：20px 细体，当前那个用主色 -->
    <Style Selector="Button.rxtab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Light" />
      <Setter Property="Foreground" Value="#8d8d8d" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.rxtab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#0a84c8" />
    </Style>
    <Style Selector="Button.rxtab.on">
      <Setter Property="Foreground" Value="{StaticResource SelBd}" />
    </Style>

    <!-- 表头一格 / 表身一行（原型 .rx-th / .rx-tr） -->
    <Style Selector="TextBlock.th">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#3a3a3a" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.trow">
      <!-- 透明也能收指针，写白只是省一层：表本来就铺在白上 -->
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#ececec" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.trow:pointerover">
      <Setter Property="Background" Value="{StaticResource HovBg}" />
    </Style>
    <Style Selector="Border.trow.sel">
      <Setter Property="Background" Value="{StaticResource SelBg}" />
    </Style>
    <Style Selector="Border.trow TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#2b2b2b" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 参数小标签（原型 .rx-chip） -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="#f4f4f4" />
      <Setter Property="BorderBrush" Value="#e6e6e6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.exp3">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#6b6b6b" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.exp3.up">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="180" />
      </Setter>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="280,*,342">

    <!-- ══ 左：配方库（原型 .rx-lib）══ -->
    <!-- ClipToBounds：这一栏宽度写死 280，Grid 不裁，里面的东西真比它宽的话
         会溢到中列上去 -->
    <Border Grid.Column="0" ClipToBounds="True"
            Background="#fafafa" BorderBrush="#dcdcdc" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- 抬头 + 搜索（原型 .rx-lhead） -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#e3e3e3"
                BorderThickness="0,0,0,1" Padding="12,11,12,10">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,9">
              <TextBlock Grid.Column="0" Text="配方库" FontSize="19" FontWeight="Light"
                         Foreground="#3b3b3b" />
              <TextBlock Grid.Column="1" Text="{Binding LibCountText}" FontSize="10.5"
                         Foreground="#a2a2a2" VerticalAlignment="Bottom" Margin="0,0,0,3" />
            </Grid>
            <Panel>
              <TextBox Classes="finput" Height="26" MinHeight="26" Padding="25,3,6,3"
                       Watermark="搜配方名" Text="{Binding Query, Mode=TwoWay}" />
              <ctl:TecIcon Key="ui-search" Tint="#9a9a9a" Size="12" Margin="8,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Panel>
          </StackPanel>
        </Border>

        <!-- 库级动作（原型 .rx-ltools）：新增与导入。这两件事跟「库」有关，
             跟当前打开的是哪条无关，所以摆在库这一栏 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#dcdcdc"
                BorderThickness="0,0,0,1" Padding="12,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="tbtn sm" ToolTip.Tip="把配方页当前通道的配方收进库"
                    Command="{Binding NewFromChannel}">
              <ctl:TecIcon Key="ui-lh-libnew" />
            </Button>
            <Button Classes="tbtn sm" ToolTip.Tip="从文件导入（.tecrecipe）"
                    Command="{Binding ImportToLib}">
              <ctl:TecIcon Key="ui-lh-libimport" />
            </Button>
          </StackPanel>
        </Border>

        <!-- 底部留白同上：Padding 只留左右上，底下那截写在内容的 Margin 上 -->
        <ScrollViewer Padding="8,8,8,0">
          <StackPanel Margin="0,0,0,40">
            <StackPanel IsVisible="{Binding IsEmpty}" Margin="4,8" Spacing="7">
              <TextBlock Text="没有配方" FontSize="13" Foreground="#6f6f6f" />
              <TextBlock FontSize="11.5" Foreground="#9a9a9a" LineHeight="19" TextWrapping="Wrap"
                         Text="在配方页把一条配方调好，用上面第一个按钮收进来；或者从 .tecrecipe 文件导入。搜索没结果时清空搜索框即可。" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="rxitem" Classes.sel="{Binding IsSelected}"
                         >
                    <!-- 6px 那一列常在，选中才上色：内容不会因为选中横跳 -->
                    <Grid ColumnDefinitions="6,*">
                      <Border Grid.Column="0"
                              Background="{Binding IsSelected, Converter={x:Static ctl:Is.SelBar}}" />
                      <StackPanel Grid.Column="1" Margin="9,7,9,8">
                        <TextBlock Text="{Binding Name}" Classes="rn" />
                        <TextBlock Text="{Binding Meta}" FontSize="10.5" Foreground="#9a9a9a"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <!-- 模块色带：一步一段，这条配方用到哪些模块一眼看得出 -->
                        <Border Height="4" CornerRadius="2" Background="#f0f0f0"
                                Margin="0,7,0,0" ClipToBounds="True">
                          <ItemsControl ItemsSource="{Binding Mix}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate><Border Background="{Binding}" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ══ 中：标题 + 标签页 + 工具条 + 表（原型 .rx-main）══ -->
    <Border Grid.Column="1" Background="White" Padding="0,0,6,0">
    <DockPanel>

      <!-- 抬头（原型 .rx-head）：名字 26px 细体，下面一行元信息 -->
      <StackPanel DockPanel.Dock="Top" Margin="20,12,20,0" IsVisible="{Binding HasSelection}">
        <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Light" Foreground="#3b3b3b" />
        <TextBlock Text="{Binding HeaderMeta}" FontSize="11" Foreground="#7a7a7a"
                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <!-- 标签页（原型 .rx-tabs）。原型第三个是「版本历史」，我们不记版本，只有两个 -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="20"
                  Margin="20,10,20,9" IsVisible="{Binding HasSelection}">
        <Button Classes="rxtab" Classes.on="{Binding IsStepsTab}" Content="步骤"
                Command="{Binding ShowSteps}" />
        <Button Classes="rxtab" Classes.on="{Binding IsMatTab}" Content="物料"
                Command="{Binding ShowMaterials}" />
      </StackPanel>

      <!-- 工具条（原型 .rx-tool）：这一条上的动作都是对「当前打开的这条配方」的。
           原型那排是解锁改步骤，我们这一页不改步骤（改在配方页），
           所以放的是这一页真正的主动作——应用到通道 -->
      <Border DockPanel.Dock="Top" Height="42" Background="#f4f4f4"
              BorderBrush="#e3e3e3" BorderThickness="0,1,0,1" IsVisible="{Binding HasSelection}">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,0,16,0"
                    VerticalAlignment="Center">
          <TextBlock Text="应用到" FontSize="12" Foreground="#444444" VerticalAlignment="Center" />
          <ComboBox Classes="sel" Width="180" ItemsSource="{Binding ApplyTargets}"
                    SelectedItem="{Binding ApplyTarget, Mode=TwoWay}" />
          <Button Classes="btn" Content="应用" Command="{Binding ApplyToChannel}"
                  IsEnabled="{Binding HasTargets}"
                  ToolTip.Tip="替换该通道当前的全部步骤，并跳到配方页" />
          <Button Classes="btn" Content="应用到全部通道" Command="{Binding ApplyToAll}"
                  IsEnabled="{Binding HasTargets}"
                  ToolTip.Tip="替换全部启用通道的步骤。每个通道各落一份独立副本" />
          <TextBlock Text="应用会替换目标通道当前的全部步骤" FontSize="11" Foreground="#9a9a9a"
                     VerticalAlignment="Center" Margin="4,0,0,0" />
        </StackPanel>
      </Border>

      <!-- ── 表头。跟表身用同一串列宽，两边才对得齐 ── -->
      <Border DockPanel.Dock="Top" Background="#fafafa" BorderBrush="#d5d5d5"
              BorderThickness="0,0,0,1" Height="28"
              IsVisible="{Binding IsStepsTab}">
        <Grid ColumnDefinitions="6,40,104,1.2*,1.8*,60,104">
          <TextBlock Grid.Column="1" Text="#" Classes="th" TextAlignment="Right" />
          <TextBlock Grid.Column="2" Text="类型" Classes="th" />
          <TextBlock Grid.Column="3" Text="步骤" Classes="th" />
          <TextBlock Grid.Column="4" Text="参数" Classes="th" />
          <TextBlock Grid.Column="5" Text="耗时" Classes="th" TextAlignment="Right" />
          <TextBlock Grid.Column="6" Text="结束条件" Classes="th" />
        </Grid>
      </Border>
      <Border DockPanel.Dock="Top" Background="#fafafa" BorderBrush="#d5d5d5"
              BorderThickness="0,0,0,1" Height="28"
              IsVisible="{Binding IsMatTab}">
        <Grid ColumnDefinitions="6,1.4*,110,80,120,90">
          <TextBlock Grid.Column="1" Text="组分" Classes="th" />
          <TextBlock Grid.Column="2" Text="CAS" Classes="th" />
          <TextBlock Grid.Column="3" Text="角色" Classes="th" />
          <TextBlock Grid.Column="4" Text="用量" Classes="th" />
          <TextBlock Grid.Column="5" Text="相态" Classes="th" />
        </Grid>
      </Border>

      <Panel>
        <!-- 空库 -->
        <StackPanel IsVisible="{Binding IsEmpty}" Margin="30,26" Spacing="7"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
          <TextBlock Text="还没有配方可看" FontSize="15" Foreground="#6f6f6f" />
          <TextBlock FontSize="12" Foreground="#9a9a9a" LineHeight="19" MaxWidth="480"
                     TextWrapping="Wrap"
                     Text="库里存进第一条配方之后，这里会把它的步骤按工艺阶段摊开，方便应用前先看一眼。" />
        </StackPanel>

        <!-- 步骤表 -->
        <ScrollViewer IsVisible="{Binding IsStepsTab}">
          <ItemsControl ItemsSource="{Binding Phases}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <!-- 阶段组头（原型 .rx-phase）。没标阶段的那一组不出组头 -->
                  <Border Background="#f2f2f2" BorderBrush="#e3e3e3" BorderThickness="0,1,0,1"
                          Padding="12,6" IsVisible="{Binding HasName}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9">
                        <TextBlock Text="阶段" FontSize="11" Foreground="#3d3d3d" />
                        <TextBlock Text="{Binding Name}" FontSize="11"
                                   Foreground="{StaticResource SelBd}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="10.5"
                                 Foreground="#8d8d8d" />
                    </Grid>
                  </Border>

                  <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="trow" Classes.sel="{Binding IsSelected}"
                                MinHeight="34">
                          <Grid ColumnDefinitions="6,40,104,1.2*,1.8*,60,104">
                            <Border Grid.Column="0"
                                    Background="{Binding IsSelected, Converter={x:Static ctl:Is.SelBar}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Seq}" TextAlignment="Right"
                                       FontSize="10.5" Foreground="#9a9a9a" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7"
                                        Margin="8,0" VerticalAlignment="Center">
                              <Border Width="4" Height="17" CornerRadius="1"
                                      Background="{Binding ModuleColor}" />
                              <TextBlock Text="{Binding Name}" Margin="0" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Desc}" />
                            <ItemsControl Grid.Column="4" ItemsSource="{Binding Chips}"
                                          Margin="8,0" VerticalAlignment="Center"
                                          ClipToBounds="True">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Classes="chip">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                      <TextBlock Text="{Binding Label}" FontSize="10"
                                                 Foreground="#9a9a9a" Margin="0" />
                                      <TextBlock Text="{Binding Value}" FontSize="10"
                                                 Foreground="#4a4a4a" Margin="0" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Column="5" Text="{Binding PlanDuration}"
                                       TextAlignment="Right" Foreground="#4a4a4a" />
                            <TextBlock Grid.Column="6" Text="{Binding EndText}" Foreground="#5a5a5a" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- 物料表：配方捎着的配料表。没捎就空着说一句，不编一张假表 -->
        <ScrollViewer IsVisible="{Binding IsMatTab}">
          <StackPanel>
            <TextBlock IsVisible="{Binding NoMaterials}" Margin="20,18" FontSize="11.5"
                       Foreground="#9a9a9a" TextWrapping="Wrap" MaxWidth="520"
                       HorizontalAlignment="Left"
                       Text="这条配方没有捎配料表。配方页存进库时，通道上那张配料表会一起入库（实投与批号不带——那是跟某一炉走的）。" />
            <ItemsControl ItemsSource="{Binding Materials}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="trow" MinHeight="32" Cursor="Arrow">
                    <Grid ColumnDefinitions="6,1.4*,110,80,120,90">
                      <TextBlock Grid.Column="1" Text="{Binding Name}" />
                      <TextBlock Grid.Column="2" Text="{Binding Cas}" Foreground="#5a5a5a" />
                      <TextBlock Grid.Column="3" Text="{Binding Role}" Foreground="#5a5a5a" />
                      <TextBlock Grid.Column="4" Text="{Binding Amount}" Foreground="#4a4a4a" />
                      <TextBlock Grid.Column="5" Text="{Binding Phase}" Foreground="#5a5a5a" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </DockPanel>
    </Border>

    <!-- ══ 右：属性栏 ══ 走台面页那一套，不照原型 -->
    <Border Grid.Column="2">
      <ScrollViewer>
          <StackPanel>
            <!-- ═ 配方块：常驻 ═ -->
            <Border Padding="18,16,18,20" Background="{StaticResource PropsBg}">
              <StackPanel>
                <TextBlock Text="配方属性" FontSize="24" FontWeight="Light" Foreground="#333333"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Classes="intro" IsVisible="{Binding IsEmpty}"
                           Text="左边库里还没有配方。存进第一条之后，这里可以改名、写描述，并把它应用到通道。" />
                <TextBlock Classes="intro" IsVisible="{Binding HasSelection}"
                           Text="点中间表里的一行，可在下面查看那一步的参数。" />

                <StackPanel IsVisible="{Binding HasSelection}">
                  <Grid ColumnDefinitions="96,*,40" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="名称" FontSize="12" Foreground="#3d3d3d"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Classes="finput" Text="{Binding Name, Mode=TwoWay}" />
                  </Grid>
                  <Grid ColumnDefinitions="96,*,40" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="描述" FontSize="12" Foreground="#3d3d3d"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Classes="finput" Text="{Binding Desc, Mode=TwoWay}" />
                  </Grid>
                  <Grid ColumnDefinitions="96,*,40" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="步骤数" FontSize="12" Foreground="#3d3d3d"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Classes="finput" Text="{Binding StepCountText}"
                             IsEnabled="False" />
                  </Grid>
                  <Grid ColumnDefinitions="96,*,40" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="作者" FontSize="12" Foreground="#3d3d3d"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Classes="finput" Text="{Binding AuthorText}"
                             IsEnabled="False" />
                  </Grid>
                  <Grid ColumnDefinitions="96,*,40">
                    <TextBlock Grid.Column="0" Text="最近更新" FontSize="12" Foreground="#3d3d3d"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Classes="finput" Text="{Binding UpdatedText}"
                             IsEnabled="False" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 块与块之间的缝 -->
            <Border Height="9" IsVisible="{Binding HasStepSel}" />

            <!-- ═ 步骤块：表上点中哪一步显示哪一步，左边一条 6px 色条 ═ -->
            <Border Padding="18,16,18,20" IsVisible="{Binding HasStepSel}"
                    Background="{StaticResource PropsBg}"
                    BorderBrush="{StaticResource SelBd}" BorderThickness="6,0,0,0">
              <StackPanel DataContext="{Binding SelStep}">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                  <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                          Background="{Binding ModuleColor}" />
                  <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Light"
                             Foreground="#333333" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Module}" FontSize="12" Foreground="#8d8d8d"
                             VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding Desc}" FontSize="11.5" Foreground="#3d3d3d"
                           LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,10" />

                <Grid ColumnDefinitions="96,*,40" Margin="0,0,0,8">
                  <TextBlock Grid.Column="0" Text="耗时" FontSize="12" Foreground="#3d3d3d"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                  <TextBox Grid.Column="1" Classes="finput" Text="{Binding PlanDuration}"
                           IsEnabled="False" />
                </Grid>
                <Grid ColumnDefinitions="96,*,40" Margin="0,0,0,8">
                  <TextBlock Grid.Column="0" Text="结束条件" FontSize="12" Foreground="#3d3d3d"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                  <TextBox Grid.Column="1" Classes="finput" Text="{Binding EndText}"
                           IsEnabled="False" />
                </Grid>
                <Grid ColumnDefinitions="96,*,40">
                  <TextBlock Grid.Column="0" Text="工艺阶段" FontSize="12" Foreground="#3d3d3d"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                  <TextBox Grid.Column="1" Classes="finput" Text="{Binding PhaseText}"
                           IsEnabled="False" />
                </Grid>

                <Border Height="1" Background="#d5d5d5" Margin="0,12,0,10" />
                <TextBlock Text="参数" FontSize="11.5" Foreground="#5a5a5a" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Chips}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="96,*" Margin="0,0,0,5">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11.5"
                                   Foreground="#5a5a5a" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5"
                                   Foreground="#2b2b2b" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock IsVisible="{Binding !Chips.Count}" Text="该指令无需设置参数。"
                           FontSize="11.5" Foreground="#8d8d8d" />

                <!-- 库里的配方是只读的：要改就应用到某个通道，在配方页改 -->
                <TextBlock FontSize="11" Foreground="#8d8d8d" LineHeight="17" TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Text="库里的配方只看不改。要改先用上面的「应用」把它放到一个通道上，在配方页改完再存回库。" />
              </StackPanel>
            </Border>
            <!-- 动作区：对这条配方本身的三件事。跟在块后面，不钉在栏底——
                 钉底的话面板一高，这三颗就孤零零飘在下边，跟上面的块脱开了 -->
            <Border Height="9" IsVisible="{Binding HasSelection}" />
            <Border Padding="18,12,18,14" Background="{StaticResource PropsBg}"
                    IsVisible="{Binding HasSelection}">
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button Classes="tbtn foot" Command="{Binding SaveLib}" ToolTip.Tip="保存配方库">
                  <ctl:TecIcon Key="ui-foot-save" />
                </Button>
                <Button Classes="tbtn foot" Command="{Binding Duplicate}" ToolTip.Tip="另存副本">
                  <ctl:TecIcon Key="ui-foot-dup" />
                </Button>
                <Button Classes="tbtn foot" Command="{Binding Delete}" ToolTip.Tip="从库中删除">
                  <ctl:TecIcon Key="ui-foot-trash2" />
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
