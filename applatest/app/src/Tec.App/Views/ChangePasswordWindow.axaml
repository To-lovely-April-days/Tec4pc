<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Tec.App.Views.ChangePasswordWindow"
        Title="修改密码" Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="#333333">
  <StackPanel Margin="20,16" Spacing="10">
    <TextBlock Name="WhoLine" FontSize="12" Foreground="#7a7a7a" />

    <Border Background="#fdf2f2" BorderBrush="#f0c9c9" BorderThickness="1" CornerRadius="2"
            Name="ErrBox" IsVisible="False">
      <Grid ColumnDefinitions="3,*">
        <Border Grid.Column="0" Background="#e02020" />
        <TextBlock Grid.Column="1" Name="ErrText" FontSize="11.5" Foreground="#8d2b2b"
                   TextWrapping="Wrap" Margin="9,8" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="86,*" RowDefinitions="Auto,Auto,Auto">
      <TextBlock Grid.Row="0" Text="旧密码" VerticalAlignment="Center" />
      <TextBox Grid.Row="0" Grid.Column="1" Name="OldBox" PasswordChar="●" Margin="0,0,0,8" />
      <TextBlock Grid.Row="1" Text="新密码" VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1" Name="NewBox" PasswordChar="●" Margin="0,0,0,8" />
      <TextBlock Grid.Row="2" Text="确认新密码" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" Name="New2Box" PasswordChar="●" />
    </Grid>

    <TextBlock Text="至少 4 位。修改会写入审计追踪。" FontSize="10.5" Foreground="#9a9a9a" />

    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Classes="btn" Content="取消" Click="OnCancel" />
      <Button Classes="btn primary" Content="确定" Click="OnOk" />
    </StackPanel>
  </StackPanel>
</Window>
