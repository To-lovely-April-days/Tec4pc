<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Tec.App.Views.ChangePasswordWindow"
        Title="修改密码" Width="470" Height="374" CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None" Background="White"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="#333333">

  <!--
    修改密码（照 gbg-account 原型的 .dlg）：470 宽、深紫标题条、
    三个带「眼睛」的密码框，底下是**边打字边勾**的规则表——
    以前是打完点确定才告诉你哪条不合规，改到一半才被驳回。
    规则本身在 PasswordPolicy 里，界面不另抄一份文案。
  -->

  <Border BorderBrush="#17102b" BorderThickness="1">
    <DockPanel>

      <!-- 标题条：无系统边框，这条自己负责拖动 -->
      <Border DockPanel.Dock="Top" Height="30" Background="#3c2d63"
              PointerPressed="OnTitlebarPressed">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Name="TitleText" Text="修改密码" Foreground="White" FontSize="12.5"
                     Margin="12,0,0,0" VerticalAlignment="Center" />
          <Button Grid.Column="1" Name="CloseBtn" Classes="winx" Click="OnCancel"
                  Margin="0,3,4,3" ToolTip.Tip="关闭">
            <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="White" StrokeThickness="1.2" />
          </Button>
        </Grid>
      </Border>

      <!-- 页脚 -->
      <Border DockPanel.Dock="Bottom" BorderBrush="#e3e3e3" BorderThickness="0,1,0,0"
              Padding="22,12,22,14">
        <Grid ColumnDefinitions="*,Auto,10,Auto">
          <TextBlock Classes="au" Text="修改会写入审计追踪" />
          <Button Grid.Column="1" Name="CancelBtn" Classes="dlgbtn" Content="取消" Click="OnCancel" />
          <Button Grid.Column="3" Name="OkBtn" Classes="dlgbtn primary" Content="确定"
                  IsEnabled="False" Click="OnOk" />
        </Grid>
      </Border>

      <StackPanel Margin="22,18,22,6">

        <!-- 改的是谁的密码，一行说清 -->
        <TextBlock Name="WhoLine" FontSize="11.5" Foreground="#6f6f6f" Margin="0,0,0,15"
                   TextWrapping="Wrap" />

        <!-- 「下次登录必须修改」进来的：说明为什么现在非改不可，也就没有取消 -->
        <Border Name="ForceStrip" IsVisible="False" Background="#fdf8ec" BorderBrush="#e8d6a8"
                BorderThickness="1" CornerRadius="2" Margin="0,0,0,12">
          <Grid ColumnDefinitions="3,Auto,9,*">
            <Border Grid.Column="0" Background="#dba32c" />
            <Viewbox Grid.Column="1" Width="13" Height="13" Margin="11,9,0,0"
                     VerticalAlignment="Top">
              <Canvas Width="16" Height="16">
                <Path Data="M 8,2 L 14.4,13 H 1.6 Z" Stroke="#b5851f" StrokeThickness="1.4"
                      StrokeJoin="Round" />
                <Rectangle Canvas.Left="7.3" Canvas.Top="6" Width="1.4" Height="3.8" Fill="#b5851f" />
                <Rectangle Canvas.Left="7.3" Canvas.Top="10.6" Width="1.4" Height="1.4" Fill="#b5851f" />
              </Canvas>
            </Viewbox>
            <TextBlock Grid.Column="3" FontSize="11.5" Foreground="#8a6a1f" LineHeight="18"
                       TextWrapping="Wrap" Margin="0,9,11,9"
                       Text="这个账号的密码是别人给你定的。改成只有你知道的一个，之后记录上的署名才算得上是你做的。" />
          </Grid>
        </Border>

        <!-- 旧密码 -->
        <Grid ColumnDefinitions="76,12,*" Margin="0,0,0,11">
          <TextBlock Text="旧密码" FontSize="12" Foreground="#3d3d3d" VerticalAlignment="Center" />
          <Grid Grid.Column="2">
            <TextBox Name="OldBox" Classes="dlgin" PasswordChar="●" />
            <Button Name="OldEye" Classes="eye" Click="OnEye" Tag="OldBox" IsTabStop="False"
                    HorizontalAlignment="Right" ToolTip.Tip="显示 / 隐藏">
              <Viewbox Width="15" Height="15">
                <Canvas Width="16" Height="16">
                  <Path Data="M 1,8 C 1,8 3.6,3.8 8,3.8 C 12.4,3.8 15,8 15,8 C 15,8 12.4,12.2 8,12.2 C 3.6,12.2 1,8 1,8 Z"
                        Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
                  <Ellipse Canvas.Left="5.9" Canvas.Top="5.9" Width="4.2" Height="4.2"
                           Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
                </Canvas>
              </Viewbox>
            </Button>
          </Grid>
        </Grid>

        <!-- 新密码 -->
        <Grid ColumnDefinitions="76,12,*" Margin="0,0,0,11">
          <TextBlock Text="新密码" FontSize="12" Foreground="#3d3d3d" VerticalAlignment="Center" />
          <Grid Grid.Column="2">
            <TextBox Name="NewBox" Classes="dlgin" PasswordChar="●" />
            <Button Name="NewEye" Classes="eye" Click="OnEye" Tag="NewBox" IsTabStop="False"
                    HorizontalAlignment="Right" ToolTip.Tip="显示 / 隐藏">
              <Viewbox Width="15" Height="15">
                <Canvas Width="16" Height="16">
                  <Path Data="M 1,8 C 1,8 3.6,3.8 8,3.8 C 12.4,3.8 15,8 15,8 C 15,8 12.4,12.2 8,12.2 C 3.6,12.2 1,8 1,8 Z"
                        Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
                  <Ellipse Canvas.Left="5.9" Canvas.Top="5.9" Width="4.2" Height="4.2"
                           Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
                </Canvas>
              </Viewbox>
            </Button>
          </Grid>
        </Grid>

        <!-- 大写锁定提示。**位置一直留着**，只是内容显不显示：
             真让它撑开一行，输入框会在打字过程中上下跳一格 -->
        <Grid Height="14" Margin="88,-4,0,2">
          <StackPanel Name="CapsHint" Orientation="Horizontal" Spacing="5" IsVisible="False">
            <Viewbox Width="11" Height="11" VerticalAlignment="Center">
              <Canvas Width="16" Height="16">
                <Path Data="M 8,2 L 13,7 H 10 V 10 H 6 V 7 H 3 Z" Stroke="#b5851f"
                      StrokeThickness="1.4" StrokeJoin="Round" />
                <Rectangle Canvas.Left="6" Canvas.Top="11.6" Width="4" Height="2.4"
                           Stroke="#b5851f" StrokeThickness="1.4" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="大写锁定已开启" FontSize="10.5" Foreground="#8a6a1f"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- 确认新密码 -->
        <Grid ColumnDefinitions="76,12,*" Margin="0,0,0,2">
          <TextBlock Text="确认新密码" FontSize="12" Foreground="#3d3d3d" VerticalAlignment="Center" />
          <Grid Grid.Column="2">
            <TextBox Name="New2Box" Classes="dlgin" PasswordChar="●" />
            <Button Name="New2Eye" Classes="eye" Click="OnEye" Tag="New2Box" IsTabStop="False"
                    HorizontalAlignment="Right" ToolTip.Tip="显示 / 隐藏">
              <Viewbox Width="15" Height="15">
                <Canvas Width="16" Height="16">
                  <Path Data="M 1,8 C 1,8 3.6,3.8 8,3.8 C 12.4,3.8 15,8 15,8 C 15,8 12.4,12.2 8,12.2 C 3.6,12.2 1,8 1,8 Z"
                        Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
                  <Ellipse Canvas.Left="5.9" Canvas.Top="5.9" Width="4.2" Height="4.2"
                           Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
                </Canvas>
              </Viewbox>
            </Button>
          </Grid>
        </Grid>

        <!-- 规则表：合规的一条变深、圆圈填绿打勾 -->
        <ItemsControl Name="Rules" Margin="88,2,0,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,2.5">
                <Border Width="12" Height="12" CornerRadius="6" BorderThickness="1.4"
                        Background="{Binding BoxFill}" BorderBrush="{Binding BoxLine}"
                        VerticalAlignment="Center">
                  <Viewbox Width="8" Height="8" IsVisible="{Binding Ok}">
                    <Canvas Width="10" Height="10">
                      <Path Data="M 1.6,5.2 L 3.8,7.4 L 8.4,2.8" Stroke="White" StrokeThickness="1.9" />
                    </Canvas>
                  </Viewbox>
                </Border>
                <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{Binding Fg}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 旧密码不对这类「打完才知道」的错，还是要一句话 -->
        <TextBlock Name="ErrText" FontSize="11" Foreground="#c0392b" IsVisible="False"
                   Margin="88,6,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
  </Border>

  <Window.Styles>
    <!-- 密码框右端那颗「眼睛」：贴着框内边，浅灰底、左侧一道分隔线 -->
    <Style Selector="Button.eye">
      <Setter Property="Width" Value="32" />
      <Setter Property="Margin" Value="0,1,1,1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#fafafa" />
      <Setter Property="BorderBrush" Value="#e2e2e2" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="CornerRadius" Value="0,2,2,0" />
      <Setter Property="Foreground" Value="#7a7a7a" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.eye:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#eaf6fd" />
    </Style>
    <!-- 正在明文显示时眼睛变蓝：一眼看出哪个框是敞着的 -->
    <Style Selector="Button.eye.on">
      <Setter Property="Foreground" Value="#1a91d6" />
    </Style>
  </Window.Styles>
</Window>
