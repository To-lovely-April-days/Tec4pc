<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             x:Class="Tec.App.Views.ExportView">

  <!-- 原型 view-export：实验记录 232 ｜ exmain ｜ 导出设置 342 -->
  <Grid ColumnDefinitions="232,*,342">

    <!-- 左：实验记录（.rrow.one 单行 + 圆底曲线图标 + 4px 左选中条） -->
    <Border Grid.Column="0" Background="#f4f4f4" BorderBrush="#dcdcdc" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="14,12,14,8">
          <TextBlock Text="实验记录" FontSize="20" FontWeight="Light" Foreground="#3b3b3b"
                     VerticalAlignment="Center" />
          <Button Classes="tbtn sm" ToolTip.Tip="刷新"><ctl:TecIcon Key="ui-ex-refresh" /></Button>
          <Button Classes="tbtn sm" ToolTip.Tip="按日期筛选"><ctl:TecIcon Key="ui-ex-calendar" /></Button>
        </StackPanel>
        <ScrollViewer>
          <StackPanel>
          <TextBlock IsVisible="{Binding NoRun}" Margin="16,14,16,0" FontSize="11.5"
                     Foreground="#9a9a9a" LineHeight="18" TextWrapping="Wrap"
                     Text="还没有跑过实验。启动任一通道后，本次批次会出现在这里。" />
          <ItemsControl ItemsSource="{Binding Runs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="rrow" Classes.sel="{Binding IsSel}" Cursor="Hand"
                        ToolTip.Tip="{Binding Tip}" PointerPressed="OnRunPressed">
                  <StackPanel Orientation="Horizontal" Spacing="11">
                    <Border Classes="ri" Classes.sel="{Binding IsSel}">
                      <ctl:TecIcon Key="ui-rrow-chart"
                                   Tint="{Binding IsSel, Converter={x:Static ctl:Is.SelInk}}" />
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{Binding IsSel, Converter={x:Static ctl:Is.SelFg}}"
                               FontWeight="{Binding IsSel, Converter={x:Static ctl:Is.SelWeight}}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 中：exhead + exbody -->
    <DockPanel Grid.Column="1" Background="White">
      <Border DockPanel.Dock="Top" BorderBrush="#e3e3e3" BorderThickness="0,0,0,1" Padding="22,12,22,10">
        <StackPanel>
          <TextBlock Text="{Binding ExName}" FontSize="23" FontWeight="Light" Foreground="#2b2b2b"
                     Margin="0,0,0,7" />
          <ItemsControl ItemsSource="{Binding Meta}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                  <TextBlock Text="{Binding K}" FontSize="11.5" Foreground="#9a9a9a" Margin="0,0,5,0" />
                  <TextBlock Text="{Binding V}" FontSize="11.5" Foreground="#5a5a5a" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <ScrollViewer>
        <StackPanel Margin="22,14,22,30">

          <!-- 没有记录时不摆一堆勾不动的设置项，直接说清楚要先跑一次 -->
          <StackPanel IsVisible="{Binding NoRun}" Spacing="7" Margin="0,6,0,0">
            <TextBlock Text="还没有可以导出的数据" FontSize="15" Foreground="#6f6f6f" />
            <TextBlock FontSize="12" Foreground="#9a9a9a" LineHeight="19" MaxWidth="560"
                       TextWrapping="Wrap"
                       Text="导出的是执行引擎记下来的真实数据。先在「台面」摆好设备、在「配方」写好步骤，用模拟模式的运行按钮启动通道，跑过之后这里就有内容了。" />
          </StackPanel>

          <StackPanel IsVisible="{Binding HasRun}">

          <Button Classes="secbtn" Command="{Binding ChannelsSection.Toggle}" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="exp3s" Classes.up="{Binding ChannelsSection.Open}">
                <ctl:TecIcon Key="ui-chev-down" Tint="#555555" />
              </Border>
              <TextBlock Text="导出通道" Classes="accs" />
            </StackPanel>
          </Button>
          <StackPanel IsVisible="{Binding ChannelsSection.Open}">
          <ItemsControl ItemsSource="{Binding Chips}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="chchip" Classes.on="{Binding On}" Classes.dis="{Binding !Available}"
                        Margin="0,0,8,8" Cursor="Hand" ToolTip.Tip="{Binding Tip}"
                        PointerPressed="OnChipPressed">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="10" Height="10" Fill="{Binding ColorHex}" />
                    <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="chchip" Margin="0,0,8,8" Cursor="Hand" HorizontalAlignment="Left"
                  PointerPressed="OnAllChPressed">
            <TextBlock Text="全选 / 反选" FontSize="11.5" />
          </Border>
          </StackPanel>

          <Button Classes="secbtn" Command="{Binding ItemsSection.Toggle}" Margin="0,14,0,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="exp3s" Classes.up="{Binding ItemsSection.Open}">
                <ctl:TecIcon Key="ui-chev-down" Tint="#555555" />
              </Border>
              <TextBlock Text="数据项" Classes="accs" />
            </StackPanel>
          </Button>
          <StackPanel IsVisible="{Binding ItemsSection.Open}">
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#9a9a9a" Margin="0,8,0,3" />
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Classes="ditem" IsChecked="{Binding On, Mode=TwoWay}"
                                  IsEnabled="{Binding Available}" ToolTip.Tip="{Binding Tip}"
                                  MinHeight="0" Padding="6,0,0,0">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Name}" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Unit}" FontSize="10.5" Foreground="#9a9a9a"
                                       IsVisible="{Binding HasUnit}" />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>

          <Button Classes="secbtn" Command="{Binding RangeSection.Toggle}" Margin="0,14,0,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="exp3s" Classes.up="{Binding RangeSection.Open}">
                <ctl:TecIcon Key="ui-chev-down" Tint="#555555" />
              </Border>
              <TextBlock Text="时间范围与采样" Classes="accs" />
            </StackPanel>
          </Button>
          <StackPanel IsVisible="{Binding RangeSection.Open}">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
            <TextBlock Text="范围" FontSize="11.5" Foreground="#3d3d3d" VerticalAlignment="Center" />
            <ComboBox Classes="sel" Width="110" Height="24" ItemsSource="{Binding RangeOptions}"
                      SelectedItem="{Binding Range, Mode=TwoWay}" />
            <TextBox Classes="finput" Width="130" Text="{Binding FromText, Mode=TwoWay}" />
            <TextBlock Text="至" FontSize="11.5" Foreground="#9a9a9a" VerticalAlignment="Center" />
            <TextBox Classes="finput" Width="130" Text="{Binding ToText, Mode=TwoWay}" />
            <TextBlock Text="采样间隔" FontSize="11.5" Foreground="#3d3d3d" VerticalAlignment="Center"
                       Margin="10,0,0,0" />
            <ComboBox Classes="sel" Width="108" Height="24" ItemsSource="{Binding IntervalOptions}"
                      SelectedItem="{Binding Interval, Mode=TwoWay}" />
            <TextBlock Text="时间基准" FontSize="11.5" Foreground="#3d3d3d" VerticalAlignment="Center"
                       Margin="10,0,0,0" />
            <ComboBox Classes="sel" Width="132" Height="24" ItemsSource="{Binding BaseOptions}"
                      SelectedItem="{Binding BaseLabel, Mode=TwoWay}" />
          </StackPanel>
          <TextBlock Text="{Binding BaseTip}" FontSize="10.5" Foreground="#9a9a9a" LineHeight="16"
                     TextWrapping="Wrap" Margin="0,7,0,0" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,14,0,4">
            <Button Grid.Column="0" Classes="secbtn" Command="{Binding PreviewSection.Toggle}"
                    Margin="0,0,8,0">
              <Border Classes="exp3s" Classes.up="{Binding PreviewSection.Open}">
                <ctl:TecIcon Key="ui-chev-down" Tint="#555555" />
              </Border>
            </Button>
            <Button Grid.Column="1" Classes="secbtn" Command="{Binding PreviewSection.Toggle}">
              <TextBlock Text="数据预览" Classes="accs" />
            </Button>
            <Button Grid.Column="3" Classes="ptab" Classes.on="{Binding PrevData}"
                    Content="采样数据" Command="{Binding SetPrev}" CommandParameter="data" />
            <Button Grid.Column="4" Classes="ptab" Classes.on="{Binding PrevStep}"
                    Content="步骤记录" Command="{Binding SetPrev}" CommandParameter="step" Margin="2,0,0,0" />
          </Grid>

          <StackPanel IsVisible="{Binding PreviewSection.Open}">
          <!-- dprev -->
          <Border BorderBrush="#dcdcdc" BorderThickness="1" CornerRadius="3" Background="White"
                  MaxHeight="220">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding PrevHeader}" Background="#fafafa">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#d5d5d5" BorderThickness="0,0,0,1" Padding="9,6" MinWidth="72">
                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#5a5a5a"
                                   TextAlignment="Right" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding PrevRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="#f2f2f2" BorderThickness="0,0,0,1" Padding="9,5" MinWidth="72">
                              <TextBlock Text="{Binding}" FontSize="11" Foreground="#2b2b2b"
                                         TextAlignment="Right" FontFamily="Consolas, Menlo, monospace" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
          </StackPanel>

          <!-- dsum -->
          <Border Background="#f7f9fa" BorderBrush="#e6e9eb" BorderThickness="1" CornerRadius="3"
                  Padding="12,8" Margin="0,9,0,0">
            <ItemsControl ItemsSource="{Binding Sum}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="{Binding K}" FontSize="11.5" Foreground="#5a5a5a" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding V}" FontSize="11.5" FontWeight="SemiBold" Foreground="#2b2b2b" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- 右：导出设置 -->
    <Border Grid.Column="2" Background="#ececec" BorderBrush="#d2d2d2" BorderThickness="1,0,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#d5d5d5" BorderThickness="0,1,0,0"
                Padding="16,12,16,14">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="btn primary" Content="导出" Command="{Binding DoExport}" Width="150" />
            <Button Classes="btn" Content="预览报告" Width="150" />
          </StackPanel>
        </Border>
        <ScrollViewer>
          <StackPanel Margin="18,16">
            <TextBlock Text="导出设置" FontSize="24" FontWeight="Light" Foreground="#333333"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ExName}" FontSize="11.5" Foreground="#7a7a7a"
                       HorizontalAlignment="Center" Margin="0,2,0,10" />

            <Button Classes="secbtn" Command="{Binding FormatSection.Toggle}" Margin="0,6,0,4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="exp3s" Classes.up="{Binding FormatSection.Open}">
                  <ctl:TecIcon Key="ui-chev-down" Tint="#555555" />
                </Border>
                <TextBlock Text="导出格式" Classes="accs" />
              </StackPanel>
            </Button>
            <StackPanel IsVisible="{Binding FormatSection.Open}">
            <ItemsControl ItemsSource="{Binding Fmts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="fmt" Classes.on="{Binding On}" Margin="0,0,7,7" Cursor="Hand"
                          PointerPressed="OnFmtPressed">
                    <StackPanel>
                      <Panel Height="36">
                        <ctl:TecIcon Key="{Binding IconKey}" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                      </Panel>
                      <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#2b2b2b"
                                 TextAlignment="Center" Margin="0,5,0,0" />
                      <TextBlock Text="{Binding Desc}" FontSize="9.5" Foreground="#9a9a9a"
                                 TextAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding FileNote}" FontSize="10.5" Foreground="#9a9a9a" LineHeight="16"
                       TextWrapping="Wrap" Margin="0,7,0,0" />
            </StackPanel>

            <Button Classes="secbtn" Command="{Binding ReportSection.Toggle}" Margin="0,14,0,4">
              <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="exp3s" Classes.up="{Binding ReportSection.Open}">
                <ctl:TecIcon Key="ui-chev-down" Tint="#555555" />
              </Border>
              <TextBlock Text="报告内容" Classes="accs" />
              <TextBlock Text="仅 Word / PDF" FontSize="10" Foreground="#9a9a9a" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel IsVisible="{Binding ReportSection.Open}">
            <StackPanel IsEnabled="{Binding ReportEnabled}" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="模板" FontSize="11.5" Foreground="#3d3d3d" VerticalAlignment="Center" />
                <ComboBox Classes="sel" Width="200" Height="24" SelectedIndex="0">
                  <ComboBoxItem Content="标准实验报告" />
                  <ComboBoxItem Content="结晶工艺报告" />
                  <ComboBoxItem Content="简要摘要" />
                </ComboBox>
              </StackPanel>
              <CheckBox Content="趋势曲线（Tr / Tj / Tr−Tj / pH）" FontSize="11.5" IsChecked="True" MinHeight="0" />
              <CheckBox Content="步骤执行记录表" FontSize="11.5" IsChecked="True" MinHeight="0" />
              <CheckBox Content="报警与偏差记录" FontSize="11.5" IsChecked="True" MinHeight="0" />
              <CheckBox Content="配方参数与台面配置" FontSize="11.5" IsChecked="True" MinHeight="0" />
              <CheckBox Content="化合物物性数据" FontSize="11.5" MinHeight="0" />
            </StackPanel>
            </StackPanel>

            <Button Classes="secbtn" Command="{Binding TargetSection.Toggle}" Margin="0,14,0,4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="exp3s" Classes.up="{Binding TargetSection.Open}">
                  <ctl:TecIcon Key="ui-chev-down" Tint="#555555" />
                </Border>
                <TextBlock Text="导出目标" Classes="accs" />
              </StackPanel>
            </Button>
            <StackPanel IsVisible="{Binding TargetSection.Open}">
            <Border Classes="dest" Classes.on="{Binding DestLocal}" Cursor="Hand"
                    PointerPressed="OnDestLocal">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Border Classes="rd" Classes.on="{Binding DestLocal}">
                  <Ellipse Width="7" Height="7" Fill="#1a7fc4" IsVisible="{Binding DestLocal}" />
                </Border>
                <ctl:TecIcon Key="ui-dest-local" Tint="#7a8791" VerticalAlignment="Center" />
                <StackPanel>
                  <TextBlock Text="本地文件夹" FontSize="12" Foreground="#2b2b2b" />
                  <TextBlock Text="{Binding LocalDir}" FontSize="10.5" Foreground="#9a9a9a"
                             TextTrimming="CharacterEllipsis" MaxWidth="210"
                             ToolTip.Tip="{Binding LocalDir}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="dest" Classes.on="{Binding DestUsb}" Cursor="Hand"
                    PointerPressed="OnDestUsb">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Border Classes="rd" Classes.on="{Binding DestUsb}">
                  <Ellipse Width="7" Height="7" Fill="#1a7fc4" IsVisible="{Binding DestUsb}" />
                </Border>
                <ctl:TecIcon Key="ui-dest-usb" Tint="#7a8791" VerticalAlignment="Center" />
                <StackPanel>
                  <TextBlock Text="USB 记忆盘" FontSize="12" Foreground="#2b2b2b" />
                  <TextBlock Text="{Binding UsbNote}" FontSize="10.5" Foreground="#9a9a9a" />
                </StackPanel>
              </StackPanel>
            </Border>
            </StackPanel>

            <Button Classes="secbtn" Command="{Binding GlpSection.Toggle}" Margin="0,14,0,4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="exp3s" Classes.up="{Binding GlpSection.Open}">
                  <ctl:TecIcon Key="ui-chev-down" Tint="#555555" />
                </Border>
                <TextBlock Text="GLP 合规" Classes="accs" />
              </StackPanel>
            </Button>
            <StackPanel IsVisible="{Binding GlpSection.Open}">
            <Border Background="White" BorderBrush="#dcdcdc" BorderThickness="1" CornerRadius="4"
                    Padding="11,9,11,4">
              <StackPanel Spacing="8">
                <CheckBox Content="附带审计追踪（操作与修改记录）" FontSize="11.5" IsChecked="True" MinHeight="0" />
                <CheckBox Content="生成完整性校验码（SHA-256）" FontSize="11.5" IsChecked="True" MinHeight="0" />
                <CheckBox Content="电子签名" FontSize="11.5" IsChecked="True" MinHeight="0" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="签名人" FontSize="11.5" Foreground="#3d3d3d" Width="52"
                             VerticalAlignment="Center" />
                  <TextBox Classes="finput" Width="180" Text="{Binding Signer, Mode=TwoWay}" />
                </StackPanel>
                <CheckBox Content="本次导出写入系统日志" FontSize="11.5" IsChecked="True" MinHeight="0"
                          Margin="0,0,0,6" />
              </StackPanel>
            </Border>
            </StackPanel>
            <TextBlock FontSize="10.5" Foreground="#9a9a9a" LineHeight="16" TextWrapping="Wrap"
                       Margin="0,7,0,0"
                       Text="导出文件包含原始采样数据、配方参数、台面配置与操作记录，满足实验记录完整可追溯的要求。" />
            <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="#2f8f49" TextWrapping="Wrap"
                       Margin="0,7,0,0" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.rrow">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#f0f0f0" />
      <Setter Property="BorderThickness" Value="4,0,0,1" />
      <Setter Property="Padding" Value="8,9,14,9" />
    </Style>
    <Style Selector="Border.rrow.sel">
      <Setter Property="Background" Value="#e8f2fb" />
      <Setter Property="BorderBrush" Value="#1a7fc4" />
    </Style>
    <Style Selector="Border.ri">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="#f2f2f2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.ri.sel">
      <Setter Property="Background" Value="#d4e7f7" />
    </Style>
    <Style Selector="Border.ri > :is(Control)">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.accs">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#3d3d3d" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.exp3s.up">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="180" />
      </Setter>
    </Style>
    <Style Selector="Button.secbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.secbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.exp3s">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="#6b6b6b" />
      <Setter Property="BorderThickness" Value="1.3" />
    </Style>
    <Style Selector="Border.exp3s > :is(Control)">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.chchip">
      <Setter Property="BorderBrush" Value="#d5d5d5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="8,5,12,5" />
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="Border.chchip.on">
      <Setter Property="BorderBrush" Value="#1a7fc4" />
      <Setter Property="Background" Value="#e8f2fb" />
    </Style>
    <Style Selector="Border.chchip.dis">
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="Background" Value="#fafafa" />
    </Style>

    <Style Selector="CheckBox.ditem">
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style Selector="Button.ptab">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#d5d5d5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Foreground" Value="#3d3d3d" />
    </Style>
    <Style Selector="Button.ptab.on">
      <Setter Property="BorderBrush" Value="#1a7fc4" />
      <Setter Property="Background" Value="#e8f2fb" />
      <Setter Property="Foreground" Value="#0b3760" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.fmt">
      <Setter Property="BorderBrush" Value="#d5d5d5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="7,9,7,8" />
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="Border.fmt.on">
      <Setter Property="BorderBrush" Value="#1a7fc4" />
      <Setter Property="Background" Value="#e8f2fb" />
      <Setter Property="BoxShadow" Value="0 0 0 2 #381a7fc4" />
    </Style>

    <Style Selector="Border.dest">
      <Setter Property="BorderBrush" Value="#d5d5d5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style Selector="Border.dest.on">
      <Setter Property="BorderBrush" Value="#1a7fc4" />
      <Setter Property="Background" Value="#e8f2fb" />
      <Setter Property="BoxShadow" Value="0 0 0 2 #381a7fc4" />
    </Style>
    <Style Selector="Border.rd">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderBrush" Value="#b5b5b5" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.rd.on">
      <Setter Property="BorderBrush" Value="#1a7fc4" />
    </Style>
    <Style Selector="Border.rd > Ellipse">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
</UserControl>
