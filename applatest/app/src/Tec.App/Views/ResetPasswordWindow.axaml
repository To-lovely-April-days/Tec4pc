<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Tec.App.Views.ResetPasswordWindow"
        Title="重置密码" Width="440" Height="318" CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None" Background="White"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="#333333">

  <!--
    管理员给别人重置密码（照原型的第三个对话框）。跟「修改密码」两件事：
    那边要旧密码、是本人自己改；这边不要旧密码、是管理员代设一个临时的，
    所以新密码这里**明文显示**——管理员得念给本人听，遮起来反而要靠猜。
  -->

  <Border BorderBrush="#17102b" BorderThickness="1">
    <DockPanel>

      <Border DockPanel.Dock="Top" Height="30" Background="#3c2d63"
              PointerPressed="OnTitlebarPressed">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="重置密码" Foreground="White" FontSize="12.5"
                     Margin="12,0,0,0" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="winx" Click="OnCancel" Margin="0,3,4,3"
                  ToolTip.Tip="关闭">
            <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="White" StrokeThickness="1.2" />
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" BorderBrush="#e3e3e3" BorderThickness="0,1,0,0"
              Padding="22,12,22,14">
        <Grid ColumnDefinitions="*,Auto,10,Auto">
          <TextBlock Classes="au" Text="操作记入审计追踪" />
          <Button Grid.Column="1" Classes="dlgbtn" Content="取消" Click="OnCancel" />
          <Button Grid.Column="3" Classes="dlgbtn primary" Content="重置" Click="OnOk" />
        </Grid>
      </Border>

      <StackPanel Margin="22,18,22,6">
        <TextBlock Name="WhoLine" FontSize="11.5" Foreground="#6f6f6f" Margin="0,0,0,4"
                   TextWrapping="Wrap" />

        <!-- 提醒条：重置这件事本身没有撤销，说清后果再让人点 -->
        <Border Background="#fdf8ec" BorderBrush="#e8d6a8" BorderThickness="1" CornerRadius="2"
                Margin="0,4,0,12">
          <Grid ColumnDefinitions="3,Auto,9,*">
            <Border Grid.Column="0" Background="#dba32c" />
            <Viewbox Grid.Column="1" Width="13" Height="13" Margin="11,10,0,0"
                     VerticalAlignment="Top">
              <Canvas Width="16" Height="16">
                <Path Data="M 8,2 L 14.4,13 H 1.6 Z" Stroke="#b5851f" StrokeThickness="1.4"
                      StrokeJoin="Round" />
                <Rectangle Canvas.Left="7.3" Canvas.Top="6" Width="1.4" Height="3.8" Fill="#b5851f" />
                <Rectangle Canvas.Left="7.3" Canvas.Top="10.6" Width="1.4" Height="1.4" Fill="#b5851f" />
              </Canvas>
            </Viewbox>
            <TextBlock Grid.Column="3" FontSize="11.5" Foreground="#8a6a1f" LineHeight="18"
                       TextWrapping="Wrap" Margin="0,9,11,9"
                       Text="重置后原密码立即失效。请当面或通过可靠渠道把新密码交给本人，不要写在便签上贴在工位。" />
          </Grid>
        </Border>

        <Grid ColumnDefinitions="76,12,*,8,Auto" Margin="0,0,0,4">
          <TextBlock Text="新密码" FontSize="12" Foreground="#3d3d3d" VerticalAlignment="Center" />
          <TextBox Grid.Column="2" Name="PassBox" Classes="dlgin" Padding="9,0" />
          <Button Grid.Column="4" Classes="dlgbtn" Content="随机生成" MinWidth="0" Padding="12,0"
                  Click="OnGenerate" />
        </Grid>

        <CheckBox Name="ForceBox" Margin="88,2,0,0" FontSize="11.5" IsChecked="True"
                  Content="下次登录必须修改密码" />
        <CheckBox Name="UnlockBox" Margin="88,0,0,0" FontSize="11.5" IsChecked="True"
                  Content="同时解锁该账号" IsVisible="False" />

        <TextBlock Name="ErrText" FontSize="11" Foreground="#c0392b" IsVisible="False"
                   Margin="88,6,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
