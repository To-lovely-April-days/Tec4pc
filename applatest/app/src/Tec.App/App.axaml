<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             x:Class="Tec.App.App"
             RequestedThemeVariant="Light">

  <!--
    ══ 配色 ══

      标题栏靛  #352d6a   通用深色底  #333333   白  #ffffff
      菜单选中蓝  #2a6fe5   面色  #f1f1f1   品牌红  #a41626

    色值是甲方给的一张表，不是推出来的，别照「协调」二字自行微调：
      标题栏 #352d6a ｜ 菜单选中 #2a6fe5 ｜ 属性栏与设备库那一栏的底 #f1f1f1 ｜
      泳道头卡片 #bfc9d7 ｜ 步骤卡 #82dcfe ｜ 底部状态条 #333333 白字

    面色从 #eff1f3 挪到 #f1f1f1（去掉了原来那点偏蓝，成中性灰），
    同一轮里台面设备库的底色关系也翻了过来：栏铺面色、设备格是白的。

    用色纪律，四条，改任何一支笔之前先读一遍：

    · 大面积深色分两支：**标题栏**走 #352d6a（七个窗口的标题栏都是它），
      其余深色底（运行药丸、复选框实底、面板深色表头、底部状态条）走
      通用的 #333333。它们是外壳不是信号，所以不占信号色。
    · 面 #f1f1f1 是「不是画布的那一层」：属性块、设备库那一栏的底、
      步骤库分类块、页顶工具条，全是这一支。同一层只许有一个色值——差一档最难看。
      （台面设备库里的**设备格**是例外，它是白的：一台设备一张白卡片浮在这层灰上，
      跟「一块面上开一个浅灰坑」不是一回事。）
    · 报警红 #d93025 永远是「实底填充 + 白字 + 三角图标」这一副样子，
      靠面积和形状区分，不靠色相。别处不许出现实底彩色圆片。
    · 绿 #0e7a3e 只表示在线 / 运行 / 通过，不做装饰，也不当主按钮。

    三色之外只剩两类：中性灰（正文与分隔线的层次）和状态色（绿/琥珀/报警红）。
    通道色与化合物类别色不在这套里——那是数据，跟着主题走等于把信息抹掉。
  -->
  <Application.Resources>
   <ResourceDictionary>
    <!--
      Fluent 自带控件（复选框、单选钮、滑杆、下拉的选中行）不吃下面那些具名笔，
      它们的强调色统一取自 SystemAccentColor 三兄弟。不改这里的话，
      整套换完红，导出页那一列复选框还是蓝的——最扎眼的就是这个。
      Dark 那一档也一起给：RequestedThemeVariant 现在是 Light，
      只写 Light 的话哪天切过去就露馅。
    -->
    <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Light">
        <Color x:Key="SystemAccentColor">#a41626</Color>
        <Color x:Key="SystemAccentColorLight1">#7e0f1c</Color>
        <Color x:Key="SystemAccentColorLight2">#7e0f1c</Color>
        <Color x:Key="SystemAccentColorLight3">#5c0b14</Color>
        <Color x:Key="SystemAccentColorDark1">#7e0f1c</Color>
        <Color x:Key="SystemAccentColorDark2">#7e0f1c</Color>
        <Color x:Key="SystemAccentColorDark3">#5c0b14</Color>

        <!--
          勾选框：勾上之后**只留一个勾**，框里不填色。

          从前是黑底浅勾（底 #333333 + 勾 #EFF1F3）。一屏可能有十几个
          （导出页的数据项那一列），十几块实心黑压在浅色表里，
          比它们标记的那些数据本身还重——远看是一列黑点，不是一列勾。

          现在底 Transparent、描边和勾都是 #333333：跟圆钮一族同一个道理，
          坐在什么底上就露什么底（属性栏是面色、表格是白），
          「勾没勾」由那一笔勾说，不靠一块色块喊。
          悬停 / 按下压一层黑当反馈，用的跟圆钮一族同两个值。
          Fluent 的勾选框颜色不吃具名笔，只认这几个键。
        -->
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="Transparent" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#18000000" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#22000000" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#333333" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#000000" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#000000" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#333333" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#000000" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#000000" />

      </ResourceDictionary>
      <ResourceDictionary x:Key="Dark">
        <Color x:Key="SystemAccentColor">#a41626</Color>
        <Color x:Key="SystemAccentColorLight1">#c8404f</Color>
        <Color x:Key="SystemAccentColorLight2">#d96b76</Color>
        <Color x:Key="SystemAccentColorLight3">#e8a0a8</Color>
        <Color x:Key="SystemAccentColorDark1">#7e0f1c</Color>
        <Color x:Key="SystemAccentColorDark2">#7e0f1c</Color>
        <Color x:Key="SystemAccentColorDark3">#5c0b14</Color>

        <!--
          勾选框：勾上之后**只留一个勾**，框里不填色。

          从前是黑底浅勾（底 #333333 + 勾 #EFF1F3）。一屏可能有十几个
          （导出页的数据项那一列），十几块实心黑压在浅色表里，
          比它们标记的那些数据本身还重——远看是一列黑点，不是一列勾。

          现在底 Transparent、描边和勾都是 #333333：跟圆钮一族同一个道理，
          坐在什么底上就露什么底（属性栏是面色、表格是白），
          「勾没勾」由那一笔勾说，不靠一块色块喊。
          悬停 / 按下压一层黑当反馈，用的跟圆钮一族同两个值。
          Fluent 的勾选框颜色不吃具名笔，只认这几个键。
        -->
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="Transparent" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#18000000" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#22000000" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#333333" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#000000" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#000000" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#333333" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#000000" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#000000" />

      </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 品牌 -->
    <SolidColorBrush x:Key="Brand" Color="#a41626" />
    <!-- 标题栏靛：七个窗口的标题栏、登录页左栏那块，同一支。
         它跟 Chrome 是两回事：Shell 是「这是本程序的头」，
         Chrome 是「这是一块深色底」（运行药丸、复选框、状态条）。
         从前两者共用外壳黑，甲方给色之后分了家 -->
    <SolidColorBrush x:Key="Shell" Color="#352d6a" />
    <SolidColorBrush x:Key="ShellDeep" Color="#251f4b" />
    <!-- 菜单栏底。跟泳道头卡片同值，是甲方给的同一支 -->
    <SolidColorBrush x:Key="MenuBar" Color="#bfc9d7" />
    <!-- 通用深色底 -->
    <SolidColorBrush x:Key="Chrome" Color="#333333" />
    <SolidColorBrush x:Key="ChromeDeep" Color="#1f1f1f" />
    <SolidColorBrush x:Key="BrandMid" Color="#7e0f1c" />
    <SolidColorBrush x:Key="BrandTint" Color="#faf2f3" />
    <SolidColorBrush x:Key="BrandTint2" Color="#f4e4e6" />

    <!-- 面板成块着色、块与块之间用白缝分隔。
         「面色」这一支：属性块、设备库那一栏的底、步骤库分类块、页顶工具条共用。
         PropsBg 跟它同值，两个名字都在用，改要一起改。

         #EFF1F3 → #F1F1F1：甲方新给的值，把原来那点偏蓝去掉了，成了中性灰。
         差得很小（最多两级），别的页面上肉眼看不出来；
         真正换了样子的是台面那一栏——底色和设备格的关系整个反过来了，见 BenchView。 -->
    <SolidColorBrush x:Key="ThemeFill" Color="#f1f1f1" />
    <SolidColorBrush x:Key="ThemeGap" Color="#ffffff" />
    <SolidColorBrush x:Key="ThemeLine" Color="#d0d2cf" />

    <!-- 选中态四件套：实线边 / 底色 / 柔环 / 深色字。
         选中底用最浅的 tint 而不是饱和红——同上，纪律第一条 -->
    <SolidColorBrush x:Key="SelBd" Color="#a41626" />
    <SolidColorBrush x:Key="SelBg" Color="#faf2f3" />
    <SolidColorBrush x:Key="SelRing" Color="#38a41626" />
    <SolidColorBrush x:Key="SelTx" Color="#7e0f1c" />
    <!-- 属性栏里那条 6px 左竖条（台面 / 配方 / 配方库共四处）。
         它标的是「下面这一块讲的是当前选中的那个东西」。
         这是全程序唯一一处蓝：换过品牌红（太抢，那条挨着一整栏参数）、
         也换过外壳黑（太重，像把这一块框死了），最后回到改配色以前的
         #1a7fc4。跟 SelBd 分开定义：SelBd 还管着配方库的选中边框和
         两处红字，那些得留在红上 -->
    <SolidColorBrush x:Key="PropsBar" Color="#1a7fc4" />
    <!-- 悬停保持中性：悬停是「指针在这儿」，不是「选中了」，
         两个都染品牌色的话，扫一眼分不出哪行是真选中 -->
    <SolidColorBrush x:Key="HovBg" Color="#f0f0ee" />

    <!-- 中性四档，对应原型的 ink / ink-2 / ink-3 / ink-4。
         暗端偏冷、亮端偏暖绿，是原型自己的调子，不是纯灰 -->
    <SolidColorBrush x:Key="Ink" Color="#1f2124" />
    <SolidColorBrush x:Key="Ink2" Color="#55595e" />
    <SolidColorBrush x:Key="Muted" Color="#8a8f94" />
    <SolidColorBrush x:Key="Muted2" Color="#a9adb1" />
    <SolidColorBrush x:Key="Line" Color="#e1e3e0" />
    <SolidColorBrush x:Key="Line2" Color="#e1e3e0" />
    <!-- 跟 ThemeFill 同值，见上面那段 -->
    <SolidColorBrush x:Key="PropsBg" Color="#f1f1f1" />
    <SolidColorBrush x:Key="PropsLine" Color="#d0d2cf" />
    <SolidColorBrush x:Key="Divider" Color="#d0d2cf" />

    <!-- 状态。三支各自只有一个意思 -->
    <SolidColorBrush x:Key="Run" Color="#0e7a3e" />
    <SolidColorBrush x:Key="RunLt" Color="#2fa35f" />
    <SolidColorBrush x:Key="Hold" Color="#8a6100" />
    <SolidColorBrush x:Key="Alarm" Color="#d93025" />
    <SolidColorBrush x:Key="AlarmDk" Color="#a81e15" />
    <!-- 菜单选中蓝：名字是历史的，值是甲方给的 #2a6fe5 -->
    <SolidColorBrush x:Key="MenuBlue" Color="#2a6fe5" />
    <SolidColorBrush x:Key="Green" Color="#0e7a3e" />
    <SolidColorBrush x:Key="Red" Color="#d93025" />

    <!-- 通道色：数据，不跟主题走 -->
    <SolidColorBrush x:Key="Ch1" Color="#2f7ed8" />
    <SolidColorBrush x:Key="Ch2" Color="#2aa87a" />
    <SolidColorBrush x:Key="Ch3" Color="#c9772b" />
    <SolidColorBrush x:Key="Ch4" Color="#8a63d2" />

    <FontFamily x:Key="UiFont">Segoe UI, Microsoft YaHei UI, Microsoft YaHei, system-ui, Arial</FontFamily>
   </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!--
      强调色钉死在品牌红上。

      光在 Application.Resources 里覆盖 SystemAccentColor 是不够的：
      Windows 上 Avalonia 会从系统取主题色（IPlatformSettings 的 AccentColor1）
      灌进 Fluent 的调色板，那一份优先级压过应用资源——于是同一份代码在
      Linux 上复选框是红的、在 Windows 上跟着系统蓝。Palettes 是 FluentTheme
      自己的入口，给了它就不再问系统要。两处都写着，谁先生效都是这个色。
    -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#a41626" />
        <ColorPaletteResources x:Key="Dark" Accent="#a41626" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!--
      ══ 滚动条：全程序一套 ══

      槽 14px #e4e4e4，滑块 #b8b8b8 四周内缩 3px（露出来 8px 宽）、圆头，
      悬停 #a2a6aa、按下再深一档，两端各一枚三角箭头，点一下走一小格。

      槽的颜色试过跟面色同值（#f1f1f1）——那是个错：设备库那一栏的底就是面色，
      槽压上去整条看不见，内容又刚好装得下（没有滑块），
      于是一栏右边只剩上下两枚三角孤零零挂着，看着像界面画坏了。
      槽比它坐的底深一档才成立：白页上、面色栏上都看得出这是一道槽，
      「这栏能滚」这句话由槽说，有没有滑块说的是「现在有没有得滚」。

      **Fluent 自带那套伸缩滚动条不要。**它平时是一条几像素的细线，指针一碰
      就整条变粗、上下还长出两个箭头按钮——同一条滚动条两副样子，
      而且宽度一变旁边的内容跟着重排一次。设备库那一列尤其明显：
      滑块从细线变成粗条的那一下，整栏图标横着跳一格。

      自动隐藏也一并关掉（AllowAutoHide=False）：滚动条是「这里还有东西没看见」
      的唯一提示，让它自己淡掉，等于把这句话藏起来——列表长不长要靠试着滚一下才知道。
      代价是它一直占着 14px 宽，这正是原型里那条滚动条的做法。

      模板自己写而不是改 Fluent 的：那套模板的粗细分散在 :expanded / :pointerover
      好几个状态里，逐个压平比重写一份还长，而且下次升级 Avalonia 又得重找一遍。
      部件名（PART_Track / PART_PageUpButton / PART_PageDownButton /
      PART_LineUpButton / PART_LineDownButton）照 Avalonia 的约定给，
      翻页和步进的点击都由 ScrollBar 自己按名字接上，不用挂命令。

      两端那两枚箭头是自己画的三角（Path），不是字符也不是 svg：
      它只有 7×4 那么大，字符在这个尺寸上认不出形状，
      单开两个 svg 文件又太重——一条 M/L/Z 的路径说得完的事。
    -->
    <Style Selector="ScrollViewer">
      <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
    </Style>

    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="#e4e4e4" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="14" />
      <Setter Property="MinWidth" Value="14" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Grid RowDefinitions="14,*,14">
              <RepeatButton Grid.Row="0" Name="PART_LineUpButton" Classes="sbline">
                <Path Classes="sbarrow" Data="M 0 4 L 3.5 0 L 7 4 Z" />
              </RepeatButton>
              <Track Grid.Row="1" Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}"
                     ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_PageUpButton" Classes="sbpage" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_PageDownButton" Classes="sbpage" />
                </Track.IncreaseButton>
                <!-- 内容再长滑块也不小于这么高：短到只剩几像素就抓不住了 -->
                <Thumb Classes="sbthumb" MinHeight="28" />
              </Track>
              <RepeatButton Grid.Row="2" Name="PART_LineDownButton" Classes="sbline">
                <Path Classes="sbarrow" Data="M 0 0 L 3.5 4 L 7 0 Z" />
              </RepeatButton>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="ScrollBar:horizontal">
      <Setter Property="Height" Value="14" />
      <Setter Property="MinHeight" Value="14" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Grid ColumnDefinitions="14,*,14">
              <RepeatButton Grid.Column="0" Name="PART_LineUpButton" Classes="sbline">
                <Path Classes="sbarrow" Data="M 4 0 L 0 3.5 L 4 7 Z" />
              </RepeatButton>
              <Track Grid.Column="1" Name="PART_Track" Orientation="Horizontal"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}"
                     ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_PageUpButton" Classes="sbpage" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_PageDownButton" Classes="sbpage" />
                </Track.IncreaseButton>
                <Thumb Classes="sbthumb" MinWidth="28" />
              </Track>
              <RepeatButton Grid.Column="2" Name="PART_LineDownButton" Classes="sbline">
                <Path Classes="sbarrow" Data="M 0 0 L 4 3.5 L 0 7 Z" />
              </RepeatButton>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- 滑块。内缩 3px 靠模板里这圈 Margin，槽的底色从后面透出来当边距 -->
    <Style Selector="Thumb.sbthumb">
      <Setter Property="Background" Value="#b8b8b8" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="3" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Thumb.sbthumb:pointerover">
      <Setter Property="Background" Value="#a2a6aa" />
    </Style>
    <Style Selector="Thumb.sbthumb:pressed">
      <Setter Property="Background" Value="#8a8f94" />
    </Style>

    <!-- 滑块两侧的空槽：点一下翻一页。透明但要能收指针，所以底色写 Transparent -->
    <Style Selector="RepeatButton.sbpage">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- 两端那两枚步进钮：14×14，底透（露槽色），中间一枚三角 -->
    <Style Selector="RepeatButton.sbline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RepeatButton.sbline:pointerover">
      <Setter Property="Background" Value="#18000000" />
    </Style>
    <Style Selector="RepeatButton.sbline:pressed">
      <Setter Property="Background" Value="#22000000" />
    </Style>
    <!-- 三角本身：跟滑块同一支灰，指上去跟着一起变深 -->
    <Style Selector="Path.sbarrow">
      <Setter Property="Fill" Value="#8f8f8f" />
    </Style>
    <Style Selector="RepeatButton.sbline:pointerover Path.sbarrow">
      <Setter Property="Fill" Value="#4a4a4a" />
    </Style>
    <Style Selector="RepeatButton.sbline:pressed Path.sbarrow">
      <Setter Property="Fill" Value="#1f1f1f" />
    </Style>

    <!-- 主菜单项：25px 细体。
         没选中的走 #a9adb1——看着是禁用那一档，但它照样能点。
         这么排的道理：一次只有一项是当前视图，其余八项对「我现在在哪」
         不提供信息，压到底才不跟红字抢。
         代价是「能不能点」的提示弱了，所以悬停一步跳到 #1f2124（近黑），
         指针一碰就明确告诉你这是活的。
         选中 = 主题色的字 + 底下 2px 外壳黑，两支笔各说一件事。

         内边距挪成外边距：Avalonia 的边框画在 ContentPresenter 的外沿，
         Padding="11,0" 时下划线会比文字左右各长出 11px；原型那条是
         left:11px right:11px，正好贴着文字。改用 Margin 就对齐了。 -->
    <Style Selector="Button.menu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="11,0" />
      <!--
        原型那排菜单是 25px 拉丁，大写字母实高 18px；同样 25px 的中文实高 24px——
        汉字占满字身框，拉丁大写只占约 0.72，照抄字号中文就比原型大了三分之一，
        看着又粗又挤。22px 的中文实高 21px，比拉丁略高一点点：
        汉字笔画密，压到 18px 就该糊了，这一档是「看着一样大」又不牺牲可读的位置
      -->
      <Setter Property="FontSize" Value="22" />
      <!-- 300。中文要落到细体得靠字体自己有 Light 这一档（Windows 上的
           微软雅黑 UI 有）；没有 Light 的机器会退回 Regular，那是字体的事，不是这里 -->
      <Setter Property="FontWeight" Value="Light" />
      <!-- 未选中一律黑字。从前是浅灰 #a9adb1（白底上「没选中的往后退」那一套），
           菜单栏改成 #bfc9d7 的实底之后浅灰压在上面几乎读不出来 -->
      <Setter Property="Foreground" Value="#1f2124" />
      <!-- 拉满 52 高，下划线才落在菜单栏底边上（原型的 bottom:0） -->
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!--
      悬停 / 按下：**什么都不变**。菜单项靠「哪一个是蓝的」说当前在哪一页，
      鼠标划过去改样子只会跟这件事抢眼睛。

      这两条不能省，也不能只写 Background：Fluent 自带的按钮主题在
      :pointerover / :pressed 上把 TextBlock.Foreground 写在 **ContentPresenter**
      上，那是内容文字继承链上更近的一环，压得过按钮自己的 Foreground——
      光删掉我们这边的设值，字照样被主题刷成黑的（实测：未选中 #1f2124 → #000000，
      选中项连那个蓝都被盖成黑）。所以得在同一处显式写回原色：
      未选中写常态的墨色，选中项另写一条把蓝按回去。

      BorderBrush 同理，而且更隐蔽：选中项底下那条 2px 蓝线是靠
      BorderBrush 画的，主题在 :pointerover 上把 ContentPresenter 的
      BorderBrush 也换掉，鼠标一停线就变成栏底色、看着像整条没了
      （实测差异正好是那 92 个像素：#2a6fe5 → #bfc9d7）。
    -->
    <Style Selector="Button.menu:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#1f2124" />
    </Style>
    <Style Selector="Button.menu:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#1f2124" />
    </Style>
    <Style Selector="Button.menu.on:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource MenuBlue}" />
      <Setter Property="TextBlock.Foreground" Value="{StaticResource MenuBlue}" />
    </Style>
    <Style Selector="Button.menu.on:pressed /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource MenuBlue}" />
      <Setter Property="TextBlock.Foreground" Value="{StaticResource MenuBlue}" />
    </Style>
    <!-- 选中项：字与下划线同色。从前字是品牌红、线是外壳黑，
         那是「红只许小面积」时代的折中；甲方给了菜单选中蓝之后，
         记号只剩一个意思，就不该再拆成两个颜色说 -->
    <Style Selector="Button.menu.on">
      <Setter Property="Foreground" Value="{StaticResource MenuBlue}" />
      <Setter Property="BorderBrush" Value="{StaticResource MenuBlue}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>

    <!-- 运行控制：黑药丸 + 三颗实心圆钮。
         中间试过原型那种描边分段控件，实机上不行：底色一白，三颗钮就只剩三个
         小色块，禁用时再压到 0.38 透明度整排糊成一片，看不出哪颗是急停。
         黑底 + 实心圆片这一套是靠「色块面积」认按钮的，压暗了照样分得清。 -->
    <!-- 30 是配 38 高的药丸的（药丸配 44 高的菜单栏）。从前是 36 配 48 -->
    <Style Selector="Button.rbtn">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="#4d4d4d" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.rbtn.play">
      <Setter Property="Background" Value="#0e7a3e" />
    </Style>
    <!-- 急停：红底。三颗一个样的话，慌起来很容易把停止按成暂停 -->
    <Style Selector="Button.rbtn.stop">
      <Setter Property="Background" Value="#d93025" />
    </Style>
    <!-- 三张 svg 的 fill 是 currentColor，在黑药丸上一律描白 -->
    <Style Selector="Button.rbtn ctl|TecIcon">
      <Setter Property="Tint" Value="White" />
    </Style>
    <!-- 按不了的时候暗下去。缺省禁用样式会把底色整个刷成一片灰，
         三颗糊在一起分不出哪颗是哪颗——这里各自保住自己的颜色，只是整体压暗 -->
    <Style Selector="Button.rbtn:disabled">
      <Setter Property="Opacity" Value="0.32" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <!-- 三颗的底色钉死：Fluent 的缺省 :pointerover / :pressed / :disabled 都会去改
         ContentPresenter 的 Background，鼠标一压上去急停就从红变灰，
         看着像它自己失效了 -->
    <Style Selector="Button.rbtn:pointerover /template/ ContentPresenter,
                     Button.rbtn:pressed /template/ ContentPresenter,
                     Button.rbtn:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#4d4d4d" />
    </Style>
    <Style Selector="Button.rbtn.play:pointerover /template/ ContentPresenter,
                     Button.rbtn.play:pressed /template/ ContentPresenter,
                     Button.rbtn.play:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#0e7a3e" />
    </Style>
    <Style Selector="Button.rbtn.stop:pointerover /template/ ContentPresenter,
                     Button.rbtn.stop:pressed /template/ ContentPresenter,
                     Button.rbtn.stop:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#d93025" />
    </Style>

    <!-- 圆形工具按钮：34px，2px 深灰描边 -->
    <!--
      ══ 圆钮 ══
      细黑描边的空心圆，全程序的工具条 / 卡片动作钮共用这一族。

      描边 2 → 1.6、颜色 #474a4e → #1f2124：细一点、黑一点，圈才利落。
      2px 的深灰在 34 的圆上偏钝，一排摆开像一串垫圈。
      1.6 也是 sm 那一档本来就在用的粗细——现在整族一个粗细，
      同一行里混着 1.6 和 2 的时候，粗的那颗会显得比旁边"重要"。

      **圈里是透的**，不填白：这一族坐在什么底上就露什么底（工具条是面色、
      画布是白、属性块是面色）。填白的时候，压在面色工具条上的那几颗
      各自顶着一块比周围亮的圆盘，一排看过去像几个补丁。
    -->
    <Style Selector="Button.tbtn">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#1f2124" />
      <Setter Property="BorderThickness" Value="1.6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- 悬停：压一层 9% 的黑、描边到纯黑。原来是品牌红的一套（#faf2f3 / #a41626），
         那是换配色以前留下的——现在满屏冷灰蓝，指哪儿哪儿冒一圈红。

         **半透明而不是给个定色**：圈里既然是透的，这一族就坐在三种底上
         （白画布 / 面色工具条 / 面色属性块）。之前悬停填面色 #eff1f3，
         压在面色工具条上等于什么都没发生——指上去只有描边从 #1f2124
         挪到 #000000，肉眼分不出来。压一层黑就跟底无关：
         白 → #ebebeb，面色 → #d8dade，两边都是看得见的一档。 -->
    <Style Selector="Button.tbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#18000000" />
      <Setter Property="BorderBrush" Value="#000000" />
    </Style>
    <Style Selector="Button.tbtn.sm">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
    </Style>
    <!-- foot / del 从前各刷一层 #ebece9。它跟面色 #eff1f3 只差四级，
         压在属性块上是「看得出不一样又说不出为什么」那一档；
         底一律透明之后，这两族跟工具条那几颗长得一样，本来就该一样 -->
    <Style Selector="Button.tbtn.foot">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <!--
      ══ 删除钮 ══
      全程序**所有**删除入口共用这一族，规格照台面属性栏那颗（32 灰底圆钮 +
      实心垃圾桶 ui-foot-trash）。从前是八处各写各的：两处 tbtn foot、
      三处 tbtn sm、两处 17px 透明方角小钮（Button.trash）、一处泳道头的
      蓝灰圆钮（lhbtn）；配着四个垃圾桶 svg，其中三个是同一条 path 的
      三份拷贝，只是尺寸和颜色不同。同一个记号八种拼法。

      单开 del 这个类而不是直接用 foot：foot 的意思是「属性栏底部动作区那一排」，
      保存和连接也在用；del 的意思是「这颗会删东西」。`grep 'tbtn del'`
      就是全项目的删除入口清单，以后不会再有人拿 foot 当删除记号。

      d26 / d24 是同一颗钮的小号，给塞不下 32 的三个位置用（泳道头 26 列、
      步骤卡 24 空档、变量行 24 空档，三处都动不得——算式见各自的注释）。
      形状、底色、描边一律照旧，只是直径小一号；图标按基准的 15/32≈0.47
      等比缩到 12 / 11，视觉重量才跟大号一致。
    -->
    <Style Selector="Button.tbtn.del">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <!-- d26 / d24 只管直径，不带「删除」的意思：写在 .del 后面，所以
         `tbtn del d26` 仍然是 26。单拎出来是因为别处也有塞不下 34 的位置
         （copybar 那颗复制钮就是 26），不该为了借个尺寸去挂 del 这个记号 -->
    <Style Selector="Button.tbtn.d26">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
    </Style>
    <Style Selector="Button.tbtn.d24">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <!--
      bare：只留记号，不套圈。眼下只给配方页步骤卡右下角那颗删除钮用。

      圆钮那一族的圈是「这是一颗独立的钮」的意思——工具条上一排、属性栏底下一排，
      都是站在自己那块地方的按钮。步骤卡里不是：那颗桶挤在「预计开始 / 耗时」
      同一行的行尾，一张卡上已经有色条、图标、徽记、描述、排期五样东西，
      再多一个圈就是第六种形状。去掉圈以后它读成「这一行末尾的一个动作」，
      跟旁边两段字是一体的。

      仍然挂在 tbtn del 底下（`grep 'tbtn del'` 还是全项目的删除入口清单），
      只是把圈和直径覆写掉：20 见方、3 圆角，指上去压一层黑当反馈。
    -->
    <Style Selector="Button.tbtn.bare">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.tbtn.bare:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#18000000" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!--
      勾选框勾上之后那个方框要留着。

      上面主题字典里那几个 CheckBoxCheckBackground*Checked 只把**底**改透明就够了，
      **描边却跟着一起没了**——实测勾上之后整个方框消失，只剩一个光秃秃的勾，
      而没勾的时候是一个空方框：同一个控件，勾一下方框就不见了，
      一列里勾的和没勾的两行对不齐。

      所以直接压模板里那块 Border#NormalRectangle：底透、描边照旧 1px #333333。
      这样两个状态是同一个方框，区别只在里面有没有那一笔勾——本来就该是这样。
    -->
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#333333" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="#18000000" />
      <Setter Property="BorderBrush" Value="#000000" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="#22000000" />
      <Setter Property="BorderBrush" Value="#000000" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>


    <!-- 会丢数据的那种圆钮：描边染红，指上去也是红的，不跟别的钮一样变蓝。
         按之前一定会弹框问一遍，但在按之前就该看出来这颗跟旁边那几颗不是一回事。
         跟 del 叠着用：形状 / 尺寸 / 图标全一样，只有描边和桶是红的——
         「删一条」和「清整库」长成同尺寸同底色的孪生钮挨在一起才是真的危险 -->
    <Style Selector="Button.tbtn.danger">
      <Setter Property="BorderBrush" Value="#d93025" />
    </Style>
    <Style Selector="Button.tbtn.danger:pointerover /template/ ContentPresenter">
      <!-- 同上：半透明的红而不是 #fdecea 那种定色，坐白底坐面色底都成立 -->
      <Setter Property="Background" Value="#22d93025" />
      <Setter Property="BorderBrush" Value="#d93025" />
    </Style>
    <!-- 按不了的时候还是一个圈，只是淡下去。Fluent 的缺省禁用样式会把描边整个抹掉，
         剩一块灰饼——看着像坏了，不像"现在不能按"。
         底跟常态一样是透的（从前刷 #f5f5f4，压在面色工具条上是一块比周围亮的圆盘，
         正是"填白"那个毛病换了个颜色）：只靠描边转淡 + 整体 0.55 说明按不了 -->
    <Style Selector="Button.tbtn:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#cdcfcd" />
    </Style>
    <Style Selector="Button.tbtn:disabled">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- 普通按钮 28px；主按钮绿色 -->
    <Style Selector="Button.btn">
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="BorderBrush" Value="#b6b9bb" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#303337" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- 主操作 = 品牌红。绿只留给「在线 / 运行 / 通过」这一个意思；
         「导出」「保存」这类是动作不是状态，占了绿就分不清了 -->
    <Style Selector="Button.btn.primary">
      <Setter Property="Background" Value="#a41626" />
      <Setter Property="BorderBrush" Value="#7e0f1c" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!--
      对话框那一套（照 gbg-account 原型的 .dlg-* / .um-*）：账户菜单、修改密码、
      重置密码、用户管理四处共用。跟上面的 Button.btn 不是一回事——那是页面里的
      按钮（28 高、圆角 3），这几个是对话框里的（30 高、圆角 2、灰底深边），
      原型两套本来就长得不一样，各留各的，不互相凑合。
    -->
    <!-- 自绘标题栏右上角的窗钮 -->
    <Style Selector="Button.winx">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.winx:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e81123" />
    </Style>

    <!-- 对话框里的输入框：30 高，聚焦描蓝；.bad 是「两次不一致」那种红边 -->
    <Style Selector="TextBox.dlgin">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="9,0,38,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#a4a8ac" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="TextBox.dlgin.bad /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#d93025" />
    </Style>

    <!-- 对话框按钮 -->
    <Style Selector="Button.dlgbtn">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Background" Value="#f1f2f0" />
      <Setter Property="BorderBrush" Value="#868b90" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Foreground" Value="#303337" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.dlgbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#f4e4e6" />
      <Setter Property="BorderBrush" Value="#a41626" />
    </Style>
    <Style Selector="Button.dlgbtn.primary">
      <Setter Property="Background" Value="#a41626" />
      <Setter Property="BorderBrush" Value="#7e0f1c" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.dlgbtn.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#7e0f1c" />
      <Setter Property="BorderBrush" Value="#7e0f1c" />
    </Style>
    <!-- 禁用的主按钮仍是一颗压暗的按钮，不是一块空白：
         「现在还不能按」跟「这里没有按钮」得看得出区别 -->
    <Style Selector="Button.dlgbtn.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#d8cdcf" />
      <Setter Property="BorderBrush" Value="#c9bcbe" />
      <Setter Property="TextBlock.Foreground" Value="#f1f2f0" />
    </Style>
    <Style Selector="Button.dlgbtn:disabled">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- 表格行里的小按钮（.um-sm：22 高、11px） -->
    <Style Selector="Button.umsm">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="#f1f2f0" />
      <Setter Property="BorderBrush" Value="#868b90" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Foreground" Value="#303337" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.umsm:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#f4e4e6" />
      <Setter Property="BorderBrush" Value="#a41626" />
    </Style>
    <Style Selector="Button.umsm:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#f7f7f6" />
      <Setter Property="BorderBrush" Value="#cdcfcd" />
      <Setter Property="TextBlock.Foreground" Value="#a1a5a9" />
    </Style>
    <Style Selector="Button.umsm:disabled">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- 页脚那句灰字（「修改会写入审计追踪」这类） -->
    <Style Selector="TextBlock.au">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="#959a9f" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox.sel">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <!-- 定高的控件必须自己说要居中：默认是 Stretch，配上写死的 Height，
           Avalonia 就把它顶在槽位的**上沿**。配方工具条那条 48 高的带子里，
           一排 34 的圆钮撑出 34 的槽，26 的下拉框于是贴着槽顶——
           实测框在 y=109..134，槽中线 125.5，整整高了 3.5px -->
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="BorderBrush" Value="#a4a8ac" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="TextBox.finput">
      <!-- 23px 是原型 .finput 的高度；表单行距 = 23 + 8 的行间距 = 31，也跟原型一致 -->
      <Setter Property="Height" Value="23" />
      <Setter Property="MinHeight" Value="23" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="BorderBrush" Value="#a4a8ac" />
      <Setter Property="CornerRadius" Value="2" />
      <!-- 输入框一律白底：面板底色是灰的，不写死白的话输入框跟着灰，
           「哪儿能填」就看不出来了。原型 .finput 也是 background:#fff -->
      <Setter Property="Background" Value="White" />
    </Style>
    <!--
      只读 / 不可改的那几个框（如「设备数」）也留白底，只把字调灰。
      Avalonia 默认的禁用态会把整个框刷成一块实心灰（实测 rgb(195,195,195)），
      在灰面板上就是一条突兀的深色板子；原型那一格是白底灰字（readonly），
      看着仍是一个框，只是不让改
    -->
    <Style Selector="TextBox.finput:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#c5c8c7" />
    </Style>
    <Style Selector="TextBox.finput:disabled">
      <Setter Property="Foreground" Value="#888d92" />
    </Style>

    <!--
      检索框。全程序三处（化合物库 / 配方库 / 数据导出）从前各写各的：
      三个高度、三个左内边距、两个圆角、两种描边——同一个部件三种拼法，
      其中化合物库那个还漏了 VerticalContentAlignment，字贴着框顶。

      **必须同时写 Height 和 MinHeight**：默认主题给 TextBox 的 MinHeight
      比这里的 Height 矮，只写 Height 的话内容按 MinHeight 摆、框按 Height 撑，
      多出来的高度全落在下边，字看着往上跑（化合物库那个就是这么歪的）。
      左内边距 27 是给框里那枚放大镜让的位置。
    -->
    <Style Selector="TextBox.srch">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="27,0,8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#c1c4c4" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="White" />
    </Style>

    <!-- 面板小节头：原型统一用圆形箭头，不用细横线 -->
    <Style Selector="TextBlock.acc">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#3a3d41" />
      <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style Selector="TextBlock.h2big">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Light" />
      <Setter Property="Foreground" Value="#303337" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <!-- 面板标题底下那句副标题：一两行、居中，压着标题的轴线 -->
    <Style Selector="TextBlock.intro">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#565a5f" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <!-- 摆在控件下方的**说明正文**加上 left：三四行的段落居中之后，
         每行起点都不一样，眼睛每读一行要重新找一次行首；
         折行剩下的那两个字还会孤零零停在第二行正中 -->
    <Style Selector="TextBlock.intro.left">
      <Setter Property="TextAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#414448" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#757a7f" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
  </Application.Styles>

</Application>
