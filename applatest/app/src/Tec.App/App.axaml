<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tec.App.App"
             RequestedThemeVariant="Light">

  <!-- 配色与尺寸全部照抄原型 tecstudio.html 的 CSS，不另起一套。
       选中态四件套（实线边 / 底色 / 柔环 / 深蓝加粗文字）来自原型 :root，
       对比度 10.6:1，是刻意选的，别改浅。 -->
  <Application.Resources>
    <!-- 主题色：取自标题栏的深紫 #3c2d63，调淡到能当大面积底色。
         面板成块着色、块与块之间用白缝分隔（GBG 的做法），
         所以「底」是主题色、「缝」是白色。改配色只改这两支笔。 -->
    <SolidColorBrush x:Key="ThemeFill" Color="#ece9f5" />
    <SolidColorBrush x:Key="ThemeGap" Color="#ffffff" />
    <SolidColorBrush x:Key="ThemeLine" Color="#d6d0e6" />

    <SolidColorBrush x:Key="SelBd" Color="#1a7fc4" />
    <SolidColorBrush x:Key="SelBg" Color="#e8f2fb" />
    <SolidColorBrush x:Key="SelRing" Color="#381a7fc4" />
    <SolidColorBrush x:Key="SelTx" Color="#0b3760" />
    <SolidColorBrush x:Key="HovBg" Color="#f2f8fd" />

    <SolidColorBrush x:Key="Ink" Color="#333333" />
    <SolidColorBrush x:Key="Ink2" Color="#3b3b3b" />
    <SolidColorBrush x:Key="Muted" Color="#7a7a7a" />
    <SolidColorBrush x:Key="Muted2" Color="#9a9a9a" />
    <SolidColorBrush x:Key="Line" Color="#dcdcdc" />
    <SolidColorBrush x:Key="Line2" Color="#e3e3e3" />
    <SolidColorBrush x:Key="LibBg" Color="#f4f4f4" />
    <!-- 属性栏底色。原型写的是 #ececec，这里**有意调浅一档**到 #f4f4f4：
         整栏铺满时 #ececec 压得偏重，浅一档跟左边设备库同色，两侧一样轻、
         中间白台面自己立出来。两个键同色但角色不同，日后要分开调有地方改 -->
    <SolidColorBrush x:Key="PropsBg" Color="#f4f4f4" />
    <SolidColorBrush x:Key="PropsLine" Color="#d2d2d2" />
    <SolidColorBrush x:Key="Divider" Color="#d5d5d5" />
    <SolidColorBrush x:Key="MenuBlue" Color="#1a91d6" />
    <SolidColorBrush x:Key="Green" Color="#2f8f49" />
    <SolidColorBrush x:Key="Red" Color="#e02020" />

    <!-- 通道色，与原型 chColor 一致 -->
    <SolidColorBrush x:Key="Ch1" Color="#2f7ed8" />
    <SolidColorBrush x:Key="Ch2" Color="#2aa87a" />
    <SolidColorBrush x:Key="Ch3" Color="#c9772b" />
    <SolidColorBrush x:Key="Ch4" Color="#8a63d2" />

    <FontFamily x:Key="UiFont">Segoe UI, Microsoft YaHei UI, Microsoft YaHei, system-ui, Arial</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- 主菜单项：25px 细体，悬停 #0a84c8，选中 #1a91d6 -->
    <Style Selector="Button.menu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="11,0" />
      <!--
        原型那排菜单是 25px 拉丁，大写字母实高 18px；同样 25px 的中文实高 24px——
        汉字占满字身框，拉丁大写只占约 0.72，照抄字号中文就比原型大了三分之一，
        看着又粗又挤。22px 的中文实高 21px，比拉丁略高一点点：
        汉字笔画密，压到 18px 就该糊了，这一档是「看着一样大」又不牺牲可读的位置
      -->
      <Setter Property="FontSize" Value="22" />
      <!-- 300。中文要落到细体得靠字体自己有 Light 这一档（Windows 上的
           微软雅黑 UI 有）；没有 Light 的机器会退回 Regular，那是字体的事，不是这里 -->
      <Setter Property="FontWeight" Value="Light" />
      <Setter Property="Foreground" Value="#3b3b3b" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.menu:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="#0a84c8" />
    </Style>
    <Style Selector="Button.menu.on">
      <Setter Property="Foreground" Value="#1a91d6" />
    </Style>

    <!-- 圆形工具按钮：34px，2px 深灰描边 -->
    <Style Selector="Button.tbtn">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#4a4a4a" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tbtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#e8f4fb" />
      <Setter Property="BorderBrush" Value="#1a91d6" />
    </Style>
    <Style Selector="Button.tbtn.sm">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="BorderThickness" Value="1.6" />
    </Style>
    <Style Selector="Button.tbtn.foot">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="#ececec" />
    </Style>
    <!-- 按不了的时候还是一个圈，只是淡下去。Fluent 的缺省禁用样式会把描边整个抹掉，
         剩一块灰饼——看着像坏了，不像"现在不能按" -->
    <Style Selector="Button.tbtn:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#f5f5f5" />
      <Setter Property="BorderBrush" Value="#cfcfcf" />
    </Style>
    <Style Selector="Button.tbtn:disabled">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- 普通按钮 28px；主按钮绿色 -->
    <Style Selector="Button.btn">
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="BorderBrush" Value="#b9b9b9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#333333" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.btn.primary">
      <Setter Property="Background" Value="#2f8f49" />
      <Setter Property="BorderBrush" Value="#2a7f41" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="ComboBox.sel">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="BorderBrush" Value="#a8a8a8" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="TextBox.finput">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="BorderBrush" Value="#a8a8a8" />
      <Setter Property="CornerRadius" Value="2" />
      <!-- 输入框一律白底：面板底色是灰的（#ececec），不写死白的话输入框跟着灰，
           「哪儿能填」就看不出来了。原型 .finput 也是 background:#fff -->
      <Setter Property="Background" Value="White" />
    </Style>

    <!-- 面板小节头：原型统一用圆形箭头，不用细横线 -->
    <Style Selector="TextBlock.acc">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#3d3d3d" />
      <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style Selector="TextBlock.h2big">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Light" />
      <Setter Property="Foreground" Value="#333333" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <!-- 面板标题底下那句副标题：一两行、居中，压着标题的轴线 -->
    <Style Selector="TextBlock.intro">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#5a5a5a" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <!-- 摆在控件下方的**说明正文**加上 left：三四行的段落居中之后，
         每行起点都不一样，眼睛每读一行要重新找一次行首；
         折行剩下的那两个字还会孤零零停在第二行正中 -->
    <Style Selector="TextBlock.intro.left">
      <Setter Property="TextAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#444444" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#7a7a7a" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
  </Application.Styles>

</Application>
