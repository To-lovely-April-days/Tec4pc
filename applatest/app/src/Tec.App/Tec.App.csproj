<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Tec.App</RootNamespace>
    <AssemblyName>Tec.App</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 现场可替换的资源：整个文件夹原样拷到输出目录（exe 旁边的 Resources\），
         换图不用重新出包。见 Resources\说明.txt -->
    <Content Include="Resources\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <!-- 串口枚举（设备属性里的「串口」下拉去问系统要真实的口）。
         驱动那边本来就用它收发，这里只用 GetPortNames -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tec.Core\Tec.Core.csproj" />
    <ProjectReference Include="..\Tec.DriverHost\Tec.DriverHost.csproj" />
    <ProjectReference Include="..\Tec.Hmi.Ui\Tec.Hmi.Ui.csproj" />
    <ProjectReference Include="..\Tec.Drivers.Rd105\Tec.Drivers.Rd105.csproj" />
    <ProjectReference Include="..\Tec.Drivers.DualStation\Tec.Drivers.DualStation.csproj" />
    <ProjectReference Include="..\Tec.Drivers.Aqmd\Tec.Drivers.Aqmd.csproj" />
    <ProjectReference Include="..\Tec.Drivers.Htlab\Tec.Drivers.Htlab.csproj" />
    <!-- 【本地改动】演示模式（启动参数 demo）的演示工程 -->
    <ProjectReference Include="..\Tec.Demo\Tec.Demo.csproj" />
  </ItemGroup>

  <!-- 【本地改动】仿真驱动包：**不引用**（ReferenceOutputAssembly=false），只让它跟着编译，
       Build 后把 dll 拷到输出目录 demo\drivers\sim\（manifest.json 由 Tec.Demo 带过来）。
       程序缺省不扫这个目录，只有带 demo 参数启动时才当驱动包装进来（见 Tec.Demo/DemoDrivers）。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\tests\Tec.Drivers.Simulator\Tec.Drivers.Simulator.csproj"
                      ReferenceOutputAssembly="false" Private="false" OutputItemType="DemoSimAssembly" />
  </ItemGroup>
  <Target Name="CopyDemoSimulator" AfterTargets="Build">
    <Copy SourceFiles="@(DemoSimAssembly)" DestinationFolder="$(OutDir)demo\drivers\sim" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishDemoSimulator" AfterTargets="Publish">
    <Copy SourceFiles="@(DemoSimAssembly)" DestinationFolder="$(PublishDir)demo\drivers\sim" SkipUnchangedFiles="true" />
  </Target>

</Project>
