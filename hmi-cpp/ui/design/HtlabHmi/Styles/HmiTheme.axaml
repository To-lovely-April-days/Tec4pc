<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="CanvasBgBrush" Color="#EEF1F5" />
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#0A2A55" />
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#00559C" />
    <SolidColorBrush x:Key="DeepBlueBrush" Color="#002B7F" />
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FD9005" />
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#18102A4C" />
    <SolidColorBrush x:Key="LightBlueTintBrush" Color="#EAF2FB" />
    <SolidColorBrush x:Key="SoftTintBrush" Color="#F3F6FA" />
    <SolidColorBrush x:Key="SubHeaderBgBrush" Color="#F1F4F8" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E8ECF1" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#CFD8E3" />
    <SolidColorBrush x:Key="TrackBgBrush" Color="#DCE2E9" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2A35" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4F5B67" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8792A0" />
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="#00B368" />
    <SolidColorBrush x:Key="BrightGreenBrush" Color="#5BE3A2" />
    <SolidColorBrush x:Key="DangerRedBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="BadgeRedBrush" Color="#FF5A4E" />
  </Styles.Resources>

  <!-- Base Typography -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, PingFang SC, Inter, Segoe UI, sans-serif" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{StaticResource CanvasBgBrush}" />
  </Style>

  <Style Selector="DockPanel">
    <Setter Property="LastChildFill" Value="False" />
  </Style>

  <Style Selector="Button">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Card Container -->
  <Style Selector="Border.hmi-card">
    <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #0D102A4C" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- Primary Solid Blue Button -->
  <Style Selector="Button.hmi-primary">
    <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.hmi-primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#0066BA" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Danger Solid Red Button -->
  <Style Selector="Button.hmi-danger">
    <Setter Property="Background" Value="{StaticResource DangerRedBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.hmi-danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#F0575C" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Secondary Outline Button -->
  <Style Selector="Button.hmi-outline">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.hmi-outline:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#F4F7FB" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
  </Style>

  <!-- Danger Outline Button -->
  <Style Selector="Button.hmi-outline-danger">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource DangerRedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerRedBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.hmi-outline-danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#FFF1F1" />
  </Style>

  <!-- Top Header Channel Pill Button -->
  <Style Selector="Button.header-ch">
    <Setter Property="Width" Value="236" />
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="#24FFFFFF" />
    <Setter Property="BorderBrush" Value="#47FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.header-ch:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#36FFFFFF" />
  </Style>
  <Style Selector="Button.header-ch.active">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
  </Style>
  <Style Selector="Button.header-ch.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#FFFFFF" />
  </Style>

  <!-- Top Header Circle Nav Button -->
  <Style Selector="Button.header-nav">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="52" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.header-nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Secondary Tab Bar Button -->
  <Style Selector="Button.sec-tab">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.sec-tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#F3F7FC" />
  </Style>
  <Style Selector="Button.sec-tab.active">
    <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentOrangeBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,3" />
  </Style>
  <Style Selector="Button.sec-tab.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentOrangeBrush}" />
  </Style>

  <!-- Segmented Choice Pill -->
  <Style Selector="Button.seg-btn">
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="#F3F6FA" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.seg-btn.active">
    <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
  </Style>
  <Style Selector="Button.seg-btn.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Numeric Value Clickable Box -->
  <Style Selector="Button.num-box">
    <Setter Property="Background" Value="#F5F8FC" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.num-box:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#EAF2FB" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
  </Style>

  <!-- Keypad Button -->
  <Style Selector="Button.kp-key">
    <Setter Property="Height" Value="54" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.kp-key:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#EAF2FB" />
  </Style>
</Styles>
