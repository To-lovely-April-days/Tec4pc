<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:HtlabHmi.Converters"
             x:Class="HtlabHmi.Views.Settings.CommView">
  <UserControl.Resources>
    <conv:BoolToBrushConverter x:Key="SwitchBg" TrueBrush="#00559C" FalseBrush="#C3CCD6" />
  </UserControl.Resources>

  <!-- 1:1 Comm.dc.html: Left 778px Hardware Comm | Right 477px (330px TCP + 8px + 262px Connected PCs) -->
  <Grid ColumnDefinitions="778,9,*">
    <!-- Left Card: Hardware Serial / Modbus Devices (778x600) -->
    <Border Grid.Column="0" Classes="hmi-card" Padding="16,10,16,12">
      <Grid RowDefinitions="46,*,44">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="4,0" VerticalAlignment="Center">
          <TextBlock Text="硬件通信" FontSize="18" FontWeight="SemiBold" Foreground="#1F2A35" />
          <TextBlock Text="本机直接连各设备 · 串口 Modbus" FontSize="14" Foreground="#8792A0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Bordered Device Table (#D5DEE8) -->
        <Border Grid.Row="1" CornerRadius="10" BorderBrush="#D5DEE8" BorderThickness="1" ClipToBounds="True" Margin="0,4,0,6">
          <Grid RowDefinitions="36,*">
            <Border Grid.Row="0" Background="#F1F4F8" Padding="16,0,8,0">
              <Grid ColumnDefinitions="236,96,96,70,190,*">
                <TextBlock Text="设备" FontSize="13" Foreground="#4F5B67" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="串口" FontSize="13" Foreground="#4F5B67" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="波特率" FontSize="13" Foreground="#4F5B67" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="站号" FontSize="13" Foreground="#4F5B67" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="状态" FontSize="13" Foreground="#4F5B67" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding CommDevices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding $parent[UserControl].DataContext.OpenCommDeviceDialogCommand}" CommandParameter="{Binding}"
                            Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand">
                      <Border Height="46" Padding="16,0,8,0" BorderBrush="#E8ECF1" BorderThickness="0,0,0,1" Background="#FFFFFF">
                        <Grid ColumnDefinitions="236,96,96,70,190,*">
                          <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" Foreground="#1F2A35" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Port}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2A35" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding BaudRate}" FontSize="15" Foreground="#1F2A35" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding StationId}" FontSize="15" Foreground="#1F2A35" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{Binding Status, Converter={x:Static conv:CommStatusToBrushConverter.DotInstance}}" />
                            <TextBlock Text="{Binding Status}" FontSize="15" Foreground="{Binding Status, Converter={x:Static conv:CommStatusToBrushConverter.TextInstance}}" />
                          </StackPanel>
                          <PathIcon Grid.Column="5" Data="{StaticResource IconChevronRight}" Width="20" Height="20" Foreground="#8792A0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Footer Info -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource IconInfo}" Width="20" Height="20" Foreground="#8792A0" />
          <TextBlock Text="点一行改它的串口、波特率、校验、站号；改了要重启控制核心才生效" FontSize="14" Foreground="#8792A0" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Right Column: External TCP (330px) + Connected PCs (262px) -->
    <Grid Grid.Column="2" RowDefinitions="330,8,*">
      <!-- External TCP Card (330px) -->
      <Border Grid.Row="0" Classes="hmi-card" Padding="20,10,16,12">
        <Grid RowDefinitions="46,52,52,52,52,*">
          <!-- Header with right iOS switch -->
          <DockPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="对外通信" FontSize="18" FontWeight="SemiBold" Foreground="#1F2A35" />
              <TextBlock Text="TCP · 给 PC 工作站连" FontSize="14" Foreground="#8792A0" VerticalAlignment="Center" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Command="{Binding ToggleTcpEnabledCommand}"
                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" VerticalAlignment="Center">
              <Border Width="54" Height="32" CornerRadius="16" Background="{Binding TcpEnabled, Converter={StaticResource SwitchBg}}">
                <Border Width="26" Height="26" CornerRadius="13" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="{Binding TcpEnabled, Converter={x:Static conv:BoolToKnobMarginConverter.Instance}}"
                        BoxShadow="0 1 3 0 #47000000" />
              </Border>
            </Button>
          </DockPanel>

          <!-- Row 1: Local IP -->
          <Border Grid.Row="1" BorderBrush="#E8ECF1" BorderThickness="0,0,0,1" Margin="0,0,4,0">
            <DockPanel>
              <TextBlock Text="本机地址" Width="120" FontSize="15" Foreground="#4F5B67" VerticalAlignment="Center" />
              <TextBlock Text="192.168.1.50" FontSize="18" FontWeight="SemiBold" Foreground="#1F2A35" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Text="只读" FontSize="13" Foreground="#8792A0" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <!-- Row 2: Port -->
          <Border Grid.Row="2" BorderBrush="#E8ECF1" BorderThickness="0,0,0,1" Margin="0,0,4,0">
            <DockPanel>
              <TextBlock Text="监听端口" Width="120" FontSize="15" Foreground="#4F5B67" VerticalAlignment="Center" />
              <Button Command="{Binding EditTcpPortCommand}" Width="110" Height="40" Padding="10,0" CornerRadius="8"
                      Background="#F3F7FC" BorderBrush="#C9D6E5" BorderThickness="1.5" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalAlignment="Center" Cursor="Hand">
                <TextBlock Text="{Binding TcpPort}" FontSize="18" FontWeight="SemiBold" Foreground="#1F2A35" VerticalAlignment="Center" />
              </Button>
            </DockPanel>
          </Border>

          <!-- Row 3: Timeout -->
          <Border Grid.Row="3" BorderBrush="#E8ECF1" BorderThickness="0,0,0,1" Margin="0,0,4,0">
            <DockPanel>
              <TextBlock Text="断线超时" Width="120" FontSize="15" Foreground="#4F5B67" VerticalAlignment="Center" />
              <Button Command="{Binding EditTcpTimeoutCommand}" Width="110" Height="40" Padding="10,0" CornerRadius="8"
                      Background="#F3F7FC" BorderBrush="#C9D6E5" BorderThickness="1.5" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" Cursor="Hand">
                <DockPanel>
                  <TextBlock Text="{Binding TcpTimeoutSec}" FontSize="18" FontWeight="SemiBold" Foreground="#1F2A35" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Right" Text="s" FontSize="13" Foreground="#8792A0" VerticalAlignment="Center" />
                </DockPanel>
              </Button>
              <TextBlock DockPanel.Dock="Right" Text="超过就算 PC 掉线" FontSize="13" Foreground="#8792A0" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <!-- Row 4: Allow Remote Control -->
          <Border Grid.Row="4" BorderBrush="#E8ECF1" BorderThickness="0,0,0,1" Margin="0,0,4,0">
            <DockPanel>
              <TextBlock Text="允许远程控制" Width="120" FontSize="15" Foreground="#4F5B67" VerticalAlignment="Center" />
              <Button Command="{Binding ToggleRemoteControlCommand}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand">
                <Border Width="54" Height="32" CornerRadius="16" Background="{Binding AllowRemoteControl, Converter={StaticResource SwitchBg}}">
                  <Border Width="26" Height="26" CornerRadius="13" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top"
                          Margin="{Binding AllowRemoteControl, Converter={x:Static conv:BoolToKnobMarginConverter.Instance}}"
                          BoxShadow="0 1 3 0 #47000000" />
                </Border>
              </Button>
              <TextBlock DockPanel.Dock="Right" Text="关掉后 PC 只能看" FontSize="13" Foreground="#8792A0" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <!-- Bottom Tip -->
          <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
            <PathIcon Data="{StaticResource IconInfo}" Width="18" Height="18" Foreground="#8792A0" />
            <TextBlock Text="PC 断开不影响本机控温和序列" FontSize="13" Foreground="#8792A0" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Connected PCs Card (262px) -->
      <Border Grid.Row="2" Classes="hmi-card" Padding="20,10,20,12">
        <Grid RowDefinitions="46,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="已连上的 PC" FontSize="18" FontWeight="SemiBold" Foreground="#1F2A35" />
            <TextBlock Text="{Binding ConnectedPcs.Count, StringFormat={}{0} 台}" FontSize="14" Foreground="#8792A0" VerticalAlignment="Center" />
          </StackPanel>

          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding ConnectedPcs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Height="48" BorderBrush="#E8ECF1" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="18,138,*,Auto">
                      <Ellipse Width="9" Height="9" Fill="#00B368" HorizontalAlignment="Left" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding IpAddress}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2A35" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding StatsText}" FontSize="14" Foreground="#4F5B67" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding ConnectedDuration}" FontSize="14" Foreground="#8792A0" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
