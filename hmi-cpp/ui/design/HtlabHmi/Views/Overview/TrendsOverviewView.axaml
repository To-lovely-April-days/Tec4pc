<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:HtlabHmi.Controls"
             x:Class="HtlabHmi.Views.Overview.TrendsOverviewView">
  <!-- 1:1 Trends.dc.html: 1264x600 white card with exact coral/teal legend colors -->
  <Border Classes="hmi-card">
    <Grid RowDefinitions="60,*">
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="24" Margin="24,16,24,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="18" Height="4" CornerRadius="2" Background="#E5645A" VerticalAlignment="Center" />
          <TextBlock Text="Tr 通道 1" FontSize="14" Foreground="#4F5B67" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="18" Height="4" CornerRadius="2" Background="#19B5A5" VerticalAlignment="Center" />
          <TextBlock Text="Tj 通道 1" FontSize="14" Foreground="#4F5B67" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="18" Height="4" CornerRadius="2" Background="#F0A9A4" VerticalAlignment="Center" />
          <TextBlock Text="Tr 通道 2" FontSize="14" Foreground="#4F5B67" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="18" Height="4" CornerRadius="2" Background="#9ADAD2" VerticalAlignment="Center" />
          <TextBlock Text="Tj 通道 2" FontSize="14" Foreground="#4F5B67" />
        </StackPanel>
      </StackPanel>
      <ctrl:TrendChartControl Grid.Row="1" Margin="12,8,12,12"
                              DualChannelMode="True"
                              PrimarySamples="{Binding Channel1.TrendHistory}"
                              SecondarySamples="{Binding Channel2.TrendHistory}"
                              Revision="{Binding Channel1.ChartRevision}" />
    </Grid>
  </Border>
</UserControl>
