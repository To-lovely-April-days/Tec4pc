<Window x:Class="TecControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="TEC 恒温上位机"
        Width="1400" Height="880" WindowStartupLocation="CenterScreen"
        Background="#F5F6F8" Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 卡片式分组 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#24292F"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6A737D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#57606A"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1E8E3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D1242F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 顶栏：连接 -->
            <RowDefinition Height="*"/>      <!-- 主体：曲线 + 右侧面板 -->
            <RowDefinition Height="Auto"/>   <!-- 告警 -->
            <RowDefinition Height="Auto"/>   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ══════════ 顶栏：只放连接与全局操作 ══════════ -->
        <Border Background="#24292F" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="串口" Foreground="#C9D1D9" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" MinWidth="100"/>
                    <Button Content="刷新" Command="{Binding RefreshPortsCommand}"/>
                    <Button Content="连接" Command="{Binding ConnectCommand}" Margin="6,2,2,2"/>
                    <Button Content="断开" Command="{Binding DisconnectCommand}"/>

                    <Border Width="1" Background="#444C56" Margin="12,2"/>

                    <Button Command="{Binding ToggleLoggingCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="● 开始记录"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogging}" Value="True">
                                        <Setter Property="Content" Value="■ 停止记录"/>
                                        <Setter Property="Foreground" Value="#D1242F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding LogPathText}" Foreground="#6A737D"
                           VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding DeviceInfo}" Foreground="#7EE787" VerticalAlignment="Center"/>
                    <TextBlock Foreground="#C9D1D9" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Run Text="机内 "/><Run Text="{Binding InternalTempText}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ 主体 ══════════ -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左：曲线 ── -->
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2.2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <sp:WpfPlot x:Name="TempPlot"/>
                    <sp:WpfPlot x:Name="OutPlot" Grid.Row="1"/>
                </Grid>
            </Border>

            <!-- ── 右：运行卡片（常驻） + 选项卡（分层收纳） ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ▼ 运行卡片：日常只看这里 -->
                <Border Style="{StaticResource Card}" DataContext="{Binding Ch1}">
                    <StackPanel>
                        <!-- 状态徽标 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{Binding RunStateColor}"/>
                            <TextBlock Text="{Binding RunStateText}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{Binding RunStateColor}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 两路温度大字 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TC1 内部" Style="{StaticResource Hint}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DataContext.Tc1Text, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="26" FontWeight="Bold" Foreground="#0B72B5"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TC2 腔体" Style="{StaticResource Hint}"/>
                                <TextBlock Text="{Binding DataContext.Tc2Text, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="26" FontWeight="Bold" Foreground="#D97706"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,8"/>

                        <!-- 目标温度 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="目标温度" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding TargetInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15" FontWeight="SemiBold"/>
                            <Button Grid.Column="2" Content="更新" Command="{Binding WriteTargetCommand}"
                                    ToolTip="控温运行中修改目标温度"/>
                        </Grid>

                        <!-- 偏差 + 稳定度 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="偏差" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DeviationText}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="真实温度(10s均值)" Style="{StaticResource FieldLabel}"
                                       ToolTip="10 秒滑动平均：核心热惯性使真实温度 10s 内最多移动 ~2mK，秒级抖动是测温电路噪声（双探头互相关为零证实）——平均只消噪声，不掩盖任何真实变化"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PvAvgText}"
                                       FontWeight="SemiBold" Foreground="#0B72B5"/>
                            <TextBlock Grid.Row="2" Text="稳定度" Style="{StaticResource FieldLabel}"
                                       ToolTip="原始读数口径：最近 5 分钟滚动窗口统计 [最小 ~ 最大]"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StabilityText}"
                                       Foreground="#1E8E3E" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Text="稳定度(10s均值)" Style="{StaticResource FieldLabel}"
                                       ToolTip="真实温度口径：对 10s 均值做同窗统计——写规格/对外报数用这一行，注明'10s 平均'"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StabilityAvgText}"
                                       Foreground="#0B72B5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="4" Text="稳定区间" Style="{StaticResource FieldLabel}"
                                       ToolTip="自进入'已稳定'（偏差 ≤0.05℃ 持续 1 分钟）以来的实测极值。出带须持续 10 秒才摘牌，瞬时尖峰不打断"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StableRangeText}"
                                       Foreground="#0B72B5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Grid>

                        <!-- 输出条 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输出" Style="{StaticResource FieldLabel}"/>
                            <ProgressBar Grid.Column="1" Height="16" Minimum="0" Maximum="100"
                                         Value="{Binding DutyBarValue, Mode=OneWay}" Foreground="#0B72B5"/>
                            <TextBlock Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center">
                                <Run Text="{Binding DutyText}"/><Run Text=" % "/>
                                <Run Text="{Binding DutyDirectionText}" Foreground="#6A737D"/>
                            </TextBlock>
                        </Grid>

                        <!-- 启停 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="▶ 启动控温" Command="{Binding StartControlCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="■ 停止控温" Command="{Binding StopControlCommand}"
                                    Style="{StaticResource DangerButton}" Margin="4,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{Binding CascadeStateText}" Style="{StaticResource Hint}"
                                   Foreground="#1E8E3E" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding ProfileStateText}" Style="{StaticResource Hint}"
                                   Foreground="#0B72B5"/>
                    </StackPanel>
                </Border>

                <!-- ▼ 选项卡：按使用频率分层收纳 -->
                <TabControl Grid.Row="1" DataContext="{Binding Ch1}" Background="White" BorderBrush="#E1E4E8">

                    <!-- ── 工艺：日常会用 ── -->
                    <TabItem Header="工艺">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel>
                                <TextBlock Text="温度曲线（结晶模式）" Style="{StaticResource SectionTitle}"/>
                                <ComboBox ItemsSource="{Binding ProfileKindNames}" SelectedIndex="{Binding ProfileKindIndex}"/>
                                <TextBlock Text="每行一段：目标温度, 速率℃/min, 保温分钟" Style="{StaticResource Hint}" Margin="0,4"/>
                                <TextBox Text="{Binding ProfileSegmentsInput, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" MinHeight="66" FontFamily="Consolas"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="示例（阶梯降温）：&#x0a;20, 2, 15&#x0a;0, 0.2, 0&#x0a;-10, 0.5, 60&#x0a;速率 0.05~5℃/min，填 0 表示立即阶跃"/>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CSV" Style="{StaticResource FieldLabel}"
                                               ToolTip="自定义曲线文件，每行“分钟,温度”"/>
                                    <TextBox Grid.Column="1" Text="{Binding ProfileCsvPath, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="启动曲线" Command="{Binding StartProfileCommand}"/>
                                    <Button Content="停止曲线" Command="{Binding StopProfileCommand}"/>
                                </StackPanel>

                                <Separator Margin="0,10"/>

                                <TextBlock Text="串级控温（控内部温度）" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="启用串级：外环控内部温度 → 自动修正腔体设定值"
                                          IsChecked="{Binding CascadeEnabled}"
                                          ToolTip="单环只把腔体壁控准，内部因漏热存在稳态偏差；&#x0a;串级由外环自动补偿，并能主动抑制放热/吸热扰动"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="外环Kp" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding OuterKpInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="外环Ki" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="3" Text="{Binding OuterKiInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="1" Text="外环Kd" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OuterKdInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="偏置±℃" Style="{StaticResource FieldLabel}"
                                               ToolTip="外环可把腔体设定值偏离主设定值的最大幅度（安全限幅）"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding OuterMaxBiasInput, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Button Content="应用串级设置" Command="{Binding ApplyCascadeCommand}" Margin="0,6,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="以上是兜底值：若“整定”页的增益表已登记外环参数，运行时按目标温度自动插值，不用这里的数字。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ── 整定：调试期用 ── -->
                    <TabItem Header="整定">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel>
                                <TextBlock Text="PID 自整定（继电器法）" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="继电幅值%" Style="{StaticResource FieldLabel}"
                                               ToolTip="自整定期间输出在 ±此幅值间切换（5~100，越大振荡越明显、结果越可靠）"/>
                                    <TextBox Grid.Column="1" Text="{Binding RelayAmpInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="回差℃" Style="{StaticResource FieldLabel}"
                                               ToolTip="建议取温度噪声的 3~5 倍（默认 0.05℃）"/>
                                    <TextBox Grid.Column="3" Text="{Binding HysteresisInput, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="开始自整定" Command="{Binding StartAutoTuneCommand}"/>
                                    <Button Content="取消" Command="{Binding StopControlCommand}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TuneStatusText}" Style="{StaticResource Hint}"
                                           Foreground="#C77800" Margin="0,4,0,0"/>

                                <Separator Margin="0,10"/>

                                <TextBlock Text="PID 参数" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kp" Style="{StaticResource FieldLabel}" ToolTip="单位 %/℃"/>
                                    <TextBox Grid.Column="1" Text="{Binding KpInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="Ki" Style="{StaticResource FieldLabel}" ToolTip="单位 %/(℃·s)"/>
                                    <TextBox Grid.Column="3" Text="{Binding KiInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="4" Text="Kd" Style="{StaticResource FieldLabel}" ToolTip="单位 %·s/℃"/>
                                    <TextBox Grid.Column="5" Text="{Binding KdInput, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="输出上限%" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding MaxDutyInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="2" Content="应用参数" Command="{Binding ApplyPidCommand}"/>
                                </Grid>
                                <TextBlock Text="{Binding PidTermsText}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

                                <Separator Margin="0,10"/>

                                <TextBlock Text="启动加速（积分预置）" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Content="启用" IsChecked="{Binding UseIntegralPreset}" VerticalAlignment="Center"
                                              ToolTip="启动时把积分项预置到稳态输出附近，省去积分从零累积的等待（实测可将到温时间缩短约一半）"/>
                                    <TextBox Grid.Column="1" Text="{Binding IntegralPresetInput, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="留空 = 用自动学习的前馈预测值；填数字 = 手动指定（与界面占空比同符号）"/>
                                </Grid>
                                <TextBlock Text="{Binding SteadyOutputHint}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

                                <Separator Margin="0,10"/>

                                <TextBlock Text="增益调度（宽温域多温区参数表）" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="启用：按设定值在各温区参数间插值"
                                          IsChecked="{Binding GainSchedulingEnabled}"
                                          ToolTip="过程增益随温度变化（200℃ 靠加热膜、−40℃ 靠 TEC，特性差异很大），&#x0a;单组参数难以全温域最优。在代表温度各自整定一次即自动建表，也可在下表手工编辑。&#x0a;表中同时调度串级外环参数：低温段系统整体变慢，外环也必须跟着变慢"/>
                                <TextBlock Text="{Binding GainScheduleHint}" Style="{StaticResource Hint}"
                                           Foreground="#4B4FBF" Margin="0,4,0,0"/>

                                <DataGrid ItemsSource="{Binding GainPoints}"
                                          SelectedItem="{Binding SelectedGainPoint}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="All"
                                          MinHeight="90" MaxHeight="200" Margin="0,6,0,0"
                                          RowHeaderWidth="0" FontSize="11"
                                          HorizontalGridLinesBrush="#E1E4E8" VerticalGridLinesBrush="#E1E4E8"
                                          BorderBrush="#D5DCE4" Background="White"
                                          ToolTip="双击单元格即可编辑；改完点“应用表格”写回。温度列请按实际整定温度填写。&#x0a;加热比列留空 = 沿用下方全局值；≥100℃ 的行属于电加热段，与低温段互不插值">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="温度℃" Binding="{Binding TemperatureC, StringFormat=F1}" Width="60"/>
                                        <DataGridTextColumn Header="Kp" Binding="{Binding Kp, StringFormat=F3}" Width="70"/>
                                        <DataGridTextColumn Header="Ki" Binding="{Binding Ki, StringFormat=F5}" Width="78"/>
                                        <DataGridTextColumn Header="Kd" Binding="{Binding Kd, StringFormat=F2}" Width="72"/>
                                        <DataGridTextColumn Header="Tu(s)" Binding="{Binding Tu, StringFormat=F1}" Width="56" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="外环Kp" Binding="{Binding OuterKp, StringFormat=F2}" Width="60"/>
                                        <DataGridTextColumn Header="外环Ki" Binding="{Binding OuterKi, StringFormat=F5}" Width="70"/>
                                        <DataGridTextColumn Header="外环Kd" Binding="{Binding OuterKd, StringFormat=F1}" Width="56"/>
                                        <DataGridTextColumn Header="偏置±℃" Binding="{Binding OuterMaxBiasC, StringFormat=F1}" Width="58"/>
                                        <DataGridTextColumn Header="稳态偏置℃" Binding="{Binding SteadyBiasC, StringFormat=F2}" Width="70"
                                                            IsReadOnly="True"/>
                                        <DataGridTextColumn Header="加热比" Binding="{Binding HeatRatio, StringFormat=F2, TargetNullValue=''}" Width="54"/>
                                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="*" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="{Binding InterpolatedGainsText}" Style="{StaticResource Hint}"
                                           Foreground="#1E8E3E" FontWeight="SemiBold" Margin="0,4,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="新增行" Command="{Binding AddGainPointCommand}"
                                            ToolTip="以当前目标温度与当前 PID 参数为初值新增一个工作点"/>
                                    <Button Content="删除选中" Command="{Binding RemoveGainPointCommand}"/>
                                    <Button Content="应用表格" Command="{Binding ApplyGainPointsCommand}"
                                            ToolTip="把表格内容写回控制器（手工编辑后必须点此生效）"/>
                                    <Button Content="重新载入" Command="{Binding RefreshGainScheduleCommand}"/>
                                    <Button Content="清空" Command="{Binding ClearGainScheduleCommand}"/>
                                </StackPanel>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="加热/制冷有效度比" Style="{StaticResource FieldLabel}"
                                               ToolTip="加热手段相对制冷的强弱（全局兜底值）。实测加热约为 TEC 制冷的 2 倍则填 2；&#x0a;程序按比例缩小加热侧输出，使执行器左右对称。&#x0a;增益表某行填了“加热比”列时，该温区按表调度、优先于此全局值"/>
                                    <TextBox Grid.Column="1" Text="{Binding HeatRatioInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="2" Content="应用" Command="{Binding ApplyHeatRatioCommand}"/>
                                </Grid>

                                <Separator Margin="0,10"/>

                                <TextBlock Text="手动输出（开环阶跃测试）" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="占空比%" Style="{StaticResource FieldLabel}"
                                               ToolTip="-100~100，需先停止控温；勾选反向输出后此处同样自动反向。&#x0a;电加热棒模式下只接受 0~100（负值会被拒绝）"/>
                                    <TextBox Grid.Column="1" Text="{Binding ManualDutyInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="2" Content="写入" Command="{Binding ManualDutyCommand}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ── 设置：一次性配置 ── -->
                    <TabItem Header="设置">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel>
                                <TextBlock Text="控制回路" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="反馈传感器" Style="{StaticResource FieldLabel}"
                                               ToolTip="闭环/自整定用哪支探头做反馈。执行器作用在腔体壁上，快环推荐 TC2"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding FeedbackSensorNames}"
                                              SelectedIndex="{Binding FeedbackSensorIndex}"/>
                                </Grid>
                                <CheckBox Content="反向输出（正输出对应制冷时勾选）" IsChecked="{Binding InvertOutput}"
                                          Margin="0,6,0,0"
                                          ToolTip="用手动输出验证方向：写正值若温度下降，则需勾选此项。电加热棒模式下此项被忽略"/>
                                <CheckBox Content="电加热棒模式（只加热，>100℃ 手动换线后勾选）" IsChecked="{Binding HeaterMode}"
                                          Margin="0,6,0,0" Foreground="#B54708"
                                          ToolTip="手动换线过渡方案：加热棒经过零型固态继电器接本通道加热 PWM 引脚（通道1=PWM2），&#x0a;TEC 功率线人工断开、使能保持接通。勾选后：输出限 0~上限（无制冷，降温靠自然散热）、&#x0a;反向输出忽略、启动时自动设 PWM 频率 0.5Hz（时间比例调功）与上电不输出。&#x0a;切换须在停止状态下进行，且必须与实际接线一致"/>
                                <TextBlock Text="⚠ 加热棒安全：设备无通信看门狗，断线时输出保持——启动前必须把双通道过温上限改写到目标温度之上（留 10~15℃ 余量），这是唯一不依赖通信的兜底；建议加热棒回路串机械温控器"
                                           Style="{StaticResource Hint}" Foreground="#D1242F" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding HeaterMode, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="改动后请到「整定」页点“应用参数”生效" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

                                <Separator Margin="0,10"/>

                                <TextBlock Text="设备硬件保护（兜底）" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="占空比上限%" Style="{StaticResource FieldLabel}"
                                               ToolTip="设备端 LIMITED（0~90），硬件层限幅"/>
                                    <TextBox Grid.Column="1" Text="{Binding HwMaxDutyInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="限流A" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Column="3" Text="{Binding HwMaxCurrentInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="1" Text="过温上限℃" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OverTempUpInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="过温下限℃" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding OverTempLowerInput, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="读取" Command="{Binding ReadHwConfigCommand}"/>
                                    <Button Content="写入" Command="{Binding WriteHwConfigCommand}"/>
                                </StackPanel>

                                <Separator Margin="0,10"/>

                                <TextBlock Text="设备与通信" Style="{StaticResource SectionTitle}"
                                           DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>

                                        <TextBlock Text="波特率" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding BaudRate}"/>

                                        <TextBlock Grid.Row="1" Text="控制周期(ms)" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ControlPeriodOptions}"
                                                  SelectedItem="{Binding ControlPeriodMs}"/>

                                        <TextBlock Grid.Row="2" Text="PWM 频率" Style="{StaticResource FieldLabel}"
                                                   ToolTip="TEC 制冷量正比于电流 I、焦耳发热正比于 I²，&#x0a;同样平均电流下脉动越小效率越高，低温工况建议 100Hz"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding PwmFrequencyNames}"
                                                  SelectedIndex="{Binding PwmFrequencyIndex}"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="应用" Command="{Binding ApplyPwmFrequencyCommand}"/>

                                        <TextBlock Grid.Row="3" Text="通道同步" Style="{StaticResource FieldLabel}"
                                                   ToolTip="四片 TEC 的同步方式。上位机镜像：程序把同一占空比写给两个通道（设备须为 CONTMODE=0）"/>
                                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding SyncModeNames}"
                                                  SelectedIndex="{Binding SyncModeIndex}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ── 监视 ── -->
                    <TabItem Header="监视">
                        <StackPanel Margin="12"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="TC1 内部" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Tc1Text}"/>
                                <TextBlock Grid.Row="1" Text="TC2 腔体" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tc2Text}"/>
                                <TextBlock Grid.Row="2" Text="通道1 电流" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Current1Text}"/>
                                <TextBlock Grid.Row="3" Text="通道2 电流" Style="{StaticResource FieldLabel}"
                                           ToolTip="两路应相近；若恒为 0 说明同步未生效"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Current2Text}"/>
                                <TextBlock Grid.Row="4" Text="通道2 电压" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Out2VoltsText}"/>
                                <TextBlock Grid.Row="5" Text="机内温度" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding InternalTempText}"/>
                            </Grid>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ══════════ 告警条 ══════════ -->
        <Border Grid.Row="2" Background="#FFF1F1" BorderBrush="#FFC9C9" BorderThickness="1" Padding="10,6"
                Margin="8,0,8,8" CornerRadius="6"
                Visibility="{Binding HasAlarm, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠ 告警" Foreground="#D1242F" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ItemsControl ItemsSource="{Binding Alarms}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFD6D6" CornerRadius="10" Padding="8,3" Margin="3,0">
                                <TextBlock Text="{Binding}" Foreground="#8B1A1A"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ══════════ 状态栏 ══════════ -->
        <StatusBar Grid.Row="3" Background="#EDEFF2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding CycleLoadText}" Foreground="#6A737D"
                           ToolTip="每周期实际用于串口通信+计算的时间。占用率过高说明周期设得过短"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
