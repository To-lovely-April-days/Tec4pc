<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tec.App.Views.RecipeLibView">
  <Grid ColumnDefinitions="240,*,342">

    <Border Grid.Column="0" Background="#f4f4f4" BorderBrush="#dcdcdc" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="14,12,14,8">
          <TextBlock Text="配方库" FontSize="20" FontWeight="Light" Foreground="#3b3b3b" VerticalAlignment="Center" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="12.5" />
                <TextBlock Text="{Binding Author}" FontSize="10.5" Foreground="#7a7a7a" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1" Background="White">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14" Margin="24,14,24,10">
        <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Light" Foreground="#2b2b2b" />
        <TextBlock Text="{Binding Desc}" FontSize="12" Foreground="#7a7a7a" VerticalAlignment="Bottom" Margin="0,0,0,3" />
      </StackPanel>
      <Border BorderBrush="#e3e3e3" BorderThickness="0,1,0,0">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Flow}" Margin="24,18">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="420" Margin="0,0,0,8" Padding="10" Background="White"
                        BorderBrush="#dcdcdc" BorderThickness="1" CornerRadius="3">
                  <Grid ColumnDefinitions="28,*,90">
                    <TextBlock Grid.Column="0" Text="{Binding Ordinal}" FontSize="11" Foreground="#9a9a9a" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontSize="12.5" />
                      <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#7a7a7a" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding PlanDuration}" Classes="mono"
                               HorizontalAlignment="Right" Foreground="#7a7a7a" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </DockPanel>

    <Border Grid.Column="2" Background="#ececec" BorderBrush="#d2d2d2" BorderThickness="1,0,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#d5d5d5" BorderThickness="0,1,0,0" Padding="18,12,18,14">
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button Classes="tbtn foot" Content="⧉" Command="{Binding Duplicate}" ToolTip.Tip="另存副本" />
            <Button Classes="tbtn foot" Content="🗑" Command="{Binding Delete}" ToolTip.Tip="删除" />
          </StackPanel>
        </Border>
        <StackPanel Margin="18,16" Spacing="10">
          <TextBlock Text="{Binding Name}" Classes="h2big" />
          <TextBlock Classes="intro"
                     Text="应用会替换当前通道的全部步骤。配方绑的是能力不是设备，换一台满足同样能力的反应器照样能跑。" />
          <Button Classes="btn primary" Content="应用到配方编辑" Command="{Binding ApplyToRecipe}"
                  HorizontalAlignment="Stretch" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
