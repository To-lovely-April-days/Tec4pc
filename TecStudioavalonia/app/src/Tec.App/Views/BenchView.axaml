<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             xmlns:v="clr-namespace:Tec.App.Views"
             x:Class="Tec.App.Views.BenchView">

  <!-- 三栏宽度照原型：设备库 118 · 台面自适应 · 属性面板 342 -->
  <Grid ColumnDefinitions="118,*,342">

    <!-- 设备库 -->
    <Border Grid.Column="0" Background="#f4f4f4" BorderBrush="#dcdcdc" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="设备库" FontSize="11" Foreground="#7a7a7a"
                   HorizontalAlignment="Center" Margin="0,6,0,8" />
        <ScrollViewer Padding="0,0,0,40">
          <ItemsControl ItemsSource="{Binding Library}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="100" Margin="0,0,0,10" HorizontalAlignment="Center"
                            PointerPressed="OnLibraryPressed" Background="Transparent">
                  <Border Width="100" Height="56" Background="White" BorderBrush="#cfcfcf"
                          BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                    <ctl:DeviceArtView ArtKey="{Binding ArtKey}" ArtWidth="88"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#4a4a4a"
                             TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0" />
                  <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}"
                             FontSize="9.5" Foreground="#b3261e" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 台面：28px 网格底 + 绑定连线 + 设备 + 左下工具条 -->
    <Panel Grid.Column="1" Background="White" ClipToBounds="True">
      <ctl:GridBackdrop />
      <ctl:BenchWires Nodes="{Binding Devices}" />

      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="ItemsControl > ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="6,6,6,4" BorderThickness="1.6" CornerRadius="4"
                    BorderBrush="Transparent" Background="Transparent"
                    PointerPressed="OnDevicePressed">
              <StackPanel>
                <ctl:DeviceArtView ArtKey="{Binding ArtKey}" ArtWidth="{Binding Width}" />
                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="#3b3b3b"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock Text="{Binding ChannelText}" FontSize="10" Foreground="#9a9a9a"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" Margin="12">
        <Button Classes="tbtn sm" Content="＋" ToolTip.Tip="放大" />
        <Button Classes="tbtn sm" Content="－" ToolTip.Tip="缩小" />
        <Button Classes="tbtn sm" Content="⛶" ToolTip.Tip="适应" />
        <Button Classes="tbtn sm" Content="▦" ToolTip.Tip="网格" />
      </StackPanel>

      <TextBlock Text="{Binding BenchSummary}" FontSize="11" Foreground="#9a9a9a"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" />
    </Panel>

    <!-- 属性面板 -->
    <Border Grid.Column="2" Background="#ececec" BorderBrush="#d2d2d2" BorderThickness="1,0,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#d5d5d5" BorderThickness="0,1,0,0"
                Padding="18,12,18,14">
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button Classes="tbtn foot" Content="💾" ToolTip.Tip="保存" />
            <Button Classes="tbtn foot" Content="🔗" ToolTip.Tip="连接" Command="{Binding Probe}" />
            <Button Classes="tbtn foot" Content="⟳" ToolTip.Tip="初始化" Command="{Binding Rebuild}" />
            <Button Classes="tbtn foot" Content="🗑" ToolTip.Tip="删除选中设备" />
          </StackPanel>
        </Border>

        <ScrollViewer>
          <StackPanel Margin="18,16" Spacing="6">
            <TextBlock Text="{Binding SelectedTitle}" Classes="h2big" />
            <TextBlock Text="{Binding SelectedSub}" Classes="intro" />

            <StackPanel IsVisible="{Binding HasSelection}" Spacing="6">
              <Border Height="1" Background="#d5d5d5" Margin="0,4,0,8" />
              <TextBlock Text="通信配置" Classes="acc" />
              <v:SchemaFormView DataContext="{Binding ConnectionForm}" />
              <Button Classes="btn" Content="测试连接" Command="{Binding Probe}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding ProbeResult}" FontSize="11" Foreground="#5a5a5a" TextWrapping="Wrap" />

              <Border Height="1" Background="#d5d5d5" Margin="0,8" />
              <TextBlock Text="设备配置" Classes="acc" />
              <v:SchemaFormView DataContext="{Binding ConfigForm}" />
            </StackPanel>

            <Border Height="1" Background="#d5d5d5" Margin="0,8" />
            <TextBlock Text="通道" Classes="acc" />
            <ItemsControl ItemsSource="{Binding ChannelRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,6" Padding="9" Background="White"
                          BorderBrush="#dcdcdc" BorderThickness="1" CornerRadius="3">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#2b2b2b" />
                      <TextBlock Text="{Binding Host}" FontSize="10.5" Foreground="#7a7a7a" />
                      <TextBlock Text="{Binding Capabilities}" FontSize="10.5" Foreground="#7a7a7a"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
