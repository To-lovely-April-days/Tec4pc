<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tec.App.Views.ExportView">

  <Grid ColumnDefinitions="320,*" Margin="12">

    <ScrollViewer Grid.Column="0">
      <StackPanel Spacing="10" Margin="0,0,12,0">
        <TextBlock Text="记录与导出" Classes="h1" />
        <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" />

        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="时间基准" Classes="h2" />
            <RadioButton GroupName="base" Content="墙钟" IsChecked="{Binding WallBase, Mode=TwoWay}" FontSize="12" />
            <RadioButton GroupName="base" Content="各通道基准" IsChecked="{Binding !WallBase}" FontSize="12" />
            <TextBlock Text="{Binding BaseNote}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="表格形态" Classes="h2" />
            <CheckBox Content="宽表（不勾则为长表）" IsChecked="{Binding WideTable, Mode=TwoWay}" FontSize="12" />
            <TextBlock Text="{Binding ShapeNote}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="导出内容" Classes="h2" />
            <CheckBox Content="执行记录（计划 / 实际 / 两种偏差）" IsChecked="{Binding IncludeExecution, Mode=TwoWay}" FontSize="12" />
            <CheckBox Content="事件记录（暂停 / 参数修改 / 报警 / 取样）" IsChecked="{Binding IncludeEvents, Mode=TwoWay}" FontSize="12" />
            <CheckBox Content="采样数据" IsChecked="{Binding IncludeSamples, Mode=TwoWay}" FontSize="12" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Text="通道" Classes="h2" />
            <ItemsControl ItemsSource="{Binding Channels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected, Mode=TwoWay}" FontSize="12" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Text="数据列" Classes="h2" />
            <ItemsControl ItemsSource="{Binding Tags}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Display}" IsChecked="{Binding Selected, Mode=TwoWay}" FontSize="12" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="刷新预览" Command="{Binding Refresh}" FontSize="12" Padding="12,4" />
          <Button Content="导出到文件" Command="{Binding Save}" FontSize="12" Padding="12,4" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="1" Classes="card" Padding="0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="预览" Classes="h2" Margin="10,8" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
          <SelectableTextBlock Text="{Binding Preview}" Classes="mono" Margin="10,0,10,10" />
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
