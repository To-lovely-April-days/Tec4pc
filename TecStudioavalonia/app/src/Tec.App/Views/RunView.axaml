<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Tec.App.Controls"
             x:Class="Tec.App.Views.RunView">

  <DockPanel Margin="12">

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{Binding BatchText}" Classes="h2" VerticalAlignment="Center" />
        <TextBlock Text="{Binding SimNote}" Classes="muted" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding RecipeToLoad, Mode=TwoWay}"
                  MinWidth="200" FontSize="12">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="启动该通道" Command="{Binding StartChannel}" FontSize="12" Padding="12,4" />
        <Button Content="暂停" Command="{Binding PauseChannel}" FontSize="12" Padding="12,4" />
        <Button Content="继续" Command="{Binding ResumeChannel}" FontSize="12" Padding="12,4" />
        <Button Content="跳过当前步" Command="{Binding SkipStep}" FontSize="12" Padding="12,4" />
        <Button Content="中止" Command="{Binding AbortChannel}" FontSize="12" Padding="12,4" />
        <Button Content="确认提示" Command="{Binding ConfirmPrompt}" FontSize="12" Padding="12,4" />
        <Button Content="{Binding AxisText}" Command="{Binding ToggleAxis}" FontSize="12" Padding="12,4" />
        <TextBlock Text="{Binding Error}" Foreground="#b3261e" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <!-- 通道磁贴：通道各自启动，没启动的就是空闲，不占别人的时间轴 -->
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tiles}" Margin="0,0,0,10">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="card" Margin="0,0,8,0" PointerPressed="OnTilePressed" Background="White">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" Classes="h2" />
                <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="#6b7280" VerticalAlignment="Center" />
                <TextBlock Text="等操作人确认" IsVisible="{Binding IsWaitingOperator}"
                           FontSize="11" Foreground="#a4590a" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding RecipeName}" Classes="muted" />
              <TextBlock Text="{Binding CurrentStep}" FontSize="12" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Tr, StringFormat='Tr {0}'}" Classes="mono" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Tj, StringFormat='Tj {0}'}" Classes="mono" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Rpm}" Classes="mono" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Extra}" Classes="mono" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Elapsed, StringFormat='已运行 {0}'}" Classes="muted" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Drift, StringFormat='偏差 {0}'}" Classes="muted" />
              </Grid>
              <TextBlock Text="{Binding Projected, StringFormat='预计完成 {0}（滚动预测）'}" Classes="muted" />
              <TextBlock Text="{Binding Planned, StringFormat='基线计划 {0}'}" Classes="muted" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 甘特：计划条（浅）与实际条（实）上下并排 -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10" Padding="6">
      <ctl:GanttView x:Name="Gantt" Height="200" />
    </Border>

    <!-- 执行记录：步骤行与事件行在同一条链上 -->
    <Border Classes="card" Padding="0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedTitle}" Classes="h2" Margin="10,8" />
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,90,80,80,80,80,80,90,70"
              Background="#f3f5f7" Height="26">
          <TextBlock Grid.Column="0" Text="步骤 / 事件" Classes="muted" Margin="8,5,0,0" />
          <TextBlock Grid.Column="1" Text="结束方式" Classes="muted" Margin="2,5,0,0" />
          <TextBlock Grid.Column="2" Text="计划开始" Classes="muted" Margin="2,5,0,0" />
          <TextBlock Grid.Column="3" Text="实际开始" Classes="muted" Margin="2,5,0,0" />
          <TextBlock Grid.Column="4" Text="开始偏差" Classes="muted" Margin="2,5,0,0" />
          <TextBlock Grid.Column="5" Text="计划时长" Classes="muted" Margin="2,5,0,0" />
          <TextBlock Grid.Column="6" Text="实际时长" Classes="muted" Margin="2,5,0,0" />
          <TextBlock Grid.Column="7" Text="时长偏差" Classes="muted" Margin="2,5,0,0" />
          <TextBlock Grid.Column="8" Text="结束原因" Classes="muted" Margin="2,5,0,0" />
        </Grid>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,90,80,80,80,80,80,90,70" Margin="8,3">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="●" FontSize="10" Foreground="#8a63d2" IsVisible="{Binding IsEvent}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Note}" FontSize="11" Foreground="#6b7280" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Termination}" FontSize="11" Foreground="#6b7280" />
                  <TextBlock Grid.Column="2" Text="{Binding PlanStart}" Classes="mono" />
                  <TextBlock Grid.Column="3" Text="{Binding ActualStart}" Classes="mono" />
                  <TextBlock Grid.Column="4" Text="{Binding StartDeviation}" Classes="mono" />
                  <TextBlock Grid.Column="5" Text="{Binding PlanDuration}" Classes="mono" />
                  <TextBlock Grid.Column="6" Text="{Binding ActualDuration}" Classes="mono" />
                  <TextBlock Grid.Column="7" Text="{Binding DurationDeviation}" Classes="mono" />
                  <TextBlock Grid.Column="8" Text="{Binding Reason}" FontSize="11" Foreground="#6b7280" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
