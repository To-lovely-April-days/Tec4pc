<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Tec.App.Views"
             x:Class="Tec.App.Views.RecipeView">

  <Grid ColumnDefinitions="230,*,360">

    <!-- 指令库：按模块分组，配方从这里选。指令由驱动声明，不是写死的 -->
    <Border Grid.Column="0" Classes="section">
      <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="指令库" Classes="h2" Margin="0,0,0,6" />
        <Button DockPanel.Dock="Bottom" Content="加入配方" Command="{Binding AddCommand}"
                HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="0,6" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Modules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,10">
                  <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                             Foreground="#6b7280" Margin="0,0,0,4" />
                  <ListBox ItemsSource="{Binding Commands}"
                           SelectionChanged="OnCommandSelected"
                           BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontSize="12" />
                          <TextBlock Text="{Binding Termination}" FontSize="10" Foreground="#9aa1ab" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 步骤表：计划开始/耗时全部来自同一份 Schedule -->
    <DockPanel Grid.Column="1" Margin="12">
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ComboBox ItemsSource="{Binding Library}" SelectedItem="{Binding Recipe, Mode=TwoWay}"
                    MinWidth="220" FontSize="12">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="装载到" Classes="muted" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding TargetChannels}" SelectedItem="{Binding TargetChannel, Mode=TwoWay}"
                    MinWidth="90" FontSize="12">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="上移" Command="{Binding MoveUp}" FontSize="12" Padding="10,3" />
          <Button Content="下移" Command="{Binding MoveDown}" FontSize="12" Padding="10,3" />
          <Button Content="复制" Command="{Binding DuplicateStep}" FontSize="12" Padding="10,3" />
          <Button Content="删除" Command="{Binding RemoveStep}" FontSize="12" Padding="10,3" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding TotalText}" Classes="muted" />
          <TextBlock Text="{Binding IssueSummary}" Classes="muted" />
          <TextBlock Text="{Binding MissingText}" IsVisible="{Binding HasMissing}"
                     FontSize="12" Foreground="#b3261e" />
        </StackPanel>
      </StackPanel>

      <Border Classes="card" Padding="0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="40,*,110,90,90,80"
                Background="#f3f5f7" Height="28">
            <TextBlock Grid.Column="0" Text="#" Classes="muted" Margin="8,6,0,0" />
            <TextBlock Grid.Column="1" Text="步骤" Classes="muted" Margin="4,6,0,0" />
            <TextBlock Grid.Column="2" Text="结束方式" Classes="muted" Margin="4,6,0,0" />
            <TextBlock Grid.Column="3" Text="计划开始" Classes="muted" Margin="4,6,0,0" />
            <TextBlock Grid.Column="4" Text="计划时长" Classes="muted" Margin="4,6,0,0" />
            <TextBlock Grid.Column="5" Text="模块" Classes="muted" Margin="4,6,0,0" />
          </Grid>
          <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="40,*,110,90,90,80">
                  <TextBlock Grid.Column="0" Text="{Binding Ordinal}" FontSize="12" Foreground="#9aa1ab" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LoopNote}" IsVisible="{Binding IsLoop}"
                               FontSize="11" Foreground="#8a63d2" />
                    <TextBlock Text="缺少驱动" IsVisible="{Binding IsMissing}"
                               FontSize="11" Foreground="#b3261e" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Termination}" FontSize="11" Foreground="#6b7280" />
                  <TextBlock Grid.Column="3" Text="{Binding PlanStart}" Classes="mono" />
                  <TextBlock Grid.Column="4" Text="{Binding PlanDuration}" Classes="mono" />
                  <TextBlock Grid.Column="5" Text="{Binding Module}" FontSize="11" Foreground="#6b7280" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </DockPanel>

    <!-- 参数表单 + 校验清单 -->
    <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
            BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="10">
          <TextBlock Text="{Binding SelectedTitle}" Classes="h2" />
          <TextBlock Text="{Binding SelectedTip}" Classes="muted" TextWrapping="Wrap" />
          <v:SchemaFormView DataContext="{Binding Form}" IsVisible="{Binding HasSelection}" />

          <Border Height="1" Background="#e5e8ec" />
          <TextBlock Text="校验" Classes="h2" />
          <ItemsControl ItemsSource="{Binding Issues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
