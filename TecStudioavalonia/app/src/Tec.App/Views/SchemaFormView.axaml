<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tec.App.Views.SchemaFormView">

  <!-- 表单一律由 schema 渲染：指令参数、通信配置、设备配置共用这一个控件。
       原型验证过 31 条指令零手写表单，这里是它的实装。 -->
  <StackPanel Spacing="8">

    <ItemsControl ItemsSource="{Binding Fields}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="120,*,Auto" Margin="0,0,0,6" IsVisible="{Binding IsVisible}">
            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                       FontSize="12" Foreground="#4b5563" TextWrapping="Wrap" Margin="0,0,8,0" />

            <TextBox Grid.Column="1" Text="{Binding NumberText, Mode=TwoWay}"
                     IsVisible="{Binding IsNumber}" FontSize="12" Padding="6,3" />
            <TextBox Grid.Column="1" Text="{Binding DurationText, Mode=TwoWay}"
                     IsVisible="{Binding IsDuration}" FontSize="12" Padding="6,3"
                     Watermark="时:分:秒" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}"
                      SelectedItem="{Binding ChoiceValue, Mode=TwoWay}"
                      IsVisible="{Binding IsChoice}" FontSize="12" HorizontalAlignment="Stretch" />
            <CheckBox Grid.Column="1" IsChecked="{Binding ToggleValue, Mode=TwoWay}"
                      IsVisible="{Binding IsToggle}" />
            <TextBox Grid.Column="1" Text="{Binding TextValue, Mode=TwoWay}"
                     IsVisible="{Binding IsText}" FontSize="12" Padding="6,3" />

            <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Unit}" FontSize="11" Foreground="#6b7280" />
              <TextBlock Text="{Binding LimitNote}" FontSize="10" Foreground="#9aa1ab"
                         IsVisible="{Binding HasLimitNote}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 多分段表：梯度控温、分段加料 -->
    <StackPanel IsVisible="{Binding HasTable}" Spacing="4">
      <Border Height="1" Background="#e5e8ec" Margin="0,4" />
      <TextBlock Text="{Binding TableLabel}" Classes="h2" />
      <ItemsControl ItemsSource="{Binding RowForms}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#f8f9fb" BorderBrush="#e5e8ec" BorderThickness="1"
                    CornerRadius="4" Padding="6" Margin="0,0,0,4">
              <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Width="118">
                      <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#6b7280" />
                      <TextBox Text="{Binding NumberText, Mode=TwoWay}" IsVisible="{Binding IsNumber}"
                               FontSize="12" Padding="4,2" />
                      <TextBox Text="{Binding DurationText, Mode=TwoWay}" IsVisible="{Binding IsDuration}"
                               FontSize="12" Padding="4,2" />
                      <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding ChoiceValue, Mode=TwoWay}"
                                IsVisible="{Binding IsChoice}" FontSize="12" HorizontalAlignment="Stretch" />
                      <TextBox Text="{Binding TextValue, Mode=TwoWay}" IsVisible="{Binding IsText}"
                               FontSize="12" Padding="4,2" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="＋ 添加一段" Click="OnAddRow" FontSize="12" Padding="8,3" HorizontalAlignment="Left" />
    </StackPanel>

    <Border IsVisible="{Binding HasTip}" Background="#f2f6fb" BorderBrush="#d6e3f3"
            BorderThickness="1" CornerRadius="4" Padding="8">
      <TextBlock Text="{Binding Tip}" FontSize="11" Foreground="#3b5570" TextWrapping="Wrap" />
    </Border>

  </StackPanel>
</UserControl>
