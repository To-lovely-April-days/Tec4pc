<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tec.App.Views.StartView">
  <Grid ColumnDefinitions="210,*">

    <!-- 左侧文件菜单（原型 .startnav） -->
    <Border Grid.Column="0" Background="#f4f4f4" BorderBrush="#dcdcdc" BorderThickness="0,0,1,0">
      <StackPanel Margin="0,10">
        <Button Classes="snav on" Content="打开实验" />
        <Button Classes="snav" Content="新建实验" />
        <Button Classes="snav" Content="保存" />
        <Button Classes="snav" Content="另存为" />
        <Border Height="1" Background="#dcdcdc" Margin="14,8" />
        <Button Classes="snav" Content="导入台面" />
        <Button Classes="snav" Content="导出台面" />
        <Button Classes="snav" Content="数据导出（GLP）" Command="{Binding OpenExport}" />
        <Button Classes="snav" Content="设置" />
        <Border Height="1" Background="#dcdcdc" Margin="14,8" />
        <Button Classes="snav" Content="关于" />
        <Button Classes="snav" Content="退出" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="34,26,34,40">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Border Width="52" Height="52" CornerRadius="6" Background="#3c2d63" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="TecStudio" FontSize="30" FontWeight="Light" Foreground="#2b2b2b" />
            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#7a7a7a" />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,26,0,10">
          <TextBlock Text="最近实验" FontSize="15" Foreground="#3b3b3b" VerticalAlignment="Center" />
          <Border Height="1" Background="#e3e3e3" VerticalAlignment="Center" Width="720" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Recent}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="330" Margin="0,0,14,14" Padding="14" Background="White"
                      BorderBrush="#dcdcdc" BorderThickness="1" CornerRadius="4">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#2b2b2b" />
                    <Border Background="#e8f2fb" CornerRadius="2" Padding="6,1" IsVisible="{Binding Running}">
                      <TextBlock Text="运行中" FontSize="10" Foreground="#0b3760" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="#7a7a7a" />
                  <TextBlock Text="{Binding Badges}" FontSize="11" Foreground="#9a9a9a" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.snav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="18,7" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="#3d3d3d" />
    </Style>
    <Style Selector="Button.snav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#f2f8fd" />
    </Style>
    <Style Selector="Button.snav.on">
      <Setter Property="Background" Value="#e8f2fb" />
      <Setter Property="Foreground" Value="#0b3760" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
</UserControl>
