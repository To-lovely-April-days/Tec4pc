<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tec.App.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <!-- 沿用《台面与配方界面设计说明》§6 的配色与两条硬规则：
         选中态对比度 ≥ 7:1；状态类不复用工具类名。 -->
    <Color x:Key="TecInk">#1c2024</Color>
    <Color x:Key="TecMuted">#6b7280</Color>
    <Color x:Key="TecLine">#d8dde3</Color>
    <Color x:Key="TecPanel">#f6f7f9</Color>
    <Color x:Key="TecAccent">#1f6feb</Color>

    <SolidColorBrush x:Key="Ink" Color="#1c2024" />
    <SolidColorBrush x:Key="Muted" Color="#6b7280" />
    <SolidColorBrush x:Key="Line" Color="#d8dde3" />
    <SolidColorBrush x:Key="Panel" Color="#f6f7f9" />
    <SolidColorBrush x:Key="PanelAlt" Color="#eef1f5" />
    <SolidColorBrush x:Key="Accent" Color="#1f6feb" />
    <SolidColorBrush x:Key="Ok" Color="#177245" />
    <SolidColorBrush x:Key="Warn" Color="#a4590a" />
    <SolidColorBrush x:Key="Bad" Color="#b3261e" />
    <SolidColorBrush x:Key="Ch1" Color="#2f7ed8" />
    <SolidColorBrush x:Key="Ch2" Color="#2aa87a" />
    <SolidColorBrush x:Key="Ch3" Color="#c9772b" />
    <SolidColorBrush x:Key="Ch4" Color="#8a63d2" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
  </Application.Styles>

</Application>
